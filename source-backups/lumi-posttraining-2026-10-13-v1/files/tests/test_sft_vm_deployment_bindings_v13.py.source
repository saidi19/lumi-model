"""Offline verification for selector-corrected control bindings."""

import socket
import sys
import unittest
from unittest.mock import patch

from scripts import prepare_sft_vm_deployment_bindings_v13 as m


class Tests(unittest.TestCase):
    def test_plan_release_and_all_sources_verify(self):
        manifest = m.verify()
        plan = m.build()
        self.assertEqual(len(manifest["outputs"]), 156)
        self.assertEqual(plan["attempt"], m.ATTEMPT)
        self.assertEqual(plan["network_candidate_cidr"], "172.31.96.224/27")

    def test_deployed_controls_reverify_against_v0_2(self):
        pins = m.controls()
        self.assertEqual(set(pins), {m.WATCH, m.STORE})
        self.assertEqual(len(pins), 2)

    def test_drift_rejected(self):
        for key in ("QUALIFIED_SHA", "RELEASE_SHA", "PLAN_SHA", "PLAN_RELEASE_SHA"):
            with self.subTest(key=key), patch.object(m, key, "0" * 64):
                with self.assertRaises(ValueError):
                    m.build()

    def test_no_execution_authority(self):
        with self.assertRaises(ValueError):
            m.run(approved=True)


if __name__ == "__main__":
    socket.has_ipv6 = False

    def guard(event, _args):
        if event.startswith("socket.") or event == "subprocess.Popen":
            raise RuntimeError("offline_only")

    sys.addaudithook(guard)
    unittest.main()
