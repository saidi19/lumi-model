"""Fresh isolated subprocess tests only byte-identical staged tiny CPU sources.

Never calls the Linux entry, rootfs installer, privilege or namespace functions.
Actual ML imports happen only after copying the exact manifest-bound module tree.
The temporary directory and all fixtures belong exclusively to this test.
"""

from __future__ import annotations

import hashlib
import importlib
import json
import os
import subprocess
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CHILD = r'''
import hashlib, importlib, importlib.util, json, os, sys, tempfile, time
from pathlib import Path
root = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location(
    "_staged_entry", root / "scripts/run_checkpoint_guarded_import_v1.py")
entry = importlib.util.module_from_spec(spec)
spec.loader.exec_module(entry)
manifest = (root / "configs/lumi-4b-sft-import-guard-source-manifest-v0.1.json").read_bytes()
rows = entry.validate_source_manifest(manifest, hashlib.sha256(manifest).hexdigest())
files = {}
for name, row in rows.items():
    body = (root / "src" / name).read_bytes()
    assert len(body) == row["bytes"] and hashlib.sha256(body).hexdigest() == row["sha256"]
    files[name] = body
assert not any(name.split(".", 1)[0] in entry.ML_ROOTS for name in sys.modules)
deadline = time.monotonic() + 30
def budget():
    assert time.monotonic() < deadline
with tempfile.TemporaryDirectory(prefix="lumi-generated-staged-closure-") as temporary:
    parent = Path(temporary).resolve()
    source, staging = entry.stage_private_sources(parent, files)
    del files
    sys.path.insert(0, str(source))
    fixture = importlib.import_module("lumi.posttraining_checkpoint_guard_fixture_v1")
    import lumi
    assert Path(lumi.__file__).resolve() == source / "lumi/__init__.py"
    import lumi.configuration_lumi, lumi.modeling_lumi
    assert Path(lumi.configuration_lumi.__file__).is_relative_to(source)
    assert Path(lumi.modeling_lumi.__file__).is_relative_to(source)
    private = parent / "fixture"
    private.mkdir(mode=0o700)
    report = fixture.run_tiny_fixture(private, check_budget=budget)
    budget()
    assert report["status"] == "passed"
    print(json.dumps({"status":"passed","staging":staging,"fixture":report},sort_keys=True))
'''


class StagedSourceClosureTests(unittest.TestCase):
    def test_exact_staged_source_closure_runs_one_genuine_tiny_import(self):
        environment = dict(os.environ)
        environment.update({"OMP_NUM_THREADS": "1", "OPENBLAS_NUM_THREADS": "1",
                            "MKL_NUM_THREADS": "1", "CUDA_VISIBLE_DEVICES": "",
                            "HF_HUB_OFFLINE": "1", "HF_DATASETS_OFFLINE": "1",
                            "TRANSFORMERS_OFFLINE": "1", "HF_HUB_DISABLE_TELEMETRY": "1",
                            "HF_HUB_DISABLE_PROGRESS_BARS": "1", "TOKENIZERS_PARALLELISM": "false",
                            "AWS_EC2_METADATA_DISABLED": "true", "PYTHONDONTWRITEBYTECODE": "1"})
        completed = subprocess.run([sys.executable, "-I", "-B", "-c", CHILD, str(ROOT)],
                                   stdin=subprocess.DEVNULL, capture_output=True,
                                   env=environment, timeout=45, check=False)
        self.assertEqual(completed.returncode, 0, "isolated staged-source tiny fixture failed")
        self.assertLessEqual(len(completed.stdout), 4096)
        report = json.loads(completed.stdout)
        self.assertEqual(report["status"], "passed")
        self.assertEqual(report["staging"]["private_source_copy_files"], 35)
        self.assertEqual(report["staging"]["private_source_copy_bytes_reserved"], 610752)
        self.assertEqual(report["staging"]["private_source_copy_readback_bytes"], 610752)
        self.assertIs(report["staging"]["hostile_owner_code_immutability_verified"], False)
        self.assertIs(report["fixture"]["real_4b_import"], False)
        # Pure validator integration; never call the Linux composition entry.
        from tests.test_sft_checkpoint_guard_sources_v1 import subject

        composition = importlib.import_module(
            subject.__package__ + ".posttraining_checkpoint_guard_composition_v1")
        manifest_path = ROOT / "configs/lumi-4b-sft-import-guard-source-manifest-v0.1.json"
        manifest = manifest_path.read_bytes()
        code = (ROOT / "scripts/run_checkpoint_guarded_import_v1.py").read_bytes()
        environment = {"LUMI_IMPORT_SOURCE_MANIFEST_SHA256": hashlib.sha256(manifest).hexdigest(),
                       "LUMI_IMPORT_ENTRY_SHA256": hashlib.sha256(code).hexdigest()}
        enriched = {**report["fixture"], **report["staging"], "source_files_verified": 35,
                    "source_bytes_verified": 610752,
                    "source_verification_read_bytes": 610752 + len(manifest),
                    "source_manifest_sha256": environment["LUMI_IMPORT_SOURCE_MANIFEST_SHA256"],
                    "entry_sha256": environment["LUMI_IMPORT_ENTRY_SHA256"]}
        packet = composition._canonical(enriched)
        self.assertLessEqual(len(packet), 4096)
        self.assertEqual(composition._worker(composition._parse(packet), environment), enriched)
