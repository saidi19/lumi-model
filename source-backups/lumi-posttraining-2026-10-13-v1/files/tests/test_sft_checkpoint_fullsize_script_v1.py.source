    def test_changed_runtime_source_fails_real_resource_validation_before_worker(self):
        doubles = self.pipeline_doubles()
        self.files["lumi/modeling_lumi.py"] = b"wrong-source-model"
        total = sum(map(len, self.files.values()))
        self.source_report.update(source_bytes_verified=total,
                                  source_verification_read_bytes=total + 1000)
        self.copy_report.update(private_source_copy_bytes_reserved=total,
                                private_source_copy_readback_bytes=total)
        with self.assertRaises(m.FullsizeScriptError):
            self.invoke()
        doubles.module._run_admitted_once.assert_not_called()

    def test_private_worker_failure_is_closed_consumed_and_not_retried(self):
        doubles = self.pipeline_doubles()
        doubles.module._run_admitted_once.side_effect = KeyboardInterrupt("secret worker failure")
        with self.assertRaisesRegex(m.FullsizeScriptError, "^import_failed$"):
            self.invoke()
        with self.assertRaisesRegex(m.FullsizeScriptError, "^already_attempted$"):
            self.invoke()
        doubles.module._run_admitted_once.assert_called_once()

    def test_changed_worker_summary_denies_success_without_retry(self):
        doubles = self.pipeline_doubles()
        self.worker = self.worker | {"gate_5_complete": True}
        with self.assertRaisesRegex(m.FullsizeScriptError, "^result_rejected$"):
            self.invoke()
        with self.assertRaisesRegex(m.FullsizeScriptError, "^already_attempted$"):
            self.invoke()
        doubles.module._run_admitted_once.assert_called_once()

    def test_report_data_never_leaks_into_returned_worker_summary(self):
        doubles = self.pipeline_doubles()
        observed = self.invoke()
        self.assertEqual(set(observed), set(self.worker))
        self.assertNotIn("source_files_verified", observed)
        self.assertNotIn("private_source_copy_files", observed)
        self.assertNotIn("synthetic source", fixtures.canonical(observed).decode())
        doubles.writing.assert_not_called()

    def test_stdout_is_silenced_before_staged_import_and_restored_once_on_success(self):
        doubles = self.pipeline_doubles()
        installed = doubles.install.side_effect

        def install(source):
            doubles.duplicate.assert_called_once_with(1)
            doubles.redirect.assert_called_once_with(2, 1)
            doubles.stream.flush.assert_called_once_with()
            return installed(source)

        doubles.install.side_effect = install
        self.assertEqual(self.invoke(), self.worker)
        self.assertEqual([call.args for call in doubles.redirect.call_args_list],
                         [(2, 1), (99001, 1)])
        doubles.close.assert_called_once_with(99001)
        self.assertEqual(doubles.stream.flush.call_count, 2)

    def test_failed_initial_flush_keeps_null_sink_and_never_imports_or_retries(self):
        doubles = self.pipeline_doubles()
        doubles.stream.flush.side_effect = OSError("private buffer text")
        with self.assertRaisesRegex(m.FullsizeScriptError, "^import_failed$"):
            self.invoke()
        doubles.redirect.assert_called_once_with(2, 1)
        doubles.stream.flush.assert_called_once_with()
        doubles.close.assert_called_once_with(99001)
        doubles.install.assert_not_called()
        with self.assertRaisesRegex(m.FullsizeScriptError, "^already_attempted$"):
            self.invoke()

    def test_failed_final_flush_cannot_reopen_report_channel_or_return_success(self):
        doubles = self.pipeline_doubles()
        doubles.stream.flush.side_effect = [None, OSError("private delayed output")]
        with self.assertRaisesRegex(m.FullsizeScriptError, "^import_failed$"):
            self.invoke()
        doubles.redirect.assert_called_once_with(2, 1)
        self.assertEqual(doubles.stream.flush.call_count, 2)
        doubles.close.assert_called_once_with(99001)
        doubles.module._run_admitted_once.assert_called_once()
        with self.assertRaisesRegex(m.FullsizeScriptError, "^already_attempted$"):
            self.invoke()

    def test_python_buffer_flush_happens_before_restoring_report_descriptor(self):
        doubles = self.pipeline_doubles()
        order = []
        doubles.redirect.side_effect = lambda *args: order.append(("dup2", args))
        doubles.stream.flush.side_effect = lambda: order.append(("flush", ()))
        doubles.close.side_effect = lambda *args: order.append(("close", args))
        self.assertEqual(self.invoke(), self.worker)
        self.assertEqual(order, [("dup2", (2, 1)), ("flush", ()), ("flush", ()),
                                 ("dup2", (99001, 1)), ("close", (99001,))])

    def test_import_prepare_and_worker_failures_restore_stdout_and_close_saved_fd_once(self):
        for stage in ("install", "prepare", "worker"):
            with self.subTest(stage=stage), patch.object(m, "_ATTEMPTED", False):
                doubles = self.pipeline_doubles()
                selected = {"install": doubles.install,
                            "prepare": doubles.module.prepare_entry,
                            "worker": doubles.module._run_admitted_once}[stage]
                selected.side_effect = RuntimeError("secret staged exception")
                with self.assertRaises(m.FullsizeScriptError):
                    self.invoke()
                self.assertEqual([call.args for call in doubles.redirect.call_args_list],
                                 [(2, 1), (99001, 1)])
                doubles.close.assert_called_once_with(99001)
                self.assertTrue(m._ATTEMPTED)

    def test_stdout_duplicate_failure_denies_import_without_restore_or_close_guess(self):
        doubles = self.pipeline_doubles()
        doubles.duplicate.side_effect = OSError("secret dup failure")
        with self.assertRaises(m.FullsizeScriptError):
            self.invoke()
        doubles.duplicate.assert_called_once_with(1)
        doubles.redirect.assert_not_called()
        doubles.close.assert_not_called()
        doubles.install.assert_not_called()

    def test_initial_stdout_redirect_failure_restores_and_never_starts_import(self):
        doubles = self.pipeline_doubles()
        doubles.redirect.side_effect = [OSError("secret redirect failure"), None]
        with self.assertRaises(m.FullsizeScriptError):
            self.invoke()
        self.assertEqual([call.args for call in doubles.redirect.call_args_list],
                         [(2, 1), (99001, 1)])
        doubles.close.assert_called_once_with(99001)
        doubles.install.assert_not_called()

    def test_ambiguous_stdout_restore_or_close_never_retries_or_returns_success(self):
        for stage in ("restore", "close"):
            with self.subTest(stage=stage), patch.object(m, "_ATTEMPTED", False):
                doubles = self.pipeline_doubles()
                if stage == "restore":
                    doubles.redirect.side_effect = [None, OSError("secret restore failure")]
                else:
                    doubles.close.side_effect = OSError("secret close failure")
                with self.assertRaises(m.FullsizeScriptError):
                    self.invoke()
                with self.assertRaisesRegex(m.FullsizeScriptError, "^already_attempted$"):
                    self.invoke()
                self.assertEqual([call.args for call in doubles.redirect.call_args_list],
                                 [(2, 1), (99001, 1)])
                doubles.close.assert_called_once_with(99001)
                doubles.module._run_admitted_once.assert_called_once()

    def test_package_install_uses_inert_lumi_namespace_and_exact_new_entry_module(self):
        modules = {key: value for key, value in sys.modules.items()
                   if key.split(".", 1)[0] not in m.ML_ROOTS | {"lumi"}}
        with patch.dict(sys.modules, modules, clear=True), \
                patch.object(m.importlib, "import_module") as imported:
            m.install_package(Path("/outputs/lumi-import-code-generated/src"))
            package = sys.modules["lumi"]
            self.assertEqual(package.__path__, ["/outputs/lumi-import-code-generated/src/lumi"])
            self.assertIsNone(package.__spec__.loader)
        imported.assert_called_once_with("lumi.posttraining_checkpoint_fullsize_entry_v1")

    def test_preexisting_lumi_namespace_is_not_overwritten(self):
        installed = types.ModuleType("lumi")
        with patch.dict(sys.modules, {"lumi": installed}), \
                patch.object(m.importlib, "import_module") as imported:
            with self.assertRaises(m.FullsizeScriptError):
                m.install_package(Path("/outputs/lumi-import-code-generated/src"))
            self.assertIs(sys.modules["lumi"], installed)
        imported.assert_not_called()

    def test_parent_creation_is_fixed_exclusive_private_and_fsynced(self):
        helper = Mock()
        helper.open_directory.return_value = 80
        info = types.SimpleNamespace(st_dev=1, st_ino=2, st_mode=stat.S_IFDIR | 0o700,
            st_uid=10001, st_gid=10001, st_nlink=2, st_size=0, st_mtime_ns=1, st_ctime_ns=1)
        with patch.object(m.os, "fstat", return_value=info), \
                patch.object(m.os, "mkdir") as mkdir, \
                patch.object(m.os, "open", return_value=81) as opened, \
                patch.object(m.os, "stat", return_value=info) as observed, \
                patch.object(m.os, "fsync") as synced, patch.object(m.os, "close") as closed:
            m.prepare_import_parent(helper)
        helper.open_directory.assert_called_once_with(m.OUTPUT)
        mkdir.assert_called_once_with("import", 0o700, dir_fd=80)
        opened.assert_called_once_with("import", m.DIR_FLAGS, dir_fd=80)
        observed.assert_called_once_with("import", dir_fd=80, follow_symlinks=False)
        self.assertEqual([call.args for call in synced.call_args_list], [(81,), (80,)])
        self.assertEqual([call.args for call in closed.call_args_list], [(81,), (80,)])

    def test_existing_parent_is_not_reused_removed_or_chmodded(self):
        helper = Mock()
        helper.open_directory.return_value = 80
        info = types.SimpleNamespace(st_mode=stat.S_IFDIR | 0o700, st_uid=10001, st_gid=10001)
        with patch.object(m.os, "fstat", return_value=info), \
                patch.object(m.os, "mkdir", side_effect=FileExistsError("secret path")) as mkdir, \
                patch.object(m.os, "open") as opened, patch.object(m.os, "rmdir") as remove, \
                patch.object(m.os, "chmod") as chmod, patch.object(m.os, "close") as closed:
            with self.assertRaisesRegex(m.FullsizeScriptError, "^output_rejected$"):
                m.prepare_import_parent(helper)
        mkdir.assert_called_once()
        opened.assert_not_called()
        remove.assert_not_called()
        chmod.assert_not_called()
        closed.assert_called_once_with(80)

    def test_root_owned_control_metadata_rejects_worker_owner_writable_mode_and_hardlinks(self):
        for uid, gid, mode, links in ((10001, 10001, 0o400, 1), (0, 0, 0o666, 1),
                                     (0, 0, 0o400, 2), (0, 10001, 0o400, 1)):
            info = types.SimpleNamespace(st_mode=stat.S_IFREG | mode,
                                         st_uid=uid, st_gid=gid, st_nlink=links)
            with self.subTest(uid=uid, mode=mode, links=links), \
                    self.assertRaises(m.FullsizeScriptError):
                m._root_owned(info)

    def root_read_doubles(self, *, changed=False):
        directory = types.SimpleNamespace(st_dev=1, st_ino=1, st_mode=stat.S_IFDIR | 0o755,
            st_uid=0, st_gid=0, st_nlink=2, st_size=128, st_mtime_ns=9, st_ctime_ns=9)
        control = types.SimpleNamespace(st_dev=1, st_ino=2, st_mode=stat.S_IFREG | 0o400,
            st_uid=0, st_gid=0, st_nlink=1, st_size=5, st_mtime_ns=9, st_ctime_ns=9)
        observed = types.SimpleNamespace(**vars(control))
        if changed:
            observed.st_ctime_ns += 1
        opened = self.stack.enter_context(patch.object(m.os, "open",
            side_effect=lambda path, *_args, **_kwargs: 99 if path == m.CONTROL.name else 50))
        self.stack.enter_context(patch.object(m.os, "fstat",
            side_effect=lambda fd: control if fd == 99 else directory))
        self.stack.enter_context(patch.object(m.os, "stat", return_value=observed))
        read = self.stack.enter_context(patch.object(m.os, "read", side_effect=[b"ab", b"cde"]))
        close = self.stack.enter_context(patch.object(m.os, "close"))
        return opened, read, close

    def test_root_read_walks_nofollow_ancestors_checks_snapshot_and_bounds_each_read(self):
        opened, read, closed = self.root_read_doubles()
        self.assertEqual(m.root_read(m.CONTROL, maximum=5), b"abcde")
        self.assertEqual([call.args for call in read.call_args_list], [(99, 5), (99, 3)])
        self.assertTrue(all(call.args[1] & m.os.O_NOFOLLOW for call in opened.call_args_list))
        self.assertEqual(opened.call_args_list[-1].args, (m.CONTROL.name, m.READ_FLAGS))
        self.assertEqual([call.args for call in closed.call_args_list][-2:], [(99,), (50,)])

    def test_root_read_size_over_cap_rejects_before_read_and_closes_both_handles(self):
        _, read, closed = self.root_read_doubles()
        with self.assertRaises(m.FullsizeScriptError):
            m.root_read(m.CONTROL, maximum=4)
        read.assert_not_called()
        self.assertEqual([call.args for call in closed.call_args_list][-2:], [(99,), (50,)])

    def test_root_read_detects_replaced_control_metadata(self):
        _, _, closed = self.root_read_doubles(changed=True)
        with self.assertRaises(m.FullsizeScriptError):
            m.root_read(m.CONTROL, maximum=5)
        self.assertEqual([call.args for call in closed.call_args_list][-2:], [(99,), (50,)])

    def test_root_read_short_or_invalid_body_closes_once_without_retry(self):
        for reads in ([b"ab", b""], [b"abcdef"], ["not-bytes"]):
            with self.subTest(reads=reads):
                _, read, closed = self.root_read_doubles()
                read.side_effect = reads
                with self.assertRaises(m.FullsizeScriptError):
                    m.root_read(m.CONTROL, maximum=5)
                self.assertEqual(read.call_count, len(reads))
                self.assertEqual(sum(call.args == (99,) for call in closed.call_args_list), 1)

    def test_root_read_bad_ancestor_owner_rejects_before_leaf_open_or_payload_read(self):
        opened, read, closed = self.root_read_doubles()
        bad = types.SimpleNamespace(st_mode=stat.S_IFDIR | 0o755,
                                     st_uid=10001, st_gid=10001, st_nlink=2)
        with patch.object(m.os, "fstat", return_value=bad):
            with self.assertRaises(m.FullsizeScriptError):
                m.root_read(m.CONTROL, maximum=5)
        opened.assert_called_once_with("/", m.DIR_FLAGS)
        read.assert_not_called()
        closed.assert_called_once_with(50)

    def test_ast_has_one_private_entry_call_no_public_import_or_tiny_fixture(self):
        tree = ast.parse(SCRIPT.read_bytes())
        calls = [node.func.attr for node in ast.walk(tree) if isinstance(node, ast.Call)
                 and isinstance(node.func, ast.Attribute)]
        self.assertEqual(calls.count("_run_admitted_once"), 1)
        self.assertNotIn("run_import", calls)
        self.assertNotIn("run_tiny_fixture", calls)
        self.assertNotIn("_coordinate_admitted_import", calls)


if __name__ == "__main__":
    unittest.main()
