import importlib.util
import os
import stat
import tempfile
import types
import unittest
from pathlib import Path
from unittest.mock import patch

from tests import test_sft_vm_parent_entry_v1 as previous


def load():
    spec = importlib.util.spec_from_file_location(
        "parent_entry_v2_test", previous.ROOT / "scripts/run_sft_vm_parent_entry_v2.py"
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class EntryTests(previous.EntryTests):
    def setUp(self):
        self.enterContext(patch.object(previous, "load", side_effect=load))
        super().setUp()


class ClosureTests(previous.ClosureTests):
    def setUp(self):
        self.enterContext(patch.object(previous, "load", side_effect=load))
        super().setUp()


class JoinedTests(previous.JoinedTests):
    def setUp(self):
        self.enterContext(patch.object(previous, "load", side_effect=load))


class ReadMetadataTests(unittest.TestCase):
    def check(self, change, module):
        with tempfile.TemporaryDirectory() as temporary:
            path = Path(temporary) / "source.py"
            path.write_bytes(b"synthetic")
            info = path.stat()
            fields = ("st_dev", "st_ino", "st_nlink", "st_size", "st_mtime_ns", "st_ctime_ns")
            values = {name: getattr(info, name) for name in fields}
            values.update(st_uid=0, st_gid=0, st_mode=stat.S_IFREG | 0o400, st_atime_ns=1)
            before = types.SimpleNamespace(**values)
            after = types.SimpleNamespace(**(values | change))
            parent = types.SimpleNamespace(st_uid=0, st_mode=stat.S_IFDIR | 0o700)
            with (
                patch.object(Path, "lstat", return_value=parent),
                patch.object(os, "fstat", side_effect=[before, after]),
            ):
                return module.root_file(path)

    def test_linux_read_atime_change_accepted_v2_not_v1(self):
        self.assertEqual(self.check({"st_atime_ns": 2}, load()), b"synthetic")
        with self.assertRaises(ValueError):
            self.check({"st_atime_ns": 2}, previous.load())

    def test_content_owner_and_link_changes_still_rejected(self):
        for change in (
            {"st_mtime_ns": -1},
            {"st_ctime_ns": -1},
            {"st_uid": 99},
            {"st_nlink": 2},
            {"st_size": 4},
        ):
            with self.subTest(change=change), self.assertRaises(ValueError):
                self.check(change, load())
