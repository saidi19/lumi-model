"""Offline audit regressions; altered receipts exist only in memory."""

import copy
import socket
import subprocess
import unittest
from unittest.mock import patch

from scripts import verify_sft_vm_attempt022_control_execution_v1 as verifier


class ReceiptAuditTests(unittest.TestCase):
    def setUp(self):
        for module, name in (
            (socket, "socket"),
            (socket, "create_connection"),
            (subprocess, "run"),
            (subprocess, "Popen"),
        ):
            guard = patch.object(module, name, side_effect=AssertionError("offline_only"))
            guard.start()
            self.addCleanup(guard.stop)

    def reject_changed_receipt(self, path, change):
        original = verifier.load

        def changed(candidate):
            value = copy.deepcopy(original(candidate))
            if candidate == path:
                change(value)
            return value

        with patch.object(verifier, "load", side_effect=changed):
            with self.assertRaises(ValueError):
                verifier.verify()

    def test_complete_bound_receipts_pass(self):
        report = verifier.verify()
        self.assertEqual(report["total_deployment_control_calls"], 41)
        self.assertFalse(report["independent_live_admission_passed"])
        self.assertFalse(report["gate_5_complete"])

    def test_watchdog_budget_excess_rejected(self):
        self.reject_changed_receipt(
            verifier.watchdog.OUTPUT / "entry-result.json",
            lambda value: value.update(total_control_calls=46),
        )

    def test_private_bucket_readback_failure_rejected(self):
        self.reject_changed_receipt(
            verifier.bucket.OUTPUT / "result.json",
            lambda value: value.update(privacy_readback_verified=False),
        )

    def test_changed_request_digest_rejected(self):
        self.reject_changed_receipt(
            verifier.watchdog.OUTPUT / "call-01-started.json",
            lambda value: value.update(request_sha256="0" * 64),
        )

    def test_changed_human_authorization_rejected(self):
        self.reject_changed_receipt(
            verifier.bucket.APPROVAL,
            lambda value: value.update(human_message="not_the_authorized_reply"),
        )


if __name__ == "__main__":
    unittest.main()
