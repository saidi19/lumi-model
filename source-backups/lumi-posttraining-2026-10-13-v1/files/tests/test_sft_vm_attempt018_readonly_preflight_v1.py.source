"""Offline checks for the attempt-018 read-only preflight boundary."""

import ast
import socket
import sys
import time
import unittest
from pathlib import Path
from unittest.mock import Mock, patch

from scripts import preflight_sft_vm_attempt018_v1 as m


class Tests(unittest.TestCase):
    def setUp(self):
        m.bind()
        self.client = Mock()
        self.budget = {"calls": 0, "start": time.monotonic()}
        self.wrapper = m.ReadOnlyClient(self.client, self.budget)

    def test_mutations_and_objects_rejected_before_client(self):
        names = (
            "run_instances", "stop_instances", "delete_instance_connect_endpoint",
            "create_user", "put_bucket_policy", "get_object", "head_object",
            "list_objects_v2", "list_object_versions",
        )
        for name in names:
            with self.subTest(name=name), self.assertRaises(ValueError):
                getattr(self.wrapper, name)()
        self.assertEqual(self.budget["calls"], 0)
        self.assertFalse(self.client.mock_calls)

    def test_read_budget_and_deadline(self):
        self.wrapper.describe_instances(InstanceIds=["synthetic"])
        self.assertEqual(self.budget["calls"], 1)
        self.budget["calls"] = 79
        with self.assertRaises(ValueError):
            self.wrapper.describe_instances()
        self.budget.update(calls=0, start=time.monotonic() - 1500)
        with self.assertRaises(ValueError):
            self.wrapper.get_caller_identity()

    def test_fresh_graph_and_controls_authenticate(self):
        outer, manifest, pins = m.local()
        self.assertEqual(manifest["attempt"], m.ATTEMPT)
        self.assertEqual(len(manifest["outputs"]), 156)
        self.assertEqual(len(pins), 2)
        self.assertTrue(callable(m.admission(outer)))

    def test_no_execution_function_or_marker_path(self):
        function = m.admission(None)
        self.assertNotIn("run", function.__globals__)
        self.assertNotIn("authorized", function.__globals__)
        tree = ast.parse(Path(m.__file__).read_bytes())
        calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call)]
        self.assertFalse(any(
            isinstance(node.func, ast.Attribute) and node.func.attr == "_run_network_host_once"
            for node in calls
        ))

    def test_source_and_qualified_drift_rejected(self):
        for key in ("QUALIFIED_SHA", "BINDINGS_SHA", "SOURCE_SHA"):
            with self.subTest(key=key), patch.object(m, key, "0" * 64):
                with self.assertRaises(ValueError):
                    m.local() if key != "SOURCE_SHA" else m.admission(None)


if __name__ == "__main__":
    socket.has_ipv6 = False

    def guard(event, _args):
        if event.startswith("socket.") or event == "subprocess.Popen":
            raise RuntimeError("offline_only")

    sys.addaudithook(guard)
    unittest.main()
