import contextlib
import importlib.util
import io
import json
import subprocess
import unittest
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location(
    "native_probe_v2_test", ROOT / "scripts/probe_sft_vm_network_native_v2.py"
)
m = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(m)


class ProbeDiagnosticsTests(unittest.TestCase):
    def command_failure(self, stderr, code=1, stdout=b""):
        # Synthetic commands only; never starts a subprocess.
        with patch.object(
            m.subprocess,
            "run",
            return_value=SimpleNamespace(returncode=code, stdout=stdout, stderr=stderr),
        ) as call:
            with self.assertRaises(m.CommandFailure) as failure:
                m.run(["synthetic"], timeout=3)
        self.assertEqual(call.call_count, 1)
        return m.failure_summary(failure.exception)

    def test_known_errors_only_emit_allowlisted_codes(self):
        for pattern, code in m.ERROR_PATTERNS:
            with self.subTest(code=code):
                result = self.command_failure(b"PRIVATE_SENTINEL " + pattern + b" other text")
                self.assertEqual(result, {"error_code": code, "returncode": 1})
                self.assertNotIn("PRIVATE_SENTINEL", json.dumps(result))

    def test_unknown_error_does_not_emit_text(self):
        self.assertEqual(
            self.command_failure(b"PRIVATE_SENTINEL"),
            {"error_code": "command_failed", "returncode": 1},
        )

    def test_diagnostic_and_stdout_bounds(self):
        for stderr, stdout in ((b"x" * 4097, b""), (b"", b"x" * 65537)):
            self.assertEqual(
                self.command_failure(stderr, 0, stdout)["error_code"], "command_output_limit"
            )

    def test_timeout_and_os_error_do_not_emit_details_or_retry(self):
        for error, code in (
            (subprocess.TimeoutExpired("PRIVATE_SENTINEL", 3, stderr=b"secret"), "command_timeout"),
            (OSError("PRIVATE_SENTINEL"), "command_unavailable"),
        ):
            with patch.object(m.subprocess, "run", side_effect=error) as call:
                with self.assertRaises(m.CommandFailure) as caught:
                    m.run(["synthetic"])
            self.assertEqual(call.call_count, 1)
            self.assertEqual(
                m.failure_summary(caught.exception), {"error_code": code, "returncode": None}
            )

    def test_unexpected_exceptions_never_emit_messages(self):
        for error, code in (
            (AssertionError("PRIVATE_SENTINEL"), "assertion_failed"),
            (ValueError("PRIVATE_SENTINEL"), "value_rejected"),
            (RuntimeError("PRIVATE_SENTINEL"), "unexpected_failure"),
        ):
            self.assertEqual(m.failure_summary(error), {"error_code": code})

    def test_success_preserves_stdout(self):
        with patch.object(
            m.subprocess,
            "run",
            return_value=SimpleNamespace(returncode=0, stdout=b"synthetic", stderr=b""),
        ):
            self.assertEqual(m.run(["synthetic"]), b"synthetic")

    def test_child_records_stage_and_code_without_retry_or_payload(self):
        output = io.StringIO()
        with (
            patch.object(m.signal, "alarm"),
            patch.object(m, "policy", return_value=SimpleNamespace(install_policy=lambda: {})),
            patch.object(
                m, "run", side_effect=[b"", m.CommandFailure("syntax_rejected", 1)]
            ) as call,
            contextlib.redirect_stdout(output),
        ):
            m.child()
        self.assertEqual(call.call_count, 2)
        self.assertEqual(
            json.loads(output.getvalue()),
            {
                "isolated_network_namespace": True,
                "failed_phase": "exact_policy_syntax",
                "error_code": "syntax_rejected",
                "returncode": 1,
            },
        )
