"""Offline diagnostic guards and instrumentation fidelity; no cloud access."""

import ast
import socket
import subprocess
import unittest
from types import SimpleNamespace
from unittest.mock import Mock, patch

from scripts import diagnose_sft_vm_attempt022_network_v1 as m


class Tests(unittest.TestCase):
    def setUp(self):
        for module, name in ((socket, "socket"), (socket, "create_connection"),
                             (subprocess, "run"), (subprocess, "Popen")):
            guard = patch.object(module, name, side_effect=AssertionError("offline_only"))
            guard.start()
            self.addCleanup(guard.stop)

    def test_bound_graph_and_named_equality_check(self):
        _, cls, checks, _ = m.local()
        self.assertIn("network_selection_targets_match", checks.allowed_codes)
        self.assertNotIn("_run_network_host_once", cls.__call__.__globals__)
        self.assertNotIn("run", cls.__call__.__globals__)

    def test_check_codes_reject_unknown_and_false(self):
        checks = m.Checks()
        checks.allowed_codes.add("network_selection_targets_match")
        with self.assertRaises(ValueError):
            checks.check(True, "unknown_raw_message")
        with self.assertRaises(ValueError):
            checks.check(False, "network_selection_targets_match")
        self.assertEqual(checks.last_check, "network_selection_targets_match")

    def test_selection_retains_only_cidrs_and_cardinalities(self):
        checks = m.Checks()
        checks.selected(
            {"new_private_subnet_cidr": "172.31.97.64/27", "vpc": "synthetic"},
            {"new_private_subnet_cidr": "172.31.97.96/27", "vpc": "synthetic"},
        )
        self.assertTrue(checks.selection["only_cidr_differs"])
        self.assertEqual(checks.selection["target_field_difference_count"], 1)
        self.assertNotIn("vpc", checks.selection)

    def test_other_target_differences_not_misclassified(self):
        checks = m.Checks()
        checks.selected(
            {"new_private_subnet_cidr": "172.31.97.64/27", "vpc": "one"},
            {"new_private_subnet_cidr": "172.31.97.96/27", "vpc": "two"},
        )
        self.assertFalse(checks.selection["only_cidr_differs"])

    def meter(self, clock=None):
        return m.DiagnosticBudget(Mock(static_identity_client=Mock()),
                                  clock=clock or Mock(return_value=0))

    def test_identity_included_and_calls_capped(self):
        meter = self.meter()
        meter.consume("sts", credential=True, model=SimpleNamespace(name="GetCallerIdentity"))
        self.assertEqual((meter.calls, meter.credential_calls), (1, 1))
        meter.calls = 20
        with self.assertRaises(ValueError):
            meter.consume("ec2", model=SimpleNamespace(name="DescribeSubnets"))
        self.assertEqual(meter.calls, 20)

    def test_mutations_objects_and_other_services_rejected(self):
        for service, operation in (("ec2", "RunInstances"), ("s3", "GetObject"),
                                   ("lambda", "Invoke"), ("ec2", "CreateSubnet")):
            meter = self.meter()
            with self.assertRaises(ValueError):
                meter.consume(service, model=SimpleNamespace(name=operation))
            self.assertEqual(meter.calls, 0)

    def test_expired_time_rejected(self):
        clock = Mock(return_value=0)
        meter = self.meter(clock)
        clock.return_value = 281
        with self.assertRaises(ValueError):
            meter.consume("sts", model=SimpleNamespace(name="GetCallerIdentity"))
        self.assertEqual(meter.calls, 0)

    def test_frozen_source_hash_drift_rejected(self):
        with patch.object(m, "OUTER_SHA", "0" * 64):
            with self.assertRaises(ValueError):
                m.local()

    def test_compiled_method_retains_selection_then_exact_target_comparison(self):
        _, cls, _, _ = m.local()
        self.assertIn("selected", cls.__call__.__code__.co_varnames)
        self.assertIn("network_selection_targets_match", cls.__call__.__code__.co_consts)
        self.assertIn("record_selection", cls.__call__.__code__.co_names)
        raw = m.entry.files.read(m.entry.RELEASE / "scripts/run_sft_vm_private_outer_v7.py")
        node = next(n for n in ast.parse(raw).body if getattr(n, "name", None)
                    == "NetworkAdmission")
        self.assertEqual(sum(isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
                             and n.func.id == "need" for n in ast.walk(node)),
                         len(m.local()[2].allowed_codes))


if __name__ == "__main__":
    unittest.main()
