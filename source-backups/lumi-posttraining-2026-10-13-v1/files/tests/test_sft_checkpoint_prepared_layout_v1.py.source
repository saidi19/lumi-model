"""Pure generated byte controls plus mocked rootfs/filesystem operations only."""

from __future__ import annotations

import ast
import hashlib
import importlib
import json
import os
import stat
import sys
import types
import unittest
from pathlib import Path
from unittest.mock import Mock, patch

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "_synthetic_checkpoint_prepared_layout_v1"
package = types.ModuleType(PACKAGE)
package.__path__ = [str(ROOT / "src/lumi")]
sys.modules[PACKAGE] = package
m = importlib.import_module(PACKAGE + ".posttraining_checkpoint_prepared_layout_v1")
PARENT = "/tmp/lumi-generated-layout-parent"
ROOT_PATH = PARENT + "/lumi-owned-rootfs-generated"
PRIVATE = "private-source-or-path-never-retained"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")


def generated_bundle():
    """Byte surrogates, not a serialized model; never passed to any model loader."""
    config = m.controls.FIXED_CONFIG_RAW
    state = canonical({"checkpoint_schema_version": 1, "step": 4, "sequence_cursor": 8,
        "tokens_seen": 256, "run_fingerprint": "a" * 64,
        "run_specification": {"source_commit": "b" * 40, "config_sha256": sha(config),
                              "distributed": {"world_size": 2}}})
    checkpoint = {"distributed-training-state.json": state, "model/.metadata": b"generated-meta",
                  "model/__0_0.distcp": b"generated-data", "trainer-rank-00000.pt": b"zero",
                  "trainer-rank-00001.pt": b"one"}
    manifest = "".join(sha(raw) + "  " + name + "\n"
                       for name, raw in sorted(checkpoint.items())).encode("ascii")
    checkpoint["manifest.sha256"] = manifest
    handoff = {"checkpoint": {"directory": "checkpoint", "step": 4, "sequence_cursor": 8,
                              "tokens_seen": 256},
        "files": [{"path": name, "bytes": len(raw), "sha256": sha(raw)}
                  for name, raw in sorted(checkpoint.items())],
        "gate": "lumi_4b_checkpoint_handoff_v0.1", "run_fingerprint": "a" * 64,
        "schema_version": 1, "source_commit": "b" * 40, "status": "sealed", "world_size": 2}
    handoff["handoff_sha256"] = sha(canonical(handoff))
    handoff_raw = canonical(handoff)
    tokenizer = {"tokenizer/" + name: b'{"generated":true}' for name in
                 ("lumi_tokenizer_metadata.json", "tokenizer.json", "tokenizer_config.json")}
    tokens = [{"relative_path": name, "bytes": len(raw), "sha256": sha(raw)}
              for name, raw in sorted(tokenizer.items())]
    base = {"schema_version": "lumi.posttraining-base-binding.v0.1", "checkpoint_stage": "base",
        "model_id": "lumi-4b-base", "run_fingerprint": "a" * 64, "source_commit": "b" * 40,
        "synthetic_fixture_only": True,
        "checkpoint": {"step": 4, "sequence_cursor": 8, "training_tokens": 256,
                       "world_size": 2, "manifest_sha256": sha(manifest)},
        "tokenizer": {"files": tokens, "manifest_sha256": sha(canonical(tokens))},
        "handoff": {"sha256": handoff["handoff_sha256"], "file_sha256": sha(handoff_raw)}}
    files = dict.fromkeys(m.REQUIRED_SOURCES, b"# generated inert source\n")
    source_manifest = m.sources.build_manifest(files)
    entry = b"# generated inert entry\n"
    controls = m.controls.build_prepared_controls(
        metadata=(canonical(base), manifest, state, config, handoff_raw),
        generation_nonce_sha256="9" * 64, entry_sha256=sha(entry),
        source_manifest_sha256=sha(source_manifest),
        runtime_sources={name: files["lumi/" + name] for name in m.controls.RUNTIME_NAMES})
    return {"files": files, "manifest": source_manifest, "entry": entry,
            # Only pinned repository source is read while constructing this test fixture.
            "helper": (ROOT / "scripts/run_checkpoint_guarded_import_v1.py").read_bytes(),
            "control_raw": controls["control_raw"], "control_bodies": controls["bodies"],
            "generated_inputs": {"checkpoint": checkpoint, "tokenizer": tokenizer},
            "expected_manifest_sha256": sha(source_manifest), "expected_entry_sha256": sha(entry),
            "expected_control_sha256": sha(controls["control_raw"]),
            "expected_generation_nonce_sha256": "9" * 64}


def metadata(inode, mode, uid=0, size=0):
    return types.SimpleNamespace(st_dev=7, st_ino=inode, st_mode=mode, st_uid=uid, st_gid=uid,
                                 st_size=size, st_nlink=1, st_mtime_ns=12, st_ctime_ns=13)


class LayoutTests(unittest.TestCase):
    def setUp(self):
        self.bundle = generated_bundle()
        self.nodes, self.data, self.fds, self.closed, self.events = {}, {}, {}, [], []
        self.next_inode, self.next_fd = 10, 10
        self.add(PARENT, stat.S_IFDIR | 0o700)
        self.add(ROOT_PATH, stat.S_IFDIR | 0o700)
        self.add(ROOT_PATH + "/usr", stat.S_IFDIR | 0o700)
        self.add(ROOT_PATH + "/usr/original", stat.S_IFREG | 0o444, raw=b"base-original")
        self.owned = object.__new__(m.rootfs.OwnedRootfs)
        self.owned._parent, self.owned._path = Path(PARENT), Path(ROOT_PATH)
        self.owned._root_name = "lumi-owned-rootfs-generated"
        self.owned._parent_fd, self.owned._root_fd = self.fd(PARENT), self.fd(ROOT_PATH)
        self.owned._closed = self.owned._tainted = self.owned._frozen = False
        self.owned._nodes = {(): (m.rootfs._identity(self.nodes[ROOT_PATH]), "directory", 0o755),
            ("usr",): (m.rootfs._identity(self.nodes[ROOT_PATH + "/usr"]), "directory", 0o755),
            ("usr", "original"): (m.rootfs._identity(self.nodes[ROOT_PATH + "/usr/original"]),
                                    "file", 0o444)}
        self.owned._seen = set(self.owned._nodes)
        self.owned._installed_files = self.owned._installed_bytes = 0
        self.owned._content_bytes = len(b"base-original")
        self.owned._limits = {"file": 1048576, "total": 10485760, "entries": 256}
        self.owned._guard = Mock(side_effect=self.guard)
        self.owned._verify_tree = Mock()
        self.owned._write = Mock(side_effect=self.software_write)
        self.owned._parents = Mock(side_effect=self.parents)
        self.owned.freeze = Mock(side_effect=self.freeze)
        self.runtime = self.enterContext(patch.object(m.sources, "_runtime"))
        self.os = types.SimpleNamespace(
            **{name: getattr(os, name) for name in ("O_RDONLY", "O_DIRECTORY", "O_NOFOLLOW",
                "O_CLOEXEC", "O_WRONLY", "O_CREAT", "O_EXCL")},
            open=Mock(side_effect=self.open), close=Mock(side_effect=self.close),
            fstat=Mock(side_effect=lambda fd: self.nodes[self.fds[fd]]),
            stat=Mock(side_effect=self.stat), mkdir=Mock(side_effect=self.mkdir),
            write=Mock(side_effect=self.write), fchmod=Mock(side_effect=self.chmod),
            fchown=Mock(side_effect=self.chown))
        self.enterContext(patch.object(m, "os", self.os))
        self.enterContext(patch.object(m.input_mount, "os", self.os))
        self.enterContext(patch.object(m.rootfs, "_open_absolute",
                                      side_effect=lambda path, **_kwargs: self.fd(str(path))))

    def tearDown(self):
        self.assertEqual(len(self.closed), len(set(self.closed)))

    def add(self, path, mode, uid=0, raw=None):
        self.next_inode += 1
        self.nodes[path] = metadata(self.next_inode, mode, uid, 0 if raw is None else len(raw))
        if raw is not None:
            self.data[path] = raw

    def fd(self, path):
        self.assertIn(path, self.nodes)
        fd, self.next_fd = self.next_fd, self.next_fd + 1
        self.fds[fd] = path
        return fd

    def guard(self):
        if self.owned._closed or self.owned._tainted:
            raise m.rootfs.RootfsError("rootfs_operation_failed")

    def parents(self, parts):
        for depth in range(1, len(parts) + 1):
            key = parts[:depth]
            if key not in self.owned._nodes:
                path = ROOT_PATH + "/" + "/".join(key)
                self.assertNotIn(path, self.nodes)
                self.add(path, stat.S_IFDIR | 0o700)
                self.owned._nodes[key] = m.rootfs._identity(self.nodes[path]), "directory", 0o755

    def software_write(self, parts, stream, size, mode):
        self.parents(parts[:-1])
        path = ROOT_PATH + "/" + "/".join(parts)
        self.assertNotIn(path, self.nodes)
        raw = stream.read()
        self.assertEqual(len(raw), size)
        self.add(path, stat.S_IFREG | mode, raw=raw)
        self.owned._nodes[parts] = m.rootfs._identity(self.nodes[path]), "file", mode
        self.owned._content_bytes += len(raw)
        self.events.append(("software-write", path))

    def freeze(self):
        for parts, (_identity, kind, mode) in self.owned._nodes.items():
            if kind == "directory":
                path = ROOT_PATH + ("/" + "/".join(parts) if parts else "")
                self.nodes[path].st_mode = stat.S_IFDIR | mode
        self.owned._frozen = True
        self.events.append(("freeze",))

    def stat(self, name, *, dir_fd, follow_symlinks):
        self.assertFalse(follow_symlinks)
        path = self.fds[dir_fd] + "/" + name
        if path not in self.nodes:
            raise FileNotFoundError()
        return self.nodes[path]

    def mkdir(self, name, mode, *, dir_fd):
        path = self.fds[dir_fd] + "/" + name
        self.assertNotIn(path, self.nodes)
        self.assertEqual(mode, 0o700)
        self.add(path, stat.S_IFDIR | mode)
        self.events.append(("mkdir", path))

    def open(self, name, flags, mode=None, *, dir_fd):
        path = self.fds[dir_fd] + "/" + name
        self.assertTrue(flags & os.O_NOFOLLOW and flags & os.O_CLOEXEC)
        if flags & os.O_CREAT:
            self.assertTrue(flags & os.O_EXCL and flags & os.O_WRONLY)
            self.assertNotIn(path, self.nodes)
            self.assertEqual(mode, 0o600)
            self.add(path, stat.S_IFREG | mode, raw=b"")
        return self.fd(path)

    def close(self, fd):
        self.closed.append(fd)
        del self.fds[fd]

    def write(self, fd, raw):
        path = self.fds[fd]
        self.assertFalse(path.startswith(ROOT_PATH + "/"))
        self.data[path] += raw
        self.nodes[path].st_size += len(raw)
        self.events.append(("input-write", path, len(raw)))
        return len(raw)

    def chmod(self, fd, mode):
        path = self.fds[fd]
        self.assertTrue(any(path.startswith(PARENT + "/" + role)
                            for role in m.SIBLINGS))
        info = self.nodes[path]
        info.st_mode = stat.S_IFMT(info.st_mode) | mode

    def chown(self, fd, uid, gid):
        path = self.fds[fd]
        self.assertTrue(any(path.startswith(PARENT + "/" + role)
                            for role in m.SIBLINGS))
        self.nodes[path].st_uid, self.nodes[path].st_gid = uid, gid

    def install(self, **changes):
        return m.install_prepared_layout(self.owned, **(self.bundle | changes))

    def error(self, code=None, **changes):
        with self.assertRaises(m.PreparedLayoutError) as caught:
            self.install(**changes)
        if code:
            self.assertEqual(caught.exception.args, (code,))
        self.assertNotIn(PRIVATE, str(caught.exception))
        self.assertTrue(caught.exception.__suppress_context__)

    def test_pure_bundle_rebuild_binds_exact_payload_bytes_and_detaches_mappings(self):
        result = m.validate_bundle(**self.bundle)
        self.assertEqual(result["input_files"], 9)
        result["generated_inputs"]["checkpoint"].clear()
        self.assertEqual(len(self.bundle["generated_inputs"]["checkpoint"]), 6)
        self.owned._guard.assert_not_called()
        self.os.open.assert_not_called()

    def test_exact_addons_private_modes_frozen_tree_and_mount_controls(self):
        result = self.install()
        for relative, raw in m.validate_bundle(**self.bundle)["additions"].items():
            path = ROOT_PATH + "/" + relative
            self.assertEqual(self.data[path], raw)
            self.assertEqual(self.nodes[path].st_mode, stat.S_IFREG | 0o444)
            self.assertEqual(self.nodes[path].st_uid, 0)
        self.assertEqual(self.data[ROOT_PATH + "/usr/original"], b"base-original")
        for role, rows in self.bundle["generated_inputs"].items():
            for relative, raw in rows.items():
                path = PARENT + "/" + role + "/" + relative
                self.assertEqual(self.data[path], raw)
                self.assertEqual(self.nodes[path].st_mode, stat.S_IFREG | 0o600)
                self.assertEqual(self.nodes[path].st_uid, 10001)
        self.assertTrue(self.owned._frozen)
        self.assertFalse(self.owned._tainted)
        self.assertEqual(result["mount_arguments"],
                         m.import_rootfs.validate_arguments(**result["mount_arguments"]))
        self.assertEqual(set(result["mount_arguments"]["expected_identities"]),
                         set(m.input_mount.ROLES))
        self.assertEqual(len(result["mount_arguments"]["expected_mountpoint_identity"]), 9)
        self.assertEqual(result["environment"],
                         m.bootstrap.validate_environment(result["environment"]))
        self.assertEqual(set(self.fds), {self.owned._parent_fd, self.owned._root_fd})

    def test_receipt_is_path_free_and_does_not_claim_origin_mount_or_authorization(self):
        receipt = self.install()["receipt"]
        self.assertNotIn(PARENT, json.dumps(receipt))
        self.assertNotIn("generated-meta", json.dumps(receipt))
        for name in m.FALSE_FLAGS:
            self.assertIs(receipt[name], False)
        self.assertIs(receipt["source_mounts_installed"], False)
        self.assertEqual(receipt["new_input_payload_readback_bytes"], 0)
        self.assertEqual(receipt["private_content_write_bytes"],
                         receipt["rootfs_addon_bytes"] + receipt["generated_input_bytes"])

    def test_exact_root_targets_and_empty_output_mountpoint(self):
        self.install()
        for parts, mode in m.TARGET_MODES.items():
            info = self.nodes[ROOT_PATH + "/" + "/".join(parts)]
            self.assertEqual((info.st_uid, stat.S_IMODE(info.st_mode)), (0, mode))
        for role, uid in (("checkpoint", 10001), ("tokenizer", 10001),
                          ("output", 10001), ("mountpoint", 0)):
            info = self.nodes[PARENT + "/" + role]
            self.assertEqual((info.st_uid, stat.S_IMODE(info.st_mode)), (uid, 0o700))
        for name in ("output", "mountpoint"):
            self.assertFalse(any(path.startswith(PARENT + "/" + name + "/") for path in self.nodes))

    def test_wrong_helper_or_entry_or_control_pin_rejects_before_filesystem(self):
        for changes in ({"helper": b"x" * m.HELPER_BYTES}, {"expected_entry_sha256": "0" * 64},
                        {"expected_control_sha256": "0" * 64}):
            self.error("binding_rejected", **changes)
        self.owned._guard.assert_not_called()
        self.os.open.assert_not_called()

    def test_changed_generated_input_same_size_rejected_before_first_write(self):
        value = {role: dict(rows) for role, rows in self.bundle["generated_inputs"].items()}
        value["checkpoint"]["model/.metadata"] = b"X" * len(value["checkpoint"]["model/.metadata"])
        self.error("binding_rejected", generated_inputs=value)
        self.owned._write.assert_not_called()
        self.os.mkdir.assert_not_called()

    def test_missing_extra_or_unsafe_input_path_rejected_before_write(self):
        for extra in ({"../escape": b"x"}, {"other": b"x"}):
            value = {role: dict(rows) for role, rows in self.bundle["generated_inputs"].items()}
            value["checkpoint"].update(extra)
            self.error(generated_inputs=value)
        self.error(generated_inputs={})
        self.owned._write.assert_not_called()

    def test_control_source_membership_and_source_pin_rejected_before_write(self):
        files = dict(self.bundle["files"])
        files["lumi/configuration_lumi.py"] = b"changed-runtime"
        manifest = m.sources.build_manifest(files)
        self.error("binding_rejected", files=files, manifest=manifest,
                   expected_manifest_sha256=sha(manifest))
        self.owned._write.assert_not_called()

    def test_runtime_denial_precedes_bundle_and_filesystem(self):
        self.runtime.side_effect = RuntimeError(PRIVATE)
        self.error("runtime_rejected", helper=b"")
        self.owned._guard.assert_not_called()

    def test_preexisting_external_sibling_rejected_before_any_write(self):
        self.add(PARENT + "/checkpoint", stat.S_IFDIR | 0o700)
        self.error("layout_rejected")
        self.owned._write.assert_not_called()
        self.os.mkdir.assert_not_called()
        self.assertFalse(self.owned._tainted)

    def test_preexisting_addon_subtree_rejected_before_any_write(self):
        self.parents(("inputs",))
        self.error("layout_rejected")
        self.owned._write.assert_not_called()
        self.os.mkdir.assert_not_called()

    def test_frozen_or_previously_modified_root_rejected(self):
        self.owned._frozen = True
        self.error("layout_rejected")
        self.owned._frozen = False
        self.owned._installed_files = 1
        self.error("layout_rejected")
        self.owned._write.assert_not_called()

    def test_wrong_parent_owner_or_mode_rejected_before_first_write(self):
        self.nodes[PARENT].st_uid = 10001
        self.error("layout_rejected")
        self.nodes[PARENT].st_uid = 0
        self.nodes[PARENT].st_mode = stat.S_IFDIR | 0o755
        self.error("layout_rejected")
        self.owned._write.assert_not_called()

    def test_closed_root_object_and_unexpected_approval_cannot_start_installation(self):
        with self.assertRaises(m.PreparedLayoutError):
            m.install_prepared_layout(object(), **self.bundle)
        self.error("layout_rejected", approved=True)
        self.owned._guard.assert_not_called()
        self.owned._write.assert_not_called()

    def test_foreign_owner_guard_rejection_is_redacted_before_first_write(self):
        self.owned._guard.side_effect = OSError(PRIVATE)
        self.error("layout_rejected")
        self.owned._write.assert_not_called()
        self.os.mkdir.assert_not_called()

    def test_all_software_capacity_checks_precede_first_write(self):
        for limits in ({"file": 1, "total": 10485760, "entries": 256},
                       {"file": 1048576, "total": 10, "entries": 256},
                       {"file": 1048576, "total": 10485760, "entries": 4}):
            self.owned._limits = limits
            self.error("layout_rejected")
        self.owned._write.assert_not_called()

    def test_started_software_failure_taints_without_cleanup_or_retry(self):
        self.owned._write.side_effect = OSError(PRIVATE)
        self.error("installation_failed")
        self.assertTrue(self.owned._tainted)
        self.error("layout_rejected")
        self.assertEqual(self.owned._write.call_count, 1)

    def test_short_input_write_not_retried_and_partial_nodes_retained(self):
        self.os.write.side_effect = lambda _fd, raw: len(raw) - 1
        self.error("layout_rejected")
        self.assertEqual(self.os.write.call_count, 1)
        self.assertTrue(self.owned._tainted)
        self.assertIn(PARENT + "/checkpoint", self.nodes)
        self.assertEqual(set(self.fds), {self.owned._parent_fd, self.owned._root_fd})

    def test_freeze_failure_terminal_and_preserves_external_nodes(self):
        self.owned.freeze.side_effect = OSError(PRIVATE)
        self.error("installation_failed")
        self.assertTrue(self.owned._tainted)
        self.assertIn(PARENT + "/output", self.nodes)

    def test_ambiguous_close_not_retried(self):
        original = self.os.close.side_effect

        def fail(fd):
            original(fd)
            if len(self.closed) == 1:
                raise OSError(PRIVATE)

        self.os.close.side_effect = fail
        self.error("close_failed")
        self.assertTrue(self.owned._tainted)

    def test_no_recursive_cleanup_native_mount_or_worker_dispatch_api(self):
        tree = ast.parse(Path(m.__file__).read_text())
        forbidden = {"rmtree", "unlink", "rmdir", "fork", "execve", "mount",
                     "chown", "chmod", "enter_import_rootfs", "run_prepared_synthetic_guard"}
        for node in ast.walk(tree):
            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
                self.assertNotIn(node.func.attr, forbidden)
                if node.func.attr == "remove":
                    self.assertEqual(ast.unparse(node.func.value), "descriptors")


if __name__ == "__main__":
    unittest.main()
