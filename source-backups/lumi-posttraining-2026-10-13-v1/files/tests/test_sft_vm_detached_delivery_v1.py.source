import hashlib
import importlib
import json
import os
import tempfile
import threading
import types
import unittest
from pathlib import Path
from unittest.mock import patch

from tests import test_sft_vm_acquisition_issuer_v1 as prior

m = importlib.import_module("run_sft_vm_detached_delivery_v1")
ID = "1" * 32


def observed(state="workflow_returned", empty=True, reaped=True):
    return dict(
        state=state,
        parent_cgroup_empty=empty,
        children_reaped=reaped,
        gate_5_complete=False,
        retry_allowed=False,
    )


class DeliveryTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.output = self.root / "delivery"
        self.calls = []
        self.elapsed = 0
        self.deadline = 9000
        self.responses = [observed("running", False, False), observed()]

    def exchange(self, operation, body=b"", **kw):
        self.calls.append(operation)
        self.assertGreater(kw["timeout"], 0)
        self.assertLessEqual(kw["timeout"], 100)
        if operation == "dispatch":
            return {"dispatch_requested": True, "workflow_completed": False}
        if operation == "submit":
            self.assertTrue(body)
            return {"delivery_sent": True, "workflow_completed": False}
        if operation == "status":
            return self.responses.pop(0)

    def wait(self, seconds):
        self.elapsed += seconds

    def deliver(self, exchange=None, raw=b"synthetic-session-secret"):
        return m._deliver_admitted_once(
            raw,
            ID,
            self.output,
            exchange or self.exchange,
            deadline=self.deadline,
            clock=lambda: self.elapsed,
            wait=self.wait,
        )

    def report(self):
        raw = (self.output / "result.json").read_bytes()
        self.assertNotIn(b"synthetic-session-secret", raw)
        self.assertNotIn(b"private exception", raw)
        return json.loads(raw)

    def test_waits_for_both_parent_and_children_without_resubmission(self):
        self.responses = [observed(empty=True, reaped=False), observed()]
        self.deliver()
        self.assertEqual(self.calls, ["dispatch", "submit", "status", "status"])
        self.assertEqual(self.elapsed, 30)
        self.assertTrue(self.report()["stop_verified"])
        with self.assertRaises(FileExistsError):
            self.deliver()
        self.assertEqual(len(self.calls), 4)

    def test_ambiguous_send_is_never_resent_and_stop_is_verified(self):
        def exchange(op, *a, **kw):
            if op == "submit":
                self.calls.append(op)
                raise TimeoutError("private exception synthetic-session-secret")
            return self.exchange(op, *a, **kw)

        self.responses = [observed("failed")]
        with self.assertRaises(ValueError):
            self.deliver(exchange)
        self.assertEqual(self.calls, ["dispatch", "submit", "cancel", "status"])
        self.assertTrue(self.report()["stop_verified"])
        self.assertFalse(self.report()["workflow_returned"])

    def test_ambiguous_dispatch_never_submits_or_dispatches_again(self):
        def exchange(op, *a, **kw):
            if op == "dispatch":
                self.calls.append(op)
                raise TimeoutError()
            return self.exchange(op, *a, **kw)

        self.responses = [observed("interrupted")]
        with self.assertRaises(ValueError):
            self.deliver(exchange)
        self.assertEqual(self.calls, ["dispatch", "cancel", "status"])

    def test_unreachable_cancel_not_reported_as_cleanup_success(self):
        def exchange(op, *a, **kw):
            self.calls.append(op)
            raise OSError("private exception")

        with self.assertRaises(ValueError):
            self.deliver(exchange)
        self.assertEqual(self.calls, ["dispatch", "cancel", "status"])
        self.assertFalse(self.report()["stop_verified"])
        self.assertTrue(self.report()["cancel_outcome_unconfirmed"])

    def test_false_success_or_extra_status_fields_rejected(self):
        for value in [
            observed() | {"gate_5_complete": True},
            observed() | {"source": "private"},
            observed() | {"children_reaped": 1},
        ]:
            with self.assertRaises(ValueError):
                m.status(value)
        for raw in [b'{"x":1,"x":2}', b"[]", b"x" * 4097]:
            with self.assertRaises(ValueError):
                m.decode(raw)

    def test_deadline_reserves_stop_and_never_restarts(self):
        def exchange(op, *a, **kw):
            if op == "status":
                self.calls.append(op)
                return observed("running", False, False)
            return self.exchange(op, *a, **kw)

        self.deadline = 150
        with self.assertRaises(ValueError):
            self.deliver(exchange)
        self.assertEqual(self.calls.count("dispatch"), 1)
        self.assertEqual(self.calls.count("submit"), 1)
        self.assertEqual(self.calls.count("cancel"), 1)
        self.assertFalse(self.report()["stop_verified"])

    def test_issuer_role_kept_until_remote_workflow_returns(self):
        cloud = prior.Fake()
        bodies = []

        def callback(body):
            self.assertEqual(cloud.keys, [])
            self.assertIn("role", cloud.entities)
            bodies.append(body)
            self.deliver(raw=body)
            self.assertIn("role", cloud.entities)

        with patch.object(
            prior.m.permissions, "SELECTION_SHA", hashlib.sha256(prior.RAW).hexdigest()
        ):
            result = prior.m._run_for_admitted_delivery(
                prior.RAW,
                ID,
                self.root / "issuer",
                callback,
                cloud=cloud,
                now=lambda: prior.NOW,
                wait=lambda _: None,
            )
        self.assertTrue(result["delivery_returned"])
        self.assertTrue(result["cleanup_verified"])
        self.assertFalse(cloud.entities)
        self.assertEqual(set(bodies[0]), {0})

    def test_public_entry_closed(self):
        with self.assertRaisesRegex(ValueError, "host_guard_not_bound"):
            m.run(approved=True)

    def test_missing_cleanup_time_or_overlong_host_budget_before_any_dispatch(self):
        for deadline in (0, 120, 14401, float("nan"), float("inf"), True):
            self.deadline = deadline
            with self.assertRaises(ValueError):
                self.deliver()
        self.assertFalse(self.calls)
        self.assertFalse(self.output.exists())

    def test_unconfirmed_remote_stop_still_cleans_issuer_without_claiming_success(self):
        cloud = prior.Fake()

        def unavailable(*_a, **_kw):
            raise OSError("private exception")

        with patch.object(
            prior.m.permissions, "SELECTION_SHA", hashlib.sha256(prior.RAW).hexdigest()
        ):
            result = prior.m._run_for_admitted_delivery(
                prior.RAW,
                ID,
                self.root / "issuer",
                lambda body: self.deliver(unavailable, body),
                cloud=cloud,
                now=lambda: prior.NOW,
                wait=lambda _: None,
            )
        self.assertFalse(result["delivery_returned"])
        self.assertTrue(result["cleanup_verified"])
        self.assertFalse(result["immediate_session_revocation_claimed"])
        self.assertFalse(self.report()["stop_verified"])
        self.assertFalse(cloud.entities)


class TransportTests(unittest.TestCase):
    def test_pinned_config_and_fixed_command_no_secret_argv(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary).resolve()
            key = root / "key"
            key.write_bytes(b"synthetic-never-read")
            key.chmod(0o600)
            binding = dict(
                attempt=ID,
                instance="i-" + "1" * 17,
                endpoint="eice-" + "2" * 17,
                root_volume="vol-" + "3" * 17,
                work_volume="vol-" + "4" * 17,
                vm_group="sg-" + "5" * 17,
                endpoint_group="sg-" + "6" * 17,
                key_name="lumi-synthetic",
            )
            config = m.connection.ssh_config(binding, key, root / "known_hosts").encode()
            hosts = b"synthetic-public-host-key"
            for name, raw in (("ssh_config", config), ("known_hosts", hosts)):
                (root / name).write_bytes(raw)
                (root / name).chmod(0o600)
            channel = m.SSH(
                binding,
                key,
                root,
                hashlib.sha256(config).hexdigest(),
                hashlib.sha256(hosts).hexdigest(),
                "a" * 64,
            )
            with patch.object(
                m,
                "pipe_exchange",
                return_value=b'{"delivery_sent":true,"workflow_completed":false}',
            ) as pipe:
                channel("submit", b"synthetic-session-secret")
                argv, body, timeout = pipe.call_args.args
                self.assertNotIn("synthetic-session-secret", " ".join(argv))
                self.assertEqual(body, b"synthetic-session-secret")
                self.assertEqual(timeout, 100)
                self.assertIn("submit " + ID, argv[-1])
                (root / "known_hosts").write_bytes(b"changed")
                with self.assertRaises(ValueError):
                    channel("submit", b"synthetic-session-secret")
                self.assertEqual(pipe.call_count, 1)

    def pipe_case(self, reply):
        input_read, input_write = os.pipe()
        output_read, output_write = os.pipe()
        received = []

        def worker():
            with os.fdopen(input_read, "rb") as stream:
                received.append(stream.read())
            try:
                os.write(output_write, reply)
            except BrokenPipeError:
                pass
            finally:
                os.close(output_write)

        thread = threading.Thread(target=worker, daemon=True)
        process = types.SimpleNamespace(
            pid=424242,
            stdin=os.fdopen(input_write, "wb", buffering=0),
            stdout=os.fdopen(output_read, "rb", buffering=0),
            wait=lambda **kw: 0,
        )
        thread.start()
        try:
            with (
                patch.object(m.subprocess, "Popen", return_value=process) as launch,
                patch.object(m.os, "killpg") as kill,
            ):
                result = m.pipe_exchange(["synthetic-only"], b"synthetic-session-secret", 1)
                self.assertEqual(launch.call_args.kwargs["stderr"], m.subprocess.DEVNULL)
                kill.assert_called_once_with(424242, m.signal.SIGKILL)
                return result
        finally:
            thread.join(timeout=2)
            self.assertFalse(thread.is_alive())
            self.assertEqual(received, [b"synthetic-session-secret"])

    def test_bounded_real_pipes_no_process_or_network(self):
        self.assertEqual(self.pipe_case(b'{"ok":true}'), b'{"ok":true}')

    def test_overlong_reply_rejected(self):
        with self.assertRaises(ValueError):
            self.pipe_case(b"x" * 4097)
