"""Regression: import control entry without running lumi's eager ML registry."""
from __future__ import annotations

import json
import subprocess
import sys
import unittest
from pathlib import Path


class StdlibEntryTests(unittest.TestCase):
    def test_fresh_interpreter_rejects_any_package_or_ml_import(self):
        root = Path(__file__).resolve().parents[1]
        code = r'''
import importlib.abc,importlib.util,json,sys
from pathlib import Path
class RejectML(importlib.abc.MetaPathFinder):
    def find_spec(self,fullname,path=None,target=None):
        if fullname.split('.')[0] in {'lumi','torch','transformers','numpy','safetensors'}:
            raise AssertionError('ML/package import before boundary')
sys.meta_path.insert(0,RejectML())
root=Path(sys.argv[1])
spec=importlib.util.spec_from_file_location('isolated_cli',root/'scripts/run_sft_import_vm_rehearsal_v3.py')
cli=importlib.util.module_from_spec(spec)
spec.loader.exec_module(cli)
control=cli.load_control_module(root)
assert callable(control.worker) and callable(control.launch)
blocked={'lumi','torch','transformers','numpy','safetensors'}
assert not any(n.split('.')[0] in blocked for n in sys.modules)
print(json.dumps({'stdlib_control_loaded':True,'ml_or_package_imports':0}))
'''
        result = subprocess.run([sys.executable, '-I', '-B', '-c', code, str(root)],
                                capture_output=True, timeout=10, check=False)
        self.assertEqual(result.returncode, 0, result.stderr.decode())
        self.assertEqual(json.loads(result.stdout),
                         {'stdlib_control_loaded': True, 'ml_or_package_imports': 0})

    def test_cli_rejects_mac_before_control_load(self):
        if sys.platform == 'linux':
            self.skipTest('Mac entry regression')
        root = Path(__file__).resolve().parents[1]
        result = subprocess.run([
            sys.executable, '-I', '-B', str(root/'scripts/run_sft_import_vm_rehearsal_v3.py'),
            'worker', 'a'*32, 'disk',
        ], capture_output=True, timeout=10, check=False)
        self.assertEqual(result.returncode, 2)
        self.assertEqual(result.stderr, b'host_rejected_linux_required\n')


if __name__ == '__main__':
    unittest.main()
