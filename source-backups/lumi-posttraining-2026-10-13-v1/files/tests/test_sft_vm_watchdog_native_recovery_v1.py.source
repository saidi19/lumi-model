import ast
import importlib.util
import inspect
import time
import types
import unittest
from pathlib import Path
from unittest.mock import Mock, create_autospec

from tests.test_sft_vm_watchdog_login_refresh_v1 import auth, provider
from tests.test_sft_vm_watchdog_report_channel_v1 import module

m = module("execute_sft_vm_watchdog_object_v3")
previous = module("execute_sft_vm_watchdog_object_v2")
builder = module("prepare_sft_vm_watchdog_object_v3")
bootstrap = module("run_sft_vm_network_bootstrap_v2")
ROOT = Path(__file__).resolve().parents[1]


def native_statements(version):
    tree = ast.parse((ROOT / f"scripts/probe_sft_vm_watchdog_native_v{version}.py").read_text())
    native = next(
        n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "native_once"
    )
    return next(n for n in native.body if isinstance(n, ast.Try)).body


def install_statements(version):
    body = native_statements(version)
    start = next(
        i
        for i, n in enumerate(body)
        if isinstance(n, ast.Assign)
        and isinstance(n.value, ast.Constant)
        and n.value.value == "policy_installed"
    )
    end = next(
        i
        for i, n in enumerate(body)
        if isinstance(n, ast.Assign)
        and any(isinstance(t, ast.Name) and t.id == "before" for t in n.targets)
    )
    return body[start:end]


def environment():
    helper = types.SimpleNamespace(
        OUTPUT=Path("/synthetic/root-owned"),
        encode=bootstrap.encode,
        command=create_autospec(bootstrap.command, return_value=b""),
        write=create_autospec(bootstrap.write),
    )
    policy = Mock()
    policy.install_policy.return_value = {"nftables": [{"synthetic": True}]}
    return {"m": helper, "p": policy}


def execute(statements, scope):
    exec(compile(ast.Module(body=statements, type_ignores=[]), "bounded-fixture", "exec"), scope)


class ProbeContractTests(unittest.TestCase):
    def test_frozen_probe_reproduces_actual_signature_failure_before_nft(self):
        scope = environment()
        with self.assertRaises(TypeError):
            execute(install_statements(3), scope)
        scope["m"].command.assert_not_called()

    def test_fixed_install_uses_same_generated_policy_and_supported_file_api(self):
        scope = environment()
        execute(install_statements(4), scope)
        helper = scope["m"]
        path = helper.OUTPUT / "probe-install-policy.json"
        helper.write.assert_called_once_with(path, helper.encode(scope["p"].install_policy()))
        self.assertEqual(
            helper.command.call_args_list[0].args[0],
            ["/usr/sbin/nft", "--check", "--json", "--file", str(path)],
        )
        self.assertEqual(
            helper.command.call_args_list[1].args[0],
            ["/usr/sbin/nft", "--json", "--file", str(path)],
        )

    def test_fixed_transition_uses_bounded_writer_without_stdin_keyword(self):
        body = native_statements(4)
        start = next(
            i
            for i, n in enumerate(body)
            if isinstance(n, ast.Assign)
            and any(isinstance(t, ast.Name) and t.id == "transition_path" for t in n.targets)
        )
        scope = environment()
        scope["transition"] = {"nftables": [{"delete": {"synthetic": True}}]}
        execute(body[start : start + 3], scope)
        helper = scope["m"]
        path = helper.OUTPUT / "probe-setup-transition.json"
        helper.write.assert_called_once_with(path, helper.encode(scope["transition"]))
        helper.command.assert_called_once_with(["/usr/sbin/nft", "--json", "--file", str(path)])

    def test_all_probe_command_calls_bind_to_actual_frozen_signature(self):
        tree = ast.parse((ROOT / "scripts/probe_sft_vm_watchdog_native_v4.py").read_text())
        count = 0
        for call in ast.walk(tree):
            if (
                isinstance(call, ast.Call)
                and isinstance(call.func, ast.Attribute)
                and isinstance(call.func.value, ast.Name)
                and call.func.value.id == "m"
                and call.func.attr == "command"
            ):
                inspect.signature(bootstrap.command).bind(
                    *[None] * len(call.args), **{k.arg: None for k in call.keywords}
                )
                count += 1
        self.assertGreater(count, 5)


spec = importlib.util.spec_from_file_location(
    "_recovery_lifecycle_fixtures", ROOT / "tests/test_sft_vm_watchdog_object_controller_v1.py"
)
fixtures = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fixtures)
fixtures.m, fixtures.builder = m, builder


class RecoveryLifecycleTests(fixtures.ObjectControllerTests):
    @classmethod
    def setUpClass(cls):
        cls.clients = auth.clients(provider())

    def test_credentials_require_temporary_session_and_enough_lifetime(self):
        self.assertGreater(
            self.clients["s3"]._request_signer._credentials._expiry_time.timestamp() - time.time(),
            720,
        )

    def test_terminated_missing_vpc_is_accepted_but_live_missing_or_wrong_vpc_is_rejected(self):
        row = self.api.row()
        row["State"]["Name"] = "terminated"
        del row["VpcId"]
        old_attempt = previous.Attempt(
            self.api, self.writer, fixtures.ATTEMPT, fixtures.channel, builder
        )
        with self.assertRaises(ValueError):
            old_attempt.own_instance(row)
        self.assertEqual(self.attempt.own_instance(row)["InstanceId"], fixtures.INSTANCE)
        for state, vpc in (("stopped", None), ("running", None), ("terminated", "foreign")):
            wrong = dict(row, State={"Name": state}, VpcId=vpc)
            with self.assertRaises(ValueError):
                self.attempt.own_instance(wrong)

    def test_realistic_terminated_shape_and_eighty_second_eni_retention_cleanup(self):
        base = self.api.call
        release_after = [None]

        def call(service, operation, **params):
            response = base(service, operation, **params)
            if operation == "terminate_instances":
                release_after[0] = self.clock.now() + 80
            if operation == "describe_instances" and self.api.state == "terminated":
                for reservation in response["Reservations"]:
                    for row in reservation["Instances"]:
                        row.pop("VpcId", None)
            if (
                operation == "describe_network_interfaces"
                and release_after[0] is not None
                and self.clock.now() < release_after[0]
            ):
                return {"NetworkInterfaces": [{"NetworkInterfaceId": "synthetic-releasing"}]}
            return response

        self.api.call = call
        result = self.attempt.execute()
        self.assertTrue(result["cleanup_verified"])
        self.assertTrue(result["native_watchdog_qualified"])
        self.assertEqual(result["errors"], [])
        self.assertGreaterEqual(result["controller_seconds"], 80)
        self.assertLess(result["controller_seconds"], 1800)
        request = next(p for op, p in self.api.calls if op == "run_instances")
        self.assertIs(request["NetworkInterfaces"][0]["DeleteOnTermination"], True)

    def test_resource_bounds_and_frozen_production_code_preserved(self):
        self.assertEqual(m.BOUNDS, previous.BOUNDS)
        old_builder = previous.load("prepare_sft_vm_watchdog_object_v2.py")
        for name in (
            "run_sft_vm_network_bootstrap_v2.py",
            "build_sft_vm_network_expiry_v3.py",
            "sft_vm_watchdog_report_channel_v1.py",
        ):
            self.assertEqual(builder.PINS[name], old_builder.PINS[name])
        self.assertFalse(m.APPROVAL.exists())


if __name__ == "__main__":
    unittest.main()
