import base64
import contextlib
import gzip
import hashlib
import importlib.util
import io
import json
import shlex
import tempfile
import types
import unittest
from pathlib import Path
from unittest.mock import Mock, patch

ROOT = Path(__file__).resolve().parents[1]


def module(name):
    spec = importlib.util.spec_from_file_location(name, ROOT / "scripts" / (name + ".py"))
    result = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(result)
    return result


c = module("execute_sft_vm_watchdog_native_v1")
p = module("probe_sft_vm_watchdog_native_v2")


def frames(checks=None, status="watchdog_failure_receipt_verified"):
    stream = io.StringIO()
    with contextlib.redirect_stdout(stream):
        p.report(checks if checks is not None else dict.fromkeys(c.CHECKS, True), status)
    return stream.getvalue()


class ControllerTests(unittest.TestCase):
    def test_all_bindings_and_cloud_config_fit(self):
        for name in c.BINDINGS:
            c.bound_source(name)
        raw, digest = c.cloud_config()
        self.assertLessEqual(len(raw), 16384)
        self.assertEqual(digest, c.BINDINGS["probe_sft_vm_watchdog_native_v2.py"])
        config = json.loads(raw.split(b"\n", 1)[1])
        self.assertFalse(config["package_update"])
        self.assertFalse(config["package_upgrade"])
        self.assertEqual(len(config["write_files"]), 1)
        content = config["write_files"][0]["content"]
        bundle = json.loads(gzip.decompress(base64.b64decode(content)))
        self.assertEqual(len(bundle), 3)
        for name, source in bundle.items():
            self.assertEqual(hashlib.sha256(source.encode()).hexdigest(), c.BINDINGS[name])
        compile(config["runcmd"][0][-1], "bundle-seed", "exec")

    def test_bundle_seed_writes_exact_sources_and_never_overwrites(self):
        raw, _ = c.cloud_config()
        config = json.loads(raw.split(b"\n", 1)[1])
        bundle = gzip.decompress(base64.b64decode(config["write_files"][0]["content"]))
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / "sources.json").write_bytes(bundle)
            seed = config["runcmd"][0][-1].replace("/opt/lumi-bootstrap-input", directory)
            exec(compile(seed, "synthetic-seed", "exec"), {})
            for name, source in json.loads(bundle).items():
                self.assertEqual((root / name).read_bytes(), source.encode())
                self.assertEqual((root / name).stat().st_mode & 0o777, 0o400)
            with self.assertRaises(FileExistsError):
                exec(compile(seed, "synthetic-seed", "exec"), {})

    def test_bundle_mismatch_rejected_before_source_creation(self):
        raw, _ = c.cloud_config()
        config = json.loads(raw.split(b"\n", 1)[1])
        bundle = json.loads(gzip.decompress(base64.b64decode(config["write_files"][0]["content"])))
        name = next(iter(bundle))
        bundle[name] += "# changed"
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / "sources.json").write_text(json.dumps(bundle))
            seed = config["runcmd"][0][-1].replace("/opt/lumi-bootstrap-input", directory)
            with self.assertRaises(AssertionError):
                exec(compile(seed, "synthetic-seed", "exec"), {})
            self.assertEqual([path.name for path in root.iterdir()], ["sources.json"])

    def test_ready_is_not_success(self):
        self.assertIsNone(c.decode_native_console(frames({}, "ready_for_deliberate_policy_fault")))

    def test_final_and_ready_are_decoded(self):
        text = frames({}, "ready_for_deliberate_policy_fault") + frames()
        self.assertEqual(
            c.decode_native_console(text)["status"], "watchdog_failure_receipt_verified"
        )

    def test_base64_console(self):
        self.assertIsNotNone(c.decode_native_console(base64.b64encode(frames().encode()).decode()))

    def test_partial_is_not_success(self):
        self.assertIsNone(c.decode_native_console(frames().splitlines()[0] + "\n"))

    def test_failed_report_overrides_success(self):
        self.assertIsNone(c.decode_native_console(frames() + frames({}, "failed")))

    def test_missing_check_rejected(self):
        checks = dict.fromkeys(c.CHECKS, True)
        checks.pop("watchdog_failure_receipt")
        self.assertIsNone(c.decode_native_console(frames(checks)))

    def test_integer_check_rejected(self):
        checks = dict.fromkeys(c.CHECKS, True)
        checks["watchdog_exit_code"] = 1
        self.assertIsNone(c.decode_native_console(frames(checks)))

    def test_report_authority_rejected(self):
        value = {
            "schema": "lumi.watchdog-native-probe.v0.2",
            "status": "watchdog_failure_receipt_verified",
            "checks": dict.fromkeys(c.CHECKS, True),
            **c.FLAGS,
        }
        value["host_admitted"] = True
        raw = json.dumps(value).encode()
        encoded = base64.b64encode(raw).decode()
        chunks = [encoded[i : i + 512] for i in range(0, len(encoded), 512)]
        text = "".join(
            f"LUMI_WATCHDOG_PROBE_V2:{hashlib.sha256(raw).hexdigest()}:{i}/{len(chunks)}:{chunk}\n"
            for i, chunk in enumerate(chunks, 1)
        )
        self.assertIsNone(c.decode_native_console(text))

    def test_approval_missing_blocks_before_transport_import(self):
        with tempfile.TemporaryDirectory() as directory:
            with patch.object(c, "APPROVAL", Path(directory) / "missing.json"):
                with self.assertRaisesRegex(RuntimeError, "fresh_watchdog_approval_required"):
                    c.main()

    def test_observer_unit_has_real_newlines_and_authenticated_entry(self):
        unit = p.observer_unit("a" * 64)
        self.assertIn("Before=shutdown.target\n", unit)
        self.assertIn("StandardOutput=journal+console\n", unit)
        entry = next(line for line in unit.splitlines() if line.startswith("ExecStop="))
        argv = shlex.split(entry.split("=", 1)[1])
        self.assertEqual(argv[:4], ["/usr/bin/python3", "-I", "-B", "-c"])
        compile(argv[4], "observer-entry", "exec")
        self.assertIn("a" * 64, argv[4])

    def observe(self, *, failure=True, boot=100, result=b"exit-code"):
        ready = dict.fromkeys(p.CHECKS, True)
        context = {
            "machine_id": "a" * 32,
            "boot_id": "b" * 36,
            "original_deadline_boot_seconds": 500,
        }
        receipt = {
            "status": "network_or_deadline_guard_failed",
            "retry_allowed": False,
            "host_admitted": False,
            "shutdown_requested_by_unit_policy": True,
        }
        if not failure:
            receipt["host_admitted"] = True
        values = {"probe-ready.json": ready, "context.json": context, "watch-failed.json": receipt}
        frozen = types.SimpleNamespace(
            OUTPUT=Path("/synthetic"),
            WATCH="synthetic-watch",
            read=lambda path: json.dumps(values[path.name]).encode(),
            load=lambda name: types.SimpleNamespace(unique=c.unique),
            native_identity=Mock(),
            boot_time=lambda: boot,
            show=lambda *args: result,
        )
        with (
            patch.object(p, "load_bootstrap", return_value=frozen),
            patch.object(p, "report") as report,
        ):
            p.shutdown_observation()
        return report.call_args.args[1]

    def test_shutdown_receipt_valid(self):
        self.assertEqual(self.observe(), "watchdog_failure_receipt_verified")

    def test_shutdown_receipt_wrong_authority(self):
        self.assertEqual(self.observe(failure=False), "failed")

    def test_timer_fallback_is_not_success(self):
        self.assertEqual(self.observe(boot=350), "failed")

    def test_wrong_watchdog_exit_is_not_success(self):
        self.assertEqual(self.observe(result=b"success"), "failed")
