"""Offline tests for attempt-020 target-absence verification."""

import unittest
from unittest.mock import patch

from scripts import verify_sft_vm_attempt020_control_targets_v1 as m


class Tests(unittest.TestCase):
    def test_verified_fail_closed_evidence(self):
        result = m.verify()
        self.assertEqual(result["fresh_target_collisions"], 0)
        self.assertTrue(result["predecessor_instance_stopped"])
        self.assertEqual(result["predecessor_encrypted_volumes_retained"], 2)
        self.assertEqual(result["cloud_mutations"], 0)
        self.assertFalse(result["execution_authority_created"])
        self.assertFalse(result["gate_5_complete"])
        self.assertFalse(result["gpu"])

    def test_evidence_hash_drift_rejected(self):
        original = m.read

        def changed(name, digest):
            if name == m.EVIDENCE:
                digest = "0" * 64
            return original(name, digest)

        with patch.object(m, "read", changed), self.assertRaises(ValueError):
            m.verify()


if __name__ == "__main__":
    unittest.main()
