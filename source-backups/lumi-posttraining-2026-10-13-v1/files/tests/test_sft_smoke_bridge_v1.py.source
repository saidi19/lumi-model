"""Stdlib bridge tests: real ledger/protocol, synthetic metadata and callbacks.

No successful tensor/training execution, target admission or process launch.
Owned Unix socketpairs are used only to construct the real worker client.
"""

from __future__ import annotations

import hashlib
import importlib
import json
import socket
import sys
import threading
import time
import types
import unittest
from pathlib import Path
from unittest.mock import Mock, patch

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "_synthetic_smoke_bridge_v1"
package = types.ModuleType(PACKAGE)
package.__path__ = [str(ROOT / "src/lumi")]
sys.modules[PACKAGE] = package
bridge = importlib.import_module(PACKAGE + ".posttraining_sft_smoke_bridge_v1")
protocol = importlib.import_module(PACKAGE + ".posttraining_sft_epoch_protocol_v2")
worker = importlib.import_module(PACKAGE + ".posttraining_sft_worker_run_v2")


def secret(label):
    return hashlib.sha256(label.encode("ascii")).hexdigest()


class ErrorChecks:
    def error(self, code, operation, *args, **kwargs):
        with self.assertRaises(bridge.BridgeError) as caught:
            operation(*args, **kwargs)
        self.assertEqual(caught.exception.args, (code,))
        self.assertTrue(caught.exception.__suppress_context__)
        self.assertNotIn("PRIVATE", repr(caught.exception))


class RankBridgeTests(ErrorChecks, unittest.TestCase):
    def setUp(self):
        self.left, self.right = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        self.events = []
        self.client = worker.WorkerLedgerClient(
            self.left, rank=0, epoch="a" * 64, token="b" * 64,
            interrupt=lambda: None, maximum_wire_bytes=65536,
            deadline_ns=1000, maximum_exchange_ns=100, clock_ns=lambda: 1)
        self.options = {
            "client": self.client, "rank": 0, "world_size": 8, "record_limit": 8,
            "from_step": 0, "stop_step": 2, "device_type": "cuda",
            "profile": {
                "per_rank_batch_size": 1, "gradient_accumulation_steps": 1,
                "context_window": 4096, "pad_to_multiple_of": 8, "pad_token_id": 0,
                "seed": 2027, "learning_rate": 1e-5, "lr_schedule": "cosine", "warmup_steps": 0,
                "min_learning_rate_ratio": 0.1, "max_grad_norm": 1.0,
                "strategy": "fsdp_full_shard", "precision": "bf16",
                "gradient_sync_mode": "last_microbatch",
            },
            "loader_bindings": dict.fromkeys(worker.PIN_FIELDS, "c" * 64),
            "source_identity_sha256": "d" * 64,
            "checkpoint_limits": dict.fromkeys(worker.LIMIT_KEYS, 4096),
            "admit": lambda: self.events.append("admit"),
            "synchronize": lambda *_: None,
            "interrupt": lambda: self.events.append("interrupt"),
        }

    def tearDown(self):
        self.client.close()
        self.left.close()
        self.right.close()

    def prepared(self, **changes):
        values = {"model": object(), "optimizer": object(), "encoded_root": object(),
                  "output_parent_fd": 99, "close": lambda: self.events.append("close")}
        return bridge.PreparedRank(**{**values, **changes})

    def entry(self, prepare=None, **changes):
        return bridge.AdmittedRank(worker_options={**self.options, **changes},
                                   prepare=prepare or (lambda: self.prepared()))

    def test_constructor_inert_and_summary_raw_text_free(self):
        entry = self.entry()
        self.assertEqual(self.events, [])
        self.assertEqual(self.client.summary()["requests_sent"], 0)
        self.assertEqual(entry.summary()["state"], "idle")
        self.assertNotIn("c" * 64, json.dumps(entry.summary()))

    def test_invalid_geometry_and_capabilities_rejected(self):
        for change in ({"world_size": 2}, {"device_type": "cpu"}, {"admit": None},
                       {"interrupt": None}, {"profile": {}}):
            self.error("invalid_arguments", self.entry, **change)
        self.assertEqual(self.events, [])

    def test_denied_admission_never_prepares_or_runs(self):
        prepare = Mock(side_effect=AssertionError("PRIVATE"))
        entry = self.entry(prepare=prepare, admit=lambda: False)
        with patch.object(bridge.WorkerRun, "run") as run:
            self.error("admission_rejected", entry.run)
            self.error("admission_rejected", entry.run)
        prepare.assert_not_called()
        run.assert_not_called()
        self.assertEqual(self.events, ["interrupt"])

    def test_admission_exception_sanitized_without_prepare(self):
        prepare = Mock()
        entry = self.entry(prepare=prepare, admit=Mock(side_effect=ValueError("PRIVATE")))
        self.error("admission_rejected", entry.run)
        prepare.assert_not_called()

    def test_invalid_resume_rejected_before_admission_and_prepare(self):
        for change, args in (({}, {"resume_manifest_sha256": "e" * 64}),
                             ({"from_step": 1}, {}),
                             ({"from_step": 1}, {"resume_checkpoint_name": "checkpoint-00000002",
                                                "resume_manifest_sha256": "e" * 64})):
            prepare = Mock()
            self.error("invalid_arguments", self.entry(prepare=prepare, **change).run, **args)
            prepare.assert_not_called()
        self.assertNotIn("admit", self.events)

    def test_prepare_failure_consumed_no_worker_or_retry(self):
        prepare = Mock(side_effect=ValueError("PRIVATE"))
        entry = self.entry(prepare=prepare)
        with patch.object(bridge.WorkerRun, "run") as run:
            self.error("prepare_failed", entry.run)
            self.error("prepare_failed", entry.run)
        prepare.assert_called_once()
        run.assert_not_called()
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_invalid_prepared_fd_still_closes_owned_result(self):
        entry = self.entry(prepare=lambda: self.prepared(output_parent_fd=True))
        self.error("prepare_failed", entry.run)
        self.assertEqual(self.events, ["admit", "interrupt", "close"])

    def test_actual_worker_rechecks_admission_before_output_fd(self):
        calls = []

        def admit():
            calls.append(1)
            return None if len(calls) == 1 else False

        entry = self.entry(admit=admit)
        with patch.object(worker, "_directory_info") as output:
            self.error("worker_failed", entry.run)
        output.assert_not_called()
        self.assertEqual(len(calls), 2)
        self.assertEqual(self.events, ["interrupt", "close"])

    def test_delegation_order_and_private_result_without_claiming_training(self):
        prepared = self.prepared()

        def prepare():
            self.events.append("prepare")
            return prepared

        entry = self.entry(prepare=prepare, from_step=1)

        def delegated(*args, **kwargs):
            self.events.append("delegate")
            self.assertIs(args[0], prepared.model)
            self.assertEqual(kwargs["resume_checkpoint_name"], "checkpoint-00000001")
            return {"private_test_sentinel": 1}

        with patch.object(bridge.WorkerRun, "run", side_effect=delegated) as run:
            result = entry.run(resume_checkpoint_name="checkpoint-00000001",
                               resume_manifest_sha256="e" * 64)
            self.error("already_consumed", entry.run)
        self.assertEqual(result, {"private_test_sentinel": 1})
        run.assert_called_once()
        self.assertEqual(self.events, ["admit", "prepare", "delegate", "close"])

    def test_cleanup_failure_rejects_success(self):
        entry = self.entry(prepare=lambda: self.prepared(close=lambda: False))
        with patch.object(bridge.WorkerRun, "run", return_value={}):
            self.error("cleanup_failed", entry.run)
        self.assertEqual(entry.summary()["stage"], "cleanup")

    def test_swallowed_reentry_during_prepare_is_sticky_and_closes(self):
        entry = self.entry()

        def reenter():
            self.error("reentry", entry.run)
            return self.prepared()

        entry._prepare = reenter
        with patch.object(bridge.WorkerRun, "run") as run:
            self.error("reentry", entry.run)
        run.assert_not_called()
        self.assertEqual(self.events, ["admit", "interrupt", "close"])

    def test_worker_exception_closes_once_and_preserves_first_failure(self):
        close = Mock(side_effect=OSError("PRIVATE-CLOSE"))
        entry = self.entry(prepare=lambda: self.prepared(close=close))
        with patch.object(bridge.WorkerRun, "run", side_effect=ValueError("PRIVATE-WORKER")):
            self.error("worker_failed", entry.run)
            self.error("worker_failed", entry.run)
        close.assert_called_once()
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_reinitialization_cannot_reset_consumed_rank(self):
        entry = self.entry(admit=lambda: False)
        self.error("admission_rejected", entry.run)
        self.error("admission_rejected", entry.__init__,
                   worker_options=self.options, prepare=lambda: self.prepared())

    def test_rank_owner_check_precedes_admission_and_prepare(self):
        prepare = Mock()
        entry = self.entry(prepare=prepare)
        with patch.object(bridge.os, "getpid", return_value=-1):
            self.error("owner_mismatch", entry.run)
        prepare.assert_not_called()
        self.assertEqual(self.events, ["interrupt"])


class ParentBridgeTests(ErrorChecks, unittest.TestCase):
    def setUp(self):
        from .test_sft_epoch_protocol_v2 import synthetic_inputs

        caps, counts = synthetic_inputs()
        counts.update(rank_optimizer_steps=32, logical_sample_events=32,
                      rank_local_input_loads=24, maximum_encoded_index_rows=192,
                      maximum_selected_binary_bytes=192 * 4096 * 8,
                      maximum_selected_index_bytes=192 * 176)
        caps.update(maximum_encoded_binary_read_bytes=counts["maximum_selected_binary_bytes"],
                    maximum_encoded_index_read_bytes=counts["maximum_selected_index_bytes"])
        self.clock = [0]
        self.ledger = bridge.Supervisor(caps, counts, world_size=8, clock_ns=lambda: self.clock[0])
        self.sent, self.released, self.events = [], [], []
        self.new()

    def new(self, index=0, **changes):
        self.epoch = secret(f"epoch-{index}")
        self.tokens = {rank: secret(f"token-{index}-{rank}") for rank in range(8)}
        self.sequence = [1] * 8
        self.counts = [0] * 8
        options = dict(supervisor=self.ledger, epoch=self.epoch, rank_tokens=self.tokens,
                       invocation_index=index, admit=lambda: self.events.append("admit"),
                       send_frame=lambda rank, frame: self.sent.append((rank, frame)),
                       release_phase=lambda *args: self.released.append(args),
                       interrupt=lambda: self.events.append("interrupt"),
                       maximum_wire_bytes=1_048_576, maximum_feeds=1000)
        self.parent = bridge.ParentInvocation(**{**options, **changes})
        return self.parent

    def message(self, rank, operation, arguments, sequence=None):
        return protocol.encode_frame({
            "schema_version": protocol.REQUEST_SCHEMA, "epoch": self.epoch, "rank": rank,
            "token": self.tokens[rank], "sequence": self.sequence[rank]
            if sequence is None else sequence, "operation": operation, "arguments": arguments,
        })

    def request(self, rank, operation="reserve", arguments=None, confirm=True):
        before = len(self.sent)
        frame = self.message(rank, operation, arguments or {"private_write_bytes": 1})
        self.parent.feed(rank, frame)
        self.assertEqual(len(self.sent), before + 1)
        peer, frame = self.sent[-1]
        self.assertEqual(peer, rank)
        self.counts[rank] += 1
        sequence = self.sequence[rank]
        self.sequence[rank] += 1
        if confirm:
            self.confirm(rank, frame, sequence)
        return frame, sequence

    def confirm(self, rank, frame, sequence):
        self.parent.feed(rank, self.message(
            rank, "confirm_ack", {"ack_sha256": hashlib.sha256(frame).hexdigest()}, sequence))

    def phase(self, name, step):
        for rank in range(8):
            self.parent.phase(rank, name, step)

    def step(self, start):
        self.request(0, "reserve_step", {"from_step": start, "to_step": start + 1})
        for rank in range(8):
            self.request(rank, "step_complete", {"to_step": start + 1})
        self.phase("checkpoint", start + 1)

    def reports(self, index=0):
        _, start, stop, resume = bridge.SEQUENCE[index]
        return [{
            "schema_version": "lumi.sft-worker-run-summary.v0.2", "state": "complete",
            "stage": "complete", "failure_code": None, "failure_stage": None,
            "completed_steps": stop - start, "saved_checkpoints": stop - start,
            "restored_checkpoints": int(resume), "os_admission_verified": False,
            "os_resource_enforcement": False, "real_sft_execution_permitted": False,
            "production_eligible": False,
        } for _ in range(8)]

    def complete(self, index=0, finish=True):
        _, start, stop, _ = bridge.SEQUENCE[index]
        self.parent.begin()
        self.phase("inputs", start)
        self.phase("restored", start)
        for step in range(start, stop):
            self.step(step)
        if finish:
            self.parent.finish(worker_summaries=self.reports(index), rank_requests=self.counts,
                               host_ram_bytes=256, per_gpu_memory_bytes=[64] * 8)

    def test_constructor_inert_and_summary_omits_epoch_and_tokens(self):
        self.assertEqual(self.events, [])
        self.assertEqual(self.ledger.summary()["invocations_started"], 0)
        self.assertNotIn(self.epoch, json.dumps(self.parent.summary()))

    def test_admission_denied_before_ledger_begin(self):
        parent = self.new(admit=lambda: True)
        self.error("admission_rejected", parent.begin)
        self.error("admission_rejected", parent.begin)
        self.assertEqual(self.ledger.summary()["invocations_started"], 0)
        self.assertEqual(self.sent, [])
        self.assertEqual(self.events, ["interrupt"])

    def test_all_three_invocations_share_ledger_and_old_callback_cannot_poison_next(self):
        for index in range(3):
            if index:
                old = self.parent
                self.new(index)
                self.error("already_consumed", old.feed, 0, b"x")
            self.complete(index)
        summary = self.ledger.summary()
        self.assertEqual(summary["invocations_completed"], 3)
        self.assertEqual(summary["global_optimizer_steps_reserved"], 4)
        self.assertEqual(summary["global_optimizer_steps_completed"], 4)
        self.assertEqual(summary["memory_observations"], 3)
        self.assertEqual(summary["logical_sample_events_reserved"], 32)
        self.assertEqual(self.events, ["admit"] * 3)
        self.assertEqual(len(self.released), 80)  # 4 + 3 + 3 all-rank phase releases.

    def test_commit_fence_waits_for_eighth_confirmation(self):
        self.parent.begin()
        self.phase("inputs", 0)
        self.phase("restored", 0)
        self.request(0, "reserve_step", {"from_step": 0, "to_step": 1})
        for rank in range(7):
            self.request(rank, "step_complete", {"to_step": 1})
        frame, sequence = self.request(7, "step_complete", {"to_step": 1}, confirm=False)
        self.assertEqual(self.parent.summary()["global_step_fences"], 0)
        before = len(self.sent)
        self.confirm(7, frame, sequence)
        self.assertEqual(len(self.sent), before + 8)
        for rank, frame in self.sent[-8:]:
            payload = json.loads(frame[4:])
            self.assertEqual(payload, {"schema_version": bridge.STEP_FENCE_SCHEMA,
                                      "epoch": self.epoch, "rank": rank,
                                      "to_step": 1, "status": "committed"})

    def test_phase_waits_for_all_ranks_and_final_io_confirmation(self):
        self.parent.begin()
        frame, sequence = self.request(3, confirm=False)
        self.phase("inputs", 0)
        self.assertEqual(self.released, [])
        self.confirm(3, frame, sequence)
        self.assertEqual(self.released, [(rank, "inputs", 0) for rank in range(8)])

    def test_ack_send_failure_never_marked_sent_and_no_retry(self):
        parent = self.new(send_frame=Mock(side_effect=OSError("PRIVATE")))
        parent.begin()
        frame = self.message(0, "reserve", {"private_write_bytes": 1})
        self.error("transport_failed", parent.feed, 0, frame)
        self.error("transport_failed", parent.feed, 0, frame)
        self.assertEqual(parent._session.summary()["acknowledgements_sent"], 0)
        self.assertEqual(self.ledger.summary()["resources_reserved"]["private_write_bytes"], 1)
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_wire_and_feed_caps_checked_before_transport(self):
        parent = self.new(maximum_wire_bytes=1)
        parent.begin()
        self.error("wire_exhausted", parent.feed, 0,
                   self.message(0, "reserve", {"private_write_bytes": 1}))
        self.assertEqual(self.sent, [])

    def test_combined_runtime_poll_fails_closed(self):
        self.parent.begin()
        self.clock[0] = 61_000_000_000
        self.error("resource_rejected", self.parent.poll)
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_mismatched_phase_or_duplicate_rank_rejected(self):
        self.parent.begin()
        self.parent.phase(0, "inputs", 0)
        self.error("phase_rejected", self.parent.phase, 0, "inputs", 0)

    def test_finish_requires_rank_reports_and_actual_memory_observation(self):
        self.complete(finish=False)
        reports = self.reports()
        reports[7]["completed_steps"] = True
        self.error("reports_rejected", self.parent.finish, worker_summaries=reports,
                   rank_requests=self.counts, host_ram_bytes=256, per_gpu_memory_bytes=[64] * 8)
        self.assertEqual(self.ledger.summary()["invocations_completed"], 0)

    def test_rank_request_counts_cannot_be_redistributed_while_preserving_sum(self):
        self.complete(finish=False)
        changed = list(self.counts)
        changed[0] -= 1
        changed[1] += 1
        self.error("reports_rejected", self.parent.finish, worker_summaries=self.reports(),
                   rank_requests=changed, host_ram_bytes=256, per_gpu_memory_bytes=[64] * 8)

    def test_over_budget_memory_keeps_invocation_incomplete(self):
        self.complete(finish=False)
        self.error("resource_rejected", self.parent.finish, worker_summaries=self.reports(),
                   rank_requests=self.counts, host_ram_bytes=256, per_gpu_memory_bytes=[2049] * 8)
        self.assertEqual(self.ledger.summary()["invocations_completed"], 0)

    def test_partial_protocol_frame_at_finish_is_rejected(self):
        self.complete(finish=False)
        self.parent.feed(0, b"\x00")
        self.error("resource_rejected", self.parent.finish, worker_summaries=self.reports(),
                   rank_requests=self.counts, host_ram_bytes=256, per_gpu_memory_bytes=[64] * 8)

    def test_send_callback_swallowed_reentry_is_terminal(self):
        def send(*_):
            self.error("reentry", self.parent.poll)

        self.new(send_frame=send)
        self.parent.begin()
        self.error("reentry", self.parent.feed, 0,
                   self.message(0, "reserve", {"private_write_bytes": 1}))
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_feed_count_cap_rejects_before_second_protocol_read(self):
        self.new(maximum_feeds=1)
        self.parent.begin()
        frame, sequence = self.request(0, confirm=False)
        self.error("wire_exhausted", self.confirm, 0, frame, sequence)
        self.assertEqual(self.parent._session.summary()["acknowledgements_confirmed"], 0)

    def test_ack_deadline_rejects_unconfirmed_reservation(self):
        self.parent.begin()
        self.request(0, confirm=False)
        self.error("protocol_failed", self.parent.expire_ack_deadline)
        self.assertEqual(self.ledger.summary()["resources_reserved"]["private_write_bytes"], 1)

    def test_wrong_epoch_or_token_cannot_reach_ledger(self):
        self.parent.begin()
        self.epoch = secret("different-epoch")
        self.error("protocol_failed", self.parent.feed, 0,
                   self.message(0, "reserve", {"private_write_bytes": 1}))
        self.assertEqual(self.ledger.summary()["resources_reserved"]["private_write_bytes"], 0)

    def test_phase_cannot_release_across_pending_optimizer_step(self):
        self.parent.begin()
        self.request(0, "reserve_step", {"from_step": 0, "to_step": 1})
        self.phase("inputs", 0)
        self.assertEqual(self.released, [])
        for rank in range(7):
            self.request(rank, "step_complete", {"to_step": 1})
        frame, sequence = self.request(7, "step_complete", {"to_step": 1}, confirm=False)
        self.error("phase_rejected", self.confirm, 7, frame, sequence)
        self.assertEqual(self.released, [])

    def test_partial_fence_send_failure_cannot_repeat_committed_step(self):
        self.parent.begin()
        self.phase("inputs", 0)
        self.phase("restored", 0)
        self.request(0, "reserve_step", {"from_step": 0, "to_step": 1})
        for rank in range(7):
            self.request(rank, "step_complete", {"to_step": 1})
        frame, sequence = self.request(7, "step_complete", {"to_step": 1}, confirm=False)
        original_send = self.parent._send

        def fail_rank_three(rank, raw):
            if rank == 3:
                raise OSError("PRIVATE-PARTIAL-SEND")
            original_send(rank, raw)

        self.parent._send = fail_rank_three
        self.error("transport_failed", self.confirm, 7, frame, sequence)
        self.error("transport_failed", self.confirm, 7, frame, sequence)
        self.assertEqual(self.ledger.summary()["global_optimizer_steps_completed"], 1)
        self.assertEqual(self.events, ["admit", "interrupt"])

    def test_parent_reinitialization_cannot_reset_active_epoch(self):
        self.parent.begin()
        self.error("already_consumed", self.parent.__init__,
                   supervisor=self.ledger, epoch=self.epoch, rank_tokens=self.tokens,
                   invocation_index=0, admit=lambda: None, send_frame=lambda *_: None,
                   release_phase=lambda *_: None, interrupt=lambda: None,
                   maximum_wire_bytes=1000, maximum_feeds=10)

    def test_real_worker_client_roundtrip_uses_parent_shared_ledger(self):
        server, endpoint = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        server.settimeout(2)
        finished, errors = [], []
        self.new(send_frame=lambda rank, frame: server.sendall(frame))
        self.parent.begin()

        def rank_client():
            client = None
            try:
                client = worker.WorkerLedgerClient(
                    endpoint, rank=0, epoch=self.epoch, token=self.tokens[0],
                    interrupt=lambda: None, maximum_wire_bytes=65536,
                    deadline_ns=time.monotonic_ns() + 2_000_000_000,
                    maximum_exchange_ns=1_000_000_000)
                client.reserve(0, encoded_metadata_read_bytes=3)
                finished.append(client.summary())
            except BaseException:
                errors.append("synthetic_client_failed")
            finally:
                if client is not None:
                    client.close()

        thread = threading.Thread(target=rank_client)
        thread.start()
        try:
            while self.parent._session.summary()["acknowledgements_confirmed"] != 1:
                chunk = server.recv(protocol.MAXIMUM_FRAME_BYTES + 4)
                self.assertTrue(chunk)
                self.parent.feed(0, chunk)
            thread.join(timeout=2)
            self.assertFalse(thread.is_alive())
            self.assertEqual(errors, [])
            self.assertEqual(len(finished), 1)
            self.assertEqual(finished[0]["confirmations_sent"], 1)
            self.assertEqual(self.ledger.summary()["resources_reserved"]
                             ["encoded_metadata_read_bytes"], 3)
        finally:
            server.close()
            endpoint.close()
            thread.join(timeout=2)


if __name__ == "__main__":
    unittest.main()
