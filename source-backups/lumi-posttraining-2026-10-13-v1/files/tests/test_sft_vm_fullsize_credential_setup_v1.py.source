"""Synthetic pipe -> private-file -> existing acquisition/teardown integration."""

import datetime as dt
import fcntl
import importlib
import json
import os
import tempfile
import time
import types
import unittest
from unittest.mock import patch

from tests import test_sft_vm_fullsize_credential_handoff_v1 as previous

fixture = previous.fixture
m = importlib.import_module(fixture.PACKAGE + ".posttraining_vm_fullsize_credential_setup_v1")


def credentials(now=None):
    now = time.time() if now is None else now
    return {
        "AccessKeyId": "ASIASYNTHETICEXAMPLE",
        "SecretAccessKey": "synthetic-secret-never-log",
        "SessionToken": "synthetic-token-never-log",
        "Expiration": dt.datetime.fromtimestamp(now + 5400, dt.UTC).isoformat(),
    }


class InputTests(unittest.TestCase):
    def test_normalizes_only_the_three_existing_source_fields(self):
        body, expiry = m._normalize(json.dumps(credentials(1000000000)).encode(), 1000000000)
        self.assertEqual(set(json.loads(body)), {"access_key", "secret_key", "session_token"})
        self.assertEqual(expiry, 1000005400)

    def test_duplicate_unknown_longlived_whitespace_and_nonstring_rejected(self):
        value = credentials(1000000000)
        changed = [
            value | {"extra": True},
            value | {"AccessKeyId": "AKIAlonglived"},
            value | {"SecretAccessKey": "has space"},
            value | {"SessionToken": 42},
            value | {"Expiration": "2001-09-09T04:16:40"},
            value | {"SecretAccessKey": "x" * 16385},
        ]
        bodies = [json.dumps(v).encode() for v in changed]
        bodies += [b'{"AccessKeyId":"a","AccessKeyId":"b"}', b"[]", b"{}", b"x" * 65537]
        for raw in bodies:
            with self.assertRaises((ValueError, TypeError)):
                m._normalize(raw, 1000000000)

    def test_expired_short_or_overlong_session_rejected(self):
        for seconds in (-1, 3600, 3674, 7201):
            value = credentials(1000000000)
            value["Expiration"] = dt.datetime.fromtimestamp(
                1000000000 + seconds, dt.UTC
            ).isoformat()
            with self.assertRaises(ValueError):
                m._normalize(json.dumps(value).encode(), 1000000000)

    def test_real_pipe_read_restores_flags_and_does_not_close_caller_fd(self):
        read_fd, write_fd = os.pipe()
        self.addCleanup(os.close, read_fd)
        os.write(write_fd, b"synthetic")
        os.close(write_fd)
        flags = fcntl.fcntl(read_fd, fcntl.F_GETFL)
        with patch.object(m.workflow, "ROOT_UID", os.geteuid()):
            self.assertEqual(m._read_pipe(read_fd, time.monotonic() + 1), b"synthetic")
        self.assertEqual(fcntl.fcntl(read_fd, fcntl.F_GETFL), flags)

    def test_pipe_timeout_and_oversize_restore_flags(self):
        read_fd, write_fd = os.pipe()
        self.addCleanup(os.close, read_fd)
        self.addCleanup(os.close, write_fd)
        flags = fcntl.fcntl(read_fd, fcntl.F_GETFL)
        with patch.object(m.workflow, "ROOT_UID", os.geteuid()):
            with self.assertRaises(ValueError):
                m._read_pipe(read_fd, time.monotonic() + 0.01)
            os.write(write_fd, b"123456789")
            with patch.object(m, "MAX_INPUT", 8), self.assertRaises(ValueError):
                m._read_pipe(read_fd, time.monotonic() + 1)
        self.assertEqual(fcntl.fcntl(read_fd, fcntl.F_GETFL), flags)

    def test_regular_file_and_write_only_pipe_rejected(self):
        with tempfile.TemporaryFile() as stream, self.assertRaises(ValueError):
            m._read_pipe(stream.fileno(), time.monotonic() + 1)
        read_fd, write_fd = os.pipe()
        self.addCleanup(os.close, read_fd)
        self.addCleanup(os.close, write_fd)
        with patch.object(m.workflow, "ROOT_UID", os.geteuid()), self.assertRaises(ValueError):
            m._read_pipe(write_fd, time.monotonic() + 1)


class SetupTests(unittest.TestCase):
    complete = previous.WorkflowTests.complete

    def setUp(self):
        previous.WorkflowTests.setUp(self)
        self.secret.unlink()  # Only the synthetic fixture from the prior test helper.
        self.mounted = False
        self.body = json.dumps(credentials()).encode()
        self.mount_failure = None

    def commands(self, args, *a, **kw):
        if args[0] == "/usr/bin/mount":
            self.events.append(args)
            kind = "private" if args[1] == "--make-private" else "tmpfs"
            if kind == self.mount_failure:
                return types.SimpleNamespace(returncode=1, stdout=b"")
            self.mounted = True
            return types.SimpleNamespace(returncode=0, stdout=b"")
        return previous.WorkflowTests.commands(self, args, *a, **kw)

    def execute(self):
        read_fd, write_fd = os.pipe()
        os.write(write_fd, self.body)
        os.close(write_fd)
        try:
            return m._run_admitted_once(
                fixture.ID,
                self.pins,
                fixture.PINS,
                machine_id="b" * 32,
                credential_fd=read_fd,
                deadline=time.monotonic() + 8430,
            )
        finally:
            os.close(read_fd)

    def failure(self):
        self.done.assert_not_called()
        path = self.destination / "credential-provision-failed.json"
        raw = path.read_bytes()
        self.assertNotIn(b"synthetic-secret", raw)
        self.assertNotIn(b"synthetic-token", raw)
        return json.loads(raw)

    def test_pipe_mount_write_acquire_cleanup_and_frozen_handoff_joined(self):
        self.assertFalse(self.execute()["gate_5_complete"])
        self.assertFalse(self.secret.exists())
        self.assertFalse(self.mounted)
        self.done.assert_called_once()
        self.assertEqual([c[0] for c in self.events].count("/usr/bin/mount"), 2)
        self.assertEqual([c[0] for c in self.events].count("/usr/bin/umount"), 1)
        self.assertEqual([c[0] for c in self.events].count("/usr/bin/systemd-run"), 1)
        for file in self.destination.glob("*.json"):
            raw = file.read_bytes()
            self.assertNotIn(b"synthetic-secret", raw)
            self.assertNotIn(b"synthetic-token", raw)
        report = json.loads((self.destination / "credential-provision.json").read_bytes())
        self.assertFalse(report["issuer_authenticated_here"])
        self.assertFalse(report["iam_scope_independently_verified"])
        with self.assertRaises((ValueError, FileExistsError)):
            self.execute()
        self.assertEqual(self.done.call_count, 1)

    def test_invalid_pipe_payload_cleans_empty_mount_without_acquisition(self):
        self.body = b"not JSON"
        with self.assertRaises(ValueError):
            self.execute()
        self.assertFalse(self.mounted)
        self.assertFalse(self.secret.exists())
        self.assertTrue(self.failure()["undispatched_source_cleanup_complete"])
        self.assertFalse(any(c[0] == "/usr/bin/systemd-run" for c in self.events))

    def test_mount_failure_never_reads_credentials_or_dispatches(self):
        self.mount_failure = "tmpfs"
        with patch.object(m, "_read_pipe") as read:
            with self.assertRaises(ValueError):
                self.execute()
            read.assert_not_called()
        self.assertFalse(self.failure()["undispatched_source_cleanup_complete"])

    def test_private_mount_failure_retains_ambiguous_mount_for_host_cleanup(self):
        self.mount_failure = "private"
        with patch.object(m, "_read_pipe") as read, self.assertRaises(ValueError):
            self.execute()
        read.assert_not_called()
        self.assertTrue(self.mounted)
        self.assertFalse(self.secret.exists())
        self.assertFalse(self.failure()["undispatched_source_cleanup_complete"])

    def test_receipt_failure_cleans_snapshotted_source_without_dispatch(self):
        original = m.handoff.frozen.write_new

        def write(path, value):
            if path.name == "credential-provision.json":
                raise OSError("private exception")
            return original(path, value)

        with patch.object(m.handoff.frozen, "write_new", side_effect=write):
            with self.assertRaises(ValueError):
                self.execute()
        self.assertFalse(self.secret.exists())
        self.assertTrue(self.failure()["undispatched_source_cleanup_complete"])

    def test_partial_own_write_failure_removes_only_created_inode(self):
        original = m._write_source

        def partial(path, raw, ownership):
            original(path, raw[:5], ownership)
            raise OSError("private write error")

        with patch.object(m, "_write_source", side_effect=partial), self.assertRaises(ValueError):
            self.execute()
        self.assertFalse(self.secret.exists())
        self.assertFalse(self.mounted)
        self.assertTrue(self.failure()["undispatched_source_cleanup_complete"])

    def test_unexpected_file_on_exclusive_write_failure_not_deleted(self):
        def unexpected(path, _raw, _ownership):
            (path / m.workflow.SOURCE_NAME).write_bytes(b"unrelated synthetic file")
            raise FileExistsError

        with (
            patch.object(m, "_write_source", side_effect=unexpected),
            self.assertRaises(ValueError),
        ):
            self.execute()
        self.assertTrue(self.secret.exists())
        self.assertTrue(self.mounted)
        self.assertFalse(self.failure()["undispatched_source_cleanup_complete"])

    def test_workflow_preflight_failure_cleans_without_false_delegation(self):
        with patch.object(m.workflow, "_run_admitted_once", side_effect=ValueError):
            with self.assertRaises(ValueError):
                self.execute()
        self.assertFalse(self.secret.exists())
        report = self.failure()
        self.assertTrue(report["undispatched_source_cleanup_complete"])
        self.assertFalse(report["cleanup_delegated_to_workflow"])

    def test_started_workflow_failure_never_retries_its_cleanup(self):
        self.unmount_rc = 1
        with self.assertRaises(ValueError):
            self.execute()
        report = self.failure()
        self.assertTrue(report["cleanup_delegated_to_workflow"])
        self.assertEqual(sum(c[0] == "/usr/bin/umount" for c in self.events), 1)
        self.assertTrue((self.destination / "credential-workflow-failed.json").exists())

    def test_nonempty_source_and_approval_boolean_do_not_open_execution(self):
        self.secret.touch()
        with self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()
        with self.assertRaisesRegex(ValueError, "host_guard_not_bound"):
            m.run_workflow(approved=True)


if __name__ == "__main__":
    unittest.main()
