"""Offline tests for attempt-019 live-absence control bindings."""
import unittest

from scripts import prepare_sft_vm_attempt019_controls_v2 as m


class Tests(unittest.TestCase):
    def test_live_absence_is_bound_without_execution(self):
        plan = m.build()
        self.assertTrue(plan["network_candidate_live_availability_verified"])
        self.assertEqual(
            plan["control_target_absence_evidence"],
            {"path": m.ABSENCE, "sha256": m.ABSENCE_SHA},
        )
        self.assertEqual(plan["required_control_proofs"], [])
        self.assertIsNone(plan["successful_readonly_preflight"])
        self.assertIsNone(plan["approval_record"])
        self.assertFalse(plan["execution_permitted"])
        self.assertFalse(plan["gate_5_complete"])

    def test_public_execution_entry_is_closed(self):
        with self.assertRaisesRegex(ValueError, "not_cloud_or_cpu_authority"):
            m.run(approved=True)


if __name__ == "__main__":
    unittest.main()
