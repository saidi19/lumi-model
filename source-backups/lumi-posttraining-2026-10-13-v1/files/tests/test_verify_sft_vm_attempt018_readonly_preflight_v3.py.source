"""Offline tests for the attempt-018 preflight v0.3 verifier."""

import unittest
from unittest.mock import patch

from scripts import verify_sft_vm_attempt018_readonly_preflight_v3 as m


class Tests(unittest.TestCase):
    def test_verified_evidence(self):
        evidence = m.verify()
        self.assertEqual(evidence["status"], "readonly_preflight_passed")
        self.assertFalse(evidence["gate_5_complete"])

    def test_hash_drift_rejected(self):
        original = m.read

        def changed(path, digest):
            if path.endswith("result.json"):
                digest = "0" * 64
            return original(path, digest)

        with patch.object(m, "read", changed), self.assertRaises(ValueError):
            m.verify()

    def test_missing_execution_authority_is_explicit(self):
        evidence = m.verify()
        self.assertFalse(evidence["execution_authority_created"])
        self.assertFalse(evidence["cpu_instance_launched"])
        self.assertFalse(evidence["checkpoint_access"])


if __name__ == "__main__":
    unittest.main()
