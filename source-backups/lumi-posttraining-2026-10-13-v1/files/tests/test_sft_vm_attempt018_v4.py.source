"""Offline tests for SHA-256 plus byte-count closure repair."""
import json
import sys
import tempfile
import unittest
from pathlib import Path

from scripts import prepare_sft_vm_attempt018_v4 as m


class Tests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.files, cls.report = m.build()

    def test_size_changing_pins_are_repaired(self):
        inputs = json.loads(self.files["configs/lumi-vm-private-host-source-inputs-v0.1.json"])
        for role, pin in inputs["sources"].items():
            body = self.files["scripts/" + role + ".py"]
            self.assertEqual(pin, {"bytes": len(body), "sha256": m.sha(body)})

    def test_outer_authentication_accepts_repaired_source_graph(self):
        root = Path(self.enterContext(tempfile.TemporaryDirectory()))
        for name, body in self.files.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(body)
        scripts = str(root / "scripts")
        before = set(sys.modules)
        sys.path.insert(0, scripts)
        try:
            __import__("run_sft_vm_private_outer_v7").authenticate()
        finally:
            sys.path.remove(scripts)
            for name in set(sys.modules) - before:
                module = sys.modules.get(name)
                path = getattr(module, "__file__", None)
                if path is not None and Path(path).is_relative_to(root):
                    del sys.modules[name]

    def test_nonclaims_and_failed_v03_preserved(self):
        self.assertEqual(self.report["v03_authentication_failure_sha256"], m.FAILURE_SHA)
        self.assertFalse(self.report["execution_permitted"])
        self.assertFalse(self.report["gate_5_complete"])
        self.assertFalse(self.report["gpu"])


if __name__ == "__main__":
    unittest.main()
