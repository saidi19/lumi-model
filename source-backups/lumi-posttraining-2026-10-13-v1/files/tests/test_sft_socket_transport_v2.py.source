"""Real AF_UNIX transport and ledger; synthetic threads, no child/ML execution."""

from __future__ import annotations

import importlib
import json
import os
import socket
import struct
import threading
import time
import unittest
from unittest.mock import Mock, patch

from . import test_sft_smoke_bridge_v1 as fixture

transport = importlib.import_module(fixture.PACKAGE + ".posttraining_sft_socket_transport_v2")


def receive(sock):
    def exact(count):
        raw = b""
        while len(raw) < count:
            part = sock.recv(count - len(raw))
            if not part:
                raise ValueError("synthetic_eof")
            raw += part
        return raw
    size = int.from_bytes(exact(4), "big")
    if not 0 < size <= transport.CONTROL_BYTES:
        raise ValueError("synthetic_frame")
    return json.loads(exact(size))


class SocketTransportTests(unittest.TestCase):
    def setUp(self):
        self.f = fixture.ParentBridgeTests()
        self.f.setUp()
        self.events, self.peers, self.parents, self.threads, self.errors = [], [], [], [], []
        self.index = 0
        self.fragment = False
        self.final_reserve = False
        self.defer_confirm = False
        self.reports_seen = threading.Event()
        self.step_events = [threading.Event(), threading.Event()]

    def tearDown(self):
        for pair in self.peers + self.parents:
            for sock in pair:
                try:
                    sock.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                sock.close()
        for thread in self.threads:
            thread.join(timeout=2)
            self.assertFalse(thread.is_alive())

    def options(self, **changes):
        return {
            "bridge_options": dict(supervisor=self.f.ledger, epoch=self.f.epoch,
                                   rank_tokens=self.f.tokens, invocation_index=self.index,
                                   maximum_wire_bytes=2**20, maximum_feeds=1000),
            "admit": lambda: self.events.append("admit"),
            "acquire": self.acquire, "check_health": self.health,
            "observe_memory": lambda: (256, [64] * 8), "retire": self.retire,
            "deadline_ns": time.monotonic_ns() + 5_000_000_000,
            "maximum_exchange_ns": 1_000_000_000,
            "maximum_wire_bytes": 2**22, "maximum_reads": 1000, **changes,
        }

    def make_pairs(self):
        self.events.append("acquire")
        for _ in range(8):
            left, right = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
            control, peer_control = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
            self.parents.append((left, control))
            self.peers.append((right, peer_control))
            peer_control.settimeout(2)
        return tuple(self.parents)

    def acquire(self):
        pairs = self.make_pairs()
        for rank in range(8):
            thread = threading.Thread(target=self.worker, args=(rank,))
            self.threads.append(thread)
            thread.start()
        return pairs

    def send(self, sock, message):
        raw = transport.control_frame(message)
        if self.fragment:
            for byte in raw:
                sock.sendall(bytes([byte]))
        else:
            sock.sendall(raw)

    def worker(self, rank):
        ledger, control = self.peers[rank]
        client = None
        try:
            client = fixture.worker.WorkerLedgerClient(
                ledger, epoch=self.f.epoch, rank=rank, token=self.f.tokens[rank],
                interrupt=lambda: None, maximum_wire_bytes=2**20,
                deadline_ns=time.monotonic_ns() + 4_000_000_000,
                maximum_exchange_ns=2_000_000_000)

            def phase(name, step):
                self.send(control, {"status": "phase", "phase": name, "step": step})
                expected = {"status": "phase_committed", "phase": name, "step": step}
                if receive(control) != expected:
                    raise ValueError("synthetic_phase")

            _, start, stop, _ = fixture.bridge.SEQUENCE[self.index]
            phase("inputs", start)
            phase("restored", start)
            for step in range(start, stop):
                if rank == 0:
                    client.reserve_step(step, step + 1)
                phase("reserved", step + 1)
                phase("updated", step + 1)  # No native work in this transport-only fixture.
                client.step_complete(step + 1)
                client.wait_step_commit(step + 1)
                phase("completed", step + 1)
                phase("checkpoint", step + 1)
            if self.final_reserve:
                deferred = []
                original_send = client._send
                if self.defer_confirm:
                    def defer(frame, end):
                        if json.loads(frame[4:])["operation"] == "confirm_ack":
                            deferred.append((frame, end))
                        else:
                            original_send(frame, end)
                    client._send = defer
                client.reserve(rank, private_write_bytes=1)
            self.send(control, {"status": "report", "summary": self.f.reports(self.index)[rank],
                                "requests": client.summary()["requests_sent"]})
            if self.defer_confirm:
                if not self.reports_seen.wait(2):
                    raise ValueError("synthetic_wait")
                for frame, end in deferred:
                    original_send(frame, end)
            if receive(control) != {"status": "release"}:
                raise ValueError("synthetic_release")
            self.send(control, {"status": "closed"})
        except BaseException:
            self.errors.append(rank)
        finally:
            if client is not None:
                client.close()
            ledger.close()
            control.close()

    def health(self, retiring):
        if self.errors or (not retiring and any(not t.is_alive() for t in self.threads)):
            raise ValueError("PRIVATE")

    def retire(self, success):
        self.events.append(("retire", success))
        if not success:
            for pair in self.parents:
                for sock in pair:
                    try:
                        sock.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass
        for thread in self.threads:
            thread.join(timeout=2)
            if thread.is_alive():
                raise ValueError("PRIVATE")
        if success and self.errors:
            raise ValueError("PRIVATE")

    def error(self, code, fn):
        with self.assertRaises(transport.TransportError) as caught:
            fn()
        self.assertEqual(caught.exception.args, (code,))
        self.assertTrue(caught.exception.__suppress_context__)

    def test_constructor_inert(self):
        entry = transport.SocketTransport(**self.options())
        self.assertEqual(self.events, [])
        self.assertEqual(entry.summary()["state"], "idle")

    def test_all_three_real_socket_invocations_reuse_one_ledger(self):
        for index in range(3):
            if index:
                self.f.new(index)
                self.parents, self.peers, self.threads = [], [], []
                self.step_events = [threading.Event(), threading.Event()]
            self.index = index
            entry = transport.SocketTransport(**self.options())
            result = entry.run()
            self.assertEqual(result["state"], "complete")
            self.assertEqual(result["closed_reports"], 8)
            self.assertEqual(result["eof_channels"], 16)
            self.assertEqual(result["control_messages"], (96, 64, 64)[index])
            self.assertFalse(result["target_admission_verified"])
            self.assertEqual(self.errors, [])
            self.assertTrue(all(sock.fileno() == -1 for p in self.parents for sock in p))
            self.error("already_consumed", entry.run)
        self.assertEqual(self.f.ledger.summary()["invocations_completed"], 3)
        self.assertEqual(self.f.ledger.summary()["global_optimizer_steps_completed"], 4)

    def test_fragmented_control_and_final_ledger_io(self):
        self.fragment = self.final_reserve = True
        entry = transport.SocketTransport(**self.options(maximum_reads=10000,
                                                         maximum_wire_bytes=2**27))
        self.assertEqual(entry.run()["state"], "complete")

    def test_denied_admission_never_acquires(self):
        acquire = Mock()
        entry = transport.SocketTransport(**self.options(admit=lambda: False, acquire=acquire))
        self.error("admission_rejected", entry.run)
        acquire.assert_not_called()
        self.assertEqual(self.events, [("retire", False)])
        self.error("already_consumed", entry.run)

    def test_admission_exception_is_sanitized(self):
        entry = transport.SocketTransport(**self.options(
            admit=Mock(side_effect=ValueError("PRIVATE"))))
        self.error("admission_rejected", entry.run)
        self.assertNotIn("PRIVATE", json.dumps(entry.summary()))

    def test_deadline_precedes_admission(self):
        entry = transport.SocketTransport(**self.options(deadline_ns=1))
        self.error("deadline_exhausted", entry.run)
        self.assertEqual(self.events, [("retire", False)])

    def test_clock_rejection(self):
        entry = transport.SocketTransport(**self.options(clock_ns=lambda: True))
        self.error("clock_rejected", entry.run)

    def test_acquisition_failure_retired_without_retry(self):
        acquire = Mock(side_effect=ValueError("PRIVATE"))
        entry = transport.SocketTransport(**self.options(acquire=acquire))
        self.error("acquisition_failed", entry.run)
        self.error("already_consumed", entry.run)
        acquire.assert_called_once()

    def test_early_eof(self):
        def health(_):
            self.peers[0][0].close()
        entry = transport.SocketTransport(**self.options(acquire=self.make_pairs,
                                                         check_health=health))
        self.error("io_failed", entry.run)
        self.assertEqual(self.events[-1], ("retire", False))

    def test_health_failure_before_reads(self):
        entry = transport.SocketTransport(**self.options(
            acquire=self.make_pairs, check_health=Mock(side_effect=ValueError("PRIVATE"))))
        self.error("health_failed", entry.run)
        self.assertEqual(entry.summary()["read_calls"], 0)

    def test_wire_cap_precharged_before_read(self):
        def acquire():
            pairs = self.make_pairs()
            self.peers[0][1].sendall(b"x")
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire, maximum_wire_bytes=1))
        self.error("wire_exhausted", entry.run)
        self.assertEqual(entry.summary()["bytes_received"], 0)

    def test_malformed_duplicate_key_and_oversized_controls(self):
        duplicate = b'{"status":"x","status":"y"}'
        for raw in (b'\x00\x00\x10\x01', b'\x00\x00\x00\x00',
                    transport.control_frame({"status": "closed"}),
                    len(duplicate).to_bytes(4, "big") + duplicate):
            self.setUp()
            def acquire(raw=raw):
                pairs = self.make_pairs()
                self.peers[0][1].sendall(raw)
                return pairs
            entry = transport.SocketTransport(**self.options(acquire=acquire))
            try:
                self.error("control_rejected", entry.run)
            finally:
                self.tearDown()

    def test_partial_control_deadline(self):
        def acquire():
            pairs = self.make_pairs()
            self.peers[0][1].sendall(b"\x00")
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire,
                                                         maximum_exchange_ns=10_000_000))
        self.error("deadline_exhausted", entry.run)

    def test_stalled_worker_absolute_deadline(self):
        entry = transport.SocketTransport(**self.options(
            acquire=self.make_pairs, deadline_ns=time.monotonic_ns() + 20_000_000))
        self.error("deadline_exhausted", entry.run)

    def test_missing_ack_confirmation_deadline(self):
        def acquire():
            pairs = self.make_pairs()
            self.peers[0][0].sendall(self.f.message(0, "reserve", {"private_write_bytes": 1}))
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire,
                                                         maximum_exchange_ns=10_000_000))
        self.error("bridge_failed", entry.run)
        self.assertEqual(entry._bridge._session.summary()["acknowledgements_sent"], 1)

    def test_retirement_failure_invalidates_finished_shared_ledger(self):
        def retire(success):
            self.retire(success)
            raise ValueError("PRIVATE")
        entry = transport.SocketTransport(**self.options(retire=retire))
        self.error("retirement_failed", entry.run)
        self.assertTrue(entry.summary()["cleanup_failed"])
        self.assertEqual(self.f.ledger.summary()["state"], "failed")
        self.f.new(1)
        with self.assertRaises(fixture.bridge.BridgeError):
            self.f.parent.begin()

    def test_memory_failure_never_releases_success(self):
        entry = transport.SocketTransport(**self.options(observe_memory=lambda: (0, [])))
        self.error("bridge_failed", entry.run)
        self.assertEqual(self.events[-1], ("retire", False))

    def test_owner_change_rejected_without_actions(self):
        entry = transport.SocketTransport(**self.options())
        with patch.object(transport.os, "getpid", return_value=-1):
            self.error("owner_mismatch", entry.run)
        self.assertEqual(self.events, [])

    def test_duplicate_socket_rejected_and_closed(self):
        def acquire():
            pairs = self.make_pairs()
            return (pairs[0], pairs[0], *pairs[2:])
        entry = transport.SocketTransport(**self.options(acquire=acquire))
        self.error("socket_rejected", entry.run)
        self.assertEqual(self.parents[0][0].fileno(), -1)

    def test_invalid_constructor_inputs(self):
        for changes in ({"maximum_reads": True}, {"retire": None},
                        {"bridge_options": {"admit": lambda: None}},
                        {"maximum_exchange_ns": 0}):
            self.error("invalid_arguments", lambda changes=changes:
                       transport.SocketTransport(**self.options(**changes)))
        self.assertEqual(self.events, [])

    def test_short_sends_continue_to_full_ack_before_commit(self):
        entry = transport.SocketTransport(**self.options())
        original = entry._socket

        class ShortSocket:
            def __init__(self, sock):
                self.sock = sock

            def settimeout(self, timeout):
                self.sock.settimeout(timeout)

            def send(self, raw):
                return self.sock.send(raw[:17])

            def recvmsg(self, *args):
                return self.sock.recvmsg(*args)

            def fileno(self):
                return self.sock.fileno()

        with patch.object(entry, "_socket", side_effect=lambda r, k: ShortSocket(original(r, k))):
            self.assertEqual(entry.run()["state"], "complete")

    def test_send_exception_never_commits_ack(self):
        def acquire():
            pairs = self.make_pairs()
            self.peers[0][0].sendall(self.f.message(0, "reserve", {"private_write_bytes": 1}))
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire))
        with patch.object(entry, "_send", side_effect=OSError("PRIVATE")):
            self.error("io_failed", entry.run)
        self.assertEqual(entry._bridge._session.summary()["acknowledgements_sent"], 0)

    def test_read_cap_prevents_second_receive(self):
        def acquire():
            pairs = self.make_pairs()
            self.peers[0][1].sendall(transport.control_frame(
                {"status": "phase", "phase": "inputs", "step": 0}))
            self.peers[1][1].sendall(transport.control_frame(
                {"status": "phase", "phase": "inputs", "step": 0}))
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire, maximum_reads=1))
        self.error("wire_exhausted", entry.run)
        self.assertEqual(entry.summary()["read_calls"], 1)

    def test_received_file_descriptors_closed_then_rejected(self):
        captured = []
        original = transport._close_received_rights

        def close(ancillary):
            for level, kind, raw in ancillary:
                if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                    captured.extend(struct.unpack("i" * (len(raw) // 4), raw))
            return original(ancillary)

        def acquire():
            pairs = self.make_pairs()
            self.peers[0][1].sendmsg([b"x"], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                             struct.pack("i", self.peers[1][1].fileno()))])
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire))
        with patch.object(transport, "_close_received_rights", side_effect=close):
            self.error("socket_rejected", entry.run)
        self.assertEqual(len(captured), 1)
        with self.assertRaises(OSError):
            os.fstat(captured[0])

    def test_unallowlisted_report_not_retained(self):
        def acquire():
            pairs = self.make_pairs()
            summary = {**self.f.reports()[0], "source": "PRIVATE"}
            self.peers[0][1].sendall(transport.control_frame(
                {"status": "report", "summary": summary, "requests": 1}))
            return pairs
        entry = transport.SocketTransport(**self.options(acquire=acquire))
        self.error("control_rejected", entry.run)
        self.assertEqual(entry._reports, {})
        self.assertFalse(any(entry._buffers))
        self.assertNotIn("PRIVATE", json.dumps(entry.summary()))

    def test_success_requires_closed_receipts_not_only_eof(self):
        entry = transport.SocketTransport(**self.options())
        send = self.send

        def suppress_closed(sock, message):
            if message != {"status": "closed"}:
                send(sock, message)
        with patch.object(self, "send", side_effect=suppress_closed):
            self.error("io_failed", entry.run)
        self.assertEqual(self.f.ledger.summary()["state"], "failed")

    def test_close_failure_is_not_success(self):
        entry = transport.SocketTransport(**self.options())
        retire = self.retire

        def invalidate(success):
            retire(success)
            self.parents[0][0].close()
        entry._retire = invalidate
        self.error("close_failed", entry.run)
        self.assertTrue(entry.summary()["cleanup_failed"])
        self.assertEqual(self.f.ledger.summary()["state"], "failed")

    def test_all_reports_precede_final_ack_confirmations(self):
        self.final_reserve = self.defer_confirm = True
        entry = transport.SocketTransport(**self.options())
        original = entry._control
        pending = []

        def control(rank, raw):
            original(rank, raw)
            if len(entry._reports) == 8 and not self.reports_seen.is_set():
                pending.append(entry._bridge._session.summary()["pending_acknowledgements"])
                self.reports_seen.set()
        with patch.object(entry, "_control", side_effect=control):
            self.assertEqual(entry.run()["state"], "complete")
        self.assertEqual(pending, [8])

    def test_original_failure_preserved_if_retirement_also_fails(self):
        entry = transport.SocketTransport(**self.options(
            admit=lambda: False, retire=Mock(side_effect=ValueError("PRIVATE"))))
        self.error("admission_rejected", entry.run)
        self.assertTrue(entry.summary()["cleanup_failed"])

    def test_retirement_cannot_return_success_after_deadline(self):
        now = [1]
        def retire(success):
            self.retire(success)
            now[0] = 101
        entry = transport.SocketTransport(**self.options(
            clock_ns=lambda: now[0], deadline_ns=100, retire=retire))
        self.error("deadline_exhausted", entry.run)
        self.assertTrue(entry.summary()["trusted_retirement_callback_completed"])
        self.assertEqual(self.f.ledger.summary()["state"], "failed")
