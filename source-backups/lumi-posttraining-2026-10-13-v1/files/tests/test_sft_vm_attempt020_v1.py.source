"""Offline tests for the attempt-020 nested-archive repair."""

import importlib
import json
import sys
import tempfile
import unittest
from pathlib import Path

from scripts import prepare_sft_vm_attempt020_v1 as m


class Tests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.files, cls.report = m.build()

    def test_fresh_identity_binds_consumed_predecessor(self):
        self.assertEqual(self.report["attempt"], m.NEW)
        self.assertEqual(self.report["operational_predecessor"], m.OLD)
        self.assertEqual(self.report["predecessor_failure_sha256"], m.FAILURE_SHA)
        self.assertTrue(self.report["predecessor_failure_preserved"])
        self.assertFalse(self.report["execution_permitted"])
        self.assertFalse(self.report["gate_5_complete"])

    def test_nested_setup_archive_is_exact_final_release_projection(self):
        members = m.setup_members(self.files[m.SETUP_TAR])
        base_members = m.setup_members((m.BASE / m.SETUP_TAR).read_bytes())
        self.assertEqual(set(members), set(m.SETUP_MEMBERS))
        self.assertEqual(len(members), 19)
        for destination, origin in m.SETUP_MEMBERS.items():
            expected = self.files.get(origin, base_members[destination])
            self.assertEqual(members[destination], expected, destination)
        pins = m.constants(self.files[m.SETUP_SEND])
        self.assertEqual(pins["ARCHIVE_SHA"], m.sha(self.files[m.SETUP_TAR]))
        self.assertEqual(pins["ARCHIVE_BYTES"], len(self.files[m.SETUP_TAR]))
        self.assertEqual(pins["RECEIVER_SHA"], m.sha(self.files[m.SETUP_STAGE]))
        self.assertEqual(pins["RECEIVER_BYTES"], len(self.files[m.SETUP_STAGE]))

    def test_stage_contract_accepts_rebuilt_archive(self):
        root = Path(self.enterContext(tempfile.TemporaryDirectory()))
        for name, body in self.files.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(body)
        scripts = str(root / "scripts")
        before = set(sys.modules)
        sys.path.insert(0, scripts)
        try:
            stage = importlib.import_module("stage_sft_vm_setup_inputs_v5")
            unpacked = stage.unpack(self.files[m.SETUP_TAR], m.sha(self.files[m.SETUP_TAR]))
            self.assertEqual(len(unpacked), 19)
            base_members = m.setup_members((m.BASE / m.SETUP_TAR).read_bytes())
            for destination, origin in m.SETUP_MEMBERS.items():
                expected = self.files.get(origin, base_members[destination])
                self.assertEqual(unpacked[destination], expected)
        finally:
            sys.path.remove(scripts)
            for name in set(sys.modules) - before:
                module = sys.modules.get(name)
                path = getattr(module, "__file__", None)
                if path is not None and Path(path).is_relative_to(root):
                    del sys.modules[name]

    def test_outer_graph_authenticates(self):
        root = Path(self.enterContext(tempfile.TemporaryDirectory()))
        for name, body in self.files.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(body)
        scripts = str(root / "scripts")
        before = set(sys.modules)
        sys.path.insert(0, scripts)
        try:
            outer = importlib.import_module("run_sft_vm_private_outer_v7")
            outer.authenticate()
            self.assertEqual(outer.network.selection.ATTEMPT, m.NEW)
            inputs = json.loads(self.files["configs/lumi-vm-private-host-source-inputs-v0.1.json"])
            self.assertGreater(len(inputs["sources"]), 0)
        finally:
            sys.path.remove(scripts)
            for name in set(sys.modules) - before:
                module = sys.modules.get(name)
                path = getattr(module, "__file__", None)
                if path is not None and Path(path).is_relative_to(root):
                    del sys.modules[name]

    def test_old_identity_is_absent_and_public_entry_closed(self):
        for name, body in self.files.items():
            if name.startswith("scripts/"):
                self.assertNotIn(m.OLD.encode(), body)
                self.assertNotIn(b"attempt-019", body)
        with self.assertRaisesRegex(ValueError, "not_execution_authority"):
            m.run(approved=True)


if __name__ == "__main__":
    unittest.main()
