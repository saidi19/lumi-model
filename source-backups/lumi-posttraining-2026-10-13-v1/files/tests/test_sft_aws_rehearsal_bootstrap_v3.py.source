"""Final-stage expiry regression; active timer readback remains mandatory."""
import unittest
from pathlib import Path

import yaml


class BootstrapTests(unittest.TestCase):
    def setUp(self):
        root = Path(__file__).resolve().parents[1]
        self.config = yaml.safe_load(
            (root / 'configs/lumi-sft-aws-rehearsal-bootstrap-v0.3.yaml').read_text()
        )

    def test_no_early_boot_command(self):
        self.assertNotIn('bootcmd', self.config)

    def test_final_timer_creation_is_bounded(self):
        command = self.config['runcmd'][0]
        self.assertEqual(command[:3], ['timeout', '15', 'systemd-run'])
        self.assertIn('--no-block', command)
        self.assertIn('--on-boot=3600s', command)
        self.assertIn('--timer-property=AccuracySec=1s', command)
        self.assertEqual(command[-1], '/usr/sbin/poweroff')

    def test_no_workload_in_bootstrap(self):
        self.assertEqual(self.config['packages'], ['python3-venv'])
        self.assertIs(self.config['package_upgrade'], False)
        self.assertEqual([row[0] for row in self.config['runcmd'][1:]],
                         ['groupadd', 'useradd', 'install'])


if __name__ == '__main__':
    unittest.main()
