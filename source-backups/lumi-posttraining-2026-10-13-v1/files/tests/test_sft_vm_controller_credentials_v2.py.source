"""No real credential export or AWS access; SDK models and synthetic keys only."""

import datetime as dt
import importlib
import json
import sys
import time
import unittest
from pathlib import Path
from unittest.mock import Mock, patch

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
m = importlib.import_module("sft_vm_controller_credentials_v2")


class CredentialTests(unittest.TestCase):
    def setUp(self):
        self.t, self.wall = 100.0, time.time()
        self.reader = m.Reader(18100, clock=lambda: self.t, wall=lambda: self.wall)
        self.identity = dict(
            Account=m.legacy.ACCOUNT,
            Arn="arn:aws:iam::573978149073:user/synthetic",
            UserId="SYNTHETIC_USER",
        )
        self.client = Mock()
        self.client.get_caller_identity.side_effect = lambda: dict(self.identity)
        self.make_client = self.enterContext(
            patch.object(m, "static_identity_client", return_value=self.client)
        )
        self.export = self.enterContext(
            patch.object(m, "export_credentials", side_effect=self.payload)
        )

    def payload(self, seconds=900):
        return json.dumps(
            dict(
                Version=1,
                AccessKeyId="SYNTHETIC_NOT_A_KEY",
                SecretAccessKey="SYNTHETIC_SECRET",
                SessionToken="SYNTHETIC_TOKEN",
                Expiration=dt.datetime.fromtimestamp(self.wall + seconds, dt.UTC).isoformat(),
            )
        ).encode()

    def advance(self, seconds):
        self.t += seconds
        self.wall += seconds

    def test_same_provider_can_cover_five_hours_without_resetting_deadline(self):
        self.reader()
        for _ in range(27):
            self.advance(661)
            self.reader()
        self.assertEqual(self.reader.calls, 28)
        self.assertEqual(self.reader.deadline, 18100)
        self.assertEqual(self.client.close.call_count, 28)
        self.advance(120)
        self.reader.active()

    def test_generation_33_rejected_without_an_export(self):
        self.reader.calls = 32
        with self.assertRaisesRegex(ValueError, "^controller_credential_refresh_failed$"):
            self.reader()
        self.export.assert_not_called()

    def test_account_principal_and_user_id_change_rejected(self):
        for field in ("Account", "Arn", "UserId"):
            reader = m.Reader(self.t + 18000, clock=lambda: self.t, wall=lambda: self.wall)
            reader()
            self.advance(661)
            with patch.dict(self.identity, {field: "changed"}), self.assertRaises(ValueError):
                reader()

    def test_expired_short_repeated_or_duplicate_credentials_rejected(self):
        for seconds in (0, 300, 43201):
            self.export.side_effect = lambda seconds=seconds: self.payload(seconds)
            with self.subTest(seconds=seconds), self.assertRaises(ValueError):
                self.reader()
        self.export.side_effect = None
        self.export.return_value = self.payload()
        self.reader()
        with self.assertRaises(ValueError):
            self.reader()  # Same expiry cannot masquerade as another generation.
        self.export.return_value = b'{"Version":1,"Version":1}'
        with self.assertRaises(ValueError):
            self.reader()

    def test_failed_generation_is_consumed_and_exception_is_redacted(self):
        self.export.side_effect = RuntimeError("PRIVATE_SENTINEL")
        with self.assertRaisesRegex(ValueError, "^controller_credential_refresh_failed$") as raised:
            self.reader()
        self.assertNotIn("PRIVATE_SENTINEL", str(raised.exception))
        self.assertEqual(self.reader.calls, 1)

    def test_deadline_closed_provider_and_wall_clock_drift_reject(self):
        self.reader.closed = True
        with self.assertRaises(ValueError):
            self.reader.active()
        self.reader.closed = False
        self.wall += 6
        with self.assertRaises(ValueError):
            self.reader()
        self.wall -= 6
        self.advance(17980)
        with self.assertRaises(ValueError):
            self.reader.active()
        self.export.assert_not_called()

    def test_real_sdk_clients_and_actual_adapters_share_one_provider(self):
        bundle = m.Clients(self.reader)
        self.addCleanup(bundle.close)
        self.assertEqual(set(bundle.clients), set(m.SERVICES))
        for name, client in bundle.clients.items():
            self.assertIs(client._request_signer._credentials, bundle.provider)
            self.assertEqual(client.meta.endpoint_url, m.endpoint(name))
            self.assertEqual(client.meta.config.retries["total_max_attempts"], 1)
            self.assertEqual(client.meta.config.proxies, {})
        adapters = bundle.adapters()
        self.assertEqual(
            set(adapters),
            {
                "host_cloud",
                "watchdog_cloud",
                "bucket_cloud",
                "network_cloud",
                "acquisition_cloud",
                "retention_cloud",
            },
        )
        self.assertEqual(bundle.provider._mandatory_refresh_timeout, 240)
        self.assertEqual(bundle.provider._advisory_refresh_timeout, 240)
        self.assertEqual(self.reader.calls, 1)
        # No operation or secret has been forwarded to a child host.
        self.assertFalse(hasattr(bundle, "launch"))

    def test_real_sdk_refresh_checks_new_generation_before_using_it(self):
        bundle = m.Clients(self.reader)
        self.addCleanup(bundle.close)
        self.advance(661)
        bundle.provider._time_fetcher = lambda: dt.datetime.fromtimestamp(self.wall, dt.UTC)
        frozen = bundle.provider.get_frozen_credentials()
        self.assertEqual(frozen.access_key, "SYNTHETIC_NOT_A_KEY")
        self.assertEqual(self.reader.calls, 2)
        self.assertEqual(bundle.reader.deadline, 18100)

    def test_clients_reject_cached_credentials_after_original_deadline_or_close(self):
        bundle = m.Clients(self.reader)
        client = bundle.clients["ec2"]
        self.advance(17981)
        with self.assertRaises(ValueError):
            client.describe_instances(MaxResults=5)
        bundle.close()
        with self.assertRaises(ValueError):
            client.describe_instances(MaxResults=5)
        with self.assertRaises(ValueError):
            bundle.adapters()

    def test_partial_client_construction_closes_without_fallback(self):
        sdk = Mock()
        first = Mock()
        sdk.create_client.side_effect = [first, RuntimeError("PRIVATE_SENTINEL")]
        with (
            patch.object(m, "session", return_value=sdk),
            self.assertRaisesRegex(ValueError, "^controller_client_setup_failed$"),
        ):
            m.Clients(self.reader)
        first.close.assert_called_once()
        self.assertTrue(self.reader.closed)

    def test_issuer_management_uses_sdk_not_legacy_profile_cli(self):
        clients = {"iam": Mock(), "sts": Mock()}
        for cls, prefix in (
            (m.AcquisitionCloud, "lumi-acquire-"),
            (m.RetentionCloud, "lumi-retain-"),
        ):
            cloud = cls(clients)
            cloud.cli("iam", "get-role", RoleName=prefix + m.network.selection.ATTEMPT)
            with self.assertRaises(ValueError):
                cloud.cli("iam", "delete-role", RoleName="unrelated")
            with self.assertRaises(ValueError):
                cloud.cli("s3", "get-object", Bucket="forbidden")
        self.assertIs(
            m.AcquisitionCloud.issue_source_session, m.acquisition.Cloud.issue_source_session
        )
        self.assertIs(
            m.RetentionCloud.issue_retention_session, m.retention.Cloud.issue_retention_session
        )
        self.export.assert_not_called()

    def test_legacy_eight_generation_bound_and_public_entries_unchanged(self):
        old = m.legacy.Reader(time.monotonic() + 1800)
        old.calls = 8
        with patch.object(m.legacy.subprocess, "run") as proc, self.assertRaises(ValueError):
            old()
        proc.assert_not_called()
        with self.assertRaises(ValueError):
            m.run(approved=True)


class PipeTests(unittest.TestCase):
    def pipe(self, stdout, stderr=b"", status=0):
        proc = Mock()
        proc.stdout.fileno.return_value = 71
        proc.stderr.fileno.return_value = 72
        proc.wait.return_value = status
        proc.poll.return_value = status
        chunks = {71: [stdout, b""], 72: [stderr, b""]}
        self.enterContext(
            patch.object(m.select, "select", side_effect=lambda ready, *_: (ready, [], []))
        )
        self.enterContext(patch.object(m.os, "read", side_effect=lambda fd, _: chunks[fd].pop(0)))
        popen = self.enterContext(patch.object(m.subprocess, "Popen", return_value=proc))
        return proc, popen

    def test_bounded_export_argv_environment_and_pipe_cleanup(self):
        proc, popen = self.pipe(b"synthetic")
        with patch.dict(
            m.os.environ, {"AWS_SECRET_ACCESS_KEY": "PRIVATE_SENTINEL", "HTTPS_PROXY": "bad"}
        ):
            self.assertEqual(m.export_credentials(), b"synthetic")
        args, kw = popen.call_args
        self.assertNotIn("PRIVATE_SENTINEL", repr(args))
        self.assertNotIn("AWS_SECRET_ACCESS_KEY", kw["env"])
        self.assertNotIn("HTTPS_PROXY", kw["env"])
        proc.stdout.close.assert_called_once()
        proc.stderr.close.assert_called_once()

    def test_oversized_output_rejected_before_json_or_secret_retention(self):
        proc, _ = self.pipe(b"x" * 32769)
        with self.assertRaises(ValueError):
            m.export_credentials()
        proc.stdout.close.assert_called_once()

    def test_oversized_stderr_and_failed_process_rejected(self):
        proc, _ = self.pipe(b"", b"x" * 4097, 255)
        with self.assertRaises(ValueError):
            m.export_credentials()
        proc.stderr.close.assert_called_once()


class EndpointModelTests(unittest.TestCase):
    def test_all_eight_endpoints_match_independently_resolved_sdk_clients(self):
        import botocore.session
        from botocore.config import Config

        sdk = botocore.session.Session()
        for name in m.SERVICES:
            client = sdk.create_client(
                name,
                region_name="us-east-1",
                aws_access_key_id="SYNTHETIC",
                aws_secret_access_key="SYNTHETIC",
                config=Config(s3={"us_east_1_regional_endpoint": "regional"}),
            )
            try:
                self.assertEqual(m.endpoint(name), client.meta.endpoint_url, name)
            finally:
                client.close()
        self.assertEqual(m.endpoint("pricing"), "https://api.pricing.us-east-1.amazonaws.com")

    def test_wrong_predecessor_pricing_endpoint_is_detectable(self):
        old = importlib.import_module("sft_vm_controller_credentials_v1")
        self.assertNotEqual(old.endpoint("pricing"), m.endpoint("pricing"))
        self.assertEqual(m.endpoint("ec2"), old.endpoint("ec2"))
