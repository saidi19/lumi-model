"""Offline tests for the fresh attempt-019 identity."""
import importlib
import json
import sys
import tempfile
import unittest
from pathlib import Path

from scripts import prepare_sft_vm_attempt019_v1 as m


class Tests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.files, cls.report = m.build()

    def test_fresh_identity_and_read_repair_are_bound(self):
        self.assertEqual(self.report["attempt"], m.NEW)
        self.assertEqual(self.report["operational_predecessor"], m.OLD)
        self.assertEqual(self.report["selected_cidr"], m.NEW_CIDR)
        self.assertTrue(self.report["bounded_transient_read_recovery_preserved"])
        self.assertEqual(self.report["write_attempts_per_operation"], 1)
        self.assertFalse(self.report["old_authorization_reused"])
        self.assertFalse(self.report["execution_permitted"])

    def test_old_identity_is_absent_from_executable_sources(self):
        for name, body in self.files.items():
            if name.startswith("scripts/"):
                self.assertNotIn(m.OLD.encode(), body)
                self.assertNotIn(b"attempt-018", body)

    def test_outer_graph_authenticates(self):
        root = Path(self.enterContext(tempfile.TemporaryDirectory()))
        for name, body in self.files.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(body)
        scripts = str(root / "scripts")
        before = set(sys.modules)
        sys.path.insert(0, scripts)
        try:
            outer = importlib.import_module("run_sft_vm_private_outer_v7")
            outer.authenticate()
            self.assertEqual(outer.network.selection.ATTEMPT, m.NEW)
            sources = importlib.import_module("prepare_sft_vm_private_host_sources_v4")
            binding = sources.binding
            proposal = json.loads(binding.PROPOSAL_PATH.read_bytes())
            ids = {}
            digits = iter("1234567")
            for kind, spec in binding.network.KINDS.items():
                ids[kind] = f"{spec[4]}-{next(digits) * 17}"
            ids["association"] = "rtbassoc-" + "f" * 17
            proposal["host"]["subnet"] = ids["subnet"]
            proposal["private_network_binding"] = {
                "schema": "lumi.vm-private-host-network-binding.v0.1",
                "base_proposal_sha256": binding.PROPOSAL_SHA,
                "network_controller_sha256": binding.NETWORK_SHA,
                "attempt": binding.network.selection.ATTEMPT,
                "nonce": "e" * 32,
                "resources": ids,
                "workload_deadline_monotonic": 20000.0,
                "network_deadline_monotonic": 21800.0,
                "cleanup_reserve_seconds": 1800,
                "usable_only_in_original_controller_process": True,
            }
            files, result = sources.build(
                binding.encoded(proposal), root / "synthetic-host-proposal.json"
            )
            self.assertEqual(len(files), 34)
            self.assertFalse(result["live_execution_authorized"])
            provision = next(
                body
                for name, body in files.items()
                if name.startswith("provision_sft_vm_host_v2_private_")
            )
            self.assertIn(b"READ_RETRY_DELAYS = (1, 2)", provision)
            self.assertIn(b"MAX_READ_RETRIES = 8", provision)
            self.assertIn(b"delays = () if write else READ_RETRY_DELAYS", provision)
        finally:
            sys.path.remove(scripts)
            for name in set(sys.modules) - before:
                module = sys.modules.get(name)
                path = getattr(module, "__file__", None)
                if path is not None and Path(path).is_relative_to(root):
                    del sys.modules[name]

    def test_public_entry_is_closed(self):
        with self.assertRaisesRegex(ValueError, "not_execution_authority"):
            m.run(approved=True)


if __name__ == "__main__":
    unittest.main()
