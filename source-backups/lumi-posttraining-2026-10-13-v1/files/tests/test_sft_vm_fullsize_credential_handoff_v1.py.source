"""Actual tiny filesystem/acquisition join; Linux ownership/mounts/units doubled."""

import importlib
import io
import json
import os
import time
import types
import unittest
from pathlib import Path
from unittest.mock import patch

from tests import test_sft_vm_fullsize_acquisition_unit_v1 as prior

fixture = prior.fixture
m = importlib.import_module(fixture.PACKAGE + ".posttraining_vm_fullsize_credential_handoff_v1")


class MountTests(unittest.TestCase):
    def row(self, path="/fixed/credentials", options="rw,nosuid,nodev,noexec", fs="tmpfs"):
        return f"71 1 0:41 / {path} {options} - {fs} {fs} rw,size=128k\n".encode()

    def test_exact_private_tmpfs_or_absence(self):
        path = Path("/fixed/credentials")
        self.assertEqual(m._mount_record(self.row(), path)[0], "71")
        self.assertIsNone(m._mount_record(self.row("/unrelated"), path))

    def test_disk_shared_child_duplicate_and_missing_mount_options_rejected(self):
        bad = [
            self.row(fs="ext4"),
            self.row(options="rw,nosuid,nodev"),
            self.row().replace(b" - ", b" shared:2 - "),
            self.row() * 2,
            self.row() + self.row("/fixed/credentials/child"),
        ]
        for raw in bad:
            with self.assertRaises(ValueError):
                m._mount_record(raw, Path("/fixed/credentials"))

    def test_mountinfo_bound_rejected(self):
        with self.assertRaises(ValueError):
            m._mount_record(b"x" * (1024**2 + 1), Path("/fixed/credentials"))

    def test_swap_header_only_required(self):
        header = b"Filename\tType\tSize\tUsed\tPriority\n"
        with patch("builtins.open", return_value=io.BytesIO(header)):
            m._no_swap()
        for raw in (b"", header + b"/swapfile file 100 0 -2\n", b"unknown\n"):
            with patch("builtins.open", return_value=io.BytesIO(raw)):
                with self.assertRaises(ValueError):
                    m._no_swap()


class WorkflowTests(unittest.TestCase):
    def setUp(self):
        prior.ParentTests.setUp(self)
        self.credentials = self.destination / "credentials"
        self.credentials.mkdir(mode=0o700)
        self.secret = self.credentials / m.SOURCE_NAME
        self.secret.write_bytes(b"synthetic-secret-never-log")
        self.secret.chmod(0o600)
        self.mounted = True
        self.unmount_rc = 0
        self.enterContext(patch.object(m, "ROOT_UID", os.geteuid()))
        self.enterContext(patch.object(m, "ROOT_GID", os.getegid()))
        self.enterContext(patch.object(m, "_no_swap"))
        self.mount = self.enterContext(
            patch.object(
                m,
                "_mount",
                side_effect=lambda _p: (
                    ("71", "0:41", "private", "size=128k") if self.mounted else None
                ),
            )
        )
        self.capacity = self.enterContext(
            patch.object(
                m.os, "statvfs", return_value=types.SimpleNamespace(f_blocks=32, f_frsize=4096)
            )
        )
        self.done = self.enterContext(
            patch.object(m.completion, "_complete_admitted_once", side_effect=self.complete)
        )

    def commands(self, args, *a, **kw):
        if args[0] == "/usr/bin/umount":
            self.events.append(args)
            self.assertEqual(args, ["/usr/bin/umount", "--", str(self.credentials)])
            self.assertFalse(self.secret.exists())
            if self.unmount_rc == 0:
                self.mounted = False
            return types.SimpleNamespace(returncode=self.unmount_rc, stdout=b"")
        return prior.ParentTests.commands(self, args, *a, **kw)

    def complete(self, *_a, **_kw):
        self.assertFalse(self.secret.exists())
        self.assertFalse(self.mounted)
        self.assertTrue((self.stage / "inputs/synthetic").exists())
        self.assertTrue((self.destination / "credential-source-cleanup.json").exists())
        self.stop.assert_not_called()  # Preserve success terminal for the frozen handoff.
        m.handoff._finish_acquisition(fixture.ID)
        self.stop.assert_called_once()
        return {"gate_5_complete": False, "offhost_retention_verified": False}

    def execute(self):
        return m._run_admitted_once(
            fixture.ID,
            self.pins,
            fixture.PINS,
            machine_id="b" * 32,
            deadline=time.monotonic() + 8430,
        )

    def failed(self):
        self.done.assert_not_called()
        return json.loads((self.destination / "credential-workflow-failed.json").read_bytes())

    def test_actual_acquisition_input_move_then_source_removal_then_frozen_stop(self):
        original = os.open

        def guarded(path, *a, **kw):
            if isinstance(path, (str, os.PathLike)):
                self.assertNotEqual(Path(path).name, m.SOURCE_NAME)
            return original(path, *a, **kw)

        with patch.object(m.os, "open", side_effect=guarded):
            result = self.execute()
        self.assertFalse(result["gate_5_complete"])
        self.done.assert_called_once()
        self.assertEqual(sum(c[0] == "/usr/bin/systemd-run" for c in self.events), 1)
        self.assertEqual(sum(c[0] == "/usr/bin/umount" for c in self.events), 1)
        receipt = json.loads((self.destination / "credential-source-cleanup.json").read_bytes())
        self.assertFalse(receipt["credential_contents_read"])
        self.assertFalse(receipt["cryptographic_erasure_claimed"])

    def test_no_retry_after_started_success(self):
        self.execute()
        with self.assertRaises((ValueError, FileNotFoundError)):
            self.execute()
        self.assertEqual(self.done.call_count, 1)

    def test_non_tmpfs_wrong_capacity_or_swap_rejected_before_dispatch(self):
        self.mount.side_effect = None
        self.mount.return_value = None
        with self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()
        self.assertTrue(self.secret.exists())
        self.mount.return_value = ("71", "0:41", "private", "size=128k")
        self.capacity.return_value.f_blocks = 33
        with self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()
        self.capacity.return_value.f_blocks = 32
        with patch.object(m, "_no_swap", side_effect=ValueError), self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()

    def test_symlink_hardlink_extra_file_and_permissions_rejected_before_dispatch(self):
        self.secret.chmod(0o644)
        with self.assertRaises(ValueError):
            self.execute()
        self.secret.chmod(0o600)
        extra = self.credentials / "unexpected"
        extra.touch()
        with self.assertRaises(ValueError):
            self.execute()
        extra.unlink()
        os.link(self.secret, self.root / "alias")
        with self.assertRaises(ValueError):
            self.execute()
        self.secret.unlink()
        self.secret.symlink_to(self.root / "alias")
        with self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()

    def test_live_child_blocks_source_unlink_and_completion(self):
        self.empty.return_value = False
        with self.assertRaises(ValueError):
            self.execute()
        self.assertTrue(self.secret.exists())
        self.assertFalse(self.failed()["root_source_cleanup_complete"])

    def test_acquisition_failure_reaps_then_cleans_source_without_import(self):
        self.observe.return_value = fixture.SUCCESS | {
            "Result": "exit-code",
            "ExecMainStatus": "55",
        }
        with self.assertRaises(ValueError):
            self.execute()
        self.assertFalse(self.secret.exists())
        self.assertFalse(self.mounted)
        self.assertTrue(self.failed()["root_source_cleanup_complete"])
        self.assertTrue((self.acquisition / "inputs/synthetic").exists())

    def test_replaced_secret_is_not_deleted(self):
        original = self.commands

        def changed(args, *a, **kw):
            result = original(args, *a, **kw)
            if args[0] == "/usr/bin/systemd-run":
                self.secret.write_bytes(b"replacement")
            return result

        self.run.side_effect = changed
        with self.assertRaises(ValueError):
            self.execute()
        self.assertEqual(self.secret.read_bytes(), b"replacement")
        self.assertFalse(self.failed()["root_source_cleanup_complete"])

    def test_changed_mount_identity_after_acquisition_is_not_unmounted(self):
        original = self.commands

        def changed(args, *a, **kw):
            result = original(args, *a, **kw)
            if args[0] == "/usr/bin/systemd-run":
                self.mount.side_effect = None
                self.mount.return_value = ("99", "0:42", "private", "size=128k")
            return result

        self.run.side_effect = changed
        with self.assertRaises(ValueError):
            self.execute()
        self.assertTrue(self.secret.exists())
        self.assertFalse(self.failed()["root_source_cleanup_complete"])
        self.assertFalse(any(c[0] == "/usr/bin/umount" for c in self.events))

    def test_failed_unlink_blocks_unmount_and_import(self):
        with patch.object(m.os, "unlink", side_effect=PermissionError):
            with self.assertRaises(ValueError):
                self.execute()
        self.assertTrue(self.secret.exists())
        self.assertFalse(self.failed()["root_source_cleanup_complete"])
        self.assertFalse(any(c[0] == "/usr/bin/umount" for c in self.events))

    def test_unmount_failure_consumes_attempt_without_force_or_retry(self):
        self.unmount_rc = 1
        with self.assertRaises(ValueError):
            self.execute()
        self.assertFalse(self.secret.exists())
        self.assertTrue(self.mounted)
        self.assertFalse(self.failed()["root_source_cleanup_complete"])
        with self.assertRaises(ValueError):
            self.execute()
        self.assertEqual(sum(c[0] == "/usr/bin/umount" for c in self.events), 1)

    def test_mount_still_present_after_zero_exit_blocks_completion(self):
        self.mount.side_effect = None
        self.mount.return_value = ("71", "0:41", "private", "size=128k")
        with self.assertRaises(ValueError):
            self.execute()
        self.assertFalse(self.failed()["root_source_cleanup_complete"])

    def test_completion_failure_keeps_evidence_and_does_not_repeat_cleanup(self):
        self.done.side_effect = ValueError("private error details")
        with self.assertRaises(ValueError):
            self.execute()
        record = (self.destination / "credential-workflow-failed.json").read_text()
        self.assertNotIn("private error details", record)
        self.assertNotIn("synthetic-secret", record)
        self.assertTrue(json.loads(record)["root_source_cleanup_complete"])
        self.assertTrue((self.stage / "inputs/synthetic").exists())
        self.assertEqual(sum(c[0] == "/usr/bin/umount" for c in self.events), 1)

    def test_failed_cleanup_receipt_write_never_starts_import(self):
        original = m.handoff.frozen.write_new

        def fail_receipt(path, value):
            if path.name == "credential-source-cleanup.json":
                raise OSError("synthetic disk full")
            return original(path, value)

        with patch.object(m.handoff.frozen, "write_new", side_effect=fail_receipt):
            with self.assertRaises(ValueError):
                self.execute()
        self.assertTrue(self.failed()["root_source_cleanup_complete"])

    def test_public_entry_and_mismatched_pins_cannot_authorize_dispatch(self):
        with self.assertRaisesRegex(ValueError, "host_guard_not_bound"):
            m.run_workflow(approved=True)
        self.pins["source_manifest_sha256"] = "c" * 64
        with self.assertRaises(ValueError):
            self.execute()
        self.run.assert_not_called()


if __name__ == "__main__":
    unittest.main()
