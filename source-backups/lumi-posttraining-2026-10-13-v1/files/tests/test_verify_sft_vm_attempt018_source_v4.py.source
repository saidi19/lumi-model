"""Offline tests for the v0.4 source authentication verifier."""
import unittest
from unittest.mock import patch

from scripts import verify_sft_vm_attempt018_source_v4 as m


class Tests(unittest.TestCase):
    def test_verified_release_preserves_nonclaims(self):
        result = m.verify()
        self.assertTrue(result["outer_source_authentication_verified"])
        self.assertTrue(result["sha256_and_byte_count_closure_verified"])
        self.assertFalse(result["execution_authority_created"])
        self.assertFalse(result["gate_5_complete"])
        self.assertFalse(result["gpu"])

    def test_release_hash_drift_rejected(self):
        original = m.read

        def changed(path, digest, size=None, maximum=32 * 1024**2):
            if path == m.RELEASE / "release.json":
                digest = "0" * 64
            return original(path, digest, size, maximum)

        with patch.object(m, "read", changed), self.assertRaises(ValueError):
            m.verify()


if __name__ == "__main__":
    unittest.main()
