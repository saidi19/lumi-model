"""Offline checks for the admitted attempt-019 bindings."""
import unittest
from unittest.mock import patch

from scripts import prepare_sft_vm_deployment_bindings_v20 as m


class Tests(unittest.TestCase):
    def test_admitted_source_plan_controls_and_receipts(self):
        manifest = m.verify()
        plan = m.build()
        self.assertEqual(len(manifest["outputs"]), 156)
        self.assertEqual(plan["successful_readonly_preflight"]["sha256"], m.PREFLIGHT_SHA)
        self.assertEqual(m.controls(), {m.WATCH: m.WATCH_SHA, m.STORE: m.STORE_SHA})
        self.assertFalse(plan["execution_permitted"])

    def test_drift_rejected(self):
        for key in ("SOURCE_BINDINGS_SHA", "PLAN_SHA", "PREFLIGHT_SHA"):
            with self.subTest(key=key), patch.object(m, key, "0" * 64):
                with self.assertRaises(ValueError):
                    m.build()

    def test_no_execution_authority(self):
        with self.assertRaises(ValueError):
            m.run(approved=True)


if __name__ == "__main__":
    unittest.main()
