"""No-cloud regression for intermediate teardown metadata, not a native retry."""

import importlib.util
import time
import unittest
from pathlib import Path

from tests.test_sft_vm_watchdog_login_refresh_v1 import auth, provider
from tests.test_sft_vm_watchdog_report_channel_v1 import module

ROOT = Path(__file__).resolve().parents[1]
m = module("execute_sft_vm_watchdog_object_v4")
previous = module("execute_sft_vm_watchdog_object_v3")
builder = m.load("prepare_sft_vm_watchdog_object_v3.py")
spec = importlib.util.spec_from_file_location(
    "_cleanup_transition_fixtures", ROOT / "tests/test_sft_vm_watchdog_object_controller_v1.py"
)
fixtures = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fixtures)
fixtures.m, fixtures.builder = m, builder


class CleanupTransitionTests(fixtures.ObjectControllerTests):
    @classmethod
    def setUpClass(cls):
        cls.clients = auth.clients(provider())

    def test_credentials_require_temporary_session_and_enough_lifetime(self):
        self.assertGreater(
            self.clients["s3"]._request_signer._credentials._expiry_time.timestamp() - time.time(),
            720,
        )

    def test_prior_controller_rejects_pinned_intermediate_missing_vpc(self):
        prior = previous.Attempt(self.api, self.writer, fixtures.ATTEMPT, fixtures.channel, builder)
        row = self.api.row()
        prior.own_instance(row)
        row["State"]["Name"] = "shutting-down"
        row.pop("VpcId")
        with self.assertRaises(ValueError):
            prior.own_instance(row)

    def test_intermediate_missing_vpc_waits_for_termination_without_mutation_retry(self):
        base = self.api.call
        terminate_at = [None]

        def call(service, operation, **params):
            response = base(service, operation, **params)
            if operation == "terminate_instances":
                terminate_at[0] = self.clock.now()
            if operation == "describe_instances" and terminate_at[0] is not None:
                for reservation in response["Reservations"]:
                    for row in reservation["Instances"]:
                        row.pop("VpcId", None)
                        row["State"]["Name"] = (
                            "shutting-down"
                            if self.clock.now() < terminate_at[0] + 15
                            else "terminated"
                        )
            return response

        self.api.call = call
        result = self.attempt.execute()
        self.assertTrue(result["cleanup_verified"])
        self.assertTrue(result["native_watchdog_qualified"])
        self.assertEqual(result["errors"], [])
        self.assertGreaterEqual(result["controller_seconds"], 15)
        self.assertEqual(self.operations().count("run_instances"), 1)
        self.assertEqual(self.operations().count("terminate_instances"), 1)
        self.assertEqual(self.operations().count("get_object"), 4)

    def test_live_unknown_or_wrong_vpc_and_foreign_identity_stay_rejected(self):
        good = self.api.row()
        self.attempt.own_instance(good)
        for state in ("pending", "running", "stopping", "stopped", "unknown"):
            row = dict(good, State={"Name": state})
            row.pop("VpcId")
            with self.subTest(state=state), self.assertRaises(ValueError):
                self.attempt.own_instance(row)
        for field, value in (
            ("InstanceId", "i-" + "9" * 17),
            ("ClientToken", "foreign"),
            ("Tags", []),
            ("ImageId", "foreign"),
            ("InstanceType", "foreign"),
            ("VpcId", "foreign"),
        ):
            row = dict(good, State={"Name": "shutting-down"})
            row.pop("VpcId")
            row[field] = value
            with self.subTest(field=field), self.assertRaises(ValueError):
                self.attempt.own_instance(row)

    def test_unpinned_intermediate_missing_vpc_is_rejected(self):
        row = self.api.row()
        row["State"]["Name"] = "shutting-down"
        row.pop("VpcId")
        with self.assertRaises(ValueError):
            self.attempt.own_instance(row)

    def test_intermediate_state_alone_cannot_satisfy_termination(self):
        self.api.instance = self.attempt.launch_started = True
        self.attempt.own_instance(self.api.row())
        original_row = self.api.row

        def intermediate_row():
            row = original_row()
            row["State"]["Name"] = "shutting-down"
            row.pop("VpcId")
            return row

        self.api.row = intermediate_row
        with self.assertRaises(TimeoutError):
            self.attempt.cleanup_instance()
        self.assertIsNot(self.attempt.result.get("terminated_verified"), True)
        self.assertGreaterEqual(self.clock.now(), 1180)
        self.assertEqual(self.operations().count("terminate_instances"), 1)

    def test_no_new_cloud_approval_and_all_execution_bounds_preserved(self):
        self.assertEqual(m.BOUNDS, previous.BOUNDS)
        self.assertEqual(m.PINS, previous.PINS)
        self.assertFalse(m.OUT.exists())
        self.assertFalse(m.APPROVAL.exists())


if __name__ == "__main__":
    unittest.main()
