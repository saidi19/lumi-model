  "findings_and_corrections": [
    {
      "id": "socket_identity_mode_mismatch",
      "finding": "Topology v1 canonicalizes st_mode to S_IFMT; authority v1 compared full st_mode after detach. Realistic socket permission bits made valid endpoints fail.",
      "correction": "Authority v2 uses the same S_IFMT tuple; device, inode, owner, FD and status flags remain checked. The regression executes both actual identity implementations and reproduces the old failure."
    },
    {
      "id": "ledger_service_before_ready",
      "finding": "READY and CONSUMED are mediated worker writes. A controller that waits for READY before servicing reservations cannot make progress.",
      "correction": "One controller event loop services the actual parent ledger in every phase. Reservation precedes ACK, ACK failure never refunds, and ARM is attempted only once after broker-ready and reserved READY."
    },
    {
      "id": "shared_broker_workload_cgroup",
      "finding": "A broker blocked in listener receive keeps a shared leaf populated after the worker exits. Guardian v2 waits for leaf empty before terminating broker.",
      "correction": "Process v2 child branch enters the workload leaf only for the worker. Broker limit admission remains an explicit prerequisite; this change does not authorize an unbounded broker."
    },
    {
      "id": "ambient_descriptor_leak",
      "finding": "A topology transition closes topology-owned endpoints, not unrelated inherited FDs. Earlier prose overstated total descriptor exclusion.",
      "correction": "Child-role and guardian transitions now call the frozen descriptor enumerator/close helper and require exact non-stdio readback of the kept set."
    },
    {
      "id": "ambiguous_inherited_close_retry",
      "finding": "Process v1 cleared inherited_open only after close succeeded, permitting an error-path second attempt.",
      "correction": "Process v2 consumes the attempt before calling close; tests prove a failing close is called once."
    },
    {
      "id": "launch_and_cleanup_not_yet_safe",
      "finding": "Fork can run child setup before pidfd binding; controller-first guardian termination and guardian-v2 lease ownership handoff are not yet proved safe.",
      "correction": "Private process-v2 composition rejects before runtime inspection, topology creation or fork. These lifecycle issues are recorded as unresolved, not claimed fixed."
    }
  ],
