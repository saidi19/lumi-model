    ],
    "pidfd_bind_immediately_after_each_parent_fork": true,
    "later_child_inherited_pidfd_copies_closed": 1,
    "role_topology_paths": {
      "controller": "initial_to_controller",
      "guardian": "initial_to_guardian_prefork_to_guardian_watch",
      "broker": "guardian_prefork_to_broker",
      "worker": "guardian_prefork_to_worker"
    },
    "role_processes_enter_owned_cgroup": [
