  "completed": [
    "Private bootstrap reuses frozen attach, namespace, recursive mount readback, filesystem/IPC isolation, privilege drop and descriptor closure; executes only a fixed future staged entry.",
    "Parent control and bootstrap start barriers require owned pidfds before start signals; worker release additionally waits for exact READY and installed parent/deadline supervision.",
    "Private composition binds exact environment pins and worker summaries to the validated full-size entry and mount inventories.",
    "Full-size driver passes the original absolute deadline unchanged instead of the frozen synthetic run_case 220-second cap; cleanup allowances do not renew the import deadline.",
    "Failure cleanup uses only the owned controller/worker pidfds and leaf cgroup; ambiguous signal/kill/close operations are never retried; successful exit, receipt and EOF are required."
  ],
  "public_boundary": {
    "composition": "run_fullsize_guard always raises host_guard_not_bound",
    "bootstrap": "bootstrap always raises host_guard_not_bound",
