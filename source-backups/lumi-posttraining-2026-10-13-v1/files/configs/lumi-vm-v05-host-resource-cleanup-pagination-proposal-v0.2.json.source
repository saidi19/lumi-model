  "only_policy_changes": [
    "Permit up to eight pages per DescribeSecurityGroupVpcAssociations query, carrying forward the exact same group-id filter and MaxResults=100; no other query gains pagination.",
    "Require a valid list and zero association rows on every page. Require terminal absent/null/empty NextToken; a continuation token never means success. Reject malformed/repeated tokens and cap exhaustion. Keep opaque tokens in memory only.",
    "Increase aggregate resource API call cap from 64 to 96 solely to cover bounded association pagination and readback; retain other original execution caps.",
    "Pin deletion to the already resolved exact KeyPairId as well as fresh name/type/ownership/material checks.",
    "Record allowlisted check-stage codes and pagination counts, without response, token, key or exception text."
  ],
  "caps": {
    "credential_provider_invocations": 1,
    "resource_api_calls": 96,
    "mutation_api_calls": 5,
    "association_pages_per_query": 8,
    "wall_seconds": 600,
    "single_response_bytes": 262144,
    "aggregate_response_bytes": 2097152,
    "private_write_bytes": 262144,
    "aws_sdk_total_max_attempts": 1,
    "mutating_retries": 0
  },
  "unchanged": "All original ownership/rule/dependency checks, exact ordered five mutations, pre-mutation rechecks, protected exclusive journaling, uncertain-mutation stop, deletion readback and preservation requirements remain in force. Any association row still blocks cleanup; no association is disassociated.",
  "required_before_live": "Implement fresh versioned executor with synthetic pagination, foreign association, token-cycle, truncation, call-budget and no-retry tests, then bind exact implementation/test hashes in the new approval record.",
  "forbidden": "No new instance/network/key, checkpoint/data access, training/GPU, private-key access/deletion, EBS/S3/IAM/watchdog/registry/remote-claim mutation or unrelated cleanup. Preserve all prior failed and diagnostic evidence.",
