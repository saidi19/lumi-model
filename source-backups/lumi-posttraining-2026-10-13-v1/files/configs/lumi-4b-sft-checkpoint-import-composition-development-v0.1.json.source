  "rootfs_order": [
    "authenticate prepared identity metadata",
    "bind and seal software root",
    "install frozen input and output views in final private namespace",
    "re-pin root in final namespace",
    "install frozen OCI overlays",
    "pivot without later root rebind",
    "verify final input/output identities and mount flags"
  ],
  "guardian_order": [
    "validate and copy bounded controls",
    "owned cgroup and fixed bootstrap",
    "new rootfs then filesystem/IPC filters and privilege/FD drop",
    "receive exact ready packet",
    "install controller-pidfd and deadline watch before one release",
    "one fixed entry coordinator",
    "require exact report, successful exits, EOF, empty and removed owned cgroup"
  ],
  "public_real_import_boundary": "host_guard_not_bound",
  "native_integration_requirements": [
    "Prepare a new nonce-bound generated tiny fixture, root-owned worker-readable controls, source manifest and authenticated rootfs scaffold for this successor.",
    "Bind a source-verified Linux x86_64 CPython3.12 launcher to the new guardian and run bounded generated-only native qualification before any real payload acquisition.",
    "Separately admit dedicated host/runtime, input backing store and external-writer exclusion, full-size resources and real-host readback before real checkpoint import.",
    "After verified real CPU import, satisfy the existing GPU-worker, private-data and CUDA-smoke prerequisites before SFT."
  ],
  "forbidden_in_this_development_scope": [
    "native Linux or model kernel execution",
    "real model tokenizer dataset payload access",
    "network S3 cloud instance operations",
    "GPU inference training",
    "git commit push CI trigger",
    "prior source or evidence mutation"
  ],
