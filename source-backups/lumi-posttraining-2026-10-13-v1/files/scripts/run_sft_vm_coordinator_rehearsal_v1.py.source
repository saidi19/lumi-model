#!/usr/bin/env python3
"""Generated-only two-process coordinator check on a separately admitted Linux VM."""

import argparse
import importlib.util
import json
import sys
from pathlib import Path


def load_control(root):
    spec = importlib.util.spec_from_file_location('fixed_vm_coordinator_control',
        root / 'src/lumi/posttraining_vm_coordinator_rehearsal_v1.py')
    if spec is None or spec.loader is None:
        raise RuntimeError('control_unavailable')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    launch = sub.add_parser('launch')
    launch.add_argument('--machine-id', required=True)
    launch.add_argument('--attempt', required=True)
    launch.add_argument('--release-sha256', required=True)
    worker = sub.add_parser('worker')
    worker.add_argument('attempt')
    worker.add_argument('mode', choices=('prepare', 'import'))
    worker.add_argument('pin')
    args = parser.parse_args()
    root = Path('/opt/lumi-vm-coordinator-v1')
    if sys.platform != 'linux' or Path(__file__) != root / 'scripts' / Path(__file__).name:
        parser.exit(2, 'fixed_linux_release_required\n')
    try:
        control = load_control(root)
        if args.command == 'worker':
            control.worker(args.attempt, args.mode, args.pin)
        else:
            result = control.launch(machine_id=args.machine_id, attempt=args.attempt,
                                    release_sha256=args.release_sha256)
            print(json.dumps(result, sort_keys=True))
    except BaseException:
        parser.exit(1, 'generated_rehearsal_failed\n')


if __name__ == '__main__':
    main()
