"""Connect fresh-host cloud observations to the existing guarded setup delivery.

Initial-boot-proof successor. Private API: the future provisioner owns resource creation,
authentic launch receipts, initial expiry, API timeouts and independent STOP.
No launch, key generation, IAM change, network creation, import or retry here.
"""

from __future__ import annotations

import hashlib
import math
import time

import build_sft_vm_initial_boot_v1 as initial
import prepare_sft_vm_host_connection_v3 as connection
import run_sft_vm_setup_delivery_v3 as delivery

PINS = {
    "build_sft_vm_initial_boot_v1.py": (
        "b284326ae7e6c612763f63889a9cc12533cfa3c598be759e5180fa304fbc368c"
    ),
    "prepare_sft_vm_host_connection_v3.py": (
        "5f4e573a9873628ae8a4f6b67ecac51380f0b40843134fdbf37e7a72682c4d0a"
    ),
    "run_sft_vm_setup_delivery_v3.py": (
        "97fefdd9e07afb8eb26aa41c09353155466e881acd4832c795f096fcdf7eb43b"
    ),
}
OPERATIONS = {
    ("sts", "get-caller-identity"),
    *(
        ("ec2", name)
        for name in (
            "describe-instances",
            "describe-instance-status",
            "describe-instance-attribute",
            "describe-images",
            "describe-instance-connect-endpoints",
            "describe-security-groups",
            "describe-volumes",
            "describe-route-tables",
            "describe-nat-gateways",
            "describe-internet-gateways",
            "get-console-output",
        )
    ),
}


def need(value):
    if not value:
        raise ValueError("host_setup_join_rejected") from None


def _prepare_and_setup_admitted_once(
    binding,
    key,
    output,
    launch,
    *,
    cloud,
    deadline,
    launch_monotonic,
    host_deadline_monotonic,
    remaining_control_bytes,
    clock=time.monotonic,
    sleep=time.sleep,
):
    need(type(deadline) in {int, float} and math.isfinite(deadline))
    need(200 < deadline - clock() <= 1800)
    need(
        type(remaining_control_bytes) is int
        and 0 < remaining_control_bytes <= delivery.seed.INPUTS.CAP
    )
    connection.validate_launch(launch, binding)
    volumes = {name: binding[name] for name in ("root_volume", "work_volume")}
    need(type(launch_monotonic) in {int, float} and math.isfinite(launch_monotonic))
    need(type(host_deadline_monotonic) in {int, float} and math.isfinite(host_deadline_monotonic))
    need(0 <= clock() - launch_monotonic < 1350)
    need(host_deadline_monotonic == launch_monotonic + 14400)
    initial.source_bytes()
    for name, pin in PINS.items():
        need(
            hashlib.sha256(
                delivery.seed.INPUTS.read(delivery.seed.INPUTS.REPO / "scripts" / name, 131072)
            ).hexdigest()
            == pin
        )
    # Existing entry is authenticated before cloud observations or private writes.
    delivery.source_bytes()
    connection.safe_path(output)
    output.mkdir(mode=0o700, exist_ok=False)
    delivery.seed.INPUTS.sync(output.parent)
    report = dict(
        fresh_host_control_plane_verified=False,
        setup_completed=False,
        setup_unit_reaped=False,
        host_admitted=False,
        binding_created=False,
        gate_5_complete=False,
        retry_allowed=False,
        execution_permitted=False,
        outer_lifecycle_stop_required_on_failure=True,
        cloud_observation_calls=0,
    )

    def save(name):
        delivery.seed.INPUTS.write(output / name, connection.canonical(report))

    class ReadOnlyCloud:
        def cli(self, service, operation, **fields):
            need((service, operation) in OPERATIONS)
            need(report["cloud_observation_calls"] < 12)
            # Leave the old bounded CLI call plus SSH setup reserve inside the
            # original deadline; do not manufacture a fresh 1800-second budget.
            need(deadline - clock() > 180)
            report["cloud_observation_calls"] += 1
            return cloud.cli(service, operation, **fields)

    save("started.json")
    stage = "cloud_admission"
    try:
        directory = output / "connection"
        prepared = connection._prepare_bound_connection(
            binding, key, directory, launch=launch, cloud=ReadOnlyCloud()
        )
        need(prepared["status"] == "prepared_pinned_connection_not_native_admission")
        for flag in (
            "control_plane_matches",
            "fresh_launch_and_work_volume_match",
            "work_snapshot_absent",
            "private_egress_route_configured",
        ):
            need(prepared[flag] is True)
        need(
            prepared["native_host_admitted"] is False
            and prepared["egress_reachability_proven"] is False
        )
        report["fresh_host_control_plane_verified"] = True
        stage = "initial_boot_proof"
        config_sha = prepared["ssh_config_sha256"]
        hosts_sha = hashlib.sha256(
            delivery.seed.INPUTS.read(directory / "known_hosts", 4096)
        ).hexdigest()
        argv = delivery.seed.sender.command(
            binding, key, directory, config_sha, hosts_sha, initial.proof_launcher()
        )
        proof_charge = len(argv[-1].encode())
        need(proof_charge < remaining_control_bytes and deadline - clock() > 180)
        proof_started = clock()
        proof = initial.validate_proof(delivery.seed.sender.delivery.pipe_exchange(argv, b"", 25))
        need(proof["observed_boottime"] <= clock() - launch_monotonic + 5)
        # Sample was taken after proof_started, making setup conversion conservative.
        # Neither setup nor host time is restarted after connection/proof latency.
        original_host_deadline_boottime = math.floor(
            proof["observed_boottime"] + host_deadline_monotonic - clock() - 60
        )
        original_host_deadline_boottime = min(14400, original_host_deadline_boottime)
        deadline = min(deadline, proof_started + 1800 - proof["observed_boottime"] - 30)
        delivery.validate_parameters(volumes, original_host_deadline_boottime)
        need(deadline - clock() > 180)
        report["initial_boot_timers_verified"] = True
        report["proof_control_content_bytes_charged"] = proof_charge
        delivery.seed.INPUTS.write(output / "initial-proof.json", connection.canonical(proof))
        stage = "guarded_setup"
        root = delivery.seed.INPUTS.REPO
        result = _seed_send_and_setup_same_boot(
            binding,
            key,
            directory,
            config_sha,
            hosts_sha,
            root / "scripts/stage_sft_vm_setup_inputs_v5.py",
            root / "artifacts/lumi-vm-setup-inputs-release-v0.5/setup-inputs.tar",
            volumes,
            output / "setup",
            original_host_deadline_boottime=original_host_deadline_boottime,
            deadline=deadline,
            remaining_control_bytes=remaining_control_bytes - proof_charge,
            early_proof=proof,
            clock=clock,
            sleep=sleep,
        )
        need(result["setup_completed"] is True and result["setup_unit_reaped"] is True)
        report.update(
            setup_completed=True,
            setup_unit_reaped=True,
            total_control_content_bytes_charged=proof_charge
            + result["total_control_content_bytes_charged"],
        )
    except BaseException:
        report["failed_stage"] = stage
        save("result.json")
        raise ValueError("host_setup_join_failed") from None
    save("result.json")
    return report


def _seed_send_and_setup_same_boot(
    binding,
    key,
    directory,
    config_sha,
    hosts_sha,
    receiver,
    archive,
    volumes,
    output,
    *,
    original_host_deadline_boottime,
    deadline,
    remaining_control_bytes,
    early_proof,
    clock,
    sleep,
):
    # Join unchanged seed/upload and staged setup APIs, checking identity
    # between them. No candidate/model data or new setup policy.
    delivery.source_bytes()
    delivery.validate_parameters(volumes, original_host_deadline_boottime)
    need(volumes == {k: binding[k] for k in ("root_volume", "work_volume")})
    need(145 < deadline - clock() <= 1800)
    reserve = delivery.SOURCE_BYTES + (delivery.MAX_POLLS + 3) * delivery.ABORT_RESERVE_BYTES
    need(reserve < remaining_control_bytes <= delivery.seed.INPUTS.CAP)
    connection.safe_path(output)
    output.mkdir(mode=0o700, exist_ok=False)
    delivery.seed.INPUTS.sync(output.parent)
    staged = delivery.seed._seed_and_send_admitted_once(
        binding,
        key,
        directory,
        config_sha,
        hosts_sha,
        receiver,
        archive,
        output / "controls",
        deadline=deadline,
        remaining_control_bytes=remaining_control_bytes - reserve,
        clock=clock,
    )
    seed_receipt = delivery.seed.validate_seed(
        delivery.seed.INPUTS.read(output / "controls/seed.json", 4096)
    )
    need(all(seed_receipt[k] == early_proof[k] for k in ("machine_id", "boot_id")))
    need(seed_receipt["observed_boottime"] >= early_proof["observed_boottime"])
    completed = delivery._run_staged_admitted_once(
        binding,
        key,
        directory,
        config_sha,
        hosts_sha,
        seed_receipt,
        volumes,
        output / "setup",
        original_host_deadline_boottime=original_host_deadline_boottime,
        deadline=deadline,
        remaining_control_bytes=remaining_control_bytes
        - staged["total_control_content_bytes_charged"],
        clock=clock,
        sleep=sleep,
    )
    result = {
        **completed,
        "control_staging_confirmed": True,
        "total_control_content_bytes_charged": staged["total_control_content_bytes_charged"]
        + completed["control_content_bytes_charged"],
    }
    need(result["total_control_content_bytes_charged"] <= remaining_control_bytes)
    delivery.seed.INPUTS.write(output / "result.json", connection.canonical(result))
    return result


def run(**_arguments):
    raise ValueError("fullsize_host_admission_not_bound") from None
