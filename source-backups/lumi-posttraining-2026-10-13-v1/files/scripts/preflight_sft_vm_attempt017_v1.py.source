"""Standalone read-only admission; no CPU execution entry or marker reachable."""

import ast
import hashlib
import importlib
import json
import math
import sys
import time
import types
import uuid
from decimal import Decimal
from pathlib import Path

from scripts import prepare_sft_vm_deployment_bindings_v11 as bindings

ROOT = Path(__file__).resolve().parents[1]
RELEASE = ROOT / bindings.RELEASE
ATTEMPT = bindings.ATTEMPT
OUTPUT = ROOT / "artifacts/lumi-vm-attempt-017-readonly-preflight-v0.1"
SOURCE = ROOT / "scripts/execute_sft_vm_private_outer_v19.py"
SOURCE_SHA = "3a028e25c23a02a4cdc850e878a86a4700fd06887ccc9c6587dc62f6b4d6da14"
MAX_CALLS, MAX_SECONDS = 79, 1500


def need(value):
    if not value:
        raise ValueError("readonly_preflight_rejected")


def local():
    need(hashlib.sha256(Path(bindings.__file__).read_bytes()).hexdigest()
         == "c4522926e9ffb74248470698b4c03f4b80ef0d4c08d379135e90f52eba35a028")
    manifest = bindings.verify()
    pins = bindings.controls()
    path = ROOT / "evidence/lumi-vm-attempt-016-endpoint-cleanup-verification-v0.1.json"
    proof = json.loads(bindings.read(str(path.relative_to(ROOT)),
                     "503443d85c9d2e5cb99fd06255e9defe058a53f6ee7aeb91756d31e2e5990837"))
    need(proof["result"]["cleanup_verified"] and proof["endpoint_interface_absent"])
    for name, pin in proof["source_bindings"].items():
        bindings.read(name, pin["sha256"], pin["bytes"])
    need(sys.dont_write_bytecode)
    sys.path.insert(0, str(RELEASE / "scripts"))
    outer = importlib.import_module("run_sft_vm_private_outer_v7")
    need(Path(outer.__file__).resolve() == RELEASE / "scripts/run_sft_vm_private_outer_v7.py")
    outer.authenticate()
    outer.loading.fresh_identity()
    return outer, manifest, pins


def admission(outer):
    raw = SOURCE.read_bytes()
    need(hashlib.sha256(raw).hexdigest() == SOURCE_SHA)
    names = {"Preflight", "AdmissionFailure", "inspect_before_marker"}
    nodes = [n for n in ast.parse(raw).body if getattr(n, "name", None) in names]
    need(len(nodes) == 3)
    namespace = dict(outer=outer, local_preconditions=lambda: None, RELEASE=RELEASE,
                     ATTEMPT=ATTEMPT, need=need, json=json, time=time, uuid=uuid,
                     Decimal=Decimal, sha=bindings.sha)
    exec(compile(ast.Module(body=nodes, type_ignores=[]), "<pinned-readonly-admission>", "exec"),
         namespace)
    return namespace["inspect_before_marker"]


class ReadOnlyClient:
    def __init__(self, client, budget):
        self.client, self.budget = client, budget

    def __getattr__(self, name):
        if name == "meta":
            return self.client.meta
        need(name.startswith(("get_", "describe_", "list_", "head_")))
        need(name not in {"get_object", "head_object", "list_objects", "list_objects_v2",
                          "list_object_versions"})

        def read(**kwargs):
            need(self.budget["calls"] < MAX_CALLS)
            need(time.monotonic() - self.budget["start"] < MAX_SECONDS - 20)
            self.budget["calls"] += 1
            return getattr(self.client, name)(**kwargs)
        return read


def run():
    outer, _, pins = local()
    inspect = admission(outer)
    need(not OUTPUT.exists() and not any(p.is_symlink() for p in (OUTPUT, *OUTPUT.parents)))
    OUTPUT.mkdir(mode=0o700)
    outer.loading.save(OUTPUT / "started.json", bindings.encode(dict(
        entry_sha256=bindings.sha(Path(__file__).read_bytes()), control_evidence=pins,
        max_calls=MAX_CALLS, max_seconds=MAX_SECONDS, execution_authorized=False)))
    bundle = None
    budget = dict(calls=0, start=time.monotonic())
    report = dict(status="started", cloud_mutations=0, object_access=0,
                  execution_marker_created=False, outer_invoked=False,
                  gpu=False, training=False, gate_5_complete=False)
    try:
        start = float(math.floor(time.monotonic()))
        first = True

        def clock():
            nonlocal first
            if first:
                first = False
                return start
            return time.monotonic()

        reader = outer.credentials.Reader(start + 18000, clock=clock)
        bundle = outer.credentials.Clients(reader)
        wrapped = types.SimpleNamespace(reader=reader, clients={
            k: ReadOnlyClient(v, budget) for k, v in bundle.clients.items()})
        result = inspect(wrapped)
        outer.loading.save(OUTPUT / "admission.json", bindings.encode(result))
        report.update(status="readonly_preflight_passed", admission=result,
                      cpu_launch_authorized=False)
    except BaseException as error:
        report.update(status="stopped_no_retry",
                      diagnostic=outer.failure.describe(error, "preflight"))
        if getattr(error, "stage", None) in {"cpu", "watchdog", "network", "cleanup_store"}:
            report["failed_stage"] = error.stage
    finally:
        if bundle is not None:
            bundle.close()
        report.update(calls=budget["calls"], elapsed_seconds=round(
            time.monotonic() - budget["start"], 3))
        outer.loading.save(OUTPUT / "result.json", bindings.encode(report))
    print(json.dumps(report, sort_keys=True))
    return report


if __name__ == "__main__":
    run()
