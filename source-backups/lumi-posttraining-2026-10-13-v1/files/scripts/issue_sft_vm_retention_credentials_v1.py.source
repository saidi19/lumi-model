"""Private just-in-time retention issuer; public execution remains closed.

The caller must independently authenticate/admit the completed host, bucket,
release, fixed retention deadline and delivery channel before this entry. Its
delivery callback must wait for completion or verified stop, not only FIFO send.
No native admission, SSH, S3 request or VM launch is provided here.
"""

from __future__ import annotations

import datetime as dt
import hashlib
import json
import re
import resource
import time
import uuid

import issue_sft_vm_acquisition_credentials_v1 as acquisition

base = acquisition.base
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
BUCKET = "lumi-corpus-prod-27777c02b29b76efcac3"
PREFIX = "lumi-corpus/v0.1/control/sft-import-research/" + ATTEMPT + "/"
PROPOSAL_SHA = "9e1ea3041ce5ca3ead8f58d0931dc8c7e41c5a66a9bc43e55ff75890b662c061"
POLICY = "ExactRetentionWriteReadback"
USER_POLICY = "OnlyRetentionRole"
ACTIONS = ["s3:GetObject", "s3:PutObject"]
SESSION_POLICY = {
    "Version": "2012-10-17",
    "Statement": [
        {"Effect": "Allow", "Action": ACTIONS, "Resource": "*"},
        {"Effect": "Deny", "NotAction": ACTIONS, "Resource": "*"},
    ],
}


def need(value):
    if not value:
        raise ValueError("retention_issuer_rejected") from None


def utc(value):
    need(isinstance(value, dt.datetime) and value.utcoffset() == dt.timedelta(0))
    return value


def policy_for_expiry(expiry):
    """IAM scope complements, not replaces, frozen byte/request/transport caps.

    GetObject also authorizes HEAD; IAM cannot distinguish those here. The
    frozen transport forbids HEAD, retries and multipart operations separately.
    Conditional PUT and AES256 are additionally constrained by this policy.
    """
    arns = [f"arn:aws:s3:::{BUCKET}/{PREFIX}{kind}/*" for kind in ("package", "metadata")]
    statements = [
        {"Sid": "RetentionOnly", "Effect": "Allow", "Action": ACTIONS, "Resource": arns},
        {"Sid": "DenyOtherResources", "Effect": "Deny", "Action": "*", "NotResource": arns},
        {"Sid": "DenyOtherActions", "Effect": "Deny", "NotAction": ACTIONS, "Resource": "*"},
    ]
    for sid, action, condition in (
        ("DenyInsecure", "*", {"Bool": {"aws:SecureTransport": "false"}}),
        (
            "DenyExpired",
            "*",
            {"DateGreaterThanEquals": {"aws:CurrentTime": utc(expiry).isoformat()}},
        ),
        ("DenyOverwrite", "s3:PutObject", {"StringNotEquals": {"s3:if-none-match": "*"}}),
        (
            "DenyOtherEncryption",
            "s3:PutObject",
            {"StringNotEquals": {"s3:x-amz-server-side-encryption": "AES256"}},
        ),
        ("DenyCopy", "s3:PutObject", {"Null": {"s3:x-amz-copy-source": "false"}}),
    ):
        statements.append(
            dict(Sid=sid, Effect="Deny", Action=action, Resource="*", Condition=condition)
        )
    policy = dict(Version="2012-10-17", Statement=statements)
    need(len(base.compact(policy)) <= 10240)
    return policy


def build(raw, now):
    need(
        type(raw) is bytes and len(raw) <= 32768 and hashlib.sha256(raw).hexdigest() == PROPOSAL_SHA
    )
    value = json.loads(raw)
    target = value["retention_proposal"]
    need(value["prepared_attempt"] == ATTEMPT)
    need(
        target["bucket"] == BUCKET
        and target["prefix"] == PREFIX
        and target["region"] == base.REGION
    )
    expiry = utc(now) + dt.timedelta(seconds=3600)
    return policy_for_expiry(expiry), expiry


class Cloud(acquisition.permissions.issuer.Cloud):
    def issue_retention_session(self, key, role_arn):
        import botocore.config
        import botocore.session

        need(hashlib.sha256(base.CA.read_bytes()).hexdigest() == base.CA_SHA)
        need(len(base.compact(SESSION_POLICY)) <= 2048)
        client = botocore.session.Session().create_client(
            "sts",
            region_name=base.REGION,
            endpoint_url="https://sts.us-east-1.amazonaws.com",
            aws_access_key_id=key["AccessKeyId"],
            aws_secret_access_key=key["SecretAccessKey"],
            aws_session_token=None,
            verify=str(base.CA),
            config=botocore.config.Config(
                connect_timeout=10,
                read_timeout=15,
                retries={"total_max_attempts": 1},
                proxies={},
                ignore_configured_endpoint_urls=True,
            ),
        )
        try:
            return client.assume_role(
                RoleArn=role_arn,
                RoleSessionName="lumi-retention",
                DurationSeconds=3600,
                Policy=base.compact(SESSION_POLICY),
            )["Credentials"]
        finally:
            client.close()


def credential_body(value, policy_expiry, now):
    need(
        type(value) is dict
        and set(value) == {"AccessKeyId", "SecretAccessKey", "SessionToken", "Expiration"}
    )
    expiry = utc(value["Expiration"])
    need(1860 <= (expiry - utc(now)).total_seconds() <= 3600)
    need(1860 <= (utc(policy_expiry) - now).total_seconds() <= 3600)
    for field in ("AccessKeyId", "SecretAccessKey", "SessionToken"):
        item = value[field]
        need(type(item) is str and 1 <= len(item) <= 16384 and all(32 < ord(c) < 127 for c in item))
    need(value["AccessKeyId"].startswith("ASIA"))
    body = bytearray(base.compact(value | {"Expiration": expiry.isoformat()}).encode())
    need(len(body) <= 65536)
    return body


def remove_owned(cloud, name, owner, attempted, ids):
    """Nonce/ID-bound cleanup only; no assumption of instant revocation."""
    errors = []
    for kind in ("user", "role"):
        if kind not in attempted:
            continue
        try:
            if acquisition._owned(cloud, kind, name, owner, ids.get(kind)) is None:
                continue
            if kind == "user":
                keys = cloud.cli("iam", "list-access-keys", UserName=name)
                need(not keys.get("IsTruncated", False) and len(keys["AccessKeyMetadata"]) <= 1)
                for key in keys["AccessKeyMetadata"]:
                    cloud.cli(
                        "iam", "delete-access-key", UserName=name, AccessKeyId=key["AccessKeyId"]
                    )
                try:
                    cloud.cli("iam", "delete-user-policy", UserName=name, PolicyName=USER_POLICY)
                except base.CloudError as error:
                    if str(error) != "absent":
                        raise
                cloud.cli("iam", "delete-user", UserName=name)
            else:
                cloud.cli(
                    "iam",
                    "put-role-policy",
                    RoleName=name,
                    PolicyName=POLICY,
                    PolicyDocument=base.compact(base.DENY),
                )
                need(
                    cloud.cli("iam", "get-role-policy", RoleName=name, PolicyName=POLICY)[
                        "PolicyDocument"
                    ]
                    == base.DENY
                )
                cloud.cli("iam", "delete-role-policy", RoleName=name, PolicyName=POLICY)
                cloud.cli("iam", "delete-role", RoleName=name)
            need(cloud.absent(kind, name))
        except BaseException:
            errors.append(kind)
    return errors


def run(**_arguments):
    raise ValueError("host_guard_not_bound") from None


def _run_for_admitted_delivery(
    raw,
    attempt,
    output,
    deliver,
    *,
    cloud=None,
    now=lambda: dt.datetime.now(dt.UTC),
    wait=time.sleep,
):
    """Not admission: caller owns authenticated delivery and bounded supervision.

    Deliberately no CLI/approval flag. Must not be used before successful import
    and verifier completion, writer exclusion, bucket validation and host-bound
    retention admission. The callback must await completion or verified stop.
    """
    need(attempt == ATTEMPT and callable(deliver))
    policy, expiry = build(raw, now())
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    output.mkdir(mode=0o700, parents=False, exist_ok=False)
    cloud = Cloud() if cloud is None else cloud
    name, owner = "lumi-retain-" + attempt, uuid.uuid4().hex
    base.save(
        output / "started.json",
        dict(
            attempt=attempt,
            name=name,
            owner_nonce=owner,
            proposal_sha256=PROPOSAL_SHA,
            policy_sha256=hashlib.sha256(base.compact(policy).encode()).hexdigest(),
            policy_expires_at=expiry.isoformat(),
            retry_allowed=False,
        ),
    )
    report = dict(
        schema="lumi.retention-issuer.v0.1",
        session_issued=False,
        delivery_returned=False,
        retention_completion_reported=False,
        long_term_key_removed_before_delivery=False,
        cleanup_verified=False,
        host_admitted_here=False,
        gate_5_complete=False,
        production_eligible=False,
        credential_contents_retained=False,
        immediate_session_revocation_claimed=False,
    )
    stage, attempted, ids = "identity", set(), {}
    key = credentials = body = None
    try:
        need(cloud.cli("sts", "get-caller-identity").get("Account") == base.ACCOUNT)
        need(cloud.absent("user", name) and cloud.absent("role", name))
        tags = [{"Key": "LumiOwnerNonce", "Value": owner}]
        stage = "create_user"
        attempted.add("user")
        created = cloud.cli("iam", "create-user", UserName=name, Path=acquisition.PATH, Tags=tags)[
            "User"
        ]
        ids["user"] = created["UserId"]
        user = acquisition._owned(cloud, "user", name, owner, ids["user"])
        need(user is not None)
        arn = f"arn:aws:iam::{base.ACCOUNT}:role{acquisition.PATH}{name}"
        cutoff = utc(now()) + dt.timedelta(minutes=15)
        trust = dict(
            Version="2012-10-17",
            Statement=[
                dict(
                    Effect="Allow",
                    Principal={"AWS": f"arn:aws:iam::{base.ACCOUNT}:root"},
                    Action="sts:AssumeRole",
                    Condition={
                        "ArnEquals": {"aws:PrincipalArn": user["Arn"]},
                        "DateLessThan": {"aws:CurrentTime": cutoff.isoformat()},
                    },
                )
            ],
        )
        stage = "create_role"
        attempted.add("role")
        created = cloud.cli(
            "iam",
            "create-role",
            RoleName=name,
            Path=acquisition.PATH,
            Tags=tags,
            AssumeRolePolicyDocument=base.compact(trust),
            MaxSessionDuration=3600,
        )["Role"]
        ids["role"] = created["RoleId"]
        user_policy = dict(
            Version="2012-10-17",
            Statement=[
                dict(
                    Effect="Allow",
                    Action="sts:AssumeRole",
                    Resource=arn,
                    Condition={"DateLessThan": {"aws:CurrentTime": cutoff.isoformat()}},
                ),
                dict(Effect="Deny", NotAction="sts:AssumeRole", Resource="*"),
                dict(Effect="Deny", Action="sts:AssumeRole", NotResource=arn),
            ],
        )
        stage = "policy_readback"
        cloud.cli(
            "iam",
            "put-role-policy",
            RoleName=name,
            PolicyName=POLICY,
            PolicyDocument=base.compact(policy),
        )
        cloud.cli(
            "iam",
            "put-user-policy",
            UserName=name,
            PolicyName=USER_POLICY,
            PolicyDocument=base.compact(user_policy),
        )

        def readback():
            role = acquisition._owned(cloud, "role", name, owner, ids["role"])
            need(
                role is not None
                and role["MaxSessionDuration"] == 3600
                and role["AssumeRolePolicyDocument"] == trust
            )
            need(
                cloud.cli("iam", "get-role-policy", RoleName=name, PolicyName=POLICY)[
                    "PolicyDocument"
                ]
                == policy
            )
            need(
                cloud.cli("iam", "get-user-policy", UserName=name, PolicyName=USER_POLICY)[
                    "PolicyDocument"
                ]
                == user_policy
            )

        readback()
        stage = "issue"
        key = cloud.cli("iam", "create-access-key", UserName=name)["AccessKey"]
        wait(15)
        need(utc(now()) < cutoff and (expiry - now()).total_seconds() >= 1860)
        credentials = cloud.issue_retention_session(key, arn)
        report["session_issued"] = True
        stage = "remove_long_term_key"
        need(acquisition._owned(cloud, "user", name, owner, ids["user"]) is not None)
        cloud.cli("iam", "delete-access-key", UserName=name, AccessKeyId=key["AccessKeyId"])
        key = None
        inventory = cloud.cli("iam", "list-access-keys", UserName=name)
        need(inventory["AccessKeyMetadata"] == [] and not inventory.get("IsTruncated", False))
        report["long_term_key_removed_before_delivery"] = True
        stage = "deliver"
        readback()
        body = credential_body(credentials, expiry, now())
        credentials = None
        result = deliver(body)
        report["delivery_returned"] = True
        # A FIFO-send acknowledgement is not a completed/cleaned-up workflow.
        # Authenticity of this receipt remains the admitted controller's duty.
        need(type(result) is dict)
        need(
            all(
                result.get(k) is True
                for k in (
                    "offhost_retention_verified",
                    "retention_cgroup_reaped",
                    "credential_source_cleanup_complete",
                )
            )
        )
        need(
            all(
                result.get(k) is False
                for k in ("gate_5_complete", "production_eligible", "instance_termination_allowed")
            )
        )
        need(
            type(result.get("commit_sha256")) is str
            and re.fullmatch(r"[0-9a-f]{64}", result["commit_sha256"]) is not None
        )
        report["retention_completion_reported"] = True
    except BaseException:
        report["failed_stage"] = stage
    finally:
        if body is not None:
            body[:] = b"\0" * len(body)
        key = credentials = None
        errors = remove_owned(cloud, name, owner, attempted, ids)
        report["cleanup_errors"] = errors
        report["cleanup_verified"] = bool(attempted) and not errors
        base.save(output / "result.json", report)
    return report
