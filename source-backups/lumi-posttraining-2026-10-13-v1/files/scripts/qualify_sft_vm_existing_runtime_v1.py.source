"""Private same-boot generated-only qualification using the installed CPU runtime.

Reuse the already successful frozen coordinator, fixture and converter. Install
only its source bundle, never wheels or model data. No binding/admission is
created. A partial source installation consumes this qualification; no retry.
"""

import hashlib
import io
import json
import os
import re
import stat
import sys
import tarfile
import time
import types
from pathlib import Path

ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
QUALIFICATION = hashlib.sha256(("generated-runtime-v1:" + ATTEMPT).encode()).hexdigest()[:32]
ROOT = Path("/opt/lumi-vm-coordinator-v3")
ATTEMPTS = Path("/var/lib/lumi-vm-coordinator")
ARCHIVE_SHA = "dbae54038d86d712bf14e4ebb50a6ff3fd83c17a42c5e75659c2f280a1465bca"
MANIFEST_SHA = "66b35b30f3d8d98ca9f241794fed2f52e8479a918704be14792edaf6583550fa"
LOCK_SHA = "26bde6a0163e5db9d8d4564117546482601f4d0beb09f8705be5fc9183594965"
READINESS_SHA = "c6d65a5e1dc90c46855f76be9ccf241193cf2ac0fedb20c6b8ad1d95bbefdfda"
CONTROL = "src/lumi/posttraining_vm_coordinator_rehearsal_v3.py"
SECONDS = 600
RESERVE = 11315


def need(value):
    if not value:
        raise ValueError("generated_runtime_qualification_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def decode(raw):
    def unique(rows):
        result = {}
        for key, value in rows:
            need(key not in result)
            result[key] = value
        return result

    return json.loads(raw, object_pairs_hook=unique)


def unpack(raw):
    """Authenticate the complete source-only release BEFORE writes or execution."""
    need(type(raw) is bytes and len(raw) == 181868 and sha(raw) == ARCHIVE_SHA)
    bodies = {}
    total = 0
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
        for item in archive:
            need(len(bodies) < 51 and item.name not in bodies)
            need(item.isfile() and 0 <= item.size <= 1024**2)
            need(
                re.fullmatch(r"(?:src/lumi|tests|scripts)/[A-Za-z0-9_]+\.py", item.name)
                or item.name in {"release-manifest.json", "runtime-lock.json"}
            )
            total += item.size
            need(total <= 2 * 1024**2)
            with archive.extractfile(item) as stream:
                body = stream.read(item.size + 1)
            need(len(body) == item.size)
            bodies[item.name] = body
    need(len(bodies) == 51 and sha(bodies["release-manifest.json"]) == MANIFEST_SHA)
    need(sha(bodies["runtime-lock.json"]) == LOCK_SHA)
    manifest = decode(bodies["release-manifest.json"])
    need(type(manifest) is dict and len(manifest) == 49 and CONTROL in manifest)
    need(set(bodies) == set(manifest) | {"release-manifest.json", "runtime-lock.json"})
    need(all(sha(bodies[name]) == pin for name, pin in manifest.items()))
    return bodies


def trusted_directory(path):
    need(path.is_absolute())
    for parent in (path, *path.parents):
        info = parent.lstat()
        need(stat.S_ISDIR(info.st_mode) and info.st_uid == info.st_gid == 0)
        need(not info.st_mode & 0o022)


def root_owner(info):
    need(info.st_uid == info.st_gid == 0)


def write_new(path, raw, mode):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
        os.fchmod(stream.fileno(), mode)


def install_sources(bodies):
    trusted_directory(ROOT.parent)
    trusted_directory(ATTEMPTS.parent)
    # No exist_ok on the release root: failed or ambiguous attempts stay consumed.
    ROOT.mkdir(mode=0o755)
    ROOT.chmod(0o755)
    for relative in ("src", "src/lumi", "tests", "scripts"):
        (ROOT / relative).mkdir(mode=0o755)
        (ROOT / relative).chmod(0o755)
    for name, raw in sorted(bodies.items()):
        write_new(ROOT / name, raw, 0o444)
    if not os.path.lexists(ATTEMPTS):
        ATTEMPTS.mkdir(mode=0o700)
    trusted_directory(ATTEMPTS)
    need(stat.S_IMODE(ATTEMPTS.stat().st_mode) == 0o700)


def verify_sources(bodies):
    trusted_directory(ROOT)
    need(stat.S_IMODE(ROOT.stat().st_mode) == 0o755)
    actual = set()
    directories = set()
    for path in ROOT.rglob("*"):
        need(len(actual) + len(directories) <= 55)
        info = path.lstat()
        root_owner(info)
        if stat.S_ISDIR(info.st_mode):
            need(stat.S_IMODE(info.st_mode) == 0o755)
            directories.add(path.relative_to(ROOT).as_posix())
            continue
        name = path.relative_to(ROOT).as_posix()
        need(name in bodies and stat.S_ISREG(info.st_mode) and info.st_nlink == 1)
        need(stat.S_IMODE(info.st_mode) == 0o444 and info.st_size == len(bodies[name]))
        need(path.read_bytes() == bodies[name])
        actual.add(name)
    need(actual == set(bodies) and directories == {"src", "src/lumi", "tests", "scripts"})


def load(name, raw, path):
    module = types.ModuleType(name)
    module.__file__ = str(path)
    exec(compile(raw, str(path), "exec"), module.__dict__)
    return module


def boot_time():
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def validate_native(report, control):
    need(
        type(report) is dict
        and set(report)
        == {
            "schema",
            "status",
            "summary",
            "both_cgroups_empty",
            "staged_input_and_source_files_unchanged",
            "real_4b_import",
            "training_authorized",
            "production_eligible",
            "cumulative_native_write_limit_claimed",
            "billing_managed",
            "generated_tmpfs_unmounted",
        }
    )
    need(report["schema"] == "lumi.vm-coordinator-native-rehearsal.v0.1")
    need(report["status"] == "passed_generated_only")
    need(report["both_cgroups_empty"] is True and report["generated_tmpfs_unmounted"] is True)
    for key in (
        "real_4b_import",
        "training_authorized",
        "production_eligible",
        "cumulative_native_write_limit_claimed",
        "billing_managed",
    ):
        need(report[key] is False)
    count = report["staged_input_and_source_files_unchanged"]
    need(type(count) is int and 49 < count <= 256)
    summary = report["summary"]
    need(type(summary) is dict)
    control.validate_summary(json.dumps(summary).encode(), summary.get("control_sha256"))
    need(control.frozen.hex_id(summary.get("control_sha256"), 64))
    return count


def boundary():
    # Reject the Mac before looking at installed paths, /proc or native state.
    need(sys.platform == "linux" and sys.version_info[:2] == (3, 12))
    need(os.geteuid() == os.getegid() == 0 and sys.flags.isolated and sys.dont_write_bytecode)


def _qualify_same_host(request, archive, readiness_source):
    boundary()
    need(type(readiness_source) is bytes and len(readiness_source) <= 32768)
    need(sha(readiness_source) == READINESS_SHA)
    bodies = unpack(archive)
    readiness = load(
        "_qualified_readiness",
        readiness_source,
        Path("/opt/lumi-bootstrap-input/inspect_sft_vm_native_readiness_v1.py"),
    )
    readiness._inspect_same_host(request)  # Authenticates the original request and boot.
    need(boot_time() < request["host_deadline_boottime"] - RESERVE - SECONDS)
    started = time.monotonic()
    install_sources(bodies)
    try:
        verify_sources(bodies)  # All source bodies authenticate before nested helper imports.
        control = load("_qualified_generated_coordinator", bodies[CONTROL], ROOT / CONTROL)
        need(control.ROOT == ROOT and control.ATTEMPTS == ATTEMPTS)
        need(control.TOTAL_SECONDS == 240)
        result = control.launch(
            machine_id=request["machine_id"], attempt=QUALIFICATION, release_sha256=MANIFEST_SHA
        )
        count = validate_native(result, control)
        verify_sources(bodies)
        need(
            all(
                control.cgroup_empty(control.unit_name(QUALIFICATION, mode))
                for mode in control.MODES
            )
        )
        readiness._inspect_same_host(request)  # Same original guards, disk and empty real dirs.
        need(0 <= time.monotonic() - started < SECONDS)
        report = dict(
            schema="lumi.vm-existing-runtime-qualification.v0.1",
            attempt=ATTEMPT,
            qualification_attempt=QUALIFICATION,
            status="passed_generated_only",
            source_files_verified=49,
            generated_files_unchanged=count,
            native_ml_runtime_qualified=True,
            same_boot_readiness_rechecked=True,
            both_cgroups_empty=True,
            generated_tmpfs_unmounted=True,
            full_input_audits=2,
            independent_checksum_consumer=True,
            runtime_reinstalled=False,
            binding_created=False,
            host_admitted=False,
            real_4b_import=False,
            gate_5_complete=False,
            training_authorized=False,
            production_eligible=False,
            retry_allowed=False,
        )
    except BaseException:
        # Preserve frozen detailed fixed-stage evidence; never copy exception text.
        write_new(
            ROOT / "qualification-failed.json",
            b'{"status":"failed_preserve_no_retry","retry_allowed":false}\n',
            0o600,
        )
        raise ValueError("generated_qualification_failed") from None
    write_new(ROOT / "qualification.json", json.dumps(report, sort_keys=True).encode(), 0o600)
    return report


def run(**_arguments):
    raise ValueError("authenticated_same_host_qualification_required") from None
