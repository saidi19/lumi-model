"""Bind the live attempt-019 control-target absence evidence."""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path

from scripts import prepare_sft_vm_attempt019_controls_v1 as previous

ROOT = Path(__file__).resolve().parents[1]
PREVIOUS_SHA = "626ea900055d8f86b746c02afe3d4fe4c7096009b6f1fd741680f614cd4d0242"
BASE_PLAN = "artifacts/lumi-vm-attempt-019-control-plan-v0.1/plan.json"
BASE_PLAN_SHA = "c40e57adaf1d690443eb8c40acb4835ee94dc24f579d0b1a17db94ee1f2a4608"
ABSENCE = "evidence/lumi-vm-attempt-019-control-target-absence-v0.1.json"
ABSENCE_SHA = "64497983b637ae443fe88495412fc53cccef2e954ead5e7c313d863c5de8ffd9"
OUTPUT = ROOT / "artifacts/lumi-vm-attempt-019-control-plan-v0.2"
ATTEMPT = previous.ATTEMPT


def need(value):
    if not value:
        raise ValueError("attempt019_control_plan_v2_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def encode(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()


def read(name, digest):
    relative = Path(name)
    need(not relative.is_absolute() and ".." not in relative.parts)
    path = ROOT / relative
    need(not any(item.is_symlink() for item in (path, *path.parents)))
    need(path.is_file() and 0 < path.stat().st_size <= 64 * 1024)
    raw = path.read_bytes()
    need(sha(raw) == digest)
    return raw


def build():
    need(sha(Path(previous.__file__).read_bytes()) == PREVIOUS_SHA)
    previous.build()
    plan = json.loads(read(BASE_PLAN, BASE_PLAN_SHA))
    evidence = json.loads(read(ABSENCE, ABSENCE_SHA))
    observations = evidence["observations"]
    count_keys = {
        "selected_cidr_subnets",
        "attempt_instance_connect_endpoints",
        "attempt_tagged_instances",
        "attempt_key_pairs",
        "attempt_security_groups",
    }
    flag_keys = {key for key in observations if key.endswith("_exists")}
    need(
        evidence["attempt"] == ATTEMPT
        and evidence["account"] == plan["account"]
        and evidence["region"] == plan["region"]
        and observations["selected_cidr"] == previous.CIDR
        and all(observations[key] == 0 for key in count_keys)
        and all(observations[key] is False for key in flag_keys)
        and evidence["read_only_aws_calls"] <= 20
        and evidence["bounded_transient_read_retries"] <= 8
        and evidence["cloud_mutations"] == 0
        and evidence["object_access"] == 0
        and evidence["instance_actions"] == 0
        and evidence["collision_free_for_control_preparation"] is True
        and evidence["execution_permitted"] is False
    )
    plan["schema"] = "lumi.vm-attempt-019-control-plan.v0.2"
    plan["status"] = "live_absence_verified_fresh_control_deployment_approval_required"
    plan["network_candidate_live_availability_verified"] = True
    plan["control_target_absence_evidence"] = {"path": ABSENCE, "sha256": ABSENCE_SHA}
    plan["readiness_review"]["decision"] = (
        "fresh_watchdog_and_cleanup_bucket_deployment_approval_required"
    )
    plan["readiness_review"]["risk"] = (
        "Live absence is verified, but the inert watchdog and cleanup bucket do not yet "
        "exist; read-only admission and remote import remain unproved."
    )
    plan["unresolved_before_live_execution"] = [
        "Deploy and verify the fresh inert stop watchdog under an exact one-shot approval.",
        "Create and verify the fresh dedicated cleanup bucket under an exact one-shot approval.",
        "Pass the fresh read-only CPU/network/store/watchdog admission.",
        "Bind a separate one-shot CPU proposal and exact human approval.",
    ]
    plan["approval_record"] = None
    plan["execution_permitted"] = False
    plan["gate_5_complete"] = False
    return plan


def prepare():
    plan = build()
    body = encode(plan)
    report = {
        "schema": "lumi.vm-attempt-019-control-plan-release.v0.2",
        "attempt": ATTEMPT,
        "plan_sha256": sha(body),
        "plan_bytes": len(body),
        "source_release_sha256": previous.RELEASE_SHA,
        "source_verification_sha256": previous.SOURCE_PROOF_SHA,
        "control_target_absence_sha256": ABSENCE_SHA,
        "live_target_absence_verified": True,
        "fresh_control_deployment_required": True,
        "execution_permitted": False,
        "cloud_mutations": 0,
        "gate_5_complete": False,
        "gpu": False,
        "training": False,
    }
    need(not OUTPUT.exists() and not any(item.is_symlink() for item in (OUTPUT, *OUTPUT.parents)))
    OUTPUT.mkdir(mode=0o700)
    for name, raw in (("plan.json", body), ("release.json", encode(report))):
        fd = os.open(OUTPUT / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
        with os.fdopen(fd, "wb") as stream:
            need(stream.write(raw) == len(raw))
    return report


def run(**_arguments):
    raise ValueError("control_plan_is_not_cloud_or_cpu_authority") from None


if __name__ == "__main__":
    print(json.dumps(prepare(), sort_keys=True))
