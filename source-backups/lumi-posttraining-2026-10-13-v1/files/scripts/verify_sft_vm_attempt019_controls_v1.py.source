STORE_OUTPUT = ROOT / "evidence/lumi-vm-attempt-019-cleanup-bucket-verification-v0.1.json"
PLAN = ROOT / "artifacts/lumi-vm-attempt-019-control-plan-v0.2/plan.json"
PLAN_SHA = "07b44f0281e4ee07009ce93aeb433cf92aeaaf845f37dc71a6570d03197cb6ec"
