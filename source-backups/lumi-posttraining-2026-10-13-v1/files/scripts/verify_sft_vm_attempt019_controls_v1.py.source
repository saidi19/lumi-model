WORKER_ROLE = "lumi-stop-worker-" + ATTEMPT
SCHEDULE_ROLE = "lumi-stop-schedule-" + ATTEMPT
GROUP = "lumi-stop-" + ATTEMPT
LOG_GROUP = "/aws/lambda/" + FUNCTION
BUCKET = "lumi-cleanup-" + ATTEMPT
PREFIX = "lumi-corpus/v0.1/control/sft-import-research/" + ATTEMPT + "/network-cleanup/"
WATCH_OUTPUT = ROOT / (
    "evidence/lumi-vm-attempt-019-inert-watchdog-deployment-verification-v0.1.json"
