        "92079353cc15e586337a4ed1698e5cd7a12e8b642aa41adfcaf4a40f39ed0e74",
    ),
}
MAX_CALLS = 28
MAX_SECONDS = 300


def need(value):
    if not value:
        raise ValueError("attempt019_control_verification_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def encode(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()


def read(relative, size, digest):
    path = ROOT / relative
    need(not any(item.is_symlink() for item in (path, *path.parents)))
    need(path.is_file() and path.stat().st_size == size)
    raw = path.read_bytes()
    need(sha(raw) == digest)
    return raw


def local():
    raw = {name: read(name, *pin) for name, pin in SOURCE_BINDINGS.items()}
    plan = json.loads(raw[str(PLAN.relative_to(ROOT))])
    watch = json.loads(
        raw["artifacts/lumi-vm-attempt-019-watchdog-deployment-v0.1/entry-result.json"]
    )
    deployed = json.loads(
        raw["artifacts/lumi-vm-attempt-019-watchdog-deployment-v0.1/deployment/result.json"]
    )
    store = json.loads(raw["artifacts/lumi-vm-attempt-019-cleanup-bucket-v0.1/result.json"])
    need(
        plan["attempt"] == ATTEMPT
        and plan["execution_permitted"] is False
        and watch["status"] == "deployed_unarmed_invocation_disabled"
        and watch["deployment"] == deployed
        and watch["total_control_calls"] <= 45
        and watch["mutation_dispatches"] == 9
        and watch["invocation"] is False
        and watch["schedule_creation"] is False
        and watch["instance_actions"] == 0
        and watch["retry"] is False
        and store["status"] == "created_private_cleanup_store_verified"
        and store["calls"] <= 20
        and store["mutation_dispatches"] == 6
        and store["privacy_readback_verified"] is True
        and store["shared_bucket_mutation"] is False
        and store["object_access"] is False
        and store["iam_mutation"] is False
        and store["instance_action"] is False
        and store["retry"] is False
    )
    return plan, watch, store


class Reads:
    def __init__(self, cloud, *, clock=time.monotonic, sleep=time.sleep):
        self.cloud = cloud
        self.clock = clock
        self.sleep = sleep
        self.start = clock()
        self.calls = 0
        self.retries = 0

    def call(self, service, operation, **fields):
        need(operation.startswith(("get_", "describe_", "list_", "head_")))
        need(operation not in {"get_object", "list_objects", "list_objects_v2"})
        for index, delay in enumerate((0, *transport.READ_DELAYS)):
            need(self.calls < MAX_CALLS and self.clock() - self.start < MAX_SECONDS)
            if delay:
                need(self.retries < transport.MAX_READ_RETRIES)
                self.retries += 1
                self.sleep(delay)
            self.calls += 1
            try:
                return getattr(self.cloud[service], operation)(**fields)
            except Exception as error:
                if index == len(transport.READ_DELAYS) or not transport.transient(error):
                    raise
        need(False)

    def absent(self, service, operation, **fields):
        try:
            self.call(service, operation, **fields)
        except Exception as error:
            if transport.error_code(error) in transport.ABSENCE_CODES.get(service, set()):
                return True
            raise
        return False


def verify_live(cloud):
    plan, watch, store = local()
    reads = Reads(cloud)
    need(reads.call("sts", "get_caller_identity")["Account"] == ACCOUNT)
    configuration = reads.call("lambda", "get_function_configuration", FunctionName=FUNCTION)
    need(
        configuration["FunctionName"] == FUNCTION
        and configuration["State"] == "Active"
        and configuration["LastUpdateStatus"] == "Successful"
        and configuration["CodeSha256"] == watch["deployment"]["code_sha256"]
        and configuration["Runtime"] == "python3.13"
        and configuration["Timeout"] == 180
        and configuration["MemorySize"] == 128
        and configuration["Environment"]["Variables"]
        == {"LUMI_WATCHDOG_BINDING": '{"armed":false}'}
    )
    concurrency = reads.call("lambda", "get_function_concurrency", FunctionName=FUNCTION)
    invoke = reads.call("lambda", "get_function_event_invoke_config", FunctionName=FUNCTION)
    need(
        concurrency["ReservedConcurrentExecutions"] == 0
        and invoke["MaximumRetryAttempts"] == 0
        and invoke["MaximumEventAgeInSeconds"] == 60
    )
    roles = {row["role"]: row for row in plan["watchdog"]["roles"]}
    for name in (WORKER_ROLE, SCHEDULE_ROLE):
        role = reads.call("iam", "get_role", RoleName=name)["Role"]
        expected = roles[name]
        need(
            role["RoleName"] == name
            and role["Path"] == "/lumi/temporary/"
            and {item["Key"]: item["Value"] for item in role.get("Tags", [])}.get("LumiAttempt")
            == ATTEMPT
        )
        policy = reads.call(
            "iam",
            "get_role_policy",
            RoleName=name,
            PolicyName=plan["watchdog"]["inline_policy_name"],
        )
        need(policy["PolicyDocument"] == expected["inline_policy"])
    log_groups = reads.call("logs", "describe_log_groups", logGroupNamePrefix=LOG_GROUP, limit=10)[
        "logGroups"
    ]
    exact_logs = [row for row in log_groups if row["logGroupName"] == LOG_GROUP]
    need(len(exact_logs) == 1 and exact_logs[0]["retentionInDays"] == 7)
    need(reads.absent("scheduler", "get_schedule_group", Name=GROUP))
    fields = {"Bucket": BUCKET, "ExpectedBucketOwner": ACCOUNT}
    location = reads.call("s3", "get_bucket_location", **fields)
    public = reads.call("s3", "get_public_access_block", **fields)
    ownership = reads.call("s3", "get_bucket_ownership_controls", **fields)
    encryption = reads.call("s3", "get_bucket_encryption", **fields)
    versioning = reads.call("s3", "get_bucket_versioning", **fields)
    tagging = reads.call("s3", "get_bucket_tagging", **fields)
    policy = reads.call("s3", "get_bucket_policy", **fields)
    status = reads.call("s3", "get_bucket_policy_status", **fields)
    lifecycle_absent = reads.absent("s3", "get_bucket_lifecycle_configuration", **fields)
    block = public["PublicAccessBlockConfiguration"]
    need(
        location["LocationConstraint"] is None
        and all(block[name] is True for name in bucket_source.BLOCK)
        and ownership["OwnershipControls"]["Rules"]
        == [{"ObjectOwnership": "BucketOwnerEnforced"}]
        and encryption["ServerSideEncryptionConfiguration"] == bucket_source.ENCRYPTION
        and versioning["Status"] == "Enabled"
        and sorted(tagging["TagSet"], key=lambda row: row["Key"])
        == sorted(bucket_source.TAGS, key=lambda row: row["Key"])
        and json.loads(policy["Policy"]) == bucket_source.policy()
        and status["PolicyStatus"]["IsPublic"] is False
        and lifecycle_absent
    )
    common = {
        "date": dt.datetime.now(dt.UTC).date().isoformat(),
        "attempt": ATTEMPT,
        "source_bindings": {
            name: {"bytes": size, "sha256": digest}
            for name, (size, digest) in SOURCE_BINDINGS.items()
        },
        "read_only_calls_total": reads.calls,
        "bounded_transient_read_retries": reads.retries,
        "cloud_mutations": 0,
        "object_access": False,
        "full_cpu_execution_authorized": False,
        "cpu_instance_launched": False,
        "checkpoint_access": False,
        "gate_5_complete": False,
        "gpu": False,
        "training": False,
    }
    watch_evidence = dict(
        common,
        schema="lumi.attempt019-inert-watchdog-deployment-verification.v0.1",
        status="verified_deployed_unarmed_invocation_disabled",
        result=watch,
        independent_live_readback={
            "function_state": configuration["State"],
            "last_update_status": configuration["LastUpdateStatus"],
            "code_sha256": configuration["CodeSha256"],
            "runtime": configuration["Runtime"],
            "timeout_seconds": configuration["Timeout"],
            "memory_mib": configuration["MemorySize"],
            "unarmed_environment_verified": True,
            "reserved_concurrency": concurrency["ReservedConcurrentExecutions"],
            "maximum_retry_attempts": invoke["MaximumRetryAttempts"],
            "maximum_event_age_seconds": invoke["MaximumEventAgeInSeconds"],
            "roles_and_inline_policies_verified": True,
            "log_retention_days": exact_logs[0]["retentionInDays"],
            "schedule_group_absent": True,
        },
    )
    store_evidence = dict(
        common,
        schema="lumi.attempt019-cleanup-bucket-verification.v0.1",
        status="verified_private_cleanup_bucket_created",
        result=store,
        storage={
            "bucket": BUCKET,
            "prefix": PREFIX,
            "region": "us-east-1",
            "ownership": "BucketOwnerEnforced",
            "default_encryption": "AES256",
            "versioning": "Enabled",
            "public": False,
            "lifecycle_configuration_present": False,
            "object_access": False,
        },
        independent_readback={
            "all_public_access_blocks_enabled": True,
            "bucket_owner_enforced": True,
            "aes256_default_encryption": True,
            "versioning_enabled": True,
            "attempt_and_purpose_tags_verified": True,
            "deny_only_policy_verified": True,
            "policy_is_public": False,
            "lifecycle_absent": True,
        },
    )
    return watch_evidence, store_evidence


def run():
    need(not WATCH_OUTPUT.exists() and not STORE_OUTPUT.exists())
    cloud = transport.clients()
    try:
        watch, store = verify_live(cloud)
    finally:
        for client in cloud.values():
            client.close()
    for path, value in ((WATCH_OUTPUT, watch), (STORE_OUTPUT, store)):
        raw = encode(value)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
        with os.fdopen(fd, "wb") as stream:
            need(stream.write(raw) == len(raw))
    print(
        json.dumps(
            {"watchdog": watch["status"], "cleanup_store": store["status"]},
            sort_keys=True,
        )
    )
    return watch, store


if __name__ == "__main__":
    run()
