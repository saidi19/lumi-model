SOURCE_BINDINGS = {
    "scripts/prepare_sft_vm_deployment_bindings_v18.py": (
        4342,
        "7dbd2c244d5a91696487288b956b736a215a7bbfd62cf5eb3c5da9a3a180e294",
    ),
    "scripts/execute_sft_vm_inert_watchdog_v12.py": (
        8143,
        "abc5be19dcafc37bd58bf263c84c3da0e66ea662b9fd7806b817595744eadcc5",
    ),
    "scripts/sft_vm_dedicated_cleanup_bucket_v10.py": (
        4138,
        "0f3eacc33022bb524253ede45e88a943542a87594f33ca432e8022874c6bd476",
    ),
    "configs/lumi-vm-attempt-019-watchdog-execution-proposal-v0.1.json": (
        808,
        "fab07db3cbf17d1148521f16293f2b2a759680f36bbfeb51201255d7addb8be5",
    ),
    "configs/lumi-vm-attempt-019-watchdog-execution-approval-v0.1.json": (
