        "3b39a0b65b348b408a86e5cb4a42c9b570e101d6d0d3e1ccc3574dfedd48b23c",
    ),
    "artifacts/lumi-vm-attempt-019-control-plan-v0.2/plan.json": (20475, PLAN_SHA),
    "artifacts/lumi-vm-attempt-019-source-v0.1/release.json": (
        26822,
        SOURCE_RELEASE_SHA,
