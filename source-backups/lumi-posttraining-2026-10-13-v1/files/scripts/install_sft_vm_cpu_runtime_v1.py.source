#!/usr/bin/env python3
"""One-shot offline CPU runtime install using the unchanged pinned 34-wheel lock.

No downloader, model access or host admission. Requires pre-staged read-only
wheels and a bounded native systemd unit. Reuses the frozen SDK install helpers;
does not reuse its SDK destination or enlarge its runtime limits.
"""

from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import stat
import sys
import types
from pathlib import Path

INPUT = Path("/opt/lumi-cpu-input")
DEST = Path("/opt/lumi-sft-rehearsal")
UNIT = "lumi-cpu-install-v1.service"
HELPER_SHA = "0326195c9ca27b98471699d85571d1f85ef2f7f8fc1282e58004ac01738aa38c"
LOCK_SHA = "26bde6a0163e5db9d8d4564117546482601f4d0beb09f8705be5fc9183594965"


def need(value):
    if not value:
        raise ValueError("cpu_runtime_install_rejected") from None


def owned(path, *, directory=False):
    for parent in path.parents:
        info = parent.lstat()
        need(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022)
    info = path.lstat()
    need(info.st_uid == info.st_gid == 0)
    if directory:
        need(stat.S_ISDIR(info.st_mode) and not info.st_mode & 0o022)
    else:
        need(
            stat.S_ISREG(info.st_mode)
            and info.st_nlink == 1
            and stat.S_IMODE(info.st_mode) == 0o400
        )
    return info


def helpers():
    path = INPUT / "install_sft_vm_acquisition_sdk_v1.py"
    owned(path)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        raw = stream.read(131073)
    need(len(raw) <= 131072 and hashlib.sha256(raw).hexdigest() == HELPER_SHA)
    module = types.ModuleType("_cpu_pinned_sdk_install_helpers")
    module.__file__ = str(path)
    exec(compile(raw, str(path), "exec"), module.__dict__)
    return module


def boundary():
    need(sys.platform == "linux" and platform.machine() == "x86_64")
    need(sys.version_info[:2] == (3, 12) and sys.flags.isolated and sys.dont_write_bytecode)
    need(os.geteuid() == os.getegid() == 0)
    with open("/proc/self/cgroup", "rb") as stream:
        need(stream.read(4097).strip() == f"0::/system.slice/{UNIT}".encode())
    group = Path("/sys/fs/cgroup/system.slice") / UNIT
    for name, value in (("memory.max", 1024**3), ("memory.swap.max", 0), ("pids.max", 64)):
        with (group / name).open("rb") as stream:
            need(stream.read(65).strip() == str(value).encode())
    need(os.stat("/proc/self/ns/net").st_ino != os.stat("/proc/1/ns/net").st_ino)
    owned(INPUT, directory=True)
    owned(DEST.parent, directory=True)
    need(not DEST.exists() and not DEST.is_symlink())
    need(os.statvfs(INPUT).f_flag & os.ST_RDONLY)
    space = os.statvfs(DEST.parent)
    need(space.f_bavail * space.f_frsize >= 4 * 1024**3)


def lock(helper):
    path = INPUT / "runtime-lock.json"
    owned(path)
    raw = helper.read(path, 131072)
    need(helper.sha(raw) == LOCK_SHA)
    value = json.loads(raw)
    need(value["python_abi"] == "cp312" and value["platform"] == "linux/amd64")
    rows = value["requirements"]
    need(len(rows) == 34 and len({r["name"] for r in rows}) == 34)
    need(len({r["filename"] for r in rows}) == 34)
    need(sum(r["bytes"] for r in rows) <= 512 * 1024**2)
    for row in rows:
        need(re.fullmatch(r"[A-Za-z0-9_.+-]+", row["name"]))
        need(re.fullmatch(r"[A-Za-z0-9_.+!~-]+", row["version"]))
        need(re.fullmatch(r"[A-Za-z0-9_.+%-]+\.whl", row["filename"]))
        need(re.fullmatch(r"[0-9a-f]{64}", row["sha256"]))
        need(type(row["bytes"]) is int and 0 < row["bytes"] <= 512 * 1024**2)
    return rows


def audit_wheels(rows):
    directory = INPUT / "wheels"
    owned(directory, directory=True)
    need({p.name for p in directory.iterdir()} == {r["filename"] for r in rows})
    count = 0
    for row in rows:
        path = directory / row["filename"]
        original = owned(path)
        need(original.st_size == row["bytes"])
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            before = os.fstat(stream.fileno())
            need((before.st_dev, before.st_ino) == (original.st_dev, original.st_ino))
            digest, size = hashlib.sha256(), 0
            while block := stream.read(min(1024**2, row["bytes"] - size + 1)):
                size += len(block)
                need(size <= row["bytes"])
                digest.update(block)
            after = os.fstat(stream.fileno())
        fields = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_nlink",
            "st_uid",
            "st_gid",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        need(all(getattr(original, k) == getattr(before, k) == getattr(after, k) for k in fields))
        need(size == row["bytes"] and digest.hexdigest() == row["sha256"])
        count += size
    return count


def install():
    boundary()
    helper = helpers()
    rows = lock(helper)
    DEST.mkdir(mode=0o755, exist_ok=False)  # Failed audits/installations consume this destination.
    stage = "wheel_audit"
    try:
        helper.write(
            DEST / "started.json",
            helper.canonical({"lock_sha256": LOCK_SHA, "retry_allowed": False}),
        )
        count = audit_wheels(rows)
        requirements = DEST / "offline-requirements.txt"
        helper.write(
            requirements,
            "".join(
                f"{r['name']}=={r['version']} --hash=sha256:{r['sha256']}\n" for r in rows
            ).encode("ascii"),
        )
        stage = "venv"
        helper.run_command(["/usr/bin/python3", "-I", "-B", "-m", "venv", str(DEST / "venv")], 90)
        python = str(DEST / "venv/bin/python")
        stage = "offline_install"
        helper.run_command(
            [
                python,
                "-I",
                "-B",
                "-m",
                "pip",
                "install",
                "--no-index",
                "--find-links=" + str(INPUT / "wheels"),
                "--only-binary=:all:",
                "--require-hashes",
                "--no-deps",
                "--no-compile",
                "-r",
                str(requirements),
            ],
            300,
        )
        stage = "dependency_check"
        helper.run_command([python, "-I", "-B", "-m", "pip", "check"], 30)
        stage = "versions"
        code = (
            "import importlib.metadata as m,json;v={n:m.version(n) for n in "
            + repr([r["name"] for r in rows])
            + "};s=json.dumps(v,sort_keys=True);assert len(s)<=8192;print(s)"
        )
        with (DEST / "versions.json").open("xb") as output:
            helper.run_command([python, "-I", "-B", "-c", code], 15, output)
            output.flush()
            os.fsync(output.fileno())
        versions = json.loads(helper.read(DEST / "versions.json", 8192))
        need(versions == {r["name"]: r["version"] for r in rows})
        result = {
            "schema": "lumi.vm-cpu-offline-install.v0.1",
            "status": "passed",
            "software_lock_sha256": LOCK_SHA,
            "wheel_count": 34,
            "wheel_bytes": count,
            "all_locked_versions_match": True,
            "native_ml_import_exercised": False,
            "old_oci_runtime_identity_claimed": False,
            "host_admitted": False,
            "real_4b_import": False,
            "gate_5_complete": False,
            "retry_allowed": False,
        }
        helper.write(DEST / "result.json", helper.canonical(result))
        return result
    except BaseException:
        helper.write(
            DEST / "failed.json", helper.canonical({"stage": stage, "retry_allowed": False})
        )
        raise ValueError("cpu_runtime_install_failed") from None


if __name__ == "__main__":
    try:
        need(len(sys.argv) == 1)
        install()  # Receipts only, not stdout logs.
    except BaseException:
        sys.exit(1)
