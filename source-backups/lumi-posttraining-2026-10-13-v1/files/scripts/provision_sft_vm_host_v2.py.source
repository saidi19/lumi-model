"""Private fresh-resource/setup transaction for a future authorized controller.

NOT a runnable approval or the full import lifecycle. Native qualification,
price/quota refresh, independent retention and final run authority remain open.
No SDK client creation or credentials here. No launch retry, terminate/delete,
IAM mutation, existing-instance reuse, source download or model access.
"""

from __future__ import annotations

import base64
import contextlib
import datetime as dt
import hashlib
import json
import math
import os
import re
import signal
import stat
import subprocess
import time

import build_sft_vm_initial_boot_v1 as initial
import prepare_sft_vm_host_connection_v3 as connection
import run_sft_vm_host_setup_v3 as setup

ATTEMPT = initial.ATTEMPT
CAP = 32 * 1024**2
MAX_CALLS = 160
ROOT = setup.delivery.seed.INPUTS.REPO
INPUTS = setup.delivery.seed.INPUTS
PINS = {
    "prepare_sft_vm_host_connection_v3.py": (
        "5f4e573a9873628ae8a4f6b67ecac51380f0b40843134fdbf37e7a72682c4d0a"
    ),
    "build_sft_vm_initial_boot_v1.py": (
        "b284326ae7e6c612763f63889a9cc12533cfa3c598be759e5180fa304fbc368c"
    ),
    "run_sft_vm_host_setup_v3.py": (
        "798cd6250470a7f807b655e22836e265ed615bce1c26c965aa95784d0a6429a6"
    ),
}
READS = setup.OPERATIONS | {
    ("ec2", "describe-subnets"),
    ("ec2", "describe-key-pairs"),
}
WRITES = {
    ("ec2", name)
    for name in (
        "create-security-group",
        "revoke-security-group-egress",
        "authorize-security-group-egress",
        "authorize-security-group-ingress",
        "import-key-pair",
        "create-instance-connect-endpoint",
        "run-instances",
        "stop-instances",
    )
}


def need(value):
    if not value:
        raise ValueError("fresh_provisioning_rejected") from None


@contextlib.contextmanager
def timeout(seconds):
    # Dedicated future main-thread controller only; do not steal an active alarm.
    need(signal.getitimer(signal.ITIMER_REAL) == (0.0, 0.0))
    old = signal.getsignal(signal.SIGALRM)

    def expired(_signum, _frame):
        raise TimeoutError("bounded_cloud_timeout")

    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old)


class SDKCloud:
    """One-shot authenticated SDK transport; caller supplies existing clients.

    Binary UserData/PublicKeyMaterial stay in memory, unlike JSON CLI argv.
    Credential issuance/refresh is not supplied by this development component.
    """

    def __init__(self, clients):
        need(type(clients) is dict and set(clients) == {"ec2", "sts"})
        for service, client in clients.items():
            meta = client.meta
            need(meta.region_name == "us-east-1")
            need(meta.endpoint_url == f"https://{service}.us-east-1.amazonaws.com")
            need(meta.config.retries.get("total_max_attempts") == 1)
            need(0 < meta.config.connect_timeout <= 3 and 0 < meta.config.read_timeout <= 5)
            need(meta.config.proxies == {})
        self.clients = clients

    def cli(self, service, operation, **fields):
        need((service, operation) in READS | WRITES)
        with timeout(20):
            return getattr(self.clients[service], operation.replace("-", "_"))(**fields)


def fresh_key(path):
    connection.safe_path(path)
    need(not os.path.lexists(path) and not os.path.lexists(str(path) + ".pub"))
    # Private material is written directly by ssh-keygen inside the exclusive
    # private attempt directory; it never enters Python output or a cloud call.
    subprocess.run(
        ["/usr/bin/ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "", "-f", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=10,
        check=True,
        env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"},
    )
    info = path.lstat()
    need(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid())
    need(info.st_nlink == 1 and stat.S_IMODE(info.st_mode) == 0o600)
    return INPUTS.read(path.with_name(path.name + ".pub"), 1024)


def public_key(raw):
    need(type(raw) is bytes and len(raw) <= 1024)
    fields = raw.strip().split()
    need(len(fields) == 2 and fields[0] == b"ssh-ed25519")
    decoded = base64.b64decode(fields[1], validate=True)
    need(len(decoded) == 51 and decoded[:19] == b"\0\0\0\x0bssh-ed25519\0\0\0\x20")
    return b" ".join(fields)


def tag_spec(kind):
    return [dict(ResourceType=kind, Tags=[dict(Key="LumiAttempt", Value=ATTEMPT)])]


def group_rule(group, account):
    return dict(
        IpProtocol="tcp",
        FromPort=22,
        ToPort=22,
        UserIdGroupPairs=[dict(GroupId=group, UserId=account)],
    )


HTTPS = dict(IpProtocol="tcp", FromPort=443, ToPort=443, IpRanges=[dict(CidrIp="0.0.0.0/0")])


def rules_equal(actual, expected):
    need(type(actual) is list)

    # AWS includes empty optional lists. Do not ignore a nonempty extra field.
    def clean(rule):
        return {k: v for k, v in rule.items() if v != []}

    need(connection.canonical([clean(r) for r in actual]) == connection.canonical(expected))


class Transaction:
    def __init__(self, output, cloud, clock, sleep, utcnow):
        self.output, self.cloud, self.clock, self.sleep, self.utcnow = (
            output,
            cloud,
            clock,
            sleep,
            utcnow,
        )
        self.started = clock()
        self.deadline = self.started + 1800
        self.calls = 0
        self.mutations = set()
        self.binding = {"attempt": ATTEMPT, "key_name": "lumi-fullsize-" + ATTEMPT}
        self.launched = False
        self.launch_clock = None
        raw = INPUTS.read(ROOT / connection.PROPOSAL, 32768)
        need(hashlib.sha256(raw).hexdigest() == connection.PROPOSAL_SHA)
        self.proposal = json.loads(raw)
        self.host = self.proposal["host"]
        need(self.proposal["prepared_attempt"] == ATTEMPT)
        self.report = dict(
            resources_created=False,
            launch_attempted=False,
            setup_completed=False,
            stop_attempted=False,
            stopped_verified=False,
            stop_verification_unresolved=False,
            resource_deletion_performed=False,
            disk_deletion_requested=False,
            stop_not_terminate_policy=True,
            host_admitted=False,
            gate_5_complete=False,
            real_4b_import=False,
            execution_permitted=False,
            retry_allowed=False,
        )
        self.written = 0

    def save(self, name, value):
        raw = connection.canonical(value)
        need(self.written + len(raw) <= 131072)
        self.written += len(raw)
        INPUTS.write(self.output / name, raw)

    def cli(self, service, operation, **fields):
        need((service, operation) in READS | WRITES and self.calls < MAX_CALLS)
        need(self.deadline - self.clock() > 21)
        self.calls += 1
        if (service, operation) in WRITES:
            # Distinct group rules are separate operations, never retries.
            key = (operation, fields.get("GroupId", fields.get("GroupName", "")))
            need(key not in self.mutations)
            self.mutations.add(key)
            self.save(
                f"mutation-{len(self.mutations):02d}.json",
                dict(
                    operation=operation,
                    attempt=ATTEMPT,
                    target=fields.get("GroupId", ""),
                    started=True,
                ),
            )
        return self.cloud.cli(service, operation, **fields)

    def preflight(self):
        need(self.cli("sts", "get-caller-identity")["Account"] == self.host["account"])
        image = connection.one(
            self.cli("ec2", "describe-images", ImageIds=[self.host["ami"]])["Images"]
        )
        need(
            all(
                image[k] == v
                for k, v in (
                    ("ImageId", self.host["ami"]),
                    ("OwnerId", self.host["ami_owner"]),
                    ("Architecture", self.host["architecture"]),
                    ("State", "available"),
                    ("RootDeviceName", "/dev/sda1"),
                    ("RootDeviceType", "ebs"),
                )
            )
        )
        connection.image_root_mapping(image)
        subnet = connection.one(
            self.cli("ec2", "describe-subnets", SubnetIds=[self.host["subnet"]])["Subnets"]
        )
        need(
            all(
                subnet[k] == v
                for k, v in (
                    ("SubnetId", self.host["subnet"]),
                    ("VpcId", self.host["vpc"]),
                    ("OwnerId", self.host["account"]),
                    ("AvailabilityZone", self.host["availability_zone"]),
                    ("State", "available"),
                )
            )
        )
        need(subnet.get("AssignIpv6AddressOnCreation") is False)
        connection.read_route(self, self.proposal)  # No NAT/IGW creation fallback.

    def create_group(self, role):
        name = "lumi-fullsize-" + ATTEMPT + "-" + role
        value = self.cli(
            "ec2",
            "create-security-group",
            Description="Lumi isolated fullsize " + role,
            GroupName=name,
            VpcId=self.host["vpc"],
            TagSpecifications=tag_spec("security-group"),
        )
        group = value["GroupId"]
        need(type(group) is str and re.fullmatch(r"sg-[0-9a-f]{17}", group))
        self.binding[role + "_group"] = group
        self.save(role + "-group.json", {"group": group})
        observed = connection.one(
            self.cli("ec2", "describe-security-groups", GroupIds=[group])["SecurityGroups"]
        )
        need(observed["GroupId"] == group and observed["GroupName"] == name)
        need(observed["OwnerId"] == self.host["account"] and observed["VpcId"] == self.host["vpc"])
        connection.owned(observed, ATTEMPT)
        need(not observed["IpPermissions"])
        egress = observed["IpPermissionsEgress"]
        # Revoke only the fresh owned group's exact default rules.
        need(type(egress) is list and 1 <= len(egress) <= 2)
        for rule in egress:
            need(
                rule["IpProtocol"] == "-1"
                and not rule.get("UserIdGroupPairs")
                and not rule.get("PrefixListIds")
            )
            need(all(r.get("CidrIp") == "0.0.0.0/0" for r in rule.get("IpRanges", [])))
            need(all(r.get("CidrIpv6") == "::/0" for r in rule.get("Ipv6Ranges", [])))
        self.cli("ec2", "revoke-security-group-egress", GroupId=group, IpPermissions=egress)
        return group

    def resources(self):
        vm = self.create_group("vm")
        endpoint = self.create_group("endpoint")
        need(vm != endpoint)
        self.cli("ec2", "authorize-security-group-egress", GroupId=vm, IpPermissions=[HTTPS])
        self.cli(
            "ec2",
            "authorize-security-group-egress",
            GroupId=endpoint,
            IpPermissions=[group_rule(vm, self.host["account"])],
        )
        self.cli(
            "ec2",
            "authorize-security-group-ingress",
            GroupId=vm,
            IpPermissions=[group_rule(endpoint, self.host["account"])],
        )
        groups = self.cli("ec2", "describe-security-groups", GroupIds=[vm, endpoint])[
            "SecurityGroups"
        ]
        need(len(groups) == 2 and {g["GroupId"] for g in groups} == {vm, endpoint})
        for group in groups:
            connection.owned(group, ATTEMPT)
            need(group["OwnerId"] == self.host["account"] and group["VpcId"] == self.host["vpc"])
            is_vm = group["GroupId"] == vm
            rules_equal(
                group["IpPermissions"],
                [group_rule(endpoint, self.host["account"])] if is_vm else [],
            )
            rules_equal(
                group["IpPermissionsEgress"],
                [HTTPS] if is_vm else [group_rule(vm, self.host["account"])],
            )
        key = self.output / "connection-key"
        material = public_key(fresh_key(key))
        created = self.cli(
            "ec2",
            "import-key-pair",
            KeyName=self.binding["key_name"],
            PublicKeyMaterial=material,
            TagSpecifications=tag_spec("key-pair"),
        )
        need(created["KeyName"] == self.binding["key_name"])
        row = connection.one(
            self.cli(
                "ec2",
                "describe-key-pairs",
                KeyNames=[self.binding["key_name"]],
                IncludePublicKey=True,
            )["KeyPairs"]
        )
        need(row["KeyName"] == self.binding["key_name"] and row["KeyType"] == "ed25519")
        need(
            row["KeyPairId"] == created["KeyPairId"]
            and public_key(row["PublicKey"].encode()) == material
        )
        connection.owned(row, ATTEMPT)
        created = self.cli(
            "ec2",
            "create-instance-connect-endpoint",
            SubnetId=self.host["subnet"],
            SecurityGroupIds=[endpoint],
            PreserveClientIp=False,
            IpAddressType="ipv4",
            ClientToken=ATTEMPT,
            TagSpecifications=tag_spec("instance-connect-endpoint"),
        )
        endpoint_id = created["InstanceConnectEndpoint"]["InstanceConnectEndpointId"]
        need(type(endpoint_id) is str and re.fullmatch(r"eice-[0-9a-f]{17}", endpoint_id))
        self.binding["endpoint"] = endpoint_id
        self.save("endpoint.json", {"endpoint": endpoint_id})
        for _ in range(40):
            row = connection.one(
                self.cli(
                    "ec2",
                    "describe-instance-connect-endpoints",
                    InstanceConnectEndpointIds=[endpoint_id],
                )["InstanceConnectEndpoints"]
            )
            need(
                row["InstanceConnectEndpointId"] == endpoint_id and row["VpcId"] == self.host["vpc"]
            )
            need(row["SubnetId"] == self.host["subnet"] and row["SecurityGroupIds"] == [endpoint])
            need(row["PreserveClientIp"] is False)
            connection.owned(row, ATTEMPT)
            if row["State"] == "create-complete":
                break
            need(row["State"] == "create-in-progress" and self.clock() - self.started < 550)
            self.sleep(5)
        else:
            need(False)
        self.report["resources_created"] = True
        return key

    def instance(self, *, reconcile=False):
        fields = (
            {"Filters": [dict(Name="client-token", Values=[ATTEMPT])], "MaxResults": 5}
            if reconcile or "instance" not in self.binding
            else {"InstanceIds": [self.binding["instance"]]}
        )
        value = self.cli("ec2", "describe-instances", **fields)
        need(not value.get("NextToken"))
        rows = value["Reservations"]
        if rows == []:
            return None
        reservation = connection.one(rows)
        need(reservation["OwnerId"] == self.host["account"])
        row = connection.one(reservation["Instances"])
        instance = row["InstanceId"]
        need(type(instance) is str and re.fullmatch(r"i-[0-9a-f]{17}", instance))
        if "instance" in self.binding:
            need(instance == self.binding["instance"])
        need(row["ClientToken"] == ATTEMPT and row["ImageId"] == self.host["ami"])
        need(row["InstanceType"] == self.host["instance_type"] and row["VpcId"] == self.host["vpc"])
        need(row["SubnetId"] == self.host["subnet"] and row["KeyName"] == self.binding["key_name"])
        connection.owned(row, ATTEMPT)
        self.binding["instance"] = instance
        return row

    def launch_and_wait(self):
        need(self.clock() - self.started < 600)
        payload = initial.user_data()
        request = connection.launch_request(self.binding)
        self.boot_control_charge = len(payload) + len(connection.canonical(request))
        need(0 < self.boot_control_charge < CAP)
        self.launch_clock = self.clock()
        started = self.utcnow().isoformat()
        self.save(
            "launch-started.json",
            dict(
                attempt=ATTEMPT,
                request=request,
                request_sha256=hashlib.sha256(connection.canonical(request)).hexdigest(),
                user_data_sha256=hashlib.sha256(payload).hexdigest(),
                user_data_bytes=len(payload),
                started_at=started,
            ),
        )
        self.launched = self.report["launch_attempted"] = True
        value = self.cli("ec2", "run-instances", **request, UserData=payload)
        instance = connection.one(value["Instances"])["InstanceId"]
        need(type(instance) is str and re.fullmatch(r"i-[0-9a-f]{17}", instance))
        self.binding["instance"] = instance
        self.launch = dict(
            attempt=ATTEMPT,
            instance=instance,
            client_token=ATTEMPT,
            request=request,
            request_sha256=hashlib.sha256(connection.canonical(request)).hexdigest(),
            started_at=started,
            acknowledged_at=self.utcnow().isoformat(),
        )
        self.save("launch.json", self.launch)
        for _ in range(60):
            need(self.clock() - self.launch_clock < 900 and self.deadline - self.clock() > 330)
            row = self.instance()
            if row is not None:
                need(row["State"]["Name"] in {"pending", "running"})
                if row["State"]["Name"] == "running":
                    health = self.cli("ec2", "describe-instance-status", InstanceIds=[instance])
                    statuses = health["InstanceStatuses"]
                    if statuses:
                        status = connection.one(statuses)
                        need(status["InstanceId"] == instance)
                        if (
                            status["InstanceStatus"]["Status"]
                            == status["SystemStatus"]["Status"]
                            == "ok"
                        ):
                            mapping = {
                                r["DeviceName"]: r["Ebs"] for r in row["BlockDeviceMappings"]
                            }
                            need(
                                len(row["BlockDeviceMappings"]) == 2
                                and set(mapping) == {"/dev/sda1", "/dev/sdf"}
                            )
                            need(all(r["DeleteOnTermination"] is False for r in mapping.values()))
                            self.binding.update(
                                root_volume=mapping["/dev/sda1"]["VolumeId"],
                                work_volume=mapping["/dev/sdf"]["VolumeId"],
                            )
                            connection.targets(self.binding, self.proposal)
                            connection.validate_launch(self.launch, self.binding)
                            self.save("binding.json", self.binding)
                            return
            self.sleep(5)
        need(False)

    def stop_failed_launch(self):
        # Separate reserve, including calls reserved independently of normal work.
        # Only reads may repeat. STOP itself has one application/SDK attempt.
        self.deadline = self.clock() + 300
        self.report["pre_stop_cloud_calls"] = self.calls
        self.calls = 0
        try:
            for _ in range(30):
                row = self.instance(reconcile=True)
                if row is None:
                    self.sleep(5)
                    continue
                state = row["State"]["Name"]
                if state == "stopped":
                    self.report["stopped_verified"] = True
                    return
                need(state in {"pending", "running", "stopping"})
                if state == "running" and not self.report["stop_attempted"]:
                    self.report["stop_attempted"] = True
                    try:
                        self.cli(
                            "ec2",
                            "stop-instances",
                            InstanceIds=[self.binding["instance"]],
                            Force=False,
                            Hibernate=False,
                        )
                    except BaseException:
                        pass  # Ambiguous STOP is observed, never retried.
                self.sleep(5)
        except BaseException:
            pass
        finally:
            self.report["stop_verification_unresolved"] = not self.report["stopped_verified"]
            self.report["stop_observation_cloud_calls"] = self.calls


def _provision_and_setup_admitted_once(
    output, *, cloud, clock=time.monotonic, sleep=time.sleep, utcnow=lambda: dt.datetime.now(dt.UTC)
):
    need(type(clock()) in {int, float} and math.isfinite(clock()))
    need(PINS)
    for name, digest in PINS.items():
        need(hashlib.sha256(INPUTS.read(ROOT / "scripts" / name, 131072)).hexdigest() == digest)
    initial.source_bytes()
    setup.delivery.source_bytes()
    connection.safe_path(output)
    output.mkdir(mode=0o700, exist_ok=False)
    INPUTS.sync(output.parent)
    transaction = Transaction(output, cloud, clock, sleep, utcnow)
    transaction.save("started.json", transaction.report)
    stage = "preflight"
    try:
        transaction.preflight()
        stage = "resources"
        key = transaction.resources()
        stage = "launch"
        transaction.launch_and_wait()
        stage = "setup"
        # Reserve 60 seconds against the launch-relative host deadline. The
        # native proof then derives boottime without granting another 4 hours.
        result = setup._prepare_and_setup_admitted_once(
            transaction.binding,
            key,
            output / "host-setup",
            transaction.launch,
            cloud=transaction,
            deadline=transaction.deadline - 30,
            launch_monotonic=transaction.launch_clock,
            host_deadline_monotonic=transaction.launch_clock + 14400,
            remaining_control_bytes=CAP - transaction.boot_control_charge,
            clock=clock,
            sleep=sleep,
        )
        need(result["setup_completed"] is True and result["initial_boot_timers_verified"] is True)
        transaction.report["setup_completed"] = True
        transaction.report["total_control_content_bytes_charged"] = (
            transaction.boot_control_charge + result["total_control_content_bytes_charged"]
        )
        need(transaction.report["total_control_content_bytes_charged"] <= CAP)
        transaction.report["next_required"] = "native_admission_and_full_lifecycle_binding"
        transaction.save("result.json", transaction.report)
    except BaseException:
        transaction.report["failed_stage"] = stage
        if transaction.launched:
            transaction.stop_failed_launch()
        try:
            name = "failure.json" if os.path.lexists(output / "result.json") else "result.json"
            transaction.save(name, transaction.report)
        except BaseException:
            pass  # Evidence-write failure must not prevent STOP or leak exception text.
        raise ValueError("fresh_provisioning_failed") from None
    return dict(
        report=transaction.report,
        binding=transaction.binding,
        launch_monotonic=transaction.launch_clock,
        host_deadline_monotonic=transaction.launch_clock + 14400,
    )


def run(**_arguments):
    raise ValueError("fullsize_host_admission_not_bound") from None
