"""Private controller-side exact-source issuer for an already admitted delivery.

No CLI; public entry is closed. Does not authenticate/admit a remote host. A
future host-bound controller must provide the private delivery callback, which
must return only after its workflow finishes/stops. Never pass root credentials
to that callback. Not included in the frozen full-size source release yet.
"""

from __future__ import annotations

import datetime as dt
import hashlib
import re
import resource
import time
import uuid

import prepare_sft_vm_acquisition_permissions_v2 as permissions

base = permissions.issuer.base
SESSION_POLICY = {
    "Version": "2012-10-17",
    "Statement": [
        {"Effect": "Allow", "Action": "s3:GetObject", "Resource": "*"},
        {"Effect": "Deny", "NotAction": "s3:GetObject", "Resource": "*"},
    ],
}
PATH = "/lumi/temporary/"
POLICY = "ExactSourceRead"
USER_POLICY = "OnlyAcquisitionRole"


def need(value):
    if not value:
        raise ValueError("acquisition_issuer_rejected") from None


class Cloud(permissions.issuer.Cloud):
    def issue_source_session(self, key, role_arn):
        import botocore.config
        import botocore.session

        need(hashlib.sha256(base.CA.read_bytes()).hexdigest() == base.CA_SHA)
        need(len(base.compact(SESSION_POLICY)) <= 2048)
        client = botocore.session.Session().create_client(
            "sts",
            region_name=base.REGION,
            endpoint_url="https://sts.us-east-1.amazonaws.com",
            aws_access_key_id=key["AccessKeyId"],
            aws_secret_access_key=key["SecretAccessKey"],
            aws_session_token=None,
            verify=str(base.CA),
            config=botocore.config.Config(
                connect_timeout=10,
                read_timeout=15,
                retries={"total_max_attempts": 1},
                proxies={},
                ignore_configured_endpoint_urls=True,
            ),
        )
        try:
            return client.assume_role(
                RoleArn=role_arn,
                RoleSessionName="lumi-source-acquisition",
                DurationSeconds=7200,
                Policy=base.compact(SESSION_POLICY),
            )["Credentials"]
        finally:
            client.close()


def _owned(cloud, kind, name, owner, expected_id=None):
    try:
        value = cloud.cli("iam", "get-" + kind, **{kind.title() + "Name": name})[kind.title()]
    except base.CloudError as error:
        if str(error) == "absent":
            return None
        raise
    tags = {item["Key"]: item["Value"] for item in value.get("Tags", [])}
    need(
        value["Arn"] == f"arn:aws:iam::{base.ACCOUNT}:{kind}{PATH}{name}"
        and value["Path"] == PATH
        and tags.get("LumiOwnerNonce") == owner
    )
    if expected_id is not None:
        need(value[kind.title() + "Id"] == expected_id)
    return value


def _remove_owned(cloud, name, owner, attempted, ids):
    """Never delete a preexisting/changed owner. No cleanup retries in this call."""
    errors = []
    for kind in ("user", "role"):
        if kind not in attempted:
            continue
        try:
            value = _owned(cloud, kind, name, owner, ids.get(kind))
            if value is None:
                continue
            if kind == "user":
                keys = cloud.cli("iam", "list-access-keys", UserName=name)
                need(not keys.get("IsTruncated", False))
                for key in keys["AccessKeyMetadata"]:
                    cloud.cli(
                        "iam", "delete-access-key", UserName=name, AccessKeyId=key["AccessKeyId"]
                    )
                try:
                    cloud.cli("iam", "delete-user-policy", UserName=name, PolicyName=USER_POLICY)
                except base.CloudError as error:
                    if str(error) != "absent":
                        raise
                cloud.cli("iam", "delete-user", UserName=name)
            else:
                # Remove the allow first. Readback is control-plane evidence,
                # NOT a claim that AWS propagation/session revocation is instant.
                cloud.cli(
                    "iam",
                    "put-role-policy",
                    RoleName=name,
                    PolicyName=POLICY,
                    PolicyDocument=base.compact(base.DENY),
                )
                readback = cloud.cli("iam", "get-role-policy", RoleName=name, PolicyName=POLICY)
                need(readback["PolicyDocument"] == base.DENY)
                cloud.cli("iam", "delete-role-policy", RoleName=name, PolicyName=POLICY)
                cloud.cli("iam", "delete-role", RoleName=name)
            need(cloud.absent(kind, name))
        except BaseException:
            errors.append(kind)
    return errors


def _credential_body(credentials, policy_expiry, now):
    need(
        type(credentials) is dict
        and set(credentials) == {"AccessKeyId", "SecretAccessKey", "SessionToken", "Expiration"}
    )
    expiry = credentials["Expiration"]
    need(isinstance(expiry, dt.datetime) and expiry.utcoffset() == dt.timedelta(0))
    need(3675 <= (expiry - now).total_seconds() <= 7200)
    need((policy_expiry - now).total_seconds() >= 3675)
    need(credentials["AccessKeyId"].startswith("ASIA"))
    for name in ("AccessKeyId", "SecretAccessKey", "SessionToken"):
        value = credentials[name]
        need(
            type(value) is str
            and 1 <= len(value) <= 16384
            and all(32 < ord(c) < 127 for c in value)
        )
    body = bytearray(base.compact(credentials | {"Expiration": expiry.isoformat()}).encode())
    need(len(body) <= 65536)
    return body


def run(**_arguments):
    raise ValueError("host_guard_not_bound") from None


def _run_for_admitted_delivery(
    selection_raw,
    attempt,
    output,
    deliver,
    *,
    cloud=None,
    now=lambda: dt.datetime.now(dt.UTC),
    wait=time.sleep,
):
    """Private injection point, not authentication via a boolean approval flag.

    Caller must have independently admitted the host and authenticated the
    delivery channel before entry. This module cannot make that assertion.
    Output must be a fresh attempt directory under the controller's private root.
    """
    need(type(attempt) is str and re.fullmatch(r"[0-9a-f]{32}", attempt) and callable(deliver))
    policy, _arns, policy_expiry = permissions.build(selection_raw, now())
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    output.mkdir(mode=0o700, parents=False, exist_ok=False)
    cloud = Cloud() if cloud is None else cloud
    name = "lumi-acquire-" + attempt
    owner = uuid.uuid4().hex
    base.save(
        output / "started.json",
        {
            "attempt": attempt,
            "name": name,
            "owner_nonce": owner,
            "selection_sha256": permissions.SELECTION_SHA,
            "policy_sha256": hashlib.sha256(base.compact(policy).encode()).hexdigest(),
            "source_policy_expires_at": policy_expiry.isoformat(),
            "retry_allowed": False,
        },
    )
    report = {
        "schema": "lumi-acquisition-issuer.v0.1",
        "session_issued": False,
        "delivery_returned": False,
        "long_term_key_removed_before_delivery": False,
        "cleanup_verified": False,
        "host_admitted_here": False,
        "real_4b_import": False,
        "gate_5_complete": False,
        "production_eligible": False,
        "credential_contents_retained": False,
        "immediate_session_revocation_claimed": False,
    }
    stage, attempted, ids = "identity", set(), {}
    credentials = key = body = None
    try:
        identity = cloud.cli("sts", "get-caller-identity")
        need(identity.get("Account") == base.ACCOUNT)
        need(cloud.absent("user", name) and cloud.absent("role", name))
        tags = [{"Key": "LumiOwnerNonce", "Value": owner}]
        stage = "create_user"
        attempted.add("user")
        value = cloud.cli("iam", "create-user", UserName=name, Path=PATH, Tags=tags)["User"]
        ids["user"] = value["UserId"]
        user = _owned(cloud, "user", name, owner, ids["user"])
        need(user is not None)
        role_arn = f"arn:aws:iam::{base.ACCOUNT}:role{PATH}{name}"
        cutoff = (now() + dt.timedelta(minutes=15)).isoformat()
        trust = {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Effect": "Allow",
                    "Principal": {"AWS": f"arn:aws:iam::{base.ACCOUNT}:root"},
                    "Action": "sts:AssumeRole",
                    "Condition": {
                        "ArnEquals": {"aws:PrincipalArn": user["Arn"]},
                        "DateLessThan": {"aws:CurrentTime": cutoff},
                    },
                }
            ],
        }
        stage = "create_role"
        attempted.add("role")
        value = cloud.cli(
            "iam",
            "create-role",
            RoleName=name,
            Path=PATH,
            Tags=tags,
            AssumeRolePolicyDocument=base.compact(trust),
            MaxSessionDuration=7200,
        )["Role"]
        ids["role"] = value["RoleId"]
        user_policy = {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Effect": "Allow",
                    "Action": "sts:AssumeRole",
                    "Resource": role_arn,
                    "Condition": {"DateLessThan": {"aws:CurrentTime": cutoff}},
                },
                {"Effect": "Deny", "NotAction": "sts:AssumeRole", "Resource": "*"},
                {"Effect": "Deny", "Action": "sts:AssumeRole", "NotResource": role_arn},
            ],
        }
        stage = "policy_readback"
        cloud.cli(
            "iam",
            "put-role-policy",
            RoleName=name,
            PolicyName=POLICY,
            PolicyDocument=base.compact(policy),
        )
        cloud.cli(
            "iam",
            "put-user-policy",
            UserName=name,
            PolicyName=USER_POLICY,
            PolicyDocument=base.compact(user_policy),
        )
        role = _owned(cloud, "role", name, owner, ids["role"])
        need(
            role is not None
            and role["MaxSessionDuration"] == 7200
            and role["AssumeRolePolicyDocument"] == trust
        )
        need(
            cloud.cli("iam", "get-role-policy", RoleName=name, PolicyName=POLICY)["PolicyDocument"]
            == policy
        )
        need(
            cloud.cli("iam", "get-user-policy", UserName=name, PolicyName=USER_POLICY)[
                "PolicyDocument"
            ]
            == user_policy
        )
        stage = "issue"
        key = cloud.cli("iam", "create-access-key", UserName=name)["AccessKey"]
        wait(15)
        need(now() < dt.datetime.fromisoformat(cutoff))
        credentials = cloud.issue_source_session(key, role_arn)
        report["session_issued"] = True
        stage = "remove_long_term_key"
        need(_owned(cloud, "user", name, owner, ids["user"]) is not None)
        cloud.cli("iam", "delete-access-key", UserName=name, AccessKeyId=key["AccessKeyId"])
        key = None
        inventory = cloud.cli("iam", "list-access-keys", UserName=name)
        need(inventory["AccessKeyMetadata"] == [] and not inventory.get("IsTruncated", False))
        report["long_term_key_removed_before_delivery"] = True
        stage = "deliver"
        # Recheck after STS/propagation wait as well, not just before key creation.
        role = _owned(cloud, "role", name, owner, ids["role"])
        need(role is not None and role["AssumeRolePolicyDocument"] == trust)
        need(
            cloud.cli("iam", "get-role-policy", RoleName=name, PolicyName=POLICY)["PolicyDocument"]
            == policy
        )
        body = _credential_body(credentials, policy_expiry, now())
        credentials = None
        deliver(body)  # Body only: no root profile, user key or IAM control API.
        report["delivery_returned"] = True
    except BaseException:
        report["failed_stage"] = stage
    finally:
        if body is not None:
            body[:] = b"\0" * len(body)
        key = credentials = None  # Python/OS copies are not securely erased.
        errors = _remove_owned(cloud, name, owner, attempted, ids)
        report["cleanup_errors"] = errors
        report["cleanup_verified"] = bool(attempted) and not errors
        base.save(output / "result.json", report)
    return report
