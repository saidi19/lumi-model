"""Independent cost-resource cleanup worker; no deployment or launch authority.

Only the nonce-tagged NAT and EIP can be changed. Shared, conditional S3 claims
prevent controller/expiry/duplicate deliveries repeating an ambiguous mutation.
Claim-before-dispatch deliberately sacrifices automatic recovery if a worker
dies between those operations. Never delete claims to retry. Live admission
must verify their retention, access policy, and the independently armed timer.
"""

import json
import math
import os
import re
import time

ACCOUNT = "573978149073"
REGION = "us-east-1"
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
VPC = "vpc-0905fbf9490a2dead"
SUBNET = "subnet-0dc6039a6453f7c95"
BUCKET = "lumi-corpus-prod-27777c02b29b76efcac3"
PREFIX = "lumi-corpus/v0.1/control/sft-import-research/" + ATTEMPT + "/network-cleanup/"
OPERATIONS = {
    "delete-nat-gateway": ("NatGatewayId", "nat"),
    "release-address": ("AllocationId", "eipalloc"),
}


def need(value):
    if not value:
        raise ValueError("network_cleanup_rejected") from None


def nonce(value):
    need(type(value) is str and re.fullmatch("[0-9a-f]{32}", value))
    return value


def unique(pairs):
    result = {}
    for key, value in pairs:
        need(key not in result)
        result[key] = value
    return result


def binding(raw):
    need(type(raw) is str and 0 < len(raw) <= 2048)
    value = json.loads(raw, object_pairs_hook=unique)
    need(type(value) is dict)
    if value == {"armed": False}:
        need(value["armed"] is False)
        return value
    need(set(value) == {"armed", "attempt", "nonce", "not_before", "expires_at"})
    need(value["armed"] is True and value["attempt"] == ATTEMPT)
    nonce(value["nonce"])
    start, end = value["not_before"], value["expires_at"]
    need(type(start) is int and type(end) is int and 0 < start < end <= start + 900)
    return value


def claim_key(token, operation):
    nonce(token)
    need(operation in OPERATIONS)
    return PREFIX + token + "/" + operation + ".json"


class Claims:
    """At most one claim attempt for each of the two operations per instance.

    Different processes contend on the same two immutable keys. Success means
    only that this process may send the mutation once, not that it completed.
    No read/list/delete/overwrite of S3 objects is implemented.
    """

    def __init__(self, s3, token):
        self.s3, self.token, self.attempted = s3, nonce(token), set()

    def take(self, operation, identifier):
        need(operation in OPERATIONS)
        prefix = OPERATIONS[operation][1]
        need(type(identifier) is str and re.fullmatch(prefix + "-[0-9a-f]{17}", identifier))
        if operation in self.attempted:
            return False
        self.attempted.add(operation)
        raw = json.dumps(
            dict(attempt=ATTEMPT, nonce=self.token, operation=operation, resource=identifier),
            sort_keys=True,
        ).encode()
        need(len(raw) <= 512)
        try:
            answer = self.s3.put_object(
                Bucket=BUCKET,
                Key=claim_key(self.token, operation),
                Body=raw,
                ContentLength=len(raw),
                ContentType="application/json",
                IfNoneMatch="*",
                ServerSideEncryption="AES256",
                ExpectedBucketOwner=ACCOUNT,
            )
            return answer.get("ResponseMetadata", {}).get("HTTPStatusCode") == 200
        except Exception:
            return False  # Includes 412, 409 and lost acknowledgement. Never retry.


def owned(row, kind, token):
    need(type(row) is dict)
    for name, wanted in (("LumiAttempt", ATTEMPT), ("LumiNetworkNonce", nonce(token))):
        tags = [t for t in row.get("Tags", []) if t.get("Key") == name]
        need(tags == [{"Key": name, "Value": wanted}])
    field, prefix = OPERATIONS["delete-nat-gateway" if kind == "nat" else "release-address"]
    identifier = row.get(field)
    need(type(identifier) is str and re.fullmatch(prefix + "-[0-9a-f]{17}", identifier))
    if kind == "nat":
        need(row.get("VpcId") == VPC and row.get("SubnetId") == SUBNET)
        need(row.get("ConnectivityType") == "public")
        need(row.get("AvailabilityMode", "zonal") == "zonal")
        need(row.get("State") in {"pending", "available", "failed", "deleting", "deleted"})
        addresses = row.get("NatGatewayAddresses", [])
        need(type(addresses) is list and len(addresses) <= 1)
        if addresses:
            need(re.fullmatch("eipalloc-[0-9a-f]{17}", addresses[0].get("AllocationId", "")))
        else:
            need(row["State"] in {"pending", "failed", "deleting", "deleted"})
    else:
        need(kind == "address" and row.get("Domain") == "vpc")
        need(row.get("NetworkBorderGroup") == REGION)
    return identifier


def result():
    return dict(
        stage="rejected",
        reads=0,
        nat_delete_sent=False,
        eip_release_sent=False,
        nat_deleted_observed=False,
        eip_absent_observed=False,
        cost_resources_released=False,
        claim_unavailable=False,
        gate_5_complete=False,
        model_data_access=False,
    )


def observe(bound, ec2, claims, context, *, clock=time.time, wait=time.sleep):
    """Bounded discovery handles lost create acknowledgements and late visibility.

    Empty tag reads alone never establish successful cleanup. The worker never
    touches instances, ENIs, routes, subnets or disks. An EIP must be unassociated
    and any visible NAT deleted before release. AWS is still best-effort.
    """
    report = result()
    seen, allocation = {}, None
    try:
        bound = binding(json.dumps(bound))
        need(bound["armed"] and claims.token == bound["nonce"])
        filters = [
            dict(Name="tag:LumiAttempt", Values=[ATTEMPT]),
            dict(Name="tag:LumiNetworkNonce", Values=[bound["nonce"]]),
        ]

        def active():
            now = clock()
            need(math.isfinite(now) and bound["not_before"] <= now < bound["expires_at"] - 25)
            need(context.get_remaining_time_in_millis() > 25000)

        def rows(kind):
            active()
            report["reads"] += 1
            try:
                if kind == "nat":
                    fields = (
                        {"NatGatewayIds": [seen[kind]]}
                        if kind in seen
                        else {"Filter": filters, "MaxResults": 5}
                    )
                    response = ec2.describe_nat_gateways(**fields)
                    key = "NatGateways"
                else:
                    fields = (
                        {"AllocationIds": [seen[kind]]} if kind in seen else {"Filters": filters}
                    )
                    response = ec2.describe_addresses(**fields)
                    key = "Addresses"
            except Exception as error:
                code = getattr(error, "response", {}).get("Error", {}).get("Code")
                absent = "NatGatewayNotFound" if kind == "nat" else "InvalidAllocationID.NotFound"
                if kind in seen and code == absent:
                    return None
                raise
            need(type(response) is dict and not response.get("NextToken"))
            need(len(json.dumps(response, default=str)) <= 262144)
            values = response[key]
            need(type(values) is list and len(values) <= 1)
            if not values:
                return None
            row = values[0]
            identifier = owned(row, kind, bound["nonce"])
            need(kind not in seen or seen[kind] == identifier)
            seen[kind] = identifier
            return row

        def send(operation, identifier):
            active()
            if operation in claims.attempted:
                return
            if not claims.take(operation, identifier):
                report["claim_unavailable"] = True
                return
            active()  # A slow or uncertain claim must not extend the expiry.
            key = "nat_delete_sent" if operation == "delete-nat-gateway" else "eip_release_sent"
            report[key] = True
            try:
                getattr(ec2, operation.replace("-", "_"))(**{OPERATIONS[operation][0]: identifier})
            except Exception:
                pass  # Observe the outcome; never dispatch this operation twice.

        for _ in range(72):
            nat, address = rows("nat"), rows("address")
            active()  # Late readback is not a successful within-window verification.
            delete_ready = True
            if nat and nat.get("NatGatewayAddresses"):
                current = nat["NatGatewayAddresses"][0]["AllocationId"]
                need(allocation is None or allocation == current)
                allocation = current
                if nat["State"] not in {"deleting", "deleted"}:
                    delete_ready = address is not None  # Wait for eventual EIP visibility.
            if address and allocation:
                need(address["AllocationId"] == allocation)
            nat_gone = (nat is not None and nat["State"] == "deleted") or (
                nat is None and "nat" in seen
            )
            # Keep looking if a create is not yet visible. Do not report absence
            # as completion, even if this invocation safely releases an orphan EIP.
            if nat and delete_ready and nat["State"] not in {"deleting", "deleted"}:
                send("delete-nat-gateway", nat["NatGatewayId"])
            if address and (nat_gone or nat is None):
                if not address.get("AssociationId") and not address.get("NetworkInterfaceId"):
                    send("release-address", address["AllocationId"])
            report["nat_deleted_observed"] = nat_gone
            report["eip_absent_observed"] = address is None and "address" in seen
            if nat_gone and report["eip_absent_observed"]:
                report.update(stage="released_verified", cost_resources_released=True)
                return report
            wait(10)
        report["stage"] = "cleanup_unconfirmed"
    except Exception:
        report["stage"] = "cleanup_rejected"
    return report


def handler(event, context):
    report = result()
    clients = []
    try:
        bound = binding(os.environ.get("LUMI_NETWORK_CLEANUP_BINDING", ""))
        if not bound["armed"]:
            report["stage"] = "unarmed"
        else:
            wanted = {k: bound[k] for k in ("attempt", "nonce", "not_before", "expires_at")}
            need(type(event) is dict and event == wanted)
            need(type(event["not_before"]) is int and type(event["expires_at"]) is int)
            need(
                context.invoked_function_arn
                == f"arn:aws:lambda:{REGION}:{ACCOUNT}:function:lumi-net-{bound['nonce']}"
            )
            need(bound["not_before"] <= time.time() < bound["expires_at"] - 25)
            import boto3
            from botocore.config import Config

            for service in ("ec2", "s3"):
                clients.append(
                    boto3.client(
                        service,
                        region_name=REGION,
                        endpoint_url=f"https://{service}.{REGION}.amazonaws.com",
                        config=Config(
                            connect_timeout=3,
                            read_timeout=5,
                            retries={"total_max_attempts": 1},
                            proxies={},
                            ignore_configured_endpoint_urls=True,
                        ),
                    )
                )
            report = observe(bound, clients[0], Claims(clients[1], bound["nonce"]), context)
    except Exception:
        pass
    finally:
        for client in clients:
            try:
                client.close()
            except Exception:
                pass
    print(json.dumps(report, sort_keys=True, separators=(",", ":")))
    return report
