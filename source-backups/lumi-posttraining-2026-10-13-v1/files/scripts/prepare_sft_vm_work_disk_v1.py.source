"""Prepare only the caller's authenticated, newly created blank work EBS volume.

Private integration for a fresh dedicated Linux host, never a general formatter.
The provisioner must bind fresh no-snapshot volume creation and retained storage.
This module checks native identity/absence of use, not cloud freshness, encryption
or other-namespace writers. The armed host guard and final admission remain required.
No deletion, forced formatting, retry, import binding or public execution entry.
"""

from __future__ import annotations

import grp
import json
import math
import os
import re
import stat
import sys
from pathlib import Path

WORK = Path("/var/lib/lumi-vm-fullsize")
SYS_BLOCK = Path("/sys/class/block")
DEV = Path("/dev")
GIB = 1024**3


def need(value):
    if not value:
        raise ValueError("work_disk_preparation_rejected") from None


def unique(pairs):
    value = {}
    for key, item in pairs:
        need(key not in value)
        value[key] = item
    return value


def blank_signatures(raw):
    need(type(raw) is bytes and 0 < len(raw) <= 32768)
    value = json.loads(raw, object_pairs_hook=unique)
    need(type(value) is dict and set(value) == {"signatures"})
    need(type(value["signatures"]) is list and value["signatures"] == [])


def validate(rows, root, candidates, binding):
    need(type(binding) is dict and set(binding) == {"root_volume", "work_volume"})
    need(all(type(v) is str and re.fullmatch(r"vol-[0-9a-f]{17}", v) for v in binding.values()))
    need(binding["root_volume"] != binding["work_volume"])
    roots = [row for row in rows if row["mount"] == "/"]
    need(len(roots) == 1 and roots[0]["root"] == "/")
    need(roots[0]["fs"] in {"ext4", "xfs"} and "rw" in roots[0]["options"])
    need(root["volume"] == binding["root_volume"] and root["bytes"] == 32 * GIB)
    matches = [c for c in candidates if c["volume"] == binding["work_volume"]]
    need(len(matches) == 1)
    target = matches[0]
    need(target["bytes"] == 128 * GIB and target["disk"] != root["disk"])
    need(re.fullmatch(r"nvme[0-9]+n[0-9]+", target["disk"]))
    need(re.fullmatch(r"[0-9]+:[0-9]+", target["device"]))
    need(not target["partitions"] and not target["slaves"])
    for row in rows:
        need(row["device"] != target["device"])
        need(row["mount"] != str(WORK) and not row["mount"].startswith(str(WORK) + "/"))
    return dict(target)


def preflight(storage, binding):
    need(sys.platform == "linux" and os.geteuid() == os.getegid() == 0)
    need(os.stat("/proc/self/ns/mnt").st_ino == os.stat("/proc/1/ns/mnt").st_ino)
    need(storage.WORK == WORK)
    for path in (WORK.parent, *WORK.parent.parents):
        info = path.lstat()
        need(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022)
    need(not os.path.lexists(WORK))
    swaps = storage.small(Path("/proc/swaps"), 4096)
    need(swaps.startswith(b"Filename") and len(swaps.splitlines()) == 1)
    before = storage.small(Path("/proc/self/mountinfo"), 1024**2)
    rows = storage.mounts(before)
    roots = [row for row in rows if row["mount"] == "/"]
    need(len(roots) == 1)
    root = storage.disk_identity(roots[0]["device"])
    need(storage.device_number(Path("/")) == roots[0]["device"])
    # The root image may have partitions; the new work volume must have none.
    nodes = list(SYS_BLOCK.iterdir())
    need(len(nodes) <= 128)
    candidates = []
    for node in nodes:
        if not re.fullmatch(r"nvme[0-9]+n[0-9]+", node.name):
            continue
        device = storage.small(node / "dev").strip().decode("ascii")
        disk = storage.disk_identity(device)
        candidates.append(
            disk
            | {
                "device": device,
                "partitions": any(
                    re.fullmatch(re.escape(node.name) + r"p[0-9]+", n.name) for n in nodes
                ),
                "slaves": bool(list((node / "slaves").iterdir())),
            }
        )
    target = validate(rows, root, candidates, binding)
    path = DEV / target["disk"]
    info = path.lstat()
    need(stat.S_ISBLK(info.st_mode) and info.st_uid == 0)
    need(info.st_gid == grp.getgrnam("disk").gr_gid)
    need(stat.S_IMODE(info.st_mode) in {0o600, 0o660})
    need(f"{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}" == target["device"])
    need(storage.small(Path("/proc/self/mountinfo"), 1024**2) == before)
    return target


def _prepare_admitted_once(storage, binding, runtime, guard, output):
    """Called inside the bounded root setup unit, after its host watchdog is ready.

    runtime supplies the existing pinned bounded-command/private-receipt helpers.
    Native admission is not conferred by passing a callback or an approval flag.
    """
    start = runtime.boot_time()
    need(type(start) in {int, float} and math.isfinite(start) and 0 <= start < 1350)
    end = min(start + 120, 1470)
    target = preflight(storage, binding)
    need(not os.path.lexists(output))
    guard()
    output.mkdir(mode=0o700, exist_ok=False)
    runtime.sync(output.parent)
    phase = "signature_probe"

    def command(argv, maximum=10):
        guard()
        remaining = end - runtime.boot_time()
        need(remaining > 0)
        return runtime.command(argv, seconds=min(maximum, remaining))

    base = dict(
        host_admitted=False, binding_created=False, gate_5_complete=False, retry_allowed=False
    )
    try:
        runtime.write(output / "started.json", runtime.encode(base | {"stage": phase}))
        # Read-only probe: never wipefs -a, mkfs -F, partition, resize or discard.
        device = str(DEV / target["disk"])
        blank_signatures(command(["/usr/sbin/wipefs", "--no-act", "--json", device]))
        need(preflight(storage, binding) == target)
        phase = "format"
        runtime.write(output / "format-started.json", runtime.encode(base | {"stage": phase}))
        command(
            [
                "/usr/sbin/mkfs.ext4",
                "-q",
                "-m",
                "0",
                "-E",
                "lazy_itable_init=0,lazy_journal_init=0,nodiscard",
                device,
            ],
            maximum=90,
        )
        phase = "mount"
        WORK.mkdir(mode=0o700, exist_ok=False)
        runtime.sync(WORK.parent)
        command(
            [
                "/usr/bin/mount",
                "--no-canonicalize",
                "-t",
                "ext4",
                "-o",
                "nodev,nosuid,noatime",
                device,
                str(WORK),
            ]
        )
        command(["/usr/bin/mount", "--make-private", str(WORK)])
        # Filesystem root permissions, not only the covered mountpoint's mode.
        os.chmod(WORK, 0o700, follow_symlinks=False)
        runtime.sync(WORK)
        phase = "readback"
        guard()
        snapshot = storage.inspect(binding)
        need(runtime.boot_time() < end)
        report = base | {"work_disk_prepared": True, "storage_snapshot": snapshot}
        runtime.write(output / "result.json", runtime.encode(report))
        return report
    except BaseException:
        # No unmount, removal, second mkfs or automatic repair on partial success.
        runtime.write(
            output / "failed.json",
            runtime.encode(base | {"stage": phase, "partial_preserved": True}),
        )
        raise ValueError("work_disk_preparation_failed") from None


def run(**_arguments):
    raise ValueError("fullsize_host_admission_not_bound") from None
