"""AWS-hosted stop-only watchdog. Deployed UNARMED; no model/data access.

Activation is a separate launch-bound operation. AWS asynchronous delivery is
at-least-once: no exactly-once or hard billing-cap claim is made. Duplicate
events observe stopped/stopping state; each invocation sends at most one STOP.
"""

import datetime as dt
import json
import math
import os
import re
import time

ACCOUNT = "573978149073"
REGION = "us-east-1"
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
FUNCTION = "lumi-stop-" + ATTEMPT
AMI = "ami-0045d7fc2ad003464"
VPC = "vpc-0905fbf9490a2dead"
SUBNET = "subnet-0dc6039a6453f7c95"


def need(value):
    if not value:
        raise ValueError("watchdog_rejected")


def binding(raw):
    need(type(raw) is str and len(raw) <= 2048)
    value = json.loads(raw)
    if value == {"armed": False} and type(value["armed"]) is bool:
        return value
    need(
        type(value) is dict
        and set(value)
        == {"armed", "attempt", "launch_not_before", "launch_not_after", "stop_at", "expires_at"}
    )
    need(value["armed"] is True and value["attempt"] == ATTEMPT)
    times = [value[k] for k in ("launch_not_before", "launch_not_after", "stop_at", "expires_at")]
    need(all(type(n) is int and n > 0 for n in times))
    start, last, stop, expiry = times
    need(0 < last - start <= 300 and last < stop <= start + 14100)
    need(stop < expiry <= min(stop + 300, start + 14400))
    return value


def candidate(response, bound):
    need(type(response) is dict and not response.get("NextToken"))
    rows = response["Reservations"]
    if rows == []:
        return None
    need(len(rows) == 1 and rows[0]["OwnerId"] == ACCOUNT and len(rows[0]["Instances"]) == 1)
    row = rows[0]["Instances"][0]
    need(re.fullmatch(r"i-[0-9a-f]{17}", row["InstanceId"]) is not None)
    need(row["ClientToken"] == ATTEMPT)
    tags = [x for x in row.get("Tags", []) if x.get("Key") == "LumiAttempt"]
    need(tags == [{"Key": "LumiAttempt", "Value": ATTEMPT}])
    need(row["ImageId"] == AMI and row["InstanceType"] == "r6i.4xlarge")
    need(row["VpcId"] == VPC and row["SubnetId"] == SUBNET)
    need(row["KeyName"] == "lumi-fullsize-" + ATTEMPT)
    launched = row["LaunchTime"]
    need(isinstance(launched, dt.datetime) and launched.utcoffset() == dt.timedelta(0))
    need(bound["launch_not_before"] <= launched.timestamp() <= bound["launch_not_after"])
    volumes = row["BlockDeviceMappings"]
    need(len(volumes) == 2 and len({x["Ebs"]["VolumeId"] for x in volumes}) == 2)
    need(all(x["Ebs"]["DeleteOnTermination"] is False for x in volumes))
    need(row["State"]["Name"] in {"pending", "running", "stopping", "stopped"})
    return row


def observe_stop(bound, ec2, context, *, clock=time.time, wait=time.sleep):
    report = dict(
        stage="observe",
        stopped_verified=False,
        stop_attempted=False,
        reads=0,
        gate_5_complete=False,
        model_data_access=False,
    )
    instance = None
    try:
        for _ in range(24):
            now = clock()
            need(math.isfinite(now) and bound["stop_at"] <= now < bound["expires_at"])
            need(context.get_remaining_time_in_millis() > 15000)
            fields = (
                {"InstanceIds": [instance]}
                if instance
                else {
                    "Filters": [
                        {"Name": "client-token", "Values": [ATTEMPT]},
                        {"Name": "tag:LumiAttempt", "Values": [ATTEMPT]},
                    ],
                    "MaxResults": 5,
                }
            )
            report["reads"] += 1
            row = candidate(ec2.describe_instances(**fields), bound)
            if row is None:
                report["stage"] = "no_matching_instance"
                break
            if instance is not None:
                need(row["InstanceId"] == instance)
            instance = row["InstanceId"]
            state = row["State"]["Name"]
            if state == "stopped":
                report.update(stage="stopped_verified", stopped_verified=True)
                break
            if state == "running" and not report["stop_attempted"]:
                report["stop_attempted"] = True
                try:
                    ec2.stop_instances(InstanceIds=[instance], Force=False, Hibernate=False)
                except Exception:
                    report["stop_acknowledgement_unknown"] = True
            wait(5)
        else:
            report["stage"] = "stop_unconfirmed"
    except Exception:
        report["stage"] = "observation_rejected"
    return report


def handler(event, context):
    """Only fixed allowlisted results are logged; never cloud rows/errors/events."""
    report = dict(
        stage="rejected",
        stopped_verified=False,
        stop_attempted=False,
        reads=0,
        gate_5_complete=False,
        model_data_access=False,
    )
    try:
        value = binding(os.environ.get("LUMI_WATCHDOG_BINDING", ""))
        if value["armed"] is False:
            report["stage"] = "unarmed"
        else:
            need(
                context.invoked_function_arn
                == f"arn:aws:lambda:{REGION}:{ACCOUNT}:function:{FUNCTION}"
            )
            need(type(event) is dict and event == {"attempt": ATTEMPT, "stop_at": value["stop_at"]})
            need(type(event["stop_at"]) is int)
            need(value["stop_at"] <= time.time() < value["expires_at"])
            import boto3
            from botocore.config import Config

            client = boto3.client(
                "ec2",
                region_name=REGION,
                endpoint_url="https://ec2.us-east-1.amazonaws.com",
                config=Config(
                    connect_timeout=3,
                    read_timeout=5,
                    retries={"total_max_attempts": 1},
                    proxies={},
                    ignore_configured_endpoint_urls=True,
                ),
            )
            try:
                report = observe_stop(value, client, context)
            finally:
                client.close()
    except Exception:
        pass
    print(json.dumps(report, separators=(",", ":"), sort_keys=True))
    return report
