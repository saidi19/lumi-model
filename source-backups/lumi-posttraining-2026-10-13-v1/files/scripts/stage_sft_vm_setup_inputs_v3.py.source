DIRECTORIES = tuple(sorted({name.split("/")[0] for name in FILES}))


def need(value):
    if not value:
        raise ValueError("setup_input_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode() + b"\n"


def read(path, cap):
    need(not any(p.is_symlink() for p in (path, *path.parents)))
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1)
        need(0 < before.st_size <= cap)
        raw = stream.read(before.st_size + 1)
        after = os.fstat(stream.fileno())
    fields = (
        "st_dev",
        "st_ino",
        "st_mode",
        "st_nlink",
        "st_uid",
        "st_gid",
        "st_size",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    need(len(raw) == before.st_size)
    need(all(getattr(before, k) == getattr(after, k) for k in fields))
    return raw


def pack(members):
    output = io.BytesIO()
    with tarfile.open(fileobj=output, mode="w", format=tarfile.USTAR_FORMAT) as archive:
        for name, body in sorted(members.items()):
            item = tarfile.TarInfo(name)
            item.size, item.mode = len(body), 0o400
            archive.addfile(item, io.BytesIO(body))
    return output.getvalue()


def unpack(raw, expected):
    need(type(raw) is bytes and 0 < len(raw) <= CAP)
    need(type(expected) is str and re.fullmatch(r"[0-9a-f]{64}", expected))
    need(sha(raw) == expected)
    members = {}
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:") as archive:
        for item in archive:
            need(item.name in FILES and item.name not in members)
            need(item.type == tarfile.REGTYPE and not item.linkname and not item.pax_headers)
            need(item.mode == 0o400 and item.uid == item.gid == 0)
            _, pin, cap = FILES[item.name]
            need(0 < item.size <= cap)
            with archive.extractfile(item) as stream:
                body = stream.read(item.size + 1)
            need(len(body) == item.size and sha(body) == pin)
            members[item.name] = body
    need(set(members) == set(FILES))
    need(pack(members) == raw)  # Reject appended/hidden members and noncanonical headers.
    return members


def assemble(repo=REPO):
    members = {name: read(repo / source, cap) for name, (source, _, cap) in FILES.items()}
    raw = pack(members)
    unpack(raw, sha(raw))
    return raw


def sync(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write(path, raw):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    with os.fdopen(fd, "wb") as stream:
        need(stream.write(raw) == len(raw))
        stream.flush()
        os.fsync(stream.fileno())


def receipt(raw):
    return {
        "schema": "lumi.vm-setup-inputs.v0.3",
        "attempt": ATTEMPT,
        "archive_sha256": sha(raw),
        "archive_bytes": len(raw),
        "files": len(FILES),
        "cpu_wheels_included": False,
        "host_admitted": False,
        "binding_created": False,
        "execution_permitted": False,
        "gate_5_complete": False,
        "retry_allowed": False,
    }


def prepare(destination):
    raw = assemble()
    need(not any(p.is_symlink() for p in (destination, *destination.parents)))
    destination.mkdir(mode=0o700, exist_ok=False)
    sync(destination.parent)
    write(destination / "setup-inputs.tar", raw)
    need(read(destination / "setup-inputs.tar", CAP) == raw)
    result = receipt(raw) | {"native_staged": False, "uploaded": False}
    write(destination / "build.json", canonical(result))
    sync(destination)
    return result


def owned_directory(path):
    for p in (path, *path.parents):
        info = p.lstat()
        need(stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022)


def boundary(machine_id):
    need(sys.platform == "linux" and os.geteuid() == os.getegid() == 0)
    need(sys.version_info[:2] == (3, 12) and sys.flags.isolated and sys.dont_write_bytecode)
    need(type(machine_id) is str and re.fullmatch(r"[0-9a-f]{32}", machine_id))
    need(read(Path("/etc/machine-id"), 65).strip() == machine_id.encode())
    need(os.stat("/proc/self/ns/mnt").st_ino == os.stat("/proc/1/ns/mnt").st_ino)
    owned_directory(OPT)
    owned_directory(RECEIPTS)


def _stage_admitted_once(raw, expected, machine_id):
    boundary(machine_id)
    members = unpack(raw, expected)  # Authenticate all paths/content before any writes.
    for name in DIRECTORIES:
        need(not os.path.lexists(OPT / name))
    attempt = RECEIPTS / ATTEMPT
    attempt.mkdir(mode=0o700, exist_ok=False)  # Failure consumes the attempt.
    sync(RECEIPTS)
    try:
        write(attempt / "started.json", canonical(receipt(raw)))
        sync(attempt)
        for name in DIRECTORIES:
            (OPT / name).mkdir(mode=0o700, exist_ok=False)
            sync(OPT)
        for name, body in sorted(members.items()):
            write(OPT / name, body)
        for name, body in members.items():
            path = OPT / name
            info = path.lstat()
            need(info.st_uid == info.st_gid == 0 and stat.S_IMODE(info.st_mode) == 0o400)
            need(read(path, FILES[name][2]) == body)
        for name in DIRECTORIES:
            sync(OPT / name)
        result = receipt(raw) | {
            "staged_files_readback_match": True,
            "readonly_mounts_established": False,
        }
        write(attempt / "result.json", canonical(result))
        sync(attempt)
        return result
    except BaseException:
        write(
            attempt / "failed.json",
            canonical(
                {
                    "partial_files_preserved": True,
                    "retry_allowed": False,
                    "execution_permitted": False,
                }
            ),
        )
        sync(attempt)
        raise ValueError("setup_input_stage_failed") from None


def run(**_arguments):
    raise ValueError("host_guard_not_bound") from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepare", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = prepare(args.prepare)
    except Exception:
        print('{"status":"rejected","execution_permitted":false}')
        return 2
    print(canonical(result).decode(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
