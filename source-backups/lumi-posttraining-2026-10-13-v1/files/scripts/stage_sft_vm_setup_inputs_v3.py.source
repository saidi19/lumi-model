"""Prepare and stage the exact existing setup controls, without running them.

No SSH, downloader, mount, runtime install, model access or execution binding.
The private native staging call belongs to a future authenticated bootstrap.
Version 3 binds the qualified policy and its bootstrap successor; no execution grant.
CPU wheels are deliberately separate from the 32 MiB control-upload allowance.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import stat
import sys
import tarfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
OPT = Path("/opt")
RECEIPTS = Path("/var/lib/lumi-vm-input-deployment")
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
CAP = 32 * 1024**2
SMALL = 131072
SDK_INSTALL = "0326195c9ca27b98471699d85571d1f85ef2f7f8fc1282e58004ac01738aa38c"
# Destination relative to /opt -> existing repository source, frozen SHA, size cap.
FILES = {
