"""Selector-corrected attempt-018 read-only admission preflight."""

import hashlib
import importlib
import importlib.util
import json
import sys
from pathlib import Path

from scripts import preflight_sft_vm_attempt017_v1 as qualified
from scripts import prepare_sft_vm_deployment_bindings_v13 as bindings

ROOT = Path(__file__).resolve().parents[1]
QUALIFIED_SHA = "939363befa790b34537feffd7c9c0e1f992de643678402e4baa6b0faf6633745"
BINDINGS_SHA = "188232d67a5ec00cace0fe6104d2c957e44ae8b365e3ba2a9c04410e17f27894"
FAILURE = ROOT / "evidence/lumi-vm-attempt-018-readonly-preflight-failure-v0.2.json"
FAILURE_SHA = "6f2554a53f56be98f0d49a272a0d2c8f822d50caac908824031e22ca446c0c4d"
CORRECTION = ROOT / "evidence/lumi-vm-attempt-018-source-v0.2-verification-v0.1.json"
CORRECTION_SHA = "edc115d2ffce111b350bd84af5c9b211495f43e902f7d3393cfa8f4c2ccb4ce8"
SDK = ROOT / "artifacts/lumi-vm-acquisition-sdk-test-runtime-v0.1/lib/python3.13/site-packages"
BOTOCORE_INIT_SHA = "a67becb8e1a2afa3579e33dd5f79073779aee3809bca0488d0bc7cb2fd9015d5"
ATTEMPT = bindings.ATTEMPT
RELEASE = ROOT / bindings.RELEASE
OUTPUT = ROOT / "artifacts/lumi-vm-attempt-018-readonly-preflight-v0.3"
SOURCE = ROOT / "scripts/execute_sft_vm_private_outer_v19.py"
SOURCE_SHA = "3a028e25c23a02a4cdc850e878a86a4700fd06887ccc9c6587dc62f6b4d6da14"
MAX_CALLS, MAX_SECONDS = 79, 1500
ReadOnlyClient = qualified.ReadOnlyClient


def need(value):
    if not value:
        raise ValueError("attempt018_readonly_preflight_v3_rejected") from None


def runtime():
    need(hashlib.sha256(Path(qualified.__file__).read_bytes()).hexdigest() == QUALIFIED_SHA)
    need(hashlib.sha256(Path(bindings.__file__).read_bytes()).hexdigest() == BINDINGS_SHA)
    need(hashlib.sha256(FAILURE.read_bytes()).hexdigest() == FAILURE_SHA)
    need(hashlib.sha256(CORRECTION.read_bytes()).hexdigest() == CORRECTION_SHA)
    need(not SDK.is_symlink() and SDK.is_dir())
    spec = importlib.util.find_spec("botocore")
    need(spec is not None and spec.origin is not None)
    origin = Path(spec.origin).resolve()
    need(origin == (SDK / "botocore/__init__.py").resolve())
    need(hashlib.sha256(origin.read_bytes()).hexdigest() == BOTOCORE_INIT_SHA)


def bind():
    runtime()
    values = {
        "bindings": bindings,
        "ROOT": ROOT,
        "RELEASE": RELEASE,
        "ATTEMPT": ATTEMPT,
        "OUTPUT": OUTPUT,
        "SOURCE": SOURCE,
        "SOURCE_SHA": SOURCE_SHA,
        "MAX_CALLS": MAX_CALLS,
        "MAX_SECONDS": MAX_SECONDS,
        "local": local,
    }
    for key, value in values.items():
        setattr(qualified, key, value)
    return qualified


def local():
    bind()
    manifest = bindings.verify()
    pins = bindings.controls()
    proof_path = ROOT / "evidence/lumi-vm-attempt-016-endpoint-cleanup-verification-v0.1.json"
    proof = json.loads(
        bindings.read(
            str(proof_path.relative_to(ROOT)),
            "503443d85c9d2e5cb99fd06255e9defe058a53f6ee7aeb91756d31e2e5990837",
        )
    )
    need(proof["result"]["cleanup_verified"] and proof["endpoint_interface_absent"])
    for name, pin in proof["source_bindings"].items():
        bindings.read(name, pin["sha256"], pin["bytes"])
    need(sys.dont_write_bytecode)
    sys.path.insert(0, str(RELEASE / "scripts"))
    outer = importlib.import_module("run_sft_vm_private_outer_v7")
    need(Path(outer.__file__).resolve() == RELEASE / "scripts/run_sft_vm_private_outer_v7.py")
    outer.authenticate()
    outer.loading.fresh_identity()
    return outer, manifest, pins


def admission(outer):
    return bind().admission(outer)


def run():
    return bind().run()


if __name__ == "__main__":
    run()
