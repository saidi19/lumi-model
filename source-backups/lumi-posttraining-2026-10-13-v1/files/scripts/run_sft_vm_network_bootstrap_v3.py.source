"""Native network/expiry guard joined to the frozen wheel/offline setup sequence.

Private entry for the admitted root controller, not provisioning authority.
Final source deployment, native qualification and full-size approval are still
required. Public run stays closed. Never run this script on the user's Mac.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import selectors
import stat
import subprocess
import sys
import time
import types
from pathlib import Path

INPUT = Path("/opt/lumi-bootstrap-input")
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
OUTPUT = Path("/var/lib/lumi-vm-input-deployment") / ATTEMPT / "network-guard"
SYSTEMD = Path("/run/systemd/system")
WATCH = "lumi-fullsize-network-watch-v1.service"
SOURCE = INPUT / "run_sft_vm_network_bootstrap_v3.py"
PINS = {
    "build_sft_vm_network_expiry_v3.py": (
        "caa0d6b551e9ee81599e3ed78f936e26705b2555e5e5b5716817160de6ea0833"
    ),
    "run_sft_vm_cpu_wheel_unit_v1.py": (
        "13fc972fe40a455bcf4d42c156445034420278f6f58b5ba3f1b0cfe95f03b978"
    ),
}
SETUP_RESULT = Path("/var/lib/lumi-vm-setup") / ATTEMPT / "result.json"
EXPECTED_SETUP = {
    "setup_components_completed": ["cpu", "sdk", "worker_source", "root_source"],
    "host_admitted": False,
    "binding_created": False,
    "gate_5_complete": False,
    "retry_allowed": False,
}


def need(value):
    if not value:
        raise ValueError("network_bootstrap_rejected") from None


def owned(path):
    for parent in (path, *path.parents):
        s = parent.lstat()
        need(stat.S_ISDIR(s.st_mode) and s.st_uid == 0 and not s.st_mode & 0o022)


def read(path, cap=131072, *, mode=0o400):
    owned(path.parent)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        need(stat.S_ISREG(before.st_mode) and before.st_uid == before.st_gid == 0)
        need(before.st_nlink == 1 and stat.S_IMODE(before.st_mode) == mode)
        need(0 < before.st_size <= cap)
        raw = stream.read(cap + 1)
        after = os.fstat(stream.fileno())
    need(len(raw) == before.st_size)
    need(
        all(
            getattr(before, k) == getattr(after, k)
            for k in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns", "st_mode")
        )
    )
    return raw


def load(name):
    raw = read(INPUT / name)
    need(hashlib.sha256(raw).hexdigest() == PINS[name])
    module = types.ModuleType("_network_" + name.removesuffix(".py"))
    module.__file__ = str(INPUT / name)
    exec(compile(raw, module.__file__, "exec"), module.__dict__)
    return module


def sync(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write(path, raw):
    need(type(raw) is bytes and 0 < len(raw) <= 32768)
    owned(path.parent)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    with os.fdopen(fd, "wb") as stream:
        need(stream.write(raw) == len(raw))
        stream.flush()
        os.fsync(stream.fileno())
    sync(path.parent)
    need(read(path, 32768) == raw)


def encode(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()


def command(argv, seconds=5, *, allowed_codes=(0,)):
    """Bound stdout while reading, suppress stderr, kill/reap even on timeout."""
    end = time.monotonic() + seconds
    process = subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        env={"PATH": "/usr/sbin:/usr/bin", "LC_ALL": "C"},
    )
    try:
        raw = bytearray()
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while True:
                remaining = end - time.monotonic()
                need(remaining > 0)
                if not selector.select(remaining):
                    raise ValueError("network_command_timeout")
                block = os.read(process.stdout.fileno(), min(4096, 32769 - len(raw)))
                if not block:
                    break
                raw.extend(block)
                need(len(raw) <= 32768)
        need(process.wait(timeout=max(0.001, end - time.monotonic())) in allowed_codes)
        return bytes(raw)
    finally:
        if process.poll() is None:
            process.kill()
        process.wait(timeout=5)
        process.stdout.close()


def native_identity(machine_id, boot_id, *, watcher=False, host_net_inode=None):
    need(sys.platform == "linux" and sys.version_info[:2] == (3, 12))
    need(sys.flags.isolated and sys.dont_write_bytecode and os.geteuid() == os.getegid() == 0)
    need(type(machine_id) is str and re.fullmatch("[0-9a-f]{32}", machine_id))
    need(
        type(boot_id) is str
        and re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", boot_id)
    )
    for name, wanted in (
        ("/etc/machine-id", machine_id),
        ("/proc/sys/kernel/random/boot_id", boot_id),
    ):
        with open(name, "rb") as stream:
            need(stream.read(65).strip() == wanted.encode("ascii"))
    # ProtectSystem/PrivateTmp deliberately give the watcher its own mount
    # namespace. CAP_NET_ADMIN alone must not need ptrace access to PID1:
    # compare its own network inode with the root-controller-bound host inode.
    if watcher:
        need(type(host_net_inode) is int and 0 < host_net_inode < 2**64)
        need(os.stat("/proc/self/ns/net").st_ino == host_net_inode)
        with open("/proc/self/cgroup", "rb") as stream:
            need(stream.read(1025) == f"0::/system.slice/{WATCH}\n".encode())
    else:
        for namespace in ("mnt", "net"):
            need(
                os.stat("/proc/self/ns/" + namespace).st_ino
                == os.stat("/proc/1/ns/" + namespace).st_ino
            )


def host_network_inode():
    return os.stat("/proc/1/ns/net").st_ino


def boot_time():
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def snapshot(policy):
    return command(["/usr/sbin/nft", "--json", "--numeric", "list", "table", "inet", policy.TABLE])


def show(unit, property_name):
    return command(
        ["/usr/bin/systemctl", "show", unit, "--property=" + property_name, "--value"],
        allowed_codes=(0, 1, 4) if property_name == "LoadState" else (0,),
    ).strip()


def active(policy):
    need(show(policy.TIMER, "ActiveState") == b"active")
    need(show(policy.TIMER, "SubState") == b"waiting")
    need(show(WATCH, "ActiveState") == b"active")
    need(show(WATCH, "SubState") == b"running")


def stop_host():
    # Shutdown behavior STOP and both EBS retention settings must be independently
    # cloud-bound before admission. This command neither terminates nor deletes.
    command(["/usr/bin/systemctl", "--no-block", "poweroff"])


def setup_finished(policy):
    marker = OUTPUT / "setup-finished"
    if not os.path.lexists(marker):
        return False
    owned(marker)
    need(stat.S_IMODE(marker.lstat().st_mode) == 0o700)
    value = json.loads(read(SETUP_RESULT, 4096, mode=0o600), object_pairs_hook=policy.unique)
    need(encode(value) == encode(EXPECTED_SETUP))
    return True


def observe(policy, previous, transitioned):
    done = setup_finished(policy)
    raw = snapshot(policy)
    if not transitioned:
        try:
            current = policy.inspect(raw, setup=True, previous=previous)
            return current, False, done
        except ValueError:
            need(done)
    need(done)
    return policy.inspect(raw, setup=False, previous=previous), True, done


def _watch_loop():
    policy = load("build_sft_vm_network_expiry_v3.py")
    context = json.loads(read(OUTPUT / "context.json", 4096), object_pairs_hook=policy.unique)
    need(
        set(context)
        == {"machine_id", "boot_id", "original_deadline_boot_seconds", "host_net_inode"}
    )
    native_identity(
        context["machine_id"],
        context["boot_id"],
        watcher=True,
        host_net_inode=context["host_net_inode"],
    )
    policy.expiry_units(
        original_deadline_boot_seconds=context["original_deadline_boot_seconds"],
        observed_boot_seconds=math.floor(boot_time()),
    )
    before = policy.inspect(snapshot(policy))
    (OUTPUT / "watch-ready").mkdir(mode=0o700, exist_ok=False)
    sync(OUTPUT)
    transitioned = False
    while True:
        native_identity(
            context["machine_id"],
            context["boot_id"],
            watcher=True,
            host_net_inode=context["host_net_inode"],
        )
        before, transitioned, done = observe(policy, before, transitioned)
        need(boot_time() < context["original_deadline_boot_seconds"])
        need(done or boot_time() < 1800)
        time.sleep(0.5)


def _watch():
    """Dedicated service; abnormal exit causes systemd FailureAction=poweroff."""
    try:
        _watch_loop()
    except BaseException:
        try:
            write(
                OUTPUT / "watch-failed.json",
                encode(
                    {
                        "status": "network_or_deadline_guard_failed",
                        "retry_allowed": False,
                        "host_admitted": False,
                        "shutdown_requested_by_unit_policy": True,
                    }
                ),
            )
        finally:
            raise ValueError("network_watch_failed") from None


def watch_unit(source_sha):
    # The child authenticates the deployed source again before executing it.
    code = (
        "import hashlib,runpy;from pathlib import Path;"
        f"p=Path({str(SOURCE)!r});"
        f"assert hashlib.sha256(p.read_bytes()).hexdigest()=={source_sha!r};"
        "runpy.run_path(str(p),run_name='__lumi_watch__')['_watch']()"
    )
    escaped = code.replace("\\", "\\\\").replace('"', '\\"')
    return (
        "[Unit]\nDescription=Lumi bounded packet-policy watchdog\n"
        "FailureAction=poweroff\nSuccessAction=poweroff\n"
        "[Service]\nType=exec\nUser=root\nGroup=root\nRestart=no\nRuntimeMaxSec=14400\n"
        "TimeoutStopSec=5s\nKillMode=control-group\nMemoryMax=64M\nMemorySwapMax=0\n"
        "TasksMax=16\nLimitCORE=0\nUMask=0077\nProtectSystem=strict\nProtectHome=yes\n"
        "NoNewPrivileges=yes\nPrivateTmp=yes\nPrivateDevices=yes\n"
        "RestrictAddressFamilies=AF_UNIX AF_NETLINK\nCapabilityBoundingSet=CAP_NET_ADMIN\n"
        f"ReadWritePaths={OUTPUT}\nReadOnlyPaths={INPUT}\n"
        "StandardInput=null\nStandardOutput=null\nStandardError=null\n"
        f'ExecStart=/usr/bin/python3 -I -B -c "{escaped}"\n'
    )


def run(**_arguments):
    raise ValueError("fullsize_host_admission_not_bound") from None


def setup_receipt(value):
    """Unwrap the frozen storage coordinator's actual return contract.

    Preserve its aggregate storage evidence; do not invent or replace the
    independently saved offline setup receipt checked by the caller.
    """
    need(
        type(value) is dict
        and set(value)
        == {"storage_snapshot", "setup", "host_admitted", "binding_created", "gate_5_complete"}
    )
    need(all(value[k] is False for k in ("host_admitted", "binding_created", "gate_5_complete")))
    snapshot = value["storage_snapshot"]
    checks = (
        "root_volume_matches",
        "work_volume_matches",
        "private_work_mount_matches",
        "no_alias_or_submount_in_current_namespace",
    )
    nonclaims = (
        "other_namespace_writer_exclusion_proven",
        "cloud_encryption_or_preservation_rechecked",
        "host_admitted",
    )
    need(
        type(snapshot) is dict
        and set(snapshot) == {*checks, *nonclaims, "work_available_bytes", "root_available_bytes"}
    )
    need(all(snapshot[k] is True for k in checks))
    need(all(snapshot[k] is False for k in nonclaims))
    need(
        type(snapshot["work_available_bytes"]) is int
        and snapshot["work_available_bytes"] >= 100 * 1024**3
    )
    need(
        type(snapshot["root_available_bytes"]) is int
        and snapshot["root_available_bytes"] >= 4 * 1024**3
    )
    need(encode(value["setup"]) == encode(EXPECTED_SETUP))
    return value["setup"]


def _bootstrap_admitted_once(machine_id, boot_id, volumes, *, original_deadline_boot_seconds):
    """No cloud admission here; original launch deadline comes from its controller."""
    native_identity(machine_id, boot_id)
    policy = load("build_sft_vm_network_expiry_v3.py")
    wheel = load("run_sft_vm_cpu_wheel_unit_v1.py")
    wheel.preflight(machine_id, volumes)
    units = policy.expiry_units(
        original_deadline_boot_seconds=original_deadline_boot_seconds,
        observed_boot_seconds=math.floor(boot_time()),
    )
    need(boot_time() < min(1470, original_deadline_boot_seconds - 330))
    units[WATCH] = watch_unit(hashlib.sha256(read(SOURCE)).hexdigest())
    owned(OUTPUT.parent)
    owned(SYSTEMD)
    for name in units:
        need(not os.path.lexists(SYSTEMD / name))
        need(show(name, "LoadState") == b"not-found")
    OUTPUT.mkdir(mode=0o700, exist_ok=False)
    sync(OUTPUT.parent)
    phase = "install"
    try:
        write(
            OUTPUT / "context.json",
            encode(
                dict(
                    machine_id=machine_id,
                    boot_id=boot_id,
                    original_deadline_boot_seconds=original_deadline_boot_seconds,
                    host_net_inode=host_network_inode(),
                )
            ),
        )
        write(OUTPUT / "policy.json", encode(policy.install_policy()))
        for name, body in units.items():
            write(SYSTEMD / name, body.encode())
        command(
            ["/usr/bin/systemd-analyze", "verify", "--man=no", *[str(SYSTEMD / n) for n in units]]
        )
        command(["/usr/sbin/nft", "--check", "--json", "--file", str(OUTPUT / "policy.json")])
        command(["/usr/bin/systemctl", "daemon-reload"])
        command(["/usr/bin/systemctl", "start", policy.TIMER])
        command(["/usr/sbin/nft", "--json", "--file", str(OUTPUT / "policy.json")])
        before = policy.inspect(snapshot(policy))
        command(["/usr/bin/systemctl", "start", WATCH])
        ready_deadline = time.monotonic() + 5
        while not os.path.lexists(OUTPUT / "watch-ready"):
            need(time.monotonic() < ready_deadline)
            time.sleep(0.05)
        owned(OUTPUT / "watch-ready")
        active(policy)
        # Verify the files PID1 loaded are still the exact rendered definitions.
        for name, body in units.items():
            need(read(SYSTEMD / name, 32768) == body.encode())
            need(show(name, "FragmentPath") == str(SYSTEMD / name).encode())
            need(show(name, "DropInPaths") == b"")
        need(show(WATCH, "FailureAction") == b"poweroff")
        need(show(WATCH, "SuccessAction") == b"poweroff")
        policy.inspect(snapshot(policy), previous=before)
        phase = "wheel_and_setup"
        remaining = min(1800, original_deadline_boot_seconds) - boot_time()
        need(remaining >= 330)
        storage_result = wheel._run_network_admitted_once(
            machine_id, volumes, time.monotonic() + remaining
        )
        result = setup_receipt(storage_result)
        need(encode(result) == encode(EXPECTED_SETUP))
        actual = json.loads(read(SETUP_RESULT, 4096, mode=0o600), object_pairs_hook=policy.unique)
        need(encode(actual) == encode(EXPECTED_SETUP))
        phase = "transition"
        active(policy)
        need(boot_time() < min(1800, original_deadline_boot_seconds))
        (OUTPUT / "setup-finished").mkdir(mode=0o700, exist_ok=False)
        sync(OUTPUT)
        change, before = policy.setup_transition(snapshot(policy))
        write(OUTPUT / "transition.json", encode(change))
        command(["/usr/sbin/nft", "--json", "--file", str(OUTPUT / "transition.json")])
        policy.inspect(snapshot(policy), setup=False, previous=before)
        active(policy)
        report = {
            "wheel_and_offline_setup_verified": True,
            "setup_gate_removed": True,
            "watchdog_left_running": True,
            "expiry_left_armed": True,
            "host_admitted": False,
            "gate_5_complete": False,
            "retry_allowed": False,
        }
        write(OUTPUT / "result.json", encode(report))
        return report
    except BaseException:
        try:
            write(
                OUTPUT / "failed.json",
                encode(
                    {
                        "failed_phase": phase,
                        "retry_allowed": False,
                        "host_admitted": False,
                        "partial_evidence_preserved": True,
                    }
                ),
            )
        finally:
            stop_host()
        raise ValueError("network_bootstrap_failed") from None
