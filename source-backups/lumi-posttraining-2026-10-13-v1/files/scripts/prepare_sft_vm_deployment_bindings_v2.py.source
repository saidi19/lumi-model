"""Pure attempt-010 policies from the pinned qualified deployment builder."""

import hashlib
import types
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DONOR_SHA = "cae2aab77ac49a0dee24ed1a49b54f4a0eeb891a6217f6311d7f5e62ef7cd06f"
ATTEMPT = "9b87f7f591a240ef8b10f46b8d008fa0"
PREVIOUS = "242bd09f5fa84b1f9a4e46cb4592ad8b"


def bound_builder():
    path = ROOT / "scripts/prepare_sft_vm_deployment_bindings_v1.py"
    raw = path.read_bytes()
    if path.is_symlink() or hashlib.sha256(raw).hexdigest() != DONOR_SHA:
        raise ValueError("deployment_builder_binding_failed")
    raw = raw.replace(PREVIOUS.encode(), ATTEMPT.encode())
    raw = raw.replace(b"attempt-008", b"attempt-010").replace(b"v0.8", b"v0.10")
    module = types.ModuleType("_attempt010_deployment")
    module.__file__ = str(path)
    exec(compile(raw, str(path), "exec"), module.__dict__)
    module.RELEASE = "artifacts/lumi-vm-attempt-010-source-v0.1"
    module.RELEASE_SHA = "6b93341e30ab6e2f1f0dbaacc47d69731a023574fb55fdda43a72dcd258001f6"
    module.REPORT = "evidence/lumi-vm-attempt010-source-verification-v0.1.json"
    module.REPORT_SHA = "5026004df4238b096fafd4416e85dbfbd7727131bd02280d7a1169ab3cae6ceb"
    module.OLD = PREVIOUS
    return module


def build():
    m = bound_builder()
    plan = m.build(*m.inputs())
    return plan, m.approval_template(plan)


def run(**_arguments):
    raise ValueError("deployment_scope_is_not_execution_authority")
