"""Bounded local child-process probes; no network, AWS or model access."""

import json
import os
import signal
import subprocess
import sys
import time


def probe(code, delay):
    child = subprocess.Popen(
        [sys.executable, "-I", "-B", "-c", code],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    row = {}
    try:
        row["leader_exit"] = child.wait(timeout=3)
        time.sleep(delay)
        for name, sig in (("existence", 0), ("cleanup", signal.SIGKILL)):
            try:
                os.killpg(child.pid, sig)
                row[name] = {"kind": "sent", "errno": None}
            except OSError as error:
                row[name] = {"kind": type(error).__name__, "errno": error.errno}
    finally:
        if child.poll() is None:
            os.killpg(child.pid, signal.SIGKILL)
            child.wait(timeout=2)
    return row


def main():
    cases = {
        "leader_only": "pass",
        "orphan_exited": "import os; os.fork(); os._exit(0)",
        "orphan_short_lived": (
            "import os,time; p=os.fork(); "
            "time.sleep(0.3 if p == 0 else 0); os._exit(0)"
        ),
    }
    rows = []
    for label, code in cases.items():
        for delay in (0, 0.5):
            rows.append(dict(case=label, delay=delay, **probe(code, delay)))
    return dict(rows=rows, aws_calls=0, network_calls=0, historical_cause_proven=False)


if __name__ == "__main__":
    print(json.dumps(main(), sort_keys=True))
