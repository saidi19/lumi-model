from scripts import prepare_sft_vm_attempt019_v1 as source
from scripts import repair_sft_vm_setup_receipt_v1 as repair

ROOT = Path(__file__).resolve().parents[1]
BASE = ROOT / "artifacts/lumi-vm-attempt-020-source-v0.1"
BASE_SHA = "059fbed8faf317fdf778cba3e29af02c5271ce4f4d76e2961381b76010a5ce52"
SOURCE_BUILDER_SHA = "050b933aa9da5714571fd48838daabf7c5352fecd439c801957029ae1a76fdd8"
FAILURE = ROOT / "evidence/lumi-vm-attempt-020-v025-execution-verification-v0.1.json"
FAILURE_SHA = "f18eae3048a52d319e6cf8c4d57e151be798f43a9505ce15af9ff3b4f92c42e1"
OUTPUT = ROOT / "artifacts/lumi-vm-attempt-021-source-v0.1"
OLD = "3179537f150b45548946f8114e8b73ca"
NEW = "07be75c955dc43fe8818192e8a9e3fc1"
OLD_CIDR = "172.31.97.32/27"
NEW_CIDR = "172.31.97.64/27"
REPAIR_SHA = "5304446d561e9e041b0ced4578e0296be2e9bef3a0d7489ea89f0486020af41a"
TAR = source.TAR
SELECTION = source.SELECTION
SETUP_TAR = "artifacts/lumi-vm-setup-inputs-release-v0.5/setup-inputs.tar"
SETUP_STAGE = "scripts/stage_sft_vm_setup_inputs_v5.py"
SETUP_SEND = "scripts/send_sft_vm_setup_inputs_v5.py"
SETUP_MEMBERS = dict(
    (
        (
            "lumi-bootstrap-input/prepare_sft_vm_work_disk_v1.py",
            "scripts/prepare_sft_vm_work_disk_v1.py",
        ),
        (
            "lumi-bootstrap-input/acquire_sft_vm_cpu_wheels_v1.py",
            "scripts/acquire_sft_vm_cpu_wheels_v1.py",
        ),
        (
            "lumi-bootstrap-input/run_sft_vm_cpu_wheel_unit_v1.py",
            "scripts/run_sft_vm_cpu_wheel_unit_v1.py",
        ),
        (
            "lumi-bootstrap-input/build_sft_vm_network_expiry_v3.py",
            "scripts/build_sft_vm_network_expiry_v3.py",
        ),
        (
            "lumi-bootstrap-input/run_sft_vm_network_bootstrap_v4.py",
            "scripts/run_sft_vm_network_bootstrap_v4.py",
        ),
        (
            "lumi-bootstrap-input/posttraining_import_vm_rehearsal_v3.py",
            "src/lumi/posttraining_import_vm_rehearsal_v3.py",
        ),
        ("lumi-bootstrap-input/cpu.service", "configs/lumi-vm-cpu-runtime-install-v0.1.service"),
        (
            "lumi-bootstrap-input/sdk.service",
            "configs/lumi-vm-acquisition-sdk-install-v0.1.service",
        ),
        (
            "lumi-bootstrap-input/stage_sft_vm_fullsize_release_v1.py",
            "scripts/stage_sft_vm_fullsize_release_v1.py",
        ),
        (
            "lumi-bootstrap-input/stage_sft_vm_root_controller_v1.py",
            "scripts/stage_sft_vm_root_controller_v1.py",
        ),
        (
            "lumi-bootstrap-input/source-controls.tar",
            "artifacts/lumi-vm-fullsize-source-release-v0.1/source-controls.tar",
        ),
        (
            "lumi-bootstrap-input/root-controller.tar",
            "artifacts/lumi-vm-root-controller-release-v0.1/root-controller.tar",
        ),
        (
            "lumi-bootstrap-input/run_sft_vm_setup_sequence_v1.py",
