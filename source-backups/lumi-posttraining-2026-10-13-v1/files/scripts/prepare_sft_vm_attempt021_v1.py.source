        ),
        ("lumi-bootstrap-input/check_sft_vm_storage_v1.py", "scripts/check_sft_vm_storage_v1.py"),
        (
            "lumi-cpu-input/install_sft_vm_cpu_runtime_v1.py",
            "scripts/install_sft_vm_cpu_runtime_v1.py",
        ),
        (
            "lumi-cpu-input/install_sft_vm_acquisition_sdk_v1.py",
            "scripts/install_sft_vm_acquisition_sdk_v1.py",
        ),
        ("lumi-cpu-input/runtime-lock.json", "configs/lumi-sft-linux-cpu-release-v0.1.lock.json"),
        (
            "lumi-sdk-input/install_sft_vm_acquisition_sdk_v1.py",
