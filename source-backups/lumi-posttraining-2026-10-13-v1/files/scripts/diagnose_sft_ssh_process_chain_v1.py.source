"""Local SSH proxy/version probes; never open an AWS tunnel or contact a host."""

import ast
import hashlib
import json
import os
import selectors
import signal
import subprocess
import time
from pathlib import Path
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / (
    "artifacts/lumi-vm-attempt-016-source-v0.1/scripts/run_sft_vm_detached_delivery_v1.py"
)
SHA = "bf696cf3463c96cd3418ab60231fd501424e57bb3bc87a65c97f9f67436cda03"


def transport():
    raw = SOURCE.read_bytes()
    if hashlib.sha256(raw).hexdigest() != SHA:
        raise ValueError("source_mismatch")
    names = {
        "EXCHANGE_STAGES", "EXIT_KINDS", "REMOTE_STAGES", "ExchangeFailure",
        "exchange_diagnostic", "remote_failure_stage", "pipe_exchange",
    }
    selected = [
        n for n in ast.parse(raw).body
        if getattr(n, "name", None) in names
        or (isinstance(n, ast.Assign) and any(
            isinstance(t, ast.Name) and t.id in names for t in n.targets
        ))
    ]
    if len(selected) != len(names):
        raise ValueError("selection_mismatch")
    ns = dict(os=os, selectors=selectors, signal=signal, subprocess=subprocess,
              time=time, json=json, MAX_REPLY=4096)
    exec(compile(ast.Module(body=selected, type_ignores=[]), "<pinned-transport>", "exec"), ns)
    return ns


def main():
    ns = transport()
    rows = []
    for label, proxy in (("true_proxy", "/usr/bin/true"),
                         ("aws_version_proxy", "/opt/homebrew/bin/aws --version")):
        argv = ["/usr/bin/ssh", "-F", "/dev/null", "-T"]
        for option in (
            "ProxyCommand=" + proxy, "BatchMode=yes", "IdentityFile=none",
            "IdentityAgent=none", "UserKnownHostsFile=/dev/null",
            "GlobalKnownHostsFile=/dev/null", "StrictHostKeyChecking=yes",
            "ConnectTimeout=2", "ConnectionAttempts=1", "LogLevel=QUIET",
        ):
            argv += ["-o", option]
        argv += ["local-proxy-test.invalid"]
        observations = []
        killpg = os.killpg

        def observe(group, sig, killpg=killpg, observations=observations):
            row = {}
            try:
                row["leader_still_present"] = os.getpgid(group) == group
            except OSError as error:
                row["leader_lookup_errno"] = error.errno
            try:
                result = killpg(group, sig)
                row["signal_result"] = "sent"
                return result
            except OSError as error:
                row.update(signal_result=type(error).__name__, errno=error.errno)
                raise
            finally:
                observations.append(row)

        with patch.object(os, "killpg", side_effect=observe):
            try:
                reply = ns["pipe_exchange"](argv, b"", 5)
                outcome = dict(status="returned", reply_bytes=len(reply))
            except ns["ExchangeFailure"] as error:
                outcome = dict(status="rejected", **ns["exchange_diagnostic"](error))
        rows.append(dict(case=label, outcome=outcome, observations=observations))
    return dict(rows=rows, aws_api_calls=0, actual_tunnel_opened=False,
                credentials_requested=False, historical_cause_proven=False)


if __name__ == "__main__":
    print(json.dumps(main(), sort_keys=True))
