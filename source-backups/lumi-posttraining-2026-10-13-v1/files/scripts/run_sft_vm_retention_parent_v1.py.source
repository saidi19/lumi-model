#!/usr/bin/env python3
"""Authenticated retention-only detached entry. Never create admission bindings.

Native bootstrap must admit and install an independent root-only retention
binding. Prior import binding alone is insufficient. No secrets in argv/logs,
no model import, no cloud launch, no restart of the original parent.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import resource
import stat
import sys
import time
import types
from pathlib import Path

ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
ROOT = Path("/var/lib/lumi-vm-fullsize") / ATTEMPT
RELEASE = ROOT / "retention-release"
ENTRY = RELEASE / "scripts/run_sft_vm_retention_parent_v1.py"
PACKAGE = "_lumi_retention_parent_cold"
CONSUMED = False
SOURCES = {
    "posttraining_import_vm_rehearsal_v3": (
        "ac97b64072ccd1f3db702bbf32bf0ff3de410e566ae1dc708533cb147ea15d4c"
    ),
    "posttraining_vm_fullsize_controls_v1": (
        "937e44cdc598247bddf2fd9e1762b8ad79f79361fb707fcd2dfdaac045267a93"
    ),
    "posttraining_vm_fullsize_staging_v1": (
        "0dd28e571a9b01ef7a2270fc9df81545d5f903acfb1133ba2771ebce1c479c68"
    ),
    "posttraining_vm_fullsize_handoff_v1": (
        "c5cd7106ea4c8b6ba48e5d10fe2f18e42349dc581a0a3cb2a0a26dd6ce9f6fcc"
    ),
    "posttraining_vm_fullsize_completion_v1": (
        "259bc102563dcf48ac55e818505082f5c0703efbfa1698055a03144c60ab98a7"
    ),
    "posttraining_vm_fullsize_acquisition_unit_v1": (
        "9f2225c7a43417bddfa8ebabd4e1cae0a19bd8b45be8b1fc3870d2049de08662"
    ),
    "posttraining_vm_fullsize_credential_handoff_v1": (
        "6a23d90686c87f4efc8133ce51fbc1282c40e4067b39e4abedf315b4bb963705"
    ),
    "posttraining_vm_fullsize_credential_setup_v1": (
        "4477dd42957befcc1872285525f9698a16d464c84b7cfc4085a1fb266f0a33ab"
    ),
    "posttraining_vm_detached_parent_v1": (
        "0239d512b345af3f23ce604707058beeb2f829e40440a512bdc94b7195339d9b"
    ),
    "posttraining_vm_fullsize_transport_v1": (
        "cb6b21e6ab1011dcc2902305f67ecaf24687930ef40628b9b01b9ce40e123c30"
    ),
    "posttraining_vm_fullsize_retention_v1": (
        "1032c6c1e916bc7c1040898240362a0863e67c0869e6c88e6d786a6d3a43c9e2"
    ),
    "posttraining_vm_retention_transport_v1": (
        "e405f819b5837e3174edc692b39907284b5119be93ad2e26e59328a7f946dbbf"
    ),
    "posttraining_vm_retention_unit_v1": (
        "193b6995f0a25c0cbab127c2961f1eb92ac7e1b8a99b5dd592a4affb4280a017"
    ),
    "posttraining_vm_retention_continuation_v2": (
        "f1dcc60c65981ba01da835aca175cad2b227e48b6b722e1c5478cabccffbc82e"
    ),
    "posttraining_vm_retention_parent_v1": (
        "f6ee949a4f0c924a972db5fa218fc356c9b18f76998118473a5ab3f75e596f55"
    ),
}
EXTRA = {
    "configs/lumi-vm-fullsize-host-proposal-v0.1.json": (
        "9e1ea3041ce5ca3ead8f58d0931dc8c7e41c5a66a9bc43e55ff75890b662c061"
    ),
    "scripts/acquire_sft_vm_fullsize_inputs_v1.py": (
        "c3fe17fe42b7e5bf7df19e8a5f198568ce7d9efa89dc2af148d3f73e9fd89424"
    ),
    "scripts/retain_sft_vm_package_v1.py": (
        "f9b2965c257af4ffa7e091e92fcc3598849cbfb7497797f9d506a95b97d52e31"
    ),
    "scripts/run_sft_vm_parent_entry_v2.py": (
        "4ec3f33ba9236f34f3ceb1b0c83f2c8abc46c9ec969b8f5c964bf5dd6f390197"
    ),
    "src/lumi/posttraining_vm_retention_continuation_v1.py": (
        "d8618e73b9d5a0e03b2d89285065b9d96f6bc980c91daa31c66097ec66a53f0a"
    ),
}


def need(value):
    if not value:
        raise ValueError("retention_entry_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def pin(value):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def root_file(path, maximum=131072):
    for parent in path.parents:
        row = parent.lstat()
        need(stat.S_ISDIR(row.st_mode) and row.st_uid == 0 and not row.st_mode & 0o022)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1)
        need(before.st_uid == before.st_gid == 0 and stat.S_IMODE(before.st_mode) == 0o400)
        need(0 < before.st_size <= maximum)
        raw = stream.read(maximum + 1)
        after = os.fstat(stream.fileno())
        fields = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_nlink",
            "st_uid",
            "st_gid",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        need(
            len(raw) == before.st_size
            and all(getattr(before, k) == getattr(after, k) for k in fields)
        )
    return raw


def decode(raw):
    def pairs(items):
        value = {}
        for key, row in items:
            need(key not in value)
            value[key] = row
        return value

    value = json.loads(raw, object_pairs_hook=pairs)
    need(type(value) is dict)
    return value


def validate_binding(value, operation, machine, boot, now, prior):
    need(
        set(value)
        == {
            "schema",
            "scope",
            "attempt",
            "machine_id",
            "boot_id",
            "prior_binding_sha256",
            "entry_sha256",
            "release_manifest_sha256",
            "started_boottime",
            "deadline_boottime",
        }
    )
    need(value["schema"] == "lumi.vm-retention-host-binding.v0.1")
    need(value["scope"] == "conditional-private-retention-once" and value["attempt"] == ATTEMPT)
    need(
        value["machine_id"] == machine == prior["machine_id"]
        and value["boot_id"] == boot == prior["boot_id"]
    )
    need(
        all(
            pin(value[k])
            for k in ("prior_binding_sha256", "entry_sha256", "release_manifest_sha256")
        )
    )
    start, end = value["started_boottime"], value["deadline_boottime"]
    need(all(type(n) in {int, float} and math.isfinite(n) for n in (start, end, now)))
    need(prior["host_started_boottime"] <= start <= now and 0 < end - start <= 1800)
    need(end <= prior["host_deadline_boottime"] - 300)
    if operation in {"dispatch", "submit", "serve"}:
        need(end - now > 60)
    return value


def authenticated_release(binding):
    manifest = root_file(RELEASE / "release-manifest.json", 32768)
    need(sha(manifest) == binding["release_manifest_sha256"])
    expected = {"src/lumi/" + n + ".py": p for n, p in SOURCES.items()} | EXTRA
    expected["scripts/run_sft_vm_retention_parent_v1.py"] = binding["entry_sha256"]
    need(decode(manifest) == expected and len(expected) == 21)
    bodies = {name: root_file(RELEASE / name) for name in expected}
    need(all(sha(bodies[name]) == p for name, p in expected.items()))
    return bodies


def load_parent(bodies):
    global CONSUMED
    need(not CONSUMED)
    need(
        not any(
            n == PACKAGE
            or n.startswith(PACKAGE + ".")
            or n.split(".")[0] in {"lumi", "torch", "transformers", "botocore", "boto3"}
            for n in sys.modules
        )
    )
    need(all(sha(bodies["src/lumi/" + n + ".py"]) == p for n, p in SOURCES.items()))
    CONSUMED = True
    package = types.ModuleType(PACKAGE)
    package.__path__ = []
    sys.modules[PACKAGE] = package
    for name, pin_value in SOURCES.items():
        relative = "src/lumi/" + name + ".py"
        raw = bodies[relative]
        need(sha(raw) == pin_value)
        module = types.ModuleType(PACKAGE + "." + name)
        module.__file__, module.__package__ = str(RELEASE / relative), PACKAGE
        sys.modules[module.__name__] = module
        setattr(package, name, module)
        exec(compile(raw, module.__file__, "exec"), module.__dict__)
    return module


def native_boundary():
    need(sys.platform == "linux" and sys.version_info[:2] == (3, 12))
    need(os.geteuid() == os.getegid() == 0 and sys.flags.isolated and sys.dont_write_bytecode)
    need(Path(__file__) == ENTRY)
    with open("/etc/machine-id", "rb") as stream:
        machine = stream.read(65).strip().decode("ascii")
    with open("/proc/sys/kernel/random/boot_id", "rb") as stream:
        boot = stream.read(65).strip().decode("ascii")
    return machine, boot


def execute(operation):
    need(operation in {"dispatch", "submit", "serve", "status", "stop"})
    machine, boot = native_boundary()
    binding_raw = root_file(ROOT / "retention-controller/binding.json", 16384)
    binding_pin = (
        root_file(ROOT / "retention-controller/binding.sha256", 65).decode("ascii").strip()
    )
    need(pin(binding_pin) and sha(binding_raw) == binding_pin)
    binding = decode(binding_raw)
    # Reuse the pinned original validator without admitting retention from it.
    helper_name = "scripts/run_sft_vm_parent_entry_v2.py"
    helper_raw = root_file(RELEASE / helper_name)
    need(sha(helper_raw) == EXTRA[helper_name])
    helper = types.ModuleType("_retention_old_binding_validator")
    exec(compile(helper_raw, "bound_prior_entry", "exec"), helper.__dict__)
    prior_raw = root_file(ROOT / "controller/binding.json", 16384)
    need(sha(prior_raw) == binding["prior_binding_sha256"])
    prior = helper.validate_binding(
        helper.decode(prior_raw),
        ATTEMPT,
        "status",
        machine,
        boot,
        time.clock_gettime(time.CLOCK_BOOTTIME),
    )
    validate_binding(
        binding, operation, machine, boot, time.clock_gettime(time.CLOCK_BOOTTIME), prior
    )
    need(sha(root_file(ENTRY)) == binding["entry_sha256"])
    bodies = authenticated_release(binding)  # Entire closure before executing any module.
    parent = load_parent(bodies)
    parent.old.handoff.frozen.host_check(machine)
    end = binding["deadline_boottime"]
    if operation in {"dispatch", "serve"}:
        parent.continuation._completed_parent(
            ATTEMPT, machine, binding["prior_binding_sha256"], minimum_seconds=60
        )
    if operation == "dispatch":
        return parent._dispatch_admitted_once(binding_pin, end)
    if operation == "submit":
        raw = parent.old.setup._read_pipe(0, time.monotonic() + min(5, parent.remaining(end)))
        try:
            return parent._submit_admitted_once(raw, binding_pin, end)
        finally:
            raw[:] = b"\0" * len(raw)
    if operation == "serve":
        parent._serve_admitted_once(binding_pin, end, machine, binding["prior_binding_sha256"])
    elif operation == "stop":
        parent._stop_admitted(binding_pin, end)
    else:
        return parent._status_admitted(binding_pin, end)
    return None


def main():
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        os.umask(0o077)
        need(len(sys.argv) == 2)
        result = execute(sys.argv[1])
        if result is not None:
            raw = (
                json.dumps(result, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
                + b"\n"
            )
            need(len(raw) <= 4096)
            sys.stdout.buffer.write(raw)
            sys.stdout.buffer.flush()
    except BaseException:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
