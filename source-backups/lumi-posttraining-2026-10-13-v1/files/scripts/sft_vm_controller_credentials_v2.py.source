"""Five-hour, memory-only controller credentials; never a launch authority.

The frozen eight-generation watchdog provider is unchanged. This provider has
one non-resettable 32-generation budget shared by every management client.
Credential refresh is not an API retry and cannot extend the original deadline.
"""

import contextlib
import hashlib
import json
import math
import os
import select
import signal
import subprocess
import time
from pathlib import Path

import issue_sft_vm_acquisition_credentials_v1 as acquisition
import issue_sft_vm_retention_credentials_v1 as retention
import run_sft_vm_joined_admission_v2 as joined
import run_sft_vm_private_network_v1 as network
import sft_vm_watchdog_login_refresh_v1 as legacy

SERVICES = ("sts", "ec2", "s3", "iam", "lambda", "scheduler", "service-quotas", "pricing")
IAM_OPS = {
    "get-user",
    "get-role",
    "create-user",
    "create-role",
    "delete-user",
    "delete-role",
    "put-user-policy",
    "put-role-policy",
    "get-user-policy",
    "get-role-policy",
    "delete-user-policy",
    "delete-role-policy",
    "create-access-key",
    "delete-access-key",
    "list-access-keys",
    "update-assume-role-policy",
}


def need(value):
    if not value:
        raise ValueError("controller_credentials_rejected") from None


def endpoint(service):
    if service == "iam":
        return "https://iam.amazonaws.com"
    name = {"service-quotas": "servicequotas", "pricing": "api.pricing"}.get(service, service)
    return f"https://{name}.us-east-1.amazonaws.com"


def ca_path():
    path = Path(__file__).resolve().parents[1] / acquisition.base.CA
    need(hashlib.sha256(path.read_bytes()).hexdigest() == acquisition.base.CA_SHA)
    return str(path)


def session():
    import botocore.session

    value = botocore.session.Session()
    value.set_config_variable("config_file", "/dev/null")
    value.set_config_variable("credentials_file", "/dev/null")
    return value


def static_identity_client(metadata):
    return session().create_client(
        "sts",
        region_name="us-east-1",
        endpoint_url=endpoint("sts"),
        config=legacy.config("sts"),
        verify=ca_path(),
        aws_access_key_id=metadata["access_key"],
        aws_secret_access_key=metadata["secret_key"],
        aws_session_token=metadata["token"],
    )


def export_credentials():
    """Bounded pipe reads; no temporary secret file or secret command argument."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith("AWS_") and k.lower() not in {"http_proxy", "https_proxy", "all_proxy"}
    }
    env.update(AWS_MAX_ATTEMPTS="1", AWS_PAGER="", AWS_EC2_METADATA_DISABLED="true")
    proc = subprocess.Popen(
        [
            "/opt/homebrew/bin/aws",
            "--profile",
            "default",
            "configure",
            "export-credentials",
            "--format",
            "process",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        start_new_session=True,
    )
    buffers = {proc.stdout: bytearray(), proc.stderr: bytearray()}
    active = set(buffers)
    end = time.monotonic() + 20
    try:
        while active:
            remaining = end - time.monotonic()
            need(remaining > 0)
            ready, _, _ = select.select(list(active), [], [], min(0.2, remaining))
            for stream in ready:
                data = os.read(stream.fileno(), 4096)
                if not data:
                    active.remove(stream)
                    continue
                buffers[stream].extend(data)
                need(len(buffers[stream]) <= (32768 if stream is proc.stdout else 4096))
        need(proc.wait(timeout=1) == 0)
        return bytes(buffers[proc.stdout])
    finally:
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait(timeout=2)
        proc.stdout.close()
        proc.stderr.close()


class Reader:
    def __init__(self, deadline, *, clock=time.monotonic, wall=time.time):
        self.clock, self.wall = clock, wall
        self.start, self.wall_start = clock(), wall()
        need(type(deadline) in {int, float} and math.isfinite(deadline))
        need(60 < deadline - self.start <= 18000)
        self.deadline, self.calls, self.closed = deadline, 0, False
        self.principal = None
        self.last_expiry = 0.0

    def active(self, **_event):
        need(not self.closed)
        now, wall = self.clock(), self.wall()
        need(self.start <= now < self.deadline - 20)
        need(abs((wall - self.wall_start) - (now - self.start)) <= 5)

    def __call__(self):
        client = None
        try:
            self.active()
            need(self.calls < 32)
            now, wall = self.clock(), self.wall()
            need(self.start <= now < self.deadline - 45)
            need(abs((wall - self.wall_start) - (now - self.start)) <= 5)
            self.calls += 1  # Failed generations are consumed; never reset the counter.
            # Respect an already active frozen transport alarm rather than replacing it.
            bound = (
                contextlib.nullcontext()
                if signal.getitimer(signal.ITIMER_REAL)[0]
                else joined.lifecycle.guard.provision.timeout(20)
            )
            with bound:
                raw = export_credentials()
                need(type(raw) is bytes and 0 < len(raw) <= 32768)
                value = json.loads(raw, object_pairs_hook=legacy.unique)
                need(type(value.get("Version")) is int and value["Version"] == 1)
                keys = {
                    "access_key": "AccessKeyId",
                    "secret_key": "SecretAccessKey",
                    "token": "SessionToken",
                    "expiry_time": "Expiration",
                }
                metadata = {key: value[field] for key, field in keys.items()}
                need(all(type(v) is str and 0 < len(v) <= 16384 for v in metadata.values()))
                expires = legacy.expiry(metadata)
                need(
                    math.floor(expires - self.wall()) > 300
                    and expires - self.wall() <= 43200
                    and expires > self.last_expiry
                )
                client = static_identity_client(metadata)
                identity = client.get_caller_identity()
                need(identity.get("Account") == legacy.ACCOUNT)
                principal = (identity.get("Arn"), identity.get("UserId"))
                need(all(type(v) is str and v for v in principal))
                need(self.principal is None or self.principal == principal)
                need(self.clock() < self.deadline - 20)
                need(math.floor(expires - self.wall()) > 300)
                self.principal, self.last_expiry = principal, expires
                return metadata
        except Exception:
            raise ValueError("controller_credential_refresh_failed") from None
        finally:
            if client is not None:
                client.close()


class IssuerManagement:
    """Use the shared SDK identity for IAM; preserve original limited STS issuers."""

    prefix = None

    def __init__(self, clients):
        need(set(clients) == {"sts", "iam"})
        self.clients = clients

    def cli(self, service, operation, **fields):
        need(
            (service == "sts" and operation == "get-caller-identity" and not fields)
            or (service == "iam" and operation in IAM_OPS)
        )
        if service == "iam":
            names = [fields[k] for k in ("UserName", "RoleName") if k in fields]
            need(len(names) == 1 and names[0] == self.prefix + network.selection.ATTEMPT)
        need("SecretAccessKey" not in fields and "SessionToken" not in fields)
        try:
            with joined.lifecycle.guard.provision.timeout(20):
                return getattr(self.clients[service], operation.replace("-", "_"))(**fields)
        except Exception as error:
            code = getattr(error, "response", {}).get("Error", {}).get("Code")
            raise acquisition.base.CloudError(
                "absent" if code == "NoSuchEntity" else "aws_call_failed"
            ) from None


class AcquisitionCloud(IssuerManagement, acquisition.Cloud):
    prefix = "lumi-acquire-"


class RetentionCloud(IssuerManagement, retention.Cloud):
    prefix = "lumi-retain-"


class Clients:
    def __init__(self, reader):
        from botocore.credentials import RefreshableCredentials

        need(type(reader) is Reader)
        self.reader, self.clients = reader, {}
        try:
            provider = RefreshableCredentials.create_from_metadata(
                reader(),
                refresh_using=reader,
                method="lumi-five-hour-controller",
                advisory_timeout=240,
                mandatory_timeout=240,
            )
            self.provider = provider
            sdk = session()
            sdk._credentials = provider  # Explicit memory-only provider, no profile fallback.
            for name in SERVICES:
                self.clients[name] = sdk.create_client(
                    name,
                    region_name="us-east-1",
                    endpoint_url=endpoint(name),
                    config=legacy.config(name),
                    verify=ca_path(),
                )
                self.clients[name].meta.events.register("before-call", reader.active)
        except BaseException:
            self.close()
            raise ValueError("controller_client_setup_failed") from None

    def adapters(self):
        c = self.clients
        need(not self.reader.closed and set(c) == set(SERVICES))
        management = {k: c[k] for k in ("sts", "iam")}
        return dict(
            host_cloud=joined.lifecycle.guard.provision.SDKCloud({k: c[k] for k in ("sts", "ec2")}),
            watchdog_cloud=joined.lifecycle.guard.SDKCloud(
                {k: c[k] for k in ("sts", "iam", "lambda", "scheduler")}
            ),
            bucket_cloud=joined.BucketReadCloud({"sts": c["sts"], "s3api": c["s3"]}),
            network_cloud=network.SDKCloud(c["ec2"]),
            acquisition_cloud=AcquisitionCloud(management),
            retention_cloud=RetentionCloud(management),
        )

    def close(self):
        self.reader.closed = True
        for client in self.clients.values():
            client.close()
        self.clients.clear()


def run(**_arguments):
    raise ValueError("controller_outer_execution_authority_required") from None
