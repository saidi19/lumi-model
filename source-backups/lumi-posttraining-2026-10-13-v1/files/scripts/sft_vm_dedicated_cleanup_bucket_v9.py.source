"""Fresh attempt-018 binding of the qualified one-shot cleanup bucket deployer."""

import hashlib
from pathlib import Path

from scripts import sft_vm_dedicated_cleanup_bucket_v8 as qualified

_qualified_expected_approval = qualified.expected_approval

ROOT = Path(__file__).resolve().parents[1]
QUALIFIED_SHA = "84f05bf571baea58478c46c2bbb4acc3dc4dd2ca23c2a397ed2f1d6afbefdeaf"
ACCOUNT = "573978149073"
REGION = "us-east-1"
ATTEMPT = "0532df93f0f2418bb6d467d3e5215759"
BUCKET = "lumi-cleanup-" + ATTEMPT
PREFIX = "lumi-corpus/v0.1/control/sft-import-research/" + ATTEMPT + "/network-cleanup/"
OUTPUT = ROOT / "artifacts/lumi-vm-attempt-018-cleanup-bucket-v0.1"
APPROVAL = ROOT / "configs/lumi-vm-attempt-018-cleanup-bucket-approval-v0.1.json"
HELPER = ROOT / "scripts/prepare_sft_vm_deployment_bindings_v12.py"
HELPER_SHA = "d87e4df415d39779433853ec8821df75b904f5ab927df741fe0abf7ed8f1408b"
PLAN = ROOT / "artifacts/lumi-vm-attempt-018-control-plan-v0.1/plan.json"
PLAN_SHA = "f361d8c0e285ee4c1593d837c780719b5115d6877fb069122010712da13e0f77"
MAX_CALLS, MAX_SECONDS, MAX_BYTES = 20, 300, 131072
BLOCK = dict(qualified.BLOCK)
ENCRYPTION = qualified.decode(qualified.encode(qualified.ENCRYPTION))
TAGS = [
    {"Key": "LumiAttempt", "Value": ATTEMPT},
    {"Key": "LumiPurpose", "Value": "cleanup-claims-only"},
]


def need(value):
    if not value:
        raise ValueError("attempt018_cleanup_bucket_rejected") from None


def bind():
    base = ROOT / "scripts/sft_vm_dedicated_cleanup_bucket_v8.py"
    need(hashlib.sha256(base.read_bytes()).hexdigest() == QUALIFIED_SHA)
    values = {
        "__file__": str(Path(__file__).resolve()),
        "ROOT": ROOT,
        "ACCOUNT": ACCOUNT,
        "REGION": REGION,
        "ATTEMPT": ATTEMPT,
        "BUCKET": BUCKET,
        "PREFIX": PREFIX,
        "OUTPUT": OUTPUT,
        "APPROVAL": APPROVAL,
        "HELPER": HELPER,
        "HELPER_SHA": HELPER_SHA,
        "PLAN": PLAN,
        "PLAN_SHA": PLAN_SHA,
        "MAX_CALLS": MAX_CALLS,
        "MAX_SECONDS": MAX_SECONDS,
        "MAX_BYTES": MAX_BYTES,
        "BLOCK": BLOCK,
        "ENCRYPTION": ENCRYPTION,
        "TAGS": TAGS,
        "expected_approval": expected_approval,
    }
    for key, value in values.items():
        setattr(qualified, key, value)
    return qualified


def encode(value):
    return bind().encode(value)


def decode(raw):
    return bind().decode(raw)


def sha(raw):
    return bind().sha(raw)


def policy():
    return bind().policy()


def requests():
    return bind().requests()


def sources():
    return bind().sources()


def expected_approval(message):
    bind()
    value = _qualified_expected_approval(message)
    value["schema"] = "lumi.attempt018-dedicated-cleanup-bucket-approval.v0.1"
    return value


def authorize():
    return bind().authorize()


def run(*, cloud=None, clock=qualified.time.monotonic):
    return bind().run(cloud=cloud, clock=clock)


if __name__ == "__main__":
    print(encode(run()).decode(), end="")
