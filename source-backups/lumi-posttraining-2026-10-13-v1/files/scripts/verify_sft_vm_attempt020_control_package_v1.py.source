"""Offline verification of the unapproved attempt-020 control package."""

from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path

from scripts import execute_sft_vm_inert_watchdog_v13 as watchdog
from scripts import sft_vm_dedicated_cleanup_bucket_v11 as cleanup

ROOT = Path(__file__).resolve().parents[1]
PLAN = "artifacts/lumi-vm-attempt-020-control-plan-v0.2/plan.json"
PLAN_SHA = "6e3a355033b684f11900bf189d17b06e6cb5fe3c43dccfa021015d47f4439ee4"
HELPER = "scripts/prepare_sft_vm_deployment_bindings_v21.py"
HELPER_SHA = "2edc65d2a7e476fd206758aa9afbb3c3c6608fb8970c53fa7a8e057481be14f5"
WATCH_ENTRY = "scripts/execute_sft_vm_inert_watchdog_v13.py"
WATCH_ENTRY_SHA = "927329abb83f7b59f39d486d81f77b3ca8d9473fc413a2f10a7b4f2051e61d3c"
WATCH_TEST = "tests/test_sft_vm_inert_watchdog_v13.py"
WATCH_TEST_SHA = "23a9db38a7f7b00c860aaa74fa8b81dfb0ae6c49cf5933a012064504ecf9e6ef"
WATCH_PROPOSAL = "configs/lumi-vm-attempt-020-watchdog-execution-proposal-v0.1.json"
WATCH_PROPOSAL_SHA = "ad286f37e275238ba34672eee0c5332de85ecb752fbcff5a14cc743d8a65aed8"
CLEAN_ENTRY = "scripts/sft_vm_dedicated_cleanup_bucket_v11.py"
CLEAN_ENTRY_SHA = "43352490e179943e258b43c124194e37b37045a78fada130f937cb5e084690ca"
CLEAN_TEST = "tests/test_sft_vm_dedicated_cleanup_bucket_v11.py"
CLEAN_TEST_SHA = "e813505c82015febfe3565321397a8a57dd0bc59f3c15d11e8dd561814899f10"
CLEAN_PROPOSAL = "configs/lumi-vm-attempt-020-cleanup-bucket-proposal-v0.1.json"
CLEAN_PROPOSAL_SHA = "1a623b0e3ae06512ea5a91eb099bf013cd2807182ad5f9af641c14e4e1182ffb"
ABSENCE_VERIFY = "evidence/lumi-vm-attempt-020-control-target-absence-verification-v0.1.json"
ABSENCE_VERIFY_SHA = "27a0307e34622c4522a32416ce3413282f800e17e586b50fc9cc1e0c057071c1"
OUTPUT = ROOT / "evidence/lumi-vm-attempt-020-control-package-verification-v0.1.json"


def need(value):
    if not value:
        raise ValueError("attempt020_control_package_verification_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def read(name, digest):
    path = ROOT / name
    need(not any(item.is_symlink() for item in (path, *path.parents)))
    need(path.is_file() and 0 < path.stat().st_size <= 128 * 1024)
    raw = path.read_bytes()
    need(sha(raw) == digest)
    return raw


def verify():
    for name, digest in (
        (PLAN, PLAN_SHA),
        (HELPER, HELPER_SHA),
        (WATCH_ENTRY, WATCH_ENTRY_SHA),
        (WATCH_TEST, WATCH_TEST_SHA),
        (WATCH_PROPOSAL, WATCH_PROPOSAL_SHA),
        (CLEAN_ENTRY, CLEAN_ENTRY_SHA),
        (CLEAN_TEST, CLEAN_TEST_SHA),
        (CLEAN_PROPOSAL, CLEAN_PROPOSAL_SHA),
        (ABSENCE_VERIFY, ABSENCE_VERIFY_SHA),
    ):
        read(name, digest)
    watch_raw = read(WATCH_PROPOSAL, WATCH_PROPOSAL_SHA)
    clean_raw = read(CLEAN_PROPOSAL, CLEAN_PROPOSAL_SHA)
    watch_value = watchdog.decode(watch_raw)
    clean_value = cleanup.decode(clean_raw)
    absence = json.loads(read(ABSENCE_VERIFY, ABSENCE_VERIFY_SHA))
    need(
        watchdog.encode(watch_value) == watchdog.encode(watchdog.expected_proposal())
        and cleanup.encode(clean_value) == cleanup.encode(cleanup.expected_proposal())
        and watch_value["plan_sha256"] == clean_value["plan_sha256"] == PLAN_SHA
        and watch_value["helper_sha256"] == clean_value["helper_sha256"] == HELPER_SHA
        and watch_value["entry_sha256"] == WATCH_ENTRY_SHA
        and clean_value["entry_sha256"] == CLEAN_ENTRY_SHA
        and watch_value["execution_permitted"] is False
        and clean_value["execution_permitted"] is False
        and absence["status"] == "fresh_targets_absent_and_predecessor_retention_verified"
        and absence["cloud_mutations"] == 0
        and absence["fresh_target_collisions"] == 0
        and not watchdog.APPROVAL.exists()
        and not cleanup.APPROVAL.exists()
        and not watchdog.OUTPUT.exists()
        and not cleanup.OUTPUT.exists()
    )
    return {
        "schema": "lumi.vm-attempt020-control-package-verification.v0.1",
        "attempt": watchdog.ATTEMPT,
        "status": "control_package_prepared_not_authorized",
        "plan_sha256": PLAN_SHA,
        "helper_sha256": HELPER_SHA,
        "watchdog": {
            "proposal_sha256": WATCH_PROPOSAL_SHA,
            "entry_sha256": WATCH_ENTRY_SHA,
            "maximum_seconds": 600,
            "maximum_control_calls": 45,
            "maximum_new_roles": 2,
            "maximum_new_functions": 1,
            "maximum_new_log_groups": 1,
            "invocation": False,
            "schedule_creation": False,
        },
        "cleanup_bucket": {
            "proposal_sha256": CLEAN_PROPOSAL_SHA,
            "entry_sha256": CLEAN_ENTRY_SHA,
            "maximum_seconds": 300,
            "maximum_calls": 20,
            "fixed_mutations": 6,
            "shared_bucket_mutation": False,
            "object_access": False,
            "iam_mutation": False,
        },
        "approval_files_present": False,
        "deployment_outputs_present": False,
        "cloud_calls": 0,
        "cloud_mutations": 0,
        "execution_authority_created": False,
        "cpu_instance_launched": False,
        "checkpoint_access": False,
        "real_4b_import": False,
        "gate_5_complete": False,
        "gpu": False,
        "training": False,
    }


def write():
    result = verify()
    raw = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    need(not OUTPUT.exists() and not OUTPUT.is_symlink())
    fd = os.open(OUTPUT, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    with os.fdopen(fd, "wb") as stream:
        need(stream.write(raw) == len(raw))
    return result


if __name__ == "__main__":
    need(sys.argv in ([sys.argv[0]], [sys.argv[0], "--write"]))
    print(json.dumps(write() if len(sys.argv) == 2 else verify(), sort_keys=True))
