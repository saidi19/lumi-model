"""One-shot exact attempt-006 cleanup; no creation, replay, model reads or training."""

import hashlib
import json
import math
import os
import re
import signal
import time
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PROPOSAL = "configs/lumi-vm-v06-leftover-cleanup-proposal-v0.2.json"
PROPOSAL_SHA = "e350b3b28359d9de00f1eab48702b9a2f03a3ea820c922fb8dca1aa34c32b4ce"
APPROVAL = "configs/lumi-vm-v06-leftover-cleanup-approval-v0.2.json"
OUTPUT = "artifacts/lumi-vm-v06-leftover-cleanup-v0.2"
ACCOUNT = "573978149073"
ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
NONCE = "d753b0b8cbda4fde8ae8c64425696aa1"
VPC = "vpc-0905fbf9490a2dead"
VM, EP = "sg-0498da19671ca347e", "sg-085e0ea72babd44d1"
ENDPOINT = "eice-07aff6ac7f4bd5491"
SUBNET, TABLE = "subnet-0d234a4f92365457b", "rtb-09df0bb62501bb995"
PUBLIC_SUBNET = "subnet-0dc6039a6453f7c95"
NAT, EIP = "nat-0ade5f222f766898b", "eipalloc-02bfac6c312f37b2a"
KEY_NAME = "lumi-fullsize-" + ATTEMPT
BUCKET = "lumi-corpus-prod-27777c02b29b76efcac3"
PREFIX = f"lumi-corpus/v0.1/control/sft-import-research/{ATTEMPT}/network-cleanup/{NONCE}/"
READS = {"get_caller_identity", "describe_security_groups", "describe_key_pairs",
         "describe_instances", "describe_network_interfaces", "get_object",
         "describe_security_group_references", "describe_security_group_vpc_associations",
         "describe_instance_connect_endpoints", "describe_subnets", "describe_route_tables",
         "describe_nat_gateways", "describe_addresses"}
WRITES = {"revoke_security_group_ingress", "revoke_security_group_egress",
          "delete_security_group", "delete_key_pair", "delete_instance_connect_endpoint",
          "disassociate_route_table", "delete_route_table", "delete_subnet"}
ABSENT = {
    ("describe_security_groups", "InvalidGroup.NotFound"): "SecurityGroups",
    ("describe_key_pairs", "InvalidKeyPair.NotFound"): "KeyPairs",
    ("describe_subnets", "InvalidSubnetID.NotFound"): "Subnets",
    ("describe_route_tables", "InvalidRouteTableID.NotFound"): "RouteTables",
    ("describe_addresses", "InvalidAllocationID.NotFound"): "Addresses",
    ("describe_nat_gateways", "NatGatewayNotFound"): "NatGateways",
}
LOCAL_ROUTE = dict(DestinationCidrBlock="172.31.0.0/16", GatewayId="local",
                   Origin="CreateRouteTable", State="active")


def need(value):
    if not value:
        raise ValueError("cleanup_validation_failed")


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str).encode()


def ssh(group):
    return dict(IpProtocol="tcp", FromPort=22, ToPort=22,
                UserIdGroupPairs=[dict(GroupId=group, UserId=ACCOUNT)])


HTTPS = dict(IpProtocol="tcp", FromPort=443, ToPort=443, IpRanges=[dict(CidrIp="0.0.0.0/0")])


class Journal:
    def __init__(self, path):
        path.mkdir(mode=0o700, parents=False, exist_ok=False)
        self.path, self.written = path, 0

    def save(self, name, value):
        raw = canonical(value)
        need(self.written + len(raw) <= 262144)
        self.written += len(raw)
        fd = os.open(self.path / (name + ".json"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())


class Cleanup:
    def __init__(self, clients, save, material, normalize, *, clock=time.monotonic,
                 wait=time.sleep, deadline=None):
        self.clients, self.save, self.material, self.normalize = clients, save, material, normalize
        self.clock, self.start = clock, clock()
        self.calls, self.response_bytes, self.writes = 0, 0, 0
        self.wait = wait
        self.deadline = self.start + 890 if deadline is None else deadline
        need(math.isfinite(self.deadline) and 0 < self.deadline - self.start <= 900)
        self.last_clock = self.start
        self.consumed = set()
        self.endpoint_enis = None
        self.endpoint_removed = False
        self.association_id = None
        self.association_resolved = False
        self.endpoint_polls = 0
        self.stage, self.key_id = "identity", None
        self.failure_code = "validation_failed"
        self.check = "initial"
        self.association_queries, self.association_pages = 0, 0
        self.rules = {VM: ([ssh(EP)], [HTTPS]), EP: ([], [ssh(VM)])}
        self.absent = []
        self.admitted = False

    def call(self, operation, **fields):
        self.check = operation
        need(operation in READS | WRITES and self.calls < 128)
        self.active()
        self.calls += 1
        client = self.clients["sts" if operation == "get_caller_identity" else
                              "s3" if operation == "get_object" else "ec2"]
        try:
            value = getattr(client, operation)(**fields)
        except Exception as error:
            response = getattr(error, "response", {})
            self.account_response(response)
            code = response.get("Error", {}).get("Code")
            empty = ABSENT.get((operation, code))
            if empty:
                return {empty: []}
            self.failure_code = code if code in {
                "ExpiredToken", "ExpiredTokenException", "AccessDenied", "UnauthorizedOperation",
                "DependencyViolation", "InvalidParameterValue", "RequestLimitExceeded",
            } else "cloud_call_failed"
            raise ValueError("cleanup_cloud_call_failed") from None
        self.active(reserve=0)
        self.account_response({k: v for k, v in value.items() if k != "Body"})
        self.check = "response_pagination"
        fields = ("NextToken", "nextToken", "IsTruncated")
        if operation == "describe_security_group_vpc_associations":
            fields = ("nextToken", "IsTruncated")
        need(not any(value.get(k) for k in fields))
        return value

    def account_response(self, value):
        size = len(canonical(value))
        self.response_bytes += size
        need(size <= 262144 and self.response_bytes <= 4194304)

    def owned(self, row):
        self.check = "attempt_ownership"
        need([t.get("Value") for t in row.get("Tags", [])
              if t.get("Key") == "LumiAttempt"] == [ATTEMPT])

    def group(self, row):
        self.check = "group_identity"
        group = row["GroupId"]
        need(group in self.rules and row["OwnerId"] == ACCOUNT and row["VpcId"] == VPC)
        need(row["GroupName"] == KEY_NAME + ("-vm" if group == VM else "-endpoint"))
        self.owned(row)
        self.check = "group_rules"
        for field, expected in zip(("IpPermissions", "IpPermissionsEgress"),
                                   self.rules[group], strict=True):
            actual = [{k: v for k, v in rule.items() if v != []} for rule in row[field]]
            need(canonical(actual) == canonical(expected))

    def active(self, reserve=10):
        now = self.clock()
        need(math.isfinite(now) and self.last_clock <= now < self.deadline - reserve)
        self.last_clock = now

    def groups(self):
        rows = self.call("describe_security_groups", Filters=[
            dict(Name="group-id", Values=[VM, EP])])["SecurityGroups"]
        need(type(rows) is list and len(rows) == len(self.rules))
        need({r["GroupId"] for r in rows} == set(self.rules))
        for row in rows:
            self.group(row)

    def key(self):
        fields = dict(KeyPairIds=[self.key_id]) if self.key_id else dict(KeyNames=[KEY_NAME])
        rows = self.call("describe_key_pairs", IncludePublicKey=True, **fields)["KeyPairs"]
        self.check = "key_shape"
        need(len(rows) == 1)
        row = rows[0]
        self.owned(row)
        self.check = "key_identity_and_material"
        need(row["KeyName"] == KEY_NAME and row["KeyType"] == "ed25519")
        need(re.fullmatch(r"key-[0-9a-f]{17}", row["KeyPairId"]))
        need(self.key_id is None or row["KeyPairId"] == self.key_id)
        need(self.normalize(row["PublicKey"].encode()) == self.material)
        if self.key_id is None:
            self.key_id = row["KeyPairId"]
            self.save("resolved-key", {"key_pair_id": self.key_id, "material_matches": True})

    def instances(self, subnet_only=False):
        filters = [("subnet-id", [SUBNET])] if subnet_only else [
            ("tag:LumiAttempt", [ATTEMPT]), ("key-name", [KEY_NAME]),
            ("instance.group-id", [VM, EP]), ("subnet-id", [SUBNET])]
        for name, values in filters:
            rows = self.call("describe_instances", Filters=[dict(Name=name, Values=values)],
                             MaxResults=100)["Reservations"]
            self.check = "instance_dependency"
            need(type(rows) is list)
            for row in rows:
                need(type(row["Instances"]) is list)
                need(all(i["State"]["Name"] == "terminated" for i in row["Instances"]))

    def enis(self, allow_endpoint=False, subnet_only=False):
        filters = [("subnet-id", [SUBNET])]
        if not subnet_only:
            filters.append(("group-id", [VM, EP]))
        for name, values in filters:
            rows = self.call("describe_network_interfaces",
                            Filters=[dict(Name=name, Values=values)],
                            MaxResults=100)["NetworkInterfaces"]
            self.check = "network_interface_dependency"
            need(type(rows) is list)
            ids = [r["NetworkInterfaceId"] for r in rows]
            need(len(ids) == len(set(ids)))
            if allow_endpoint:
                need(self.endpoint_enis is not None and set(ids) == self.endpoint_enis)
                for row in rows:
                    need(row["VpcId"] == VPC and row["SubnetId"] == SUBNET)
                    need(row["OwnerId"] == ACCOUNT)
                    need([g["GroupId"] for g in row["Groups"]] == [EP])
            else:
                need(not rows)

    def dependencies(self):
        self.instances()
        self.enis(allow_endpoint=not self.endpoint_removed)
        ids = list(self.rules)
        if not ids:
            return
        for name in ("ip-permission.group-id", "egress.ip-permission.group-id"):
            rows = self.call("describe_security_groups", Filters=[
                dict(Name="vpc-id", Values=[VPC]), dict(Name=name, Values=ids)],
                MaxResults=100)["SecurityGroups"]
            need(type(rows) is list)
            for row in rows:
                self.group(row)
        response = self.call("describe_security_group_references", GroupId=ids)
        need(response["SecurityGroupReferenceSet"] == [])
        self.empty_associations([dict(Name="group-id", Values=ids)])

    def empty_associations(self, filters):
        self.association_queries += 1
        seen, token = set(), None
        for _ in range(8):
            fields = dict(Filters=filters, MaxResults=100)
            if token is not None:
                fields["NextToken"] = token
            self.association_pages += 1
            response = self.call("describe_security_group_vpc_associations", **fields)
            self.check = "association_list_shape"
            rows = response.get("SecurityGroupVpcAssociations")
            need(type(rows) is list)
            self.check = "association_rows_present"
            need(not rows)
            token = response.get("NextToken")
            self.check = "association_token_shape"
            need(token is None or type(token) is str)
            if token is None or token == "":
                return
            need(0 < len(token) <= 8192)
            self.check = "association_token_cycle"
            need(token not in seen)
            seen.add(token)
        self.check = "association_page_cap"
        need(False)

    def endpoint(self, deleting=False):
        rows = self.call("describe_instance_connect_endpoints", Filters=[
            dict(Name="subnet-id", Values=[SUBNET])], MaxResults=50)["InstanceConnectEndpoints"]
        self.check = "endpoint_list"
        need(type(rows) is list)
        if deleting and not rows:
            return True
        need(len(rows) == 1)
        row = rows[0]
        self.owned(row)
        self.check = "endpoint_identity"
        need(row["InstanceConnectEndpointId"] == ENDPOINT and row["VpcId"] == VPC)
        need(row["SubnetId"] == SUBNET and row["OwnerId"] == ACCOUNT)
        need(row["SecurityGroupIds"] == [EP] and row["PreserveClientIp"] is False)
        ids = row["NetworkInterfaceIds"]
        need(type(ids) is list and len(ids) == len(set(ids)))
        need(all(re.fullmatch(r"eni-[0-9a-f]{17}", i) for i in ids))
        if self.endpoint_enis is None:
            need(bool(ids))
            self.endpoint_enis = set(ids)
        else:
            # AWS may clear the ID list once deletion is complete, never introduce new IDs.
            need(set(ids) <= self.endpoint_enis if deleting else set(ids) == self.endpoint_enis)
        state = row["State"]
        self.check = "endpoint_state"
        need(state in ({"create-complete", "delete-in-progress", "delete-complete"} if deleting
                       else {"create-complete"}))
        return state == "delete-complete"

    def endpoint_gone(self):
        for index in range(30):
            self.endpoint_polls += 1
            if self.endpoint(deleting=True):
                # Preserve exact endpoint ENI identities as well as subnet/group filters.
                rows = self.call("describe_network_interfaces", Filters=[
                    dict(Name="network-interface-id", Values=sorted(self.endpoint_enis))],
                    MaxResults=100)["NetworkInterfaces"]
                need(type(rows) is list)
                if not rows:
                    self.enis()
                    self.endpoint_removed = True
                    return
            if index < 29:
                self.active(reserve=15)
                self.wait(5)
        self.check = "endpoint_deletion_poll_cap"
        need(False)

    def network_row(self, kind, absent=False):
        op, arg, key, field, expected = {
            "subnet": ("describe_subnets", "SubnetIds", "Subnets", "SubnetId", SUBNET),
            "table": ("describe_route_tables", "RouteTableIds", "RouteTables",
                      "RouteTableId", TABLE)}[kind]
        rows = self.call(op, **{arg: [expected]})[key]
        self.check = "network_resource_presence"
        need(type(rows) is list)
        if absent:
            need(not rows)
            return None
        need(len(rows) == 1)
        row = rows[0]
        self.owned(row)
        self.check = "network_identity_and_nonce"
        need(row[field] == expected and row["VpcId"] == VPC and row["OwnerId"] == ACCOUNT)
        need([t.get("Value") for t in row.get("Tags", [])
              if t.get("Key") == "LumiNetworkNonce"] == [NONCE])
        if kind == "subnet":
            need(row["CidrBlock"] == "172.31.96.0/27")
            need(row["AvailabilityZone"] == "us-east-1a" and row["State"] == "available")
        return row

    def table(self, cleared=False):
        row = self.network_row("table")
        self.check = "table_routes_and_association"
        need(row["Routes"] == [LOCAL_ROUTE] and row["PropagatingVgws"] == [])
        rows = row["Associations"]
        need(type(rows) is list and len(rows) <= 1)
        assoc = None
        if rows:
            a = rows[0]
            need(a["Main"] is False and a["SubnetId"] == SUBNET and a["RouteTableId"] == TABLE)
            need(a["AssociationState"]["State"] == "associated")
            assoc = a["RouteTableAssociationId"]
            need(re.fullmatch(r"rtbassoc-[0-9a-f]{17}", assoc))
        if not self.association_resolved:
            self.association_id, self.association_resolved = assoc, True
            self.save("resolved-association", dict(association_id=assoc))
        need(assoc == (None if cleared else self.association_id))

    def released_and_claims(self):
        rows = self.call("describe_nat_gateways", NatGatewayIds=[NAT])["NatGateways"]
        self.check = "released_nat_rows_shape"
        need(type(rows) is list and len(rows) <= 1)
        if rows:
            self.check = "released_nat_identity_and_state"
            need(rows[0]["NatGatewayId"] == NAT and rows[0]["State"] == "deleted")
            self.check = "released_nat_vpc_and_public_subnet"
            need(rows[0]["VpcId"] == VPC and rows[0]["SubnetId"] == PUBLIC_SUBNET)
        addresses = self.call("describe_addresses", AllocationIds=[EIP])["Addresses"]
        self.check = "released_eip_absence"
        need(addresses == [])
        for operation, resource in (("delete-nat-gateway", NAT), ("release-address", EIP)):
            response = self.call("get_object", Bucket=BUCKET, Key=PREFIX + operation + ".json",
                                 ExpectedBucketOwner=ACCOUNT)
            stream = response["Body"]
            try:
                self.check = "cleanup_claim_body"
                size = response["ContentLength"]
                need(type(size) is int and 0 < size <= 512)
                raw = stream.read(513)
                need(type(raw) is bytes and len(raw) == response["ContentLength"] <= 512)
                self.response_bytes += len(raw)
                need(self.response_bytes <= 4194304)
                claim = json.loads(raw, object_pairs_hook=unique)
                need(claim == dict(attempt=ATTEMPT, nonce=NONCE,
                                   operation=operation, resource=resource))
            finally:
                stream.close()

    def empty_subnet(self, association_expected):
        self.network_row("subnet")
        self.instances(subnet_only=True)
        self.enis(subnet_only=True)
        need(self.endpoint(deleting=True))
        rows = self.call("describe_nat_gateways", Filter=[
            dict(Name="subnet-id", Values=[SUBNET])], MaxResults=100)["NatGateways"]
        need(type(rows) is list and all(r["State"] == "deleted" for r in rows))
        rows = self.call("describe_route_tables", Filters=[
            dict(Name="association.subnet-id", Values=[SUBNET])])["RouteTables"]
        need(type(rows) is list)
        if association_expected:
            need(len(rows) == 1 and rows[0]["RouteTableId"] == TABLE)
            # The separately authenticated exact table is checked immediately before write.
        else:
            need(not rows)

    def mutate(self, operation, fields, verify):
        identity = canonical([operation, fields])
        need(operation in WRITES and self.writes < 9 and identity not in self.consumed)
        self.active()
        need(self.calls < 128)
        self.consumed.add(identity)
        self.writes += 1
        self.save(f"mutation-{self.writes:02d}", dict(operation=operation, parameters=fields,
                                                     started=True, retry_allowed=False))
        try:
            response = self.call(operation, **fields)
            need(response.get("ResponseMetadata", {}).get("HTTPStatusCode") == 200)
            if operation == "delete_instance_connect_endpoint":
                row = response["InstanceConnectEndpoint"]
                need(row["InstanceConnectEndpointId"] == ENDPOINT)
                need(row["State"] in {"delete-in-progress", "delete-complete"})
            elif operation not in {
                "disassociate_route_table", "delete_route_table", "delete_subnet"
            }:
                need(response.get("Return") is True)
                need(not response.get("UnknownIpPermissions"))
                if operation == "delete_key_pair" and "KeyPairId" in response:
                    need(response["KeyPairId"] == self.key_id)
                if operation == "delete_security_group" and "GroupId" in response:
                    need(response["GroupId"] == fields["GroupId"])
        except Exception:
            verified = False
            try:
                verify()
                verified = True
            except Exception:
                pass
            self.save("uncertain-mutation", dict(index=self.writes, readback_matched=verified))
            raise ValueError("cleanup_mutation_uncertain") from None
        verify()
        self.save(f"verified-{self.writes:02d}", dict(operation=operation, verified=True))

    def key_gone(self):
        need(self.call("describe_key_pairs", KeyPairIds=[self.key_id])["KeyPairs"] == [])

    def run(self):
        need(self.call("get_caller_identity")["Account"] == ACCOUNT)
        self.stage = "initial_admission"
        self.groups()
        self.key()
        self.endpoint()
        self.network_row("subnet")
        self.table()
        self.dependencies()
        self.released_and_claims()
        self.admitted = True
        self.stage = "endpoint_deletion"
        self.endpoint()
        self.mutate("delete_instance_connect_endpoint",
                    dict(InstanceConnectEndpointId=ENDPOINT), self.endpoint_gone)
        for index in range(4):
            self.stage = f"group_admission_{index + 1}"
            self.groups()
            self.dependencies()
            self.stage = f"group_mutation_{index + 1}"
            if index == 0:
                self.rules[VM] = ([], [HTTPS])
                self.mutate("revoke_security_group_ingress",
                            dict(GroupId=VM, IpPermissions=[ssh(EP)]), self.groups)
            elif index == 1:
                self.rules[EP] = ([], [])
                self.mutate("revoke_security_group_egress",
                            dict(GroupId=EP, IpPermissions=[ssh(VM)]), self.groups)
            else:
                group = EP if index == 2 else VM
                del self.rules[group]
                self.absent.append(group)
                self.mutate("delete_security_group", dict(GroupId=group), self.groups)
        self.stage = "key_deletion"
        self.groups()
        self.key()
        self.dependencies()
        self.mutate("delete_key_pair", dict(KeyPairId=self.key_id), self.key_gone)
        self.stage = "network_disassociation"
        self.empty_subnet(association_expected=self.association_id is not None)
        self.table()
        if self.association_id:
            self.mutate("disassociate_route_table", dict(AssociationId=self.association_id),
                        lambda: self.table(cleared=True))
        self.stage = "table_deletion"
        self.table(cleared=True)
        self.mutate("delete_route_table", dict(RouteTableId=TABLE),
                    lambda: self.network_row("table", absent=True))
        self.stage = "subnet_deletion"
        self.empty_subnet(association_expected=False)
        self.mutate("delete_subnet", dict(SubnetId=SUBNET),
                    lambda: self.network_row("subnet", absent=True))
        self.stage = "final_verification"
        self.groups()
        self.key_gone()
        need(self.endpoint(deleting=True))
        self.enis()
        self.network_row("table", absent=True)
        self.network_row("subnet", absent=True)
        self.stage = "cleanup_verified"


def unique(pairs):
    result = {}
    for key, value in pairs:
        need(key not in result)
        result[key] = value
    return result


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def authenticate(root):
    need(digest(root / PROPOSAL) == PROPOSAL_SHA)
    plan = json.loads((root / PROPOSAL).read_text(), object_pairs_hook=unique)
    approval = json.loads((root / APPROVAL).read_text(), object_pairs_hook=unique)
    need(approval["proposal_sha256"] == PROPOSAL_SHA)
    need(approval["execution_permitted"] is True and approval["human_approval"] == "ok shuru kor")
    need(approval["execution_count"] == 1 and approval["retry_allowed"] is False)
    need(approval["bindings"]["scripts/cleanup_sft_vm_v06_leftovers_v2.py"] ==
         digest(root / "scripts/cleanup_sft_vm_v06_leftovers_v2.py"))
    for name, expected in (plan["bindings"] | approval["bindings"]).items():
        path = root / name
        need(not path.is_symlink() and path.resolve().is_relative_to(root.resolve()))
        need(not name.endswith("/connection-key"))
        need(digest(path) == expected)
    name = next(n for n in plan["bindings"] if n.startswith("evidence/"))
    outcome = json.loads((root / name).read_text(), object_pairs_hook=unique)
    for name, expected in outcome["bindings"].items():
        path = root / name
        need(not path.is_symlink() and path.resolve().is_relative_to(root.resolve()))
        need(not name.endswith("/connection-key"))
        need(digest(path) == expected)
    need(outcome["execution"]["host_launch_attempted"] is False)
    need(outcome["cleanup"]["nat_deleted_and_eip_released_verified"] is True)
    need(outcome["cleanup"]["unknown_creation_kinds"] == [])
    return plan


def effective_deadline(started, now, credential_seconds):
    need(math.isfinite(credential_seconds) and credential_seconds > 360)
    end = min(started + 890, now + credential_seconds - 60)
    need(end - now > 300)
    return end


def main():
    plan = authenticate(ROOT)
    journal = Journal(ROOT / OUTPUT)
    journal.save("started", dict(approval_sha256=digest(ROOT / APPROVAL), attempt=ATTEMPT,
                                 proposal_sha256=PROPOSAL_SHA, retry_allowed=False))
    started, clients, worker = time.monotonic(), [], None
    result = dict(status="stopped", stage="local_imports", calls=0, mutations=0,
                  cleanup_verified=False, private_key_read=False, instance_actions=0,
                  real_4b_import=False, gate_5_complete=False, gpu_used=False,
                  training_started=False, credential_provider_invocations=0)
    def expired(*_):
        raise TimeoutError("cleanup_deadline")
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, 900)
    try:
        import provision_sft_vm_host_v3 as parser
        import sft_vm_controller_credentials_v2 as credentials
        from botocore.config import Config
        result["stage"] = "credential_export"
        result["credential_provider_invocations"] = 1
        value = json.loads(credentials.export_credentials(), object_pairs_hook=unique)
        result["stage"] = "credential_schema"
        need(type(value["Version"]) is int and value["Version"] == 1)
        expiry = datetime.fromisoformat(value["Expiration"].replace("Z", "+00:00"))
        result["stage"] = "credential_lifetime"
        remaining = (expiry - datetime.now(UTC)).total_seconds()
        result["credential_remaining_seconds"] = int(remaining)
        end = effective_deadline(started, time.monotonic(), remaining)
        result["effective_runtime_cap_seconds"] = round(end - started, 3)
        secret = dict(aws_access_key_id=value["AccessKeyId"],
                      aws_secret_access_key=value["SecretAccessKey"],
                      aws_session_token=value["SessionToken"])
        need(all(type(v) is str and 0 < len(v) <= 16384 for v in secret.values()))
        result["stage"] = "client_setup"
        session = credentials.session()
        for service in ("sts", "ec2", "s3"):
            clients.append(session.create_client(service, region_name="us-east-1",
                endpoint_url=credentials.endpoint(service), verify=credentials.ca_path(),
                config=Config(proxies={}, connect_timeout=3, read_timeout=5,
                              retries={"total_max_attempts": 1},
                              ignore_configured_endpoint_urls=True), **secret))
        secret.clear()
        value.clear()
        result["stage"] = "public_key_validation"
        public = next(name for name in plan["bindings"] if name.endswith("connection-key.pub"))
        material = parser.public_key((ROOT / public).read_bytes())
        worker = Cleanup(dict(zip(("sts", "ec2", "s3"), clients, strict=True)), journal.save,
                         material, parser.readback_public_key, deadline=end)
        worker.run()
        result.update(status="completed", cleanup_verified=True)
    except Exception:
        result["failure_code"] = worker.failure_code if worker else result["stage"] + "_failed"
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        if worker is not None:
            result.update(stage=worker.stage, calls=worker.calls, mutations=worker.writes,
                          response_bytes=worker.response_bytes, key_pair_id=worker.key_id,
                          check=worker.check, association_queries=worker.association_queries,
                          association_pages=worker.association_pages,
                          endpoint_polls=worker.endpoint_polls,
                          endpoint_removed=worker.endpoint_removed,
                          association_id=worker.association_id)
        result["elapsed_seconds"] = round(time.monotonic() - started, 3)
        journal.save("result", result)
        for client in clients:
            client.close()
    print(json.dumps(result, sort_keys=True))
    return 0 if result["cleanup_verified"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
