"""One synthetic Linux firewall/timer qualification; no model or S3 access."""

import base64
import hashlib
import json
import math
import os
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import types
from pathlib import Path

BASE = Path("/opt/lumi-network-probe")
PIN = "1e4ae4078af9fd024d2ae2988b3f265010acd6c4d65d126f60e574960c4d99f7"


def run(argv, *, body=None, timeout=10):
    result = subprocess.run(argv, input=body, capture_output=True, timeout=timeout)
    if result.returncode:
        # Only commands applied to this generated firewall/OS setup run here.
        raise RuntimeError("command_failed")
    if len(result.stdout) > 65536:
        raise RuntimeError("command_output_limit")
    return result.stdout


def policy():
    raw = (BASE / "policy.py").read_bytes()
    assert hashlib.sha256(raw).hexdigest() == PIN
    module = types.ModuleType("_frozen_policy")
    exec(compile(raw, "policy.py", "exec"), module.__dict__)
    return module


def nft(document):
    return run(["/usr/sbin/nft", "--json", "--file", "-"], body=json.dumps(document).encode())


def snapshot(p):
    return run(["/usr/sbin/nft", "--json", "--numeric", "list", "table", "inet", p.TABLE])


def transfer(port, size, family=socket.AF_INET):
    address = "127.0.0.1" if family == socket.AF_INET else "::1"
    listener = socket.socket(family, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.settimeout(2)
    listener.bind((address, port))
    listener.listen(1)

    def serve():
        try:
            connection, _ = listener.accept()
            with connection:
                connection.settimeout(2)
                connection.sendall(b"x" * size)
        except OSError:
            pass
        finally:
            listener.close()

    thread = threading.Thread(target=serve)
    thread.start()
    received = 0
    try:
        with socket.socket(family, socket.SOCK_STREAM) as client:
            client.settimeout(2)
            client.connect((address, port))
            while received < size:
                raw = client.recv(min(4096, size - received))
                if not raw:
                    break
                received += len(raw)
    except OSError:
        pass
    thread.join(3)
    assert not thread.is_alive()
    return received


def child():
    signal.alarm(60)
    p = policy()
    run(["/usr/sbin/ip", "link", "set", "lo", "up"])
    report = {"isolated_network_namespace": True}
    phase = "exact_policy_syntax"
    try:
        run(
            ["/usr/sbin/nft", "--check", "--json", "--file", "-"],
            body=json.dumps(p.install_policy()).encode(),
        )
        report["exact_policy_syntax"] = True
        phase = "exact_policy_create"
        nft(p.install_policy())
        raw = snapshot(p)
        report["exact_readback"] = json.loads(raw)  # Own generated policy only, no payload.
        try:
            p.inspect(raw)
            report["exact_inspector_accepts"] = True
        except ValueError:
            report["exact_inspector_accepts"] = False
        # Separate generated fixture only; frozen source/constants stay unchanged.
        p.TABLE = "lumi_synthetic_fixture"
        p.QUOTAS = {"all_in": 131072, "setup_in": 16384, "all_out": 131072}
        phase = "fixture_create"
        nft(p.install_policy())
        assert transfer(443, 1024) == 1024
        first = json.loads(snapshot(p))
        quotas = {r["quota"]["name"]: r["quota"]["used"] for r in first["nftables"] if "quota" in r}
        report["both_inbound_quotas_count_setup"] = quotas["all_in"] > 0 and quotas["setup_in"] > 0
        gate = [
            r["rule"]["handle"]
            for r in first["nftables"]
            if "rule" in r and r["rule"]["chain"] == "setup_gate"
        ]
        assert len(gate) == 1
        nft(
            {
                "nftables": [
                    {
                        "delete": {
                            "rule": {
                                "family": "inet",
                                "table": p.TABLE,
                                "chain": "setup_gate",
                                "handle": gate[0],
                            }
                        }
                    }
                ]
            }
        )
        report["after_gate_removal_received_bytes"] = transfer(443, 32768)
        after = json.loads(snapshot(p))
        used = {r["quota"]["name"]: r["quota"]["used"] for r in after["nftables"] if "quota" in r}
        report["setup_counter_preserved"] = used["setup_in"] == quotas["setup_in"]
        report["combined_counter_increased"] = used["all_in"] > quotas["all_in"]
        report["http_blocked"] = transfer(80, 1) == 0
        report["ipv6_https_blocked"] = transfer(443, 1, socket.AF_INET6) == 0
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as receiver:
            receiver.bind(("127.0.0.1", 443))
            receiver.settimeout(0.25)
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sender:
                sender.sendto(b"x", ("127.0.0.1", 443))
            try:
                receiver.recv(2)
                report["quic_blocked"] = False
            except TimeoutError:
                report["quic_blocked"] = True
        phase = "fixture_depletion"
        report["depletion_received_bytes"] = transfer(443, 262144)
        last = json.loads(snapshot(p))
        used = {r["quota"]["name"]: r["quota"]["used"] for r in last["nftables"] if "quota" in r}
        report["quota_depleted_and_transfer_blocked"] = (
            used["all_in"] >= 131072 and report["depletion_received_bytes"] < 262144
        )
        report["fixture_checks_finished"] = True
    except BaseException:
        report["failed_phase"] = phase
    print(json.dumps(report, separators=(",", ":")))


def outer():
    assert sys.platform == "linux" and os.geteuid() == 0 and sys.version_info[:2] == (3, 12)
    signal.alarm(600)
    report = {
        "schema": "lumi.network-native-probe.v0.1",
        "real_4b_import": False,
        "gate_5_complete": False,
        "gpu": False,
        "retry_allowed": False,
    }
    phase = "fallback_expiry"
    try:
        run(
            [
                "/usr/bin/systemd-run",
                "--no-block",
                "--unit=lumi-probe-fallback",
                "--on-boot=1200s",
                "--timer-property=AccuracySec=1s",
                "/usr/sbin/poweroff",
            ]
        )
        phase = "tools"
        if not shutil.which("nft"):
            # Setup threshold, not a strict wire-byte cap. DNS is managed by the VM.
            run(["/usr/sbin/iptables", "-N", "LUMI_PROBE_HTTPS"])
            run(
                [
                    "/usr/sbin/iptables",
                    "-A",
                    "LUMI_PROBE_HTTPS",
                    "-m",
                    "quota",
                    "--quota",
                    "1073741824",
                    "-j",
                    "ACCEPT",
                ]
            )
            run(["/usr/sbin/iptables", "-A", "LUMI_PROBE_HTTPS", "-j", "DROP"])
            run(
                [
                    "/usr/sbin/iptables",
                    "-I",
                    "INPUT",
                    "1",
                    "-p",
                    "tcp",
                    "--sport",
                    "443",
                    "-j",
                    "LUMI_PROBE_HTTPS",
                ]
            )
            run(
                [
                    "/usr/sbin/iptables",
                    "-I",
                    "OUTPUT",
                    "1",
                    "-p",
                    "tcp",
                    "--dport",
                    "80",
                    "-j",
                    "REJECT",
                ]
            )
            run(
                [
                    "/usr/sbin/ip6tables",
                    "-I",
                    "OUTPUT",
                    "1",
                    "-p",
                    "tcp",
                    "-m",
                    "multiport",
                    "--dports",
                    "80,443",
                    "-j",
                    "REJECT",
                ]
            )
            run(
                [
                    "/usr/bin/apt-get",
                    "-o",
                    "Acquire::ForceIPv4=true",
                    "-o",
                    "Acquire::Retries=0",
                    "update",
                ],
                timeout=120,
            )
            run(
                [
                    "/usr/bin/apt-get",
                    "-o",
                    "Acquire::ForceIPv4=true",
                    "-o",
                    "Acquire::Retries=0",
                    "-y",
                    "--no-install-recommends",
                    "install",
                    "nftables",
                ],
                timeout=120,
            )
        report["nft_version"] = run(["/usr/sbin/nft", "--version"]).decode().strip()
        report["systemd_version"] = (
            run(["/usr/bin/systemctl", "--version"]).decode().splitlines()[0]
        )
        phase = "namespace_probe"
        report["firewall"] = json.loads(
            run(
                ["/usr/bin/unshare", "--net", "/usr/bin/python3", "-I", "-B", __file__, "--child"],
                timeout=70,
            )
        )
        phase = "exact_expiry_units"
        p = policy()
        now = math.floor(time.clock_gettime(time.CLOCK_BOOTTIME))
        deadline = now + 90
        assert deadline < 1100
        units = p.expiry_units(original_deadline_boot_seconds=deadline, observed_boot_seconds=now)
        for name, body in units.items():
            path = Path("/run/systemd/system") / name
            with path.open("x") as f:
                f.write(body)
            path.chmod(0o400)
        run(
            [
                "/usr/bin/systemd-analyze",
                "verify",
                "--man=no",
                *[str(Path("/run/systemd/system") / name) for name in units],
            ]
        )
        run(["/usr/bin/systemctl", "daemon-reload"])
        run(["/usr/bin/systemctl", "start", p.TIMER])
        report["expiry_timer_active"] = (
            run(["/usr/bin/systemctl", "is-active", p.TIMER]).strip() == b"active"
        )
        report["expected_shutdown_boottime"] = deadline
        report["observed_boottime"] = now
        report["status"] = "awaiting_independent_stopped_observation"
    except BaseException:
        report["status"] = "failed"
        report["failed_phase"] = phase
    raw = json.dumps(report, sort_keys=True, separators=(",", ":")).encode()
    assert len(raw) < 32768
    encoded = base64.b64encode(raw).decode()
    with open("/dev/console", "w") as console:
        console.write("\nLUMI_NETWORK_PROBE_V1=" + encoded + "\n")
        console.flush()


if __name__ == "__main__":
    if sys.argv[1:] == ["--child"]:
        child()
    elif sys.argv[1:] == ["--outer"]:
        outer()
    else:
        raise SystemExit(2)
