"""Offline structural/authentication verification of attempt-018 source v0.4."""
from __future__ import annotations

import ast
import hashlib
import importlib
import json
import os
import sys
from pathlib import Path

from scripts import prepare_sft_vm_attempt018_v3 as format_v3

ROOT = Path(__file__).resolve().parents[1]
RELEASE = ROOT / "artifacts/lumi-vm-attempt-018-source-v0.4"
RELEASE_SHA = "29b71cbaf944c97867bc8466e19aa8ff3e89834ec12641ff0744f651b70d9bfb"
BUILDER_SHA = "75e7eed96e4dc373bffbf79722903720ed1ae43508a77262d19332ccb0f39f8d"
TEST_SHA = "43abca4ab70b6323ebab3277c73305f324df1716136690a8febef37bd6c4ab85"
FAILURE_SHA = "8d6de31036d320ca2d4e588981450596f08a361b6a77ee7d321fd7dcfdbf2543"
OUTPUT = ROOT / "evidence/lumi-vm-attempt-018-source-v0.4-verification-v0.1.json"


def need(value):
    if not value:
        raise ValueError("attempt018_v4_verification_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def read(path, digest, size=None, maximum=32 * 1024**2):
    need(not any(item.is_symlink() for item in (path, *path.parents)))
    need(path.is_file() and 0 < path.stat().st_size <= maximum)
    raw = path.read_bytes()
    need(sha(raw) == digest and (size is None or len(raw) == size))
    return raw


def authenticate_outer():
    scripts = str(RELEASE / "scripts")
    before = set(sys.modules)
    sys.path.insert(0, scripts)
    try:
        need("run_sft_vm_private_outer_v7" not in before)
        outer = importlib.import_module("run_sft_vm_private_outer_v7")
        need(Path(outer.__file__).resolve() == RELEASE / "scripts/run_sft_vm_private_outer_v7.py")
        outer.authenticate()
    finally:
        sys.path.remove(scripts)
        for name in set(sys.modules) - before:
            module = sys.modules.get(name)
            path = getattr(module, "__file__", None)
            if path is not None and Path(path).is_relative_to(RELEASE):
                del sys.modules[name]


def verify():
    read(ROOT / "scripts/prepare_sft_vm_attempt018_v4.py", BUILDER_SHA)
    read(ROOT / "tests/test_sft_vm_attempt018_v4.py", TEST_SHA)
    failure = json.loads(
        read(
            ROOT / "evidence/lumi-vm-attempt-018-source-v0.3-authentication-failure-v0.1.json",
            FAILURE_SHA,
        )
    )
    need(failure["status"] == "offline_preflight_test_rejected_before_cloud")
    release = json.loads(read(RELEASE / "release.json", RELEASE_SHA))
    need(
        release["schema"] == "lumi.vm-attempt018-source.v0.4"
        and release["v03_authentication_failure_sha256"] == FAILURE_SHA
        and release["repair"] == "propagate_sha256_and_byte_count_bindings"
        and release["source_versions_bound"] is True
        and release["versioned_object_count"] == 22
        and release["iam_source_action"] == "s3:GetObjectVersion"
        and len(release["outputs"]) == 156
    )
    bodies = {}
    for name, pin in release["outputs"].items():
        body = read(RELEASE / name, pin["sha256"], pin["bytes"])
        bodies[name] = body
        if name.endswith(".py"):
            ast.parse(body)
    inputs = json.loads(bodies["configs/lumi-vm-private-host-source-inputs-v0.1.json"])
    for role, pin in inputs["sources"].items():
        body = bodies["scripts/" + role + ".py"]
        need(pin == {"bytes": len(body), "sha256": sha(body)})
    authenticate_outer()
    selection = json.loads(bodies[format_v3.SELECTION])
    members = format_v3.tar_members(bodies[format_v3.TAR])
    manifest = json.loads(members["release-manifest.json"])
    need(
        selection["object_versions_bound"] is True
        and selection["versioned_object_count"] == 22
        and members["controls/input-selection.json"] == bodies[format_v3.SELECTION]
        and all(sha(members[name]) == digest for name, digest in manifest.items())
    )
    return {
        "schema": "lumi.vm-attempt018-source-v0.4-verification.v0.1",
        "attempt": format_v3.ATTEMPT,
        "status": "offline_source_repair_and_authentication_verified",
        "source_release_sha256": RELEASE_SHA,
        "builder_sha256": BUILDER_SHA,
        "test_sha256": TEST_SHA,
        "v03_authentication_failure_sha256": FAILURE_SHA,
        "outputs_verified": 156,
        "outer_source_authentication_verified": True,
        "sha256_and_byte_count_closure_verified": True,
        "versioned_objects_verified": 22,
        "embedded_archive_verified": True,
        "version_only_iam_verified": True,
        "wire_or_billing_byte_cap_claimed": False,
        "cloud_calls": 0,
        "payload_reads": 0,
        "execution_authority_created": False,
        "cpu_instance_launched": False,
        "checkpoint_access": False,
        "real_4b_import": False,
        "gate_5_complete": False,
        "gpu": False,
        "training": False,
    }


def write():
    result = verify()
    raw = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    need(not OUTPUT.exists() and not OUTPUT.is_symlink())
    fd = os.open(OUTPUT, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    with os.fdopen(fd, "wb") as stream:
        need(stream.write(raw) == len(raw))
    return result


if __name__ == "__main__":
    need(sys.argv in ([sys.argv[0]], [sys.argv[0], "--write"]))
    print(json.dumps(write() if len(sys.argv) == 2 else verify(), sort_keys=True))
