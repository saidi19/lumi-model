"""One conditional backup and independent streamed readback of a completed package.

Private admitted-parent API only. No import, client creation, credentials, cloud
admission or deletion. The parent must exclude writers, admit the private bucket
and bind a separate retention credential lifetime/unit before using this code.
Public entry stays closed. A failed/ambiguous attempt is consumed, not retried.
"""

from __future__ import annotations

import hashlib
import io
import json
import math
import os
import re
import stat
import sys
import time
from pathlib import Path

from . import posttraining_vm_fullsize_completion_v1 as completion

ATTEMPT = "606d788073f1f0b66a39eabeb4b32c2c"
ROOT = completion.handoff.ROOT
REPO = Path(__file__).resolve().parents[2]
PROPOSAL_SHA = "9e1ea3041ce5ca3ead8f58d0931dc8c7e41c5a66a9bc43e55ff75890b662c061"
COMPLETION_SHA = "259bc102563dcf48ac55e818505082f5c0703efbfa1698055a03144c60ab98a7"
ACCOUNT = "573978149073"
BUCKET = "lumi-corpus-prod-27777c02b29b76efcac3"
PREFIX = "lumi-corpus/v0.1/control/sft-import-research/" + ATTEMPT + "/"
PACKAGE_REL = "retained/outputs/import/attempt-001/checkpoint"
WORKER_UID = WORKER_GID = 10001
ROOT_UID = ROOT_GID = 0
CHUNK = 1024 * 1024
PACKAGE_CAP = 8_415_205_181
META_CAP = 4 * 1024 * 1024
COMMIT_CAP = 512 * 1024
FALSE = dict(
    real_4b_import=False,
    gate_5_complete=False,
    training_authorized=False,
    production_eligible=False,
    instance_termination_allowed=False,
    retry_allowed=False,
)
METADATA = {
    "completion.json": ("completion.json", "root", 0o600),
    "verification.json": ("stage/verification/verification.json", "worker", 0o600),
    "summary.json": ("retained/outputs/summary.json", "worker", 0o600),
    **{
        name: ("retained/outputs/import/attempt-001/" + name, "worker", 0o600)
        for name in ("import-started-v0.6.json", "import-complete-v0.6.json", "source-config.json")
    },
}


def need(value):
    if not value:
        raise ValueError("retention_rejected") from None


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()


def unique(pairs):
    result = {}
    for key, value in pairs:
        need(key not in result)
        result[key] = value
    return result


def decode(raw):
    value = json.loads(raw, object_pairs_hook=unique)
    need(type(value) is dict)
    return value


def pin(value):
    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def snapshot(info):
    # Exclude atime: reading may update it, but content/ownership must not change.
    return tuple(
        getattr(info, k)
        for k in (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_nlink",
            "st_uid",
            "st_gid",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
    )


def parents(path):
    for item in (path, *path.parents):
        info = item.lstat()
        need(stat.S_ISDIR(info.st_mode) and not info.st_mode & 0o022)
        need(info.st_uid in {ROOT_UID, WORKER_UID})


def info(path, owner, mode, cap):
    parents(path.parent)
    row = path.lstat()
    uid, gid = (ROOT_UID, ROOT_GID) if owner == "root" else (WORKER_UID, WORKER_GID)
    need(stat.S_ISREG(row.st_mode) and row.st_nlink == 1 and (row.st_uid, row.st_gid) == (uid, gid))
    need(stat.S_IMODE(row.st_mode) == mode and 0 < row.st_size <= cap)
    return row


def small(path, owner, mode, cap=131072):
    before = info(path, owner, mode, cap)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        need(snapshot(os.fstat(stream.fileno())) == snapshot(before))
        raw = stream.read(cap + 1)
        need(snapshot(os.fstat(stream.fileno())) == snapshot(before))
    need(len(raw) == before.st_size and snapshot(path.lstat()) == snapshot(before))
    return raw


def policy():
    # Code/proposal bindings only, never model/tokenizer source objects.
    raw = (REPO / "configs/lumi-vm-fullsize-host-proposal-v0.1.json").read_bytes()
    need(len(raw) <= 32768 and sha(raw) == PROPOSAL_SHA)
    need(sha(Path(completion.__file__).read_bytes()) == COMPLETION_SHA)
    proposal = decode(raw)
    target = proposal["retention_proposal"]
    need(proposal["prepared_attempt"] == ATTEMPT)
    expected = dict(
        bucket=BUCKET,
        region="us-east-1",
        prefix=PREFIX,
        package_maximum_bytes=PACKAGE_CAP,
        package_files_maximum=512,
        metadata_maximum_bytes=META_CAP,
        metadata_files_maximum=16,
        put_requests_maximum=528,
        independent_get_requests_maximum=528,
        per_object_maximum_bytes=2**31,
        list_requests=0,
        overwrite_allowed=False,
        multipart=False,
        retry_allowed=False,
    )
    need(all(canonical(target[k]) == canonical(v) for k, v in expected.items()))


def _runtime(attempt):
    need(attempt == ATTEMPT and sys.platform == "linux" and os.geteuid() == 0)
    completion.frozen.root_owned(ROOT / attempt)
    need(stat.S_IMODE((ROOT / attempt).stat().st_mode) == 0o700)
    units = [completion.handoff.unit_name(attempt, p) for p in ("acquire", "import")]
    need(all(completion.frozen.cgroup_empty(u) for u in units + [completion.verify_unit(attempt)]))


def exact_children(path, expected):
    names = set()
    parents(path)
    with os.scandir(path) as entries:
        for entry in entries:
            need(entry.name in expected and entry.name not in names and len(names) < len(expected))
            names.add(entry.name)
    need(names == expected)


def inventory(destination, returned):
    bodies, rows = {}, []
    for name, (relative, owner, mode) in METADATA.items():
        path = destination / relative
        raw = small(path, owner, mode)
        bodies[name] = raw
        rows.append(
            dict(
                key=PREFIX + "metadata/" + name,
                path=path,
                owner=owner,
                mode=mode,
                bytes=len(raw),
                sha256=sha(raw),
                identity=snapshot(path.lstat()),
            )
        )
    complete = decode(bodies["completion.json"])
    need(canonical(complete) == canonical(returned))
    need(complete["schema"] == "lumi.vm-fullsize-completion.v0.1")
    need(complete["status"] == "verified_package_preserved_locally_offhost_retention_pending")
    need(
        all(
            complete[k] is True
            for k in (
                "independent_checksum_consumer",
                "all_three_cgroups_empty",
                "local_output_tree_preserved",
            )
        )
    )
    need(
        all(
            complete[k] is False
            for k in (
                "offhost_retention_verified",
                "instance_termination_allowed",
                "gpu",
                "training_authorized",
                "real_4b_import",
                "gate_5_complete",
                "production_eligible",
            )
        )
    )
    need(pin(complete["source_manifest_sha256"]) and pin(complete["package_manifest_sha256"]))
    need(sha(bodies["verification.json"]) == complete["verification_sha256"])
    need(sha(bodies["summary.json"]) == complete["import_summary_sha256"])
    verified = decode(bodies["verification.json"])
    completion._validate_verification(verified, complete["package_manifest_sha256"])
    package = destination / PACKAGE_REL
    raw = small(package / "manifest.sha256", "worker", 0o600)
    need(sha(raw) == complete["package_manifest_sha256"])
    declared = {"manifest.sha256": sha(raw)}
    for line in raw.decode("utf-8").splitlines():
        digest, separator, name = line.partition("  ")
        need(separator and pin(digest) and name not in declared)
        need(type(name) is str and 0 < len(name) <= 256 and len(name.split("/")) <= 8)
        need(re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", name))
        need(all(part not in {".", ".."} for part in name.split("/")))
        declared[name] = digest
        need(len(declared) <= 512)
    found = {}
    pending = [package]
    visited = 0
    while pending:
        path = pending.pop()
        visited += 1
        need(visited <= 1024 and len(path.relative_to(package).parts) <= 8)
        row = path.lstat()
        if stat.S_ISDIR(row.st_mode):
            parents(path)
            need((row.st_uid, row.st_gid) == (WORKER_UID, WORKER_GID))
            need(stat.S_IMODE(row.st_mode) == 0o700)
            with os.scandir(path) as entries:
                for entry in entries:
                    need(visited + len(pending) < 1024)
                    pending.append(Path(entry.path))
        else:
            row = info(path, "worker", 0o600, 2**31)
            name = path.relative_to(package).as_posix()
            need(name in declared and name not in found)
            found[name] = dict(
                key=PREFIX + "package/" + name,
                path=path,
                owner="worker",
                mode=0o600,
                bytes=row.st_size,
                sha256=declared[name],
                identity=snapshot(row),
            )
    need(set(found) == set(declared) and 3 <= len(found) <= 512)
    package_bytes = sum(r["bytes"] for r in found.values())
    need(0 < package_bytes <= PACKAGE_CAP)
    need(verified["files"] == len(found) and verified["package_bytes"] == package_bytes)
    # These are the only non-package output files of the frozen successful entry.
    output = destination / "retained/outputs"
    exact_children(output, {"summary.json", "import"})
    exact_children(output / "import", {"attempt-001"})
    exact_children(
        package.parent,
        {
            "checkpoint",
            "source-config.json",
            "import-started-v0.6.json",
            "import-complete-v0.6.json",
        },
    )
    meta_bytes = sum(map(len, bodies.values()))
    need(meta_bytes + COMMIT_CAP <= META_CAP and len(rows) + 1 <= 16)
    return [found[k] for k in sorted(found)] + rows, dict(
        package_bytes=package_bytes,
        metadata_bytes=meta_bytes,
        initial_manifest_read_bytes=len(raw),
        package_manifest_sha256=complete["package_manifest_sha256"],
        source_manifest_sha256=complete["source_manifest_sha256"],
    )


class CheckedBody:
    """One forward-only bounded upload read. Hash while sending; no SDK reread."""

    def __init__(self, handle, row, deadline, clock):
        self.handle, self.row, self.deadline, self.clock = handle, row, deadline, clock
        self.count, self.hash = 0, hashlib.sha256()

    def tell(self):
        return self.count

    def read(self, amount=CHUNK):
        need(self.clock() < self.deadline)
        need(type(amount) is int and 0 <= amount <= CHUNK)
        remaining = self.row["bytes"] - self.count
        if not remaining or not amount:
            return b""
        raw = self.handle.read(min(amount, remaining))
        need(type(raw) is bytes and 0 < len(raw) <= min(amount, remaining))
        self.count += len(raw)
        self.hash.update(raw)
        return raw

    def finish(self):
        need(self.count == self.row["bytes"] and self.hash.hexdigest() == self.row["sha256"])


def readback(reader, row, deadline, clock):
    body = reader.open(row)
    count, digest = 0, hashlib.sha256()
    try:
        while count < row["bytes"]:
            need(clock() < deadline)
            request = min(CHUNK, row["bytes"] - count)
            raw = body.read(request)
            need(type(raw) is bytes and 0 < len(raw) <= request)
            count += len(raw)
            digest.update(raw)
        need(clock() < deadline and body.read(1) == b"")
        need(digest.hexdigest() == row["sha256"])
        return count
    finally:
        body.close()


def _retain_completed_admitted_once(
    attempt, returned_completion, *, writer, reader, deadline, clock=time.monotonic
):
    need(
        type(deadline) in {int, float}
        and math.isfinite(deadline)
        and 0 < deadline - clock() <= 1800
    )
    need(writer is not reader)
    policy()
    _runtime(attempt)
    destination = ROOT / attempt
    output = destination / "retention"
    output.mkdir(mode=0o700, exist_ok=False)
    completion._fsync_directory(destination)
    report = dict(
        schema="lumi.vm-fullsize-retention.v0.1",
        attempt=ATTEMPT,
        **FALSE,
        offhost_retention_verified=False,
        puts_attempted=0,
        gets_attempted=0,
        uploaded_content_bytes=0,
        readback_content_bytes=0,
        commit_readback_verified=False,
    )
    completion.frozen.write_new(output / "started.json", report)
    completion._fsync_directory(output)
    stage = "inventory"
    try:
        rows, totals = inventory(destination, returned_completion)
        need(len(rows) + 1 <= 528 and clock() < deadline)
        stage = "package_and_metadata"
        for row in rows:
            before = info(row["path"], row["owner"], row["mode"], 2**31)
            need(snapshot(before) == row["identity"])
            fd = os.open(row["path"], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as handle:
                need(snapshot(os.fstat(handle.fileno())) == row["identity"])
                body = CheckedBody(handle, row, deadline, clock)
                report["puts_attempted"] += 1
                writer.put(row, body)
                body.finish()
                need(snapshot(os.fstat(handle.fileno())) == row["identity"])
            need(snapshot(row["path"].lstat()) == row["identity"])
            report["uploaded_content_bytes"] += body.count
            report["gets_attempted"] += 1
            report["readback_content_bytes"] += readback(reader, row, deadline, clock)
        stage = "commit"
        need(clock() < deadline)
        # No self-referential hash: commit describes preceding checked objects;
        # its own hash is independently returned/kept in the local final report.
        commit = canonical(
            dict(
                schema="lumi.vm-fullsize-retention-commit.v0.1",
                attempt=ATTEMPT,
                bucket=BUCKET,
                prefix=PREFIX,
                **totals,
                **FALSE,
                preceding_objects_readback_verified=True,
                objects=[{k: r[k] for k in ("key", "bytes", "sha256")} for r in rows],
            )
        )
        need(0 < len(commit) <= COMMIT_CAP and totals["metadata_bytes"] + len(commit) <= META_CAP)
        row = dict(
            key=PREFIX + "metadata/retention-commit.json", bytes=len(commit), sha256=sha(commit)
        )
        with io.BytesIO(commit) as handle:
            body = CheckedBody(handle, row, deadline, clock)
            report["puts_attempted"] += 1
            writer.put(row, body)
            body.finish()
        report["uploaded_content_bytes"] += len(commit)
        report["gets_attempted"] += 1
        report["readback_content_bytes"] += readback(reader, row, deadline, clock)
        need(report["puts_attempted"] == report["gets_attempted"] == len(rows) + 1)
        need(report["uploaded_content_bytes"] == report["readback_content_bytes"])
        need(report["uploaded_content_bytes"] <= PACKAGE_CAP + META_CAP)
        report.update(
            offhost_retention_verified=True,
            commit_readback_verified=True,
            commit_sha256=row["sha256"],
            objects=len(rows) + 1,
            eof_probe_count=len(rows) + 1,
            **totals,
        )
        stage = "report"
        completion.frozen.write_new(output / "result.json", report)
        completion._fsync_directory(output)
        return report
    except BaseException:
        try:
            completion.frozen.write_new(output / "failed.json", dict(report, failed_stage=stage))
            completion._fsync_directory(output)
        except BaseException:
            pass
        raise ValueError("retention_failed") from None


def retain_package(**_arguments):
    raise ValueError("host_guard_not_bound") from None
