"""Private root credential provisioning joined to existing teardown/workflow.

Not cloud provisioning, credential issuance, IAM scope verification or host
admission. The admitting controller supplies an authenticated bounded pipe of
short-lived STS Credentials, after source/runtime/disk/egress/expiry admission.
No argv/env secrets, no ambient AWS lookup, no credential body in diagnostics.
Public execution remains closed; no CLI entry. Caller owns the input descriptor.
"""

from __future__ import annotations

import datetime as dt
import fcntl
import json
import os
import select
import stat
import time

from . import posttraining_vm_fullsize_credential_handoff_v1 as workflow

handoff = workflow.handoff
completion = workflow.completion
MAX_INPUT = 65536
MIN_VALIDITY_SECONDS = 3675  # Existing 3615-second acquisition ceiling plus 60s margin.
MAX_VALIDITY_SECONDS = 7200


def need(value):
    if not value:
        raise ValueError("credential_setup_rejected") from None


def _read_pipe(fd, deadline):
    need(type(fd) is int and fd >= 0 and time.monotonic() < deadline)
    info = os.fstat(fd)
    need(stat.S_ISFIFO(info.st_mode) and info.st_uid == workflow.ROOT_UID)
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    need(flags & os.O_ACCMODE == os.O_RDONLY)
    body = bytearray()
    try:
        fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
        while True:
            remaining = deadline - time.monotonic()
            need(remaining > 0 and select.select([fd], [], [], remaining)[0] == [fd])
            try:
                chunk = os.read(fd, min(4096, MAX_INPUT + 1 - len(body)))
            except BlockingIOError:
                continue
            if not chunk:
                return body
            body.extend(chunk)
            need(len(body) <= MAX_INPUT)
    except BaseException:
        body[:] = b"\0" * len(body)
        raise ValueError("credential_pipe_rejected") from None
    finally:
        fcntl.fcntl(fd, fcntl.F_SETFL, flags)


def _normalize(raw, now):
    """Accept only the STS Credentials object, not CLI profiles or account files."""

    def pairs(items):
        result = {}
        for key, value in items:
            need(key not in result)
            result[key] = value
        return result

    need(0 < len(raw) <= MAX_INPUT)
    value = json.loads(raw, object_pairs_hook=pairs)
    need(
        type(value) is dict
        and set(value) == {"AccessKeyId", "SecretAccessKey", "SessionToken", "Expiration"}
    )
    keys = {
        "AccessKeyId": "access_key",
        "SecretAccessKey": "secret_key",
        "SessionToken": "session_token",
    }
    need(
        all(
            type(value[k]) is str
            and 1 <= len(value[k]) <= 16384
            and all(32 < ord(c) < 127 for c in value[k])
            for k in keys
        )
    )
    need(value["AccessKeyId"].startswith("ASIA"))  # Reject long-lived IAM access keys.
    need(type(value["Expiration"]) is str and len(value["Expiration"]) <= 40)
    expiry = dt.datetime.fromisoformat(value["Expiration"].replace("Z", "+00:00"))
    need(expiry.tzinfo is not None and expiry.utcoffset() == dt.timedelta(0))
    remaining = expiry.timestamp() - now
    need(MIN_VALIDITY_SECONDS <= remaining <= MAX_VALIDITY_SECONDS)
    normalized = (
        json.dumps(
            {out: value[key] for key, out in keys.items()}, sort_keys=True, separators=(",", ":")
        ).encode()
        + b"\n"
    )
    need(len(normalized) <= MAX_INPUT)
    # Python/JSON inevitably creates copies; clearing one buffer is not erasure.
    return normalized, expiry.timestamp()


def _mount_empty(path):
    workflow._no_swap()
    workflow._directory(path)
    need(workflow._mount(path) is None and list(path.iterdir()) == [])
    result = handoff.frozen.run_command(
        [
            "/usr/bin/mount",
            "-t",
            "tmpfs",
            "-o",
            "rw,nosuid,nodev,noexec,size=131072,mode=0700,uid=0,gid=0",
            "tmpfs",
            str(path),
        ],
        10,
    )
    need(result.returncode == 0)
    result = handoff.frozen.run_command(["/usr/bin/mount", "--make-private", "--", str(path)], 10)
    need(result.returncode == 0)
    workflow._directory(path)
    mount = workflow._mount(path)
    need(mount is not None and list(path.iterdir()) == [])
    capacity = os.statvfs(path)
    need(0 < capacity.f_blocks * capacity.f_frsize <= workflow.MOUNT_CAPACITY)
    return mount


def _write_source(path, raw, ownership):
    # Called only after mount/identity/capacity checks. Never fallback to disk.
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        fd = os.open(
            workflow.SOURCE_NAME,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=directory,
        )
        with os.fdopen(fd, "wb") as stream:
            info = os.fstat(stream.fileno())
            ownership["source_inode"] = (info.st_dev, info.st_ino)
            need(stream.write(raw) == len(raw))
            stream.flush()
            os.fsync(stream.fileno())
        os.fsync(directory)
    finally:
        os.close(directory)


def _abandon_undispatched(path, mount, snapshot, unit, ownership):
    """Exact own tmpfs only, no retries, no guessed target on ambiguous mount."""
    need(handoff.frozen.cgroup_empty(unit))
    need(workflow._mount(path) == mount)
    if snapshot is not None:
        workflow._remove_source(path, snapshot, unit)
    else:
        # A partial write can be removed only if this invocation created its
        # inode. Never adopt an unexpected file following an O_EXCL failure.
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            names = os.listdir(fd)
            if names:
                need(names == [workflow.SOURCE_NAME])
                info = os.stat(workflow.SOURCE_NAME, dir_fd=fd, follow_symlinks=False)
                need(
                    (info.st_dev, info.st_ino) == ownership.get("source_inode")
                    and stat.S_ISREG(info.st_mode)
                    and info.st_nlink == 1
                    and (info.st_uid, info.st_gid) == (workflow.ROOT_UID, workflow.ROOT_GID)
                    and stat.S_IMODE(info.st_mode) == 0o600
                    and 0 <= info.st_size <= MAX_INPUT
                )
                os.unlink(workflow.SOURCE_NAME, dir_fd=fd)
                os.fsync(fd)
            need(os.listdir(fd) == [])
        finally:
            os.close(fd)
        result = handoff.frozen.run_command(["/usr/bin/umount", "--", str(path)], 10)
        need(result.returncode == 0 and workflow._mount(path) is None)
        workflow._directory(path)
        need(list(path.iterdir()) == [])


def run_workflow(**_arguments):
    raise handoff.HandoffError("host_guard_not_bound") from None


def _run_admitted_once(
    attempt, acquisition_pins, import_pins, *, machine_id, credential_fd, deadline
):
    handoff.import_command(attempt, import_pins)
    workflow.acquisition.command(attempt, **acquisition_pins)
    need(acquisition_pins["source_manifest_sha256"] == import_pins["source_manifest_sha256"])
    need(type(deadline) in {int, float} and 60 < deadline - time.monotonic() <= 8435)
    handoff.frozen.host_check(machine_id)
    destination = handoff.ROOT / attempt
    workflow._directory(destination)
    source = destination / "credentials"
    workflow._directory(source)
    need(workflow._mount(source) is None and list(source.iterdir()) == [])
    workflow._no_swap()
    unit = handoff.unit_name(attempt, "acquire")
    old = handoff.frozen.run_command(
        ["/usr/bin/systemctl", "show", unit, "--property=LoadState", "--value"], 5, capture=True
    )
    need(
        old.returncode in {0, 1, 4}
        and old.stdout.strip() == b"not-found"
        and handoff.frozen.cgroup_empty(unit)
    )
    for name in ("acquisition-dispatch.started", "credential-workflow.started.json"):
        need(not (destination / name).exists() and not (destination / name).is_symlink())
    handoff.frozen.write_new(
        destination / "credential-provision.started.json", {"retry_allowed": False}
    )
    completion._fsync_directory(destination)
    phase, mount, snapshot = "mount", None, None
    raw, normalized = None, None
    ownership = {}
    delegated = False
    try:
        mount = _mount_empty(source)
        phase = "read_pipe"
        raw = _read_pipe(credential_fd, min(deadline, time.monotonic() + 5))
        phase = "validate"
        normalized, expires_at = _normalize(raw, time.time())
        raw[:] = b"\0" * len(raw)
        raw = None
        phase = "write_source"
        need(workflow._mount(source) == mount and list(source.iterdir()) == [])
        _write_source(source, normalized, ownership)
        normalized = None
        snapshot = workflow._snapshot(source)
        need(snapshot["mount"] == mount)
        phase = "receipt"
        handoff.frozen.write_new(
            destination / "credential-provision.json",
            {
                "schema": "lumi.vm-fullsize-credential-provision.v0.1",
                "source": "bounded_private_pipe",
                "root_tmpfs_capacity_bytes": 131072,
                "temporary_credential_shape_validated": True,
                "minimum_remaining_seconds": MIN_VALIDITY_SECONDS,
                "credential_identity_or_contents_retained": False,
                "iam_scope_independently_verified": False,
                "issuer_authenticated_here": False,
                "cryptographic_erasure_claimed": False,
                "host_admitted": False,
                "real_4b_import": False,
                "gate_5_complete": False,
            },
        )
        completion._fsync_directory(destination)
        need(expires_at - time.time() >= MIN_VALIDITY_SECONDS and time.monotonic() < deadline)
        phase = "workflow"
        # After delegation the existing workflow owns cleanup/no-retry evidence.
        delegated = True
        return workflow._run_admitted_once(
            attempt, acquisition_pins, import_pins, machine_id=machine_id, deadline=deadline
        )
    except BaseException:
        cleanup_complete = False
        # The workflow can reject in its preflight before taking ownership.
        # Its exclusive marker is the boundary; never retry a started cleanup.
        workflow_marker = destination / "credential-workflow.started.json"
        cleanup_delegated = delegated and (workflow_marker.exists() or workflow_marker.is_symlink())
        if mount is not None and not cleanup_delegated:
            try:
                _abandon_undispatched(source, mount, snapshot, unit, ownership)
                cleanup_complete = True
            except BaseException:
                pass
        try:
            handoff.frozen.write_new(
                destination / "credential-provision-failed.json",
                {
                    "stage": phase,
                    "undispatched_source_cleanup_complete": cleanup_complete,
                    "cleanup_delegated_to_workflow": cleanup_delegated,
                    "retry_allowed": False,
                    "credential_identity_or_contents_retained": False,
                    "output_deletion_allowed": False,
                },
            )
        except BaseException:
            pass
        raise ValueError("credential_provision_failed") from None
    finally:
        if raw is not None:
            raw[:] = b"\0" * len(raw)
        normalized = None
