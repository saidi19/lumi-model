"""Credential-source teardown joined to the frozen acquisition/completion path.

Not host admission or credential provisioning. A separately admitted root parent
must create the exact private tmpfs source before calling the private entry.
Never reads credential contents. Removes only the snapshotted source file after
empty-cgroup proof, unmounts without force/lazy flags, and preserves aggregate
evidence. Systemd's credential copy is then stopped/reaped by the unchanged
handoff before import. Unlink/unmount is not cryptographic erasure or revocation.
"""

from __future__ import annotations

import os
import stat
import time

from . import posttraining_vm_fullsize_acquisition_unit_v1 as acquisition

handoff = acquisition.handoff
completion = acquisition.completion
MOUNT_CAPACITY = 131072
SOURCE_NAME = "aws-session.json"
ROOT_UID = ROOT_GID = 0


def need(value):
    if not value:
        raise ValueError("credential_handoff_rejected") from None


def _mount_record(raw, path):
    need(type(raw) is bytes and len(raw) <= 1024**2)
    records = []
    for line in raw.decode("ascii").splitlines():
        left, right = line.split(" - ", 1)
        fields, fs = left.split(), right.split()
        need(len(fields) >= 6 and len(fs) >= 3)
        need(not fields[4].startswith(str(path) + "/"))
        if fields[4] == str(path):
            records.append((fields, fs))
    need(len(records) <= 1)
    if not records:
        return None
    fields, fs = records[0]
    need(fields[0].isdigit() and fields[3] == "/" and fs[0] == fs[1] == "tmpfs")
    need({"rw", "nosuid", "nodev", "noexec"} <= set(fields[5].split(",")))
    need(not any(x.startswith(("shared:", "master:")) for x in fields[6:]))
    return (fields[0], fields[2], fields[5], fs[2])


def _mount(path):
    with open("/proc/self/mountinfo", "rb") as stream:
        return _mount_record(stream.read(1024**2 + 1), path)


def _no_swap():
    with open("/proc/swaps", "rb") as stream:
        lines = stream.read(4097).splitlines()
    need(
        len(lines) == 1
        and lines[0].split() == [b"Filename", b"Type", b"Size", b"Used", b"Priority"]
    )


def _identity(info):
    return tuple(
        getattr(info, key)
        for key in (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_uid",
            "st_gid",
            "st_nlink",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
    )


def _directory(path):
    handoff.frozen.root_owned(path)
    info = path.lstat()
    need(
        stat.S_ISDIR(info.st_mode)
        and (info.st_uid, info.st_gid) == (ROOT_UID, ROOT_GID)
        and stat.S_IMODE(info.st_mode) == 0o700
    )
    return (info.st_dev, info.st_ino)


def _snapshot(path):
    _no_swap()
    directory = _directory(path)
    mount = _mount(path)
    need(mount is not None)
    capacity = os.statvfs(path)
    need(0 < capacity.f_blocks * capacity.f_frsize <= MOUNT_CAPACITY)
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        need((os.fstat(fd).st_dev, os.fstat(fd).st_ino) == directory)
        need(os.listdir(fd) == [SOURCE_NAME])
        info = os.stat(SOURCE_NAME, dir_fd=fd, follow_symlinks=False)
        need(
            stat.S_ISREG(info.st_mode)
            and (info.st_uid, info.st_gid) == (ROOT_UID, ROOT_GID)
            and info.st_nlink == 1
            and stat.S_IMODE(info.st_mode) == 0o600
            and 0 < info.st_size <= 65536
        )
        return {"directory": directory, "mount": mount, "source": _identity(info)}
    finally:
        os.close(fd)


def _remove_source(path, snapshot, unit):
    need(handoff.frozen.cgroup_empty(unit))
    need(_snapshot(path) == snapshot)
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        need((os.fstat(fd).st_dev, os.fstat(fd).st_ino) == snapshot["directory"])
        need(
            _identity(os.stat(SOURCE_NAME, dir_fd=fd, follow_symlinks=False)) == snapshot["source"]
        )
        need(handoff.frozen.cgroup_empty(unit))
        os.unlink(SOURCE_NAME, dir_fd=fd)
        os.fsync(fd)
        need(os.listdir(fd) == [])
    finally:
        os.close(fd)
    need(_mount(path) == snapshot["mount"])
    result = handoff.frozen.run_command(["/usr/bin/umount", "--", str(path)], 10)
    need(result.returncode == 0 and _mount(path) is None)
    _directory(path)  # Revealed underlying directory must still be private and empty.
    need(list(path.iterdir()) == [] and handoff.frozen.cgroup_empty(unit))


def _reap_failed_acquisition(unit):
    result = handoff.frozen.run_command(
        ["/usr/bin/systemctl", "show", unit, "--property=LoadState", "--value"], 5, capture=True
    )
    need(result.returncode in {0, 1, 4})
    if result.stdout.strip() != b"not-found":
        need(result.returncode == 0 and result.stdout.strip() == b"loaded")
        handoff._stop_and_reap(unit)
    need(handoff.frozen.cgroup_empty(unit))


def run_workflow(**_arguments):
    raise handoff.HandoffError("host_guard_not_bound") from None


def _run_admitted_once(attempt, acquisition_pins, import_pins, *, machine_id, deadline):
    """Existing workflow with mandatory root source cleanup before completion.

    The caller still authenticates the complete host/runtime/release/egress and
    provisions this tmpfs. There is no approval boolean or public execution path.
    The fullsize source release must separately bind this successor before use.
    """
    handoff.import_command(attempt, import_pins)
    acquisition.command(attempt, **acquisition_pins)
    need(acquisition_pins["source_manifest_sha256"] == import_pins["source_manifest_sha256"])
    need(type(deadline) in {int, float} and 0 < deadline - time.monotonic() <= 8435)
    handoff.frozen.host_check(machine_id)
    destination = handoff.ROOT / attempt
    _directory(destination)
    source = destination / "credentials"
    snapshot = _snapshot(source)
    # This marker consumes ambiguous acquisition or cleanup failures as well.
    handoff.frozen.write_new(
        destination / "credential-workflow.started.json", {"retry_allowed": False}
    )
    completion._fsync_directory(destination)
    unit = handoff.unit_name(attempt, "acquire")
    phase, cleanup_started, cleaned = "acquisition", False, False
    try:
        acquisition._run_acquisition_admitted_once(
            attempt,
            acquisition_pins,
            machine_id=machine_id,
            deadline=min(deadline, time.monotonic() + 3615),
        )
        phase = "credential_cleanup"
        cleanup_started = True
        _remove_source(source, snapshot, unit)
        cleaned = True
        handoff.frozen.write_new(
            destination / "credential-source-cleanup.json",
            {
                "schema": "lumi.vm-fullsize-credential-source-cleanup.v0.1",
                "root_source_unlinked": True,
                "root_tmpfs_unmounted": True,
                "acquisition_cgroup_empty": True,
                "credential_contents_read": False,
                "systemd_copy_teardown": "unchanged_handoff_before_import",
                "cryptographic_erasure_claimed": False,
                "credential_revocation_claimed": False,
                "host_admitted": False,
                "gate_5_complete": False,
            },
        )
        completion._fsync_directory(destination)
        phase = "completion"
        need(time.monotonic() < deadline)
        # Keep successful exited acquisition terminal state. Frozen completion
        # validates and stops it before import; pre-stopping would break that gate.
        return completion._complete_admitted_once(
            attempt,
            import_pins,
            machine_id=machine_id,
            deadline=min(deadline, time.monotonic() + 4820),
        )
    except BaseException:
        reaped = False
        try:
            _reap_failed_acquisition(unit)
            reaped = True
            if not cleanup_started:
                cleanup_started = True
                _remove_source(source, snapshot, unit)
                cleaned = True
        except BaseException:
            pass  # Fixed failure record below; never start import or retry cleanup.
        try:
            handoff.frozen.write_new(
                destination / "credential-workflow-failed.json",
                {
                    "stage": phase,
                    "root_source_cleanup_complete": cleaned,
                    "acquisition_reaped": reaped,
                    "retry_allowed": False,
                    "credential_contents_in_report": False,
                    "output_deletion_allowed": False,
                },
            )
        except BaseException:
            pass
        raise ValueError("credential_workflow_failed") from None
